// Sovereign Standard I/O
export func strlen(s: char*) -> int {
    var len: int = 0;
    var p: char* = s;
    while (*p != 0 as char) {
        len = len + 1;
        p = p + 1;
    }
    return len;
}

export func printChar(c: char) -> void {
    var buf: [char; 2];
    buf[0] = c;
    buf[1] = 0 as char;
    print(buf as string);
}

export func print(msg: string) -> void {
    var s: char* = msg as char*;
    var len: int = strlen(s);
    if (len == 0) return;

    asm {
        "mov rax, 1\n"
        "mov rdi, 1\n"
        "mov rsi, {s}\n"
        "movsxd rdx, {len}\n"
        "syscall\n"
    }
}

export func puts(msg: string) -> void {
    print(msg);
    print("\n");
}

export func printInt(n: int) -> void {
    if (n == 0) {
        print("0");
        return;
    }
    var val: int = n;
    if (val < 0) {
        print("-");
        val = -val;
    }
    
    var buf: [char; 32];
    var i: int = 0;
    
    while (val > 0) {
        var digit: int = val % 10;
        buf[i] = (digit + 48) as char;
        val = val / 10;
        i = i + 1;
    }
    
    // Reverse and print
    while (i > 0) {
        i = i - 1;
        printChar(buf[i]);
    }
}

export func exit(code: int) -> void {
    asm {
        "mov rax, 60\n"
        "mov rdi, {code}\n"
        "syscall\n"
    }
    // Fallback if syscall fails (should not happen for exit)
    while (true) {}
}
