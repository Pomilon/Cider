// Sovereign Standard I/O
export func strlen(s: char*) -> int {
    var len: int = 0;
    var p: char* = s;
    while (*p != 0 as char) {
        len = len + 1;
        p = p + 1;
    }
    return len;
}

export func printChar(c: char) -> void {
    var buf: [char; 2];
    buf[0] = c;
    buf[1] = 0 as char;
    print(buf as string);
}

export func print(msg: string) -> void {
    var s: char* = msg as char*;
    var len: int = strlen(s);
    if (len == 0) return;

    asm {
        "mov rax, 1\n"
        "mov rdi, 1\n"
        "mov rsi, {s}\n"
        "movsxd rdx, {len}\n"
        "syscall\n"
    }
}

export func puts(msg: string) -> void {
    print(msg);
    print("\n");
}

export func printInt(n: int) -> void {
    if (n == 0) {
        print("0");
        return;
    }
    var val: int = n;
    if (val < 0) {
        print("-");
        val = -val;
    }
    
    var buf: [char; 32];
    var i: int = 0;
    
    while (val > 0) {
        var digit: int = val % 10;
        buf[i] = (digit + 48) as char;
        val = val / 10;
        i = i + 1;
    }
    
    // Reverse and print
    while (i > 0) {
        i = i - 1;
        printChar(buf[i]);
    }
}

export func read_stdin(buf: *void, count: int) -> int {
    var result: int = 0;
    asm {
        "mov rax, 0\n"
        "mov rdi, 0\n"
        "mov rsi, {buf}\n"
        "movsxd rdx, {count}\n"
        "syscall\n"
        "mov {result}, eax\n"
    }
    return result;
}

export func read_line() -> string {
    var buf: [char; 4096];
    var n: int = read_stdin(buf as *void, 4096);
    if (n <= 0) { return ""; }
    var i: int = 0;
    while (i < n) {
        if (buf[i] == 10 as char) {
            buf[i] = 0 as char;
            return buf as string;
        }
        i = i + 1;
    }
    if (n < 4096) {
        buf[n] = 0 as char;
    }
    return buf as string;
}

export func read_all() -> string {
    var buf: [char; 4096];
    var total: int = 0;
    while (total < 4096) {
        var ptr: *void = (buf as *void) + total;
        var n: int = read_stdin(ptr, 4096 - total);
        if (n <= 0) break;
        total = total + n;
    }
    if (total < 4096) {
        buf[total] = 0 as char;
    } else {
        buf[4095] = 0 as char;
    }
    return buf as string;
}

export func exit(code: int) -> void {
    asm {
        "mov rax, 60\n"
        "mov rdi, {code}\n"
        "syscall\n"
    }
    // Fallback if syscall fails (should not happen for exit)
    while (true) {}
}
