// Cider Free-List Allocator — hardened (v2)
// Block layout:
//   offset 0: size (u64) - total block size inc 16-byte header
//   offset 8: next (free) / magic (allocated)
//   offset 16: user data
//
// Hardening (design spec §9):
//   - hard arena caps: MAX_ARENAS, MAX_TOTAL_BYTES (fail fast, never grow unbounded)
//   - corruption canaries on every freed block; malloc verifies before reuse
//   - fail-fast diagnostics: one line on stderr + a distinct exit code (70-79)
//   - free-list walk cycle guard: a walk that visits too many blocks dies
//     instead of looping (the 98GB incident's root cause)
//   - CIDER-BUG-215: malloc clears a block's free-list canary as it hands the
//     block out, so the allocator's own stamp is never served as data (see
//     clear_canary for the whole uninitialized-value policy)
//   - CIDER-BUG-193: malloc REFUSES some requests with nilPtr instead of
//     aborting: size < 0 or size > MAX_TOTAL_BYTES (1 GiB). The refusal is
//     cheap and deterministic -- no memory is touched -- so every caller
//     MUST test the return before use. The stdlib grow/reserve paths
//     (std.vector grow/reserve, std.map new_map/grow_map) report a refusal
//     through oom() below: `vm error: out of memory` on stderr, exit 2 --
//     the same line and code the VM reports for host-side OOM
//     (CIDER-BUG-121), so there is ONE OOM diagnostic language-wide and all
//     three backends (VM unoptimized, VM optimized, native) agree
//     byte-for-byte by construction: oom() is plain .cid plus the same
//     write(2)/exit asm pattern fail_fast uses, which the alloc_cap_overflow
//     (71) and alloc_mmap_fail (75) fixtures already pin on every backend.
//     Alternatives rejected: letting the nilPtr through misreports the
//     failure as a *user program bug* (CIDER-BUG-219's `null pointer
//     dereference`, exit 2, for a dereference the program never wrote) or
//     -- when the path skips the copy on nil old data (reserve on an empty
//     Vec) -- installs a silently corrupt container (nil data + nonzero
//     cap) that fails later or never. A fallback (keep the old buffer)
//     would either lie about cap or change every grow/push/insert
//     signature; fail-fast keeps the API unchanged, matching spec §9.

var free_list: *void = nilPtr;
var ARENA_SIZE: int = 1048576;
var HEADER_SIZE: int = 16;
var MIN_BLOCK_SIZE: int = 24;
var MAGIC_VAL: u64 = 3254775790;
var CANARY_VAL: u64 = 18446744073709551606 as u64;  // 0xFFFFFFFFFFFFFFF6
var MAX_ARENAS: int = 1024;
var MAX_TOTAL_BYTES: int = 1073741824;  // 1 GiB (fits int32; 2 GiB overflows the 32-bit int type)
var MAX_WALK_BLOCKS: int = 1000000;
var arena_count: int = 0;
// CIDER-BUG-117: 64-bit accumulator. The cap check below is evaluated in
// i64; keeping the total in the same width means an accepted request can
// never wrap the accumulator and disable the cap for later arenas.
var total_bytes: i64 = 0;

var fail_msg: string = "allocator: fatal error\n";

func fail_fast(code: int) -> void {
    var s: char* = fail_msg as char*;
    asm {
        "mov rax, 1"
        "mov rdi, 2"
        "mov rsi, {s}"
        // 23 = strlen("allocator: fatal error\n"); the old count 24 also
        // wrote the string's NUL terminator (CIDER-BUG-109 regression test
        // compares stderr byte-for-byte).
        "mov rdx, 23"
        "syscall"
    }
    asm {
        "mov rax, 60"
        "mov edi, {code}"
        "syscall"
    }
}

export func init_heap() -> void {
}

// CIDER-BUG-193: the stdlib OOM policy. A malloc refusal (size < 0 or
// size > MAX_TOTAL_BYTES -- see malloc) is reported here, never passed
// through as a nil data pointer. The bytes and exit code match the VM's
// host-side OOM diagnostic (CIDER-BUG-121) exactly: `vm error: out of
// memory` on stderr (fd 2), exit 2, the CIDER-ISS-001 runtime-error
// convention shared with the nil-pointer family (CIDER-BUG-211/219/225).
// The write+exit asm is the same pattern fail_fast uses, so the three
// backends agree byte-for-byte with no compiler support.
var oom_msg: string = "vm error: out of memory\n";

export func oom() -> void {
    var m: char* = oom_msg as char*;
    asm {
        "mov rax, 1"
        "mov rdi, 2"
        "mov rsi, {m}"
        // 24 = strlen("vm error: out of memory\n"); stopping before the
        // string's NUL terminator (cf. fail_fast, CIDER-BUG-109).
        "mov rdx, 24"
        "syscall"
    }
    asm {
        "mov rax, 60"
        "mov rdi, 2"
        "syscall"
    }
}

// CIDER-BUG-215: THE UNINITIALIZED-VALUE POLICY, part 2 of 2 (part 1 is
// VM::malloc, which makes the `mmap` syscall hand back zeroed memory on the
// VM exactly as native's kernel-zeroed MAP_ANONYMOUS pages do).
//
// The remaining source of a never-written read seeing a NON-zero value was
// the allocator's own corruption canary. This allocator marks a block as
// "on the free list" by stamping CANARY_VAL over the first 8 bytes of its
// PAYLOAD, and the walk validates that stamp before reuse. Two places write
// it, and both write it into a block the very next malloc will hand out:
//
//   * free() stamps `block + 16` as it returns a block to the list;
//   * mmap_arena stamps `arena + 16` to bootstrap the free list. The block
//     header is 16 bytes (size at +0, next/magic at +8), so `arena + 16` is
//     the user-data address of the first block carved out of every new arena.
//
// Nothing cleared the stamp on allocation, so the canary was served to the
// program as if it were data. CANARY_VAL is 0xFFFFFFFFFFFFFFF6, which reads
// back as -10 and -1 in the first two signed int words -- exactly the value
// `var back: D = p[1]` observed.
//
// Whether that happened at all depended on the run's allocation history, so
// it was not stable across backends. On the VM, mmap is emulated by a
// first-fit free list over the interpreter heap, so a program's first Cider
// arena can come out of a recycled (already-zeroed) frame chunk instead of a
// fresh extension, and which of the two happens depends on the IR's frame and
// ALLOCA layout -- which the optimizer rewrites. Hence one program saw the
// canary on `cider run --no-opt` and zeros on `cider run` and on native.
//
// The canary belongs to a block WHILE IT IS FREE, so malloc clears it as the
// block leaves the list. That restores the invariant the walk is supposed to
// enforce -- a stamp proves a real free(), not the arena bootstrap -- and
// makes every byte the allocator itself ever wrote into a payload invisible
// to the program.
//
// Only the stamp is cleared, not the whole payload, and that is deliberate:
// zeroing every allocation is not affordable here. The walk is interpreted,
// and MAX_TOTAL_BYTES exists so a program can legitimately request a 1 GiB
// block (see the alloc_cap_overflow regression); a byte-at-a-time zero fill
// turns that into a billion interpreted stores. So the policy is:
//
//   * fresh memory -- a block from a new arena, a dedicated big arena, or an
//     mmap from a program -- reads as 0 on all three backends;
//   * a RECYCLED block (one a previous free() returned) reads as whatever
//     that previous block contained beyond the cleared stamp, and is NOT
//     backend-independent: whether a given request even gets that block back
//     depends on free-list history, which differs per backend. That is C's
//     malloc contract, and defining it would mean zeroing every allocation --
//     a byte-at-a-time fill in an interpreted walk, which the 1 GiB request
//     MAX_TOTAL_BYTES exists to allow (see the alloc_cap_overflow regression)
//     cannot afford. Only the canary is defined, and only because the
//     allocator itself wrote it.
func clear_canary(ptr: *void) -> void {
    var p: *u64 = ptr as *u64;
    *p = 0 as u64;
}

func mmap_arena(size: int) -> *void {
    if (arena_count >= MAX_ARENAS) {
        fail_fast(70);
    }
    // CIDER-BUG-117: compare against the cap in 64-bit, subtraction form.
    // The old `total_bytes + size > MAX_TOTAL_BYTES` was evaluated in
    // 32-bit int: once a full 1 GiB arena had raised total_bytes to 2^30, a
    // second ~1 GiB request wrapped the sum to -2^31, so the check passed,
    // the mmap went ahead and total_bytes was left negative — the cap was
    // silently disabled for every later arena. total_bytes is never
    // negative (every accepted request keeps the total <= MAX_TOTAL_BYTES),
    // so `MAX_TOTAL_BYTES - total_bytes` cannot overflow either.
    if (size as i64 > MAX_TOTAL_BYTES as i64 - total_bytes) {
        fail_fast(71);
    }
    // CIDER-BUG-109: keep the syscall result as a signed 64-bit value.
    // Native mmap reports failure as a NEGATIVE errno in rax (-ENOMEM for an
    // impossible mapping) and the VM mirrors that (-EINVAL for a
    // non-positive length, -ENOMEM when the request cannot be satisfied); a
    // successful mapping is always a positive address. Testing a *void for
    // `== 0` treated every negative errno as success, so malloc wrote the
    // block header through a bad pointer and later faulted or corrupted the
    // heap. Any non-positive result is a failed mapping.
    var raw: i64 = 0;
    asm {
        "mov rax, 9"
        "xor rdi, rdi"
        "mov esi, {size}"
        "mov rdx, 3"
        "mov r10, 34"
        "mov r8, -1"
        "xor r9, r9"
        "syscall"
        "mov {raw}, rax"
    }
    // No fallback exists (this arena is the only remaining source for the
    // request), so report and stop through the allocator's fail-fast channel
    // (spec §9, exit codes 70-79) instead of handing back a bad pointer.
    if (raw <= 0) {
        fail_fast(75);
    }
    arena_count = arena_count + 1;
    // The cap check above bounds the sum, so this i64 addition cannot
    // wrap and total_bytes never goes negative.
    total_bytes = total_bytes + size as i64;
    return raw as *void;
}

export func malloc(size: int) -> *void {
    var s: int = size;
    if (s < 0) return nilPtr;
    if (s > 1073741824) return nilPtr;
    if (s % 8 != 0) {
        s = s + (8 - (s % 8));
    }

    var needed: int = HEADER_SIZE + s;
    if (needed < MIN_BLOCK_SIZE) {
        needed = MIN_BLOCK_SIZE;
    }
    var needed_u64: u64 = needed as u64;

    var prev: *void = nilPtr;
    var curr: *void = free_list;
    var walked: int = 0;

    while (curr != nilPtr) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }

        // Canary check: a freed block must still carry the canary. If a
        // write clobbered a freed block, the free list is corrupt — die
        // here instead of handing out a torn block.
        var canary_ptr: *u64 = (curr + 16) as *u64;
        var canary: u64 = *canary_ptr;
        if (canary != CANARY_VAL) {
            fail_fast(73);
        }

        var size_ptr: *u64 = curr as *u64;
        var block_size: u64 = *size_ptr;

        if (block_size >= needed_u64) {
            var remaining: u64 = block_size - needed_u64;

            if (remaining >= MIN_BLOCK_SIZE as u64) {
                *size_ptr = needed_u64;

                var new_free: *void = curr + needed;
                var new_size_ptr: *u64 = new_free as *u64;
                *new_size_ptr = remaining;
                var new_canary_ptr: *u64 = (new_free + 16) as *u64;
                *new_canary_ptr = CANARY_VAL;

                var curr_next_ptr: **void = (curr + 8) as **void;
                var new_next_ptr: **void = (new_free + 8) as **void;
                *new_next_ptr = *curr_next_ptr;

                if (prev != nilPtr) {
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = new_free;
                } else {
                    free_list = new_free;
                }
            } else {
                if (prev != nilPtr) {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = *curr_next_ptr;
                } else {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    free_list = *curr_next_ptr;
                }
            }

            var magic_ptr: *u64 = (curr + 8) as *u64;
            *magic_ptr = MAGIC_VAL;

            // CIDER-BUG-215: clear the canary the block is carrying as a free
            // block, so the allocator's own stamp is not served to the
            // program as data (see clear_canary).
            clear_canary(curr + HEADER_SIZE);

            return curr + HEADER_SIZE;
        }

        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    // No free block found — if the request is bigger than one arena,
    // mmap a dedicated arena of exactly this size (no split).
    var needed_u64b: u64 = needed as u64;
    if (needed_u64b > ARENA_SIZE as u64) {
        var big_arena: *void = mmap_arena(needed);
        if (big_arena == 0 as *void) return nilPtr;
        var big_size_ptr: *u64 = big_arena as *u64;
        *big_size_ptr = needed_u64b;
        var big_magic_ptr: *u64 = (big_arena + 8) as *u64;
        *big_magic_ptr = MAGIC_VAL;
        // CIDER-BUG-215: a dedicated arena is bootstrapped without a canary
        // stamp (free() has not run on it), and its mmap is zeroed on every
        // backend, so there is nothing to clear here -- the first word of the
        // payload is already 0.
        return big_arena + HEADER_SIZE;
    }

    // No free block found — mmap arena and add to free list
    var arena: *void = mmap_arena(ARENA_SIZE);
    if (arena == 0 as *void) return nilPtr;

    var arena_size_ptr: *u64 = arena as *u64;
    *arena_size_ptr = ARENA_SIZE as u64;
    var arena_canary_ptr: *u64 = (arena + 16) as *u64;
    *arena_canary_ptr = CANARY_VAL;
    var arena_next_ptr: **void = (arena + 8) as **void;
    *arena_next_ptr = free_list;
    free_list = arena;

    // Retry once (arena is at head of free list)
    prev = nilPtr;
    curr = free_list;
    walked = 0;

    while (curr != nilPtr) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }

        var canary_ptr: *u64 = (curr + 16) as *u64;
        var canary: u64 = *canary_ptr;
        if (canary != CANARY_VAL) {
            fail_fast(73);
        }

        var size_ptr: *u64 = curr as *u64;
        var block_size: u64 = *size_ptr;

        if (block_size >= needed_u64) {
            var remaining: u64 = block_size - needed_u64;

            if (remaining >= MIN_BLOCK_SIZE as u64) {
                *size_ptr = needed_u64;

                var new_free: *void = curr + needed;
                var new_size_ptr: *u64 = new_free as *u64;
                *new_size_ptr = remaining;
                var new_canary_ptr: *u64 = (new_free + 16) as *u64;
                *new_canary_ptr = CANARY_VAL;

                var curr_next_ptr: **void = (curr + 8) as **void;
                var new_next_ptr: **void = (new_free + 8) as **void;
                *new_next_ptr = *curr_next_ptr;

                if (prev != nilPtr) {
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = new_free;
                } else {
                    free_list = new_free;
                }
            } else {
                if (prev != nilPtr) {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = *curr_next_ptr;
                } else {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    free_list = *curr_next_ptr;
                }
            }

            var magic_ptr: *u64 = (curr + 8) as *u64;
            *magic_ptr = MAGIC_VAL;

            // CIDER-BUG-215: the block served here is the head of the list,
            // i.e. the arena just mapped, whose payload still holds
            // mmap_arena's bootstrap canary. Clear it (see clear_canary).
            clear_canary(curr + HEADER_SIZE);

            return curr + HEADER_SIZE;
        }

        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    return nilPtr;
}

export func free(ptr: *void) -> void {
    if (ptr == nilPtr) return;

    var block: *void = ptr - HEADER_SIZE;
    var magic_ptr: *u64 = (block + 8) as *u64;
    var magic: u64 = *magic_ptr;

    if (magic != MAGIC_VAL) {
        fail_fast(74);
    }

    var size_ptr: *u64 = block as *u64;
    var block_size: u64 = *size_ptr;

    *magic_ptr = 0 as u64;

    // Find insertion point in free list (sorted by address)
    var prev: *void = nilPtr;
    var curr: *void = free_list;
    var walked: int = 0;

    while (curr != nilPtr && curr < block) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }
        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    // Set block's next pointer
    var block_next_ptr: **void = (block + 8) as **void;
    *block_next_ptr = curr;

    // Coalesce with next
    var block_end: *void = block + block_size;
    if (curr != nilPtr && block_end == curr) {
        var curr_size_ptr: *u64 = curr as *u64;
        var curr_size: u64 = *curr_size_ptr;
        var curr_next_ptr: **void = (curr + 8) as **void;
        var curr_next: *void = *curr_next_ptr;

        block_size = block_size + curr_size;
        *size_ptr = block_size;
        *block_next_ptr = curr_next;
    }

    // Link block into free list
    if (prev != nilPtr) {
        var prev_next_ptr: **void = (prev + 8) as **void;
        *prev_next_ptr = block;
    } else {
        free_list = block;
    }

    // Coalesce with previous
    if (prev != nilPtr) {
        var prev_size_ptr: *u64 = prev as *u64;
        var prev_size: u64 = *prev_size_ptr;
        var prev_end: *void = prev + prev_size;

        if (prev_end == block) {
            var new_block_next: *void = *block_next_ptr;
            var new_size: u64 = prev_size + block_size;
            *prev_size_ptr = new_size;
            var prev_next_ptr: **void = (prev + 8) as **void;
            *prev_next_ptr = new_block_next;
        }
    }

    // Stamp the canary on the freed block.
    var canary_ptr: *u64 = (block + 16) as *u64;
    *canary_ptr = CANARY_VAL;
}
