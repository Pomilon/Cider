// Heap allocation: thin names over the prelude.
//
// The prelude owns the allocator (`alloc`/`realloc`/`free`, FEATURES §10.2);
// this module exists so programs written against `std.alloc` keep their
// imports. `free` is an explicit re-export of the prelude (`from prelude
// import ...` names the implicit import): a wrapper defined here could not
// call the prelude's `free` without calling itself.

from prelude import alloc, free;

// The v3 prelude allocator starts empty and maps its first arena on demand.
// This entry point exists for v2-shaped programs; there is no separate heap
// to initialize. The same allocator already enforces 1 MiB arenas, the 1 GiB
// heap cap, block canaries and a free-list cycle guard, so those protections
// are shared by `new`, vectors, maps and this module.
export func init_heap() {
}

// `free` is re-exported through the prelude import above: a wrapper defined
// here would resolve its own name and recurse instead of reaching the
// prelude binding. It remains part of the std.alloc surface.

export func malloc(size: i64) -> *void {
    return alloc(size, 8);
}

// Out-of-memory policy: `vm error: out of memory` on stderr, exit 2 —
// the same line and code the VM reports for host-side OOM, so all three
// backends agree byte-for-byte. Self-contained asm (no std.io import):
// the allocator sits below I/O in the layering.
export func oom() {
    var msg: string = "vm error: out of memory\n";
    var ptr: *u8 = &msg[0] as *u8;
    var count: int = msg.len as int;
    var fd: int = 2;
    asm {
        "mov rax, 1"
        "mov rdi, {fd:q}"
        "mov rsi, {ptr}"
        "mov rdx, {count:q}"
        "syscall"
    }
    var code: int = 2;
    asm {
        "mov rax, 60"
        "mov rdi, {code:q}"
        "syscall"
    }
}
