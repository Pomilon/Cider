// Cider Free-List Allocator — hardened (v2)
// Block layout:
//   offset 0: size (u64) - total block size inc 16-byte header
//   offset 8: next (free) / magic (allocated)
//   offset 16: user data
//
// Hardening (design spec §9):
//   - hard arena caps: MAX_ARENAS, MAX_TOTAL_BYTES (fail fast, never grow unbounded)
//   - corruption canaries on every freed block; malloc verifies before reuse
//   - fail-fast diagnostics: one line on stderr + a distinct exit code (70-79)
//   - free-list walk cycle guard: a walk that visits too many blocks dies
//     instead of looping (the 98GB incident's root cause)

var free_list: *void = nilPtr;
var ARENA_SIZE: int = 1048576;
var HEADER_SIZE: int = 16;
var MIN_BLOCK_SIZE: int = 24;
var MAGIC_VAL: u64 = 3254775790;
var CANARY_VAL: u64 = 18446744073709551606 as u64;  // 0xFFFFFFFFFFFFFFF6
var MAX_ARENAS: int = 1024;
var MAX_TOTAL_BYTES: int = 1073741824;  // 1 GiB (fits int32; 2 GiB overflows the 32-bit int type)
var MAX_WALK_BLOCKS: int = 1000000;
var arena_count: int = 0;
var total_bytes: int = 0;

var fail_msg: string = "allocator: fatal error\n";

func fail_fast(code: int) -> void {
    var s: char* = fail_msg as char*;
    asm {
        "mov rax, 1"
        "mov rdi, 2"
        "mov rsi, {s}"
        // 23 = strlen("allocator: fatal error\n"); the old count 24 also
        // wrote the string's NUL terminator (CIDER-BUG-109 regression test
        // compares stderr byte-for-byte).
        "mov rdx, 23"
        "syscall"
    }
    asm {
        "mov rax, 60"
        "mov edi, {code}"
        "syscall"
    }
}

export func init_heap() -> void {
}

func mmap_arena(size: int) -> *void {
    if (arena_count >= MAX_ARENAS) {
        fail_fast(70);
    }
    if (total_bytes + size > MAX_TOTAL_BYTES) {
        fail_fast(71);
    }
    // CIDER-BUG-109: keep the syscall result as a signed 64-bit value.
    // Native mmap reports failure as a NEGATIVE errno in rax (-ENOMEM for an
    // impossible mapping) and the VM mirrors that (-EINVAL for a
    // non-positive length, -ENOMEM when the request cannot be satisfied); a
    // successful mapping is always a positive address. Testing a *void for
    // `== 0` treated every negative errno as success, so malloc wrote the
    // block header through a bad pointer and later faulted or corrupted the
    // heap. Any non-positive result is a failed mapping.
    var raw: i64 = 0;
    asm {
        "mov rax, 9"
        "xor rdi, rdi"
        "mov esi, {size}"
        "mov rdx, 3"
        "mov r10, 34"
        "mov r8, -1"
        "xor r9, r9"
        "syscall"
        "mov {raw}, rax"
    }
    // No fallback exists (this arena is the only remaining source for the
    // request), so report and stop through the allocator's fail-fast channel
    // (spec §9, exit codes 70-79) instead of handing back a bad pointer.
    if (raw <= 0) {
        fail_fast(75);
    }
    arena_count = arena_count + 1;
    total_bytes = total_bytes + size;
    return raw as *void;
}

export func malloc(size: int) -> *void {
    var s: int = size;
    if (s < 0) return nilPtr;
    if (s > 1073741824) return nilPtr;
    if (s % 8 != 0) {
        s = s + (8 - (s % 8));
    }

    var needed: int = HEADER_SIZE + s;
    if (needed < MIN_BLOCK_SIZE) {
        needed = MIN_BLOCK_SIZE;
    }
    var needed_u64: u64 = needed as u64;

    var prev: *void = nilPtr;
    var curr: *void = free_list;
    var walked: int = 0;

    while (curr != nilPtr) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }

        // Canary check: a freed block must still carry the canary. If a
        // write clobbered a freed block, the free list is corrupt — die
        // here instead of handing out a torn block.
        var canary_ptr: *u64 = (curr + 16) as *u64;
        var canary: u64 = *canary_ptr;
        if (canary != CANARY_VAL) {
            fail_fast(73);
        }

        var size_ptr: *u64 = curr as *u64;
        var block_size: u64 = *size_ptr;

        if (block_size >= needed_u64) {
            var remaining: u64 = block_size - needed_u64;

            if (remaining >= MIN_BLOCK_SIZE as u64) {
                *size_ptr = needed_u64;

                var new_free: *void = curr + needed;
                var new_size_ptr: *u64 = new_free as *u64;
                *new_size_ptr = remaining;
                var new_canary_ptr: *u64 = (new_free + 16) as *u64;
                *new_canary_ptr = CANARY_VAL;

                var curr_next_ptr: **void = (curr + 8) as **void;
                var new_next_ptr: **void = (new_free + 8) as **void;
                *new_next_ptr = *curr_next_ptr;

                if (prev != nilPtr) {
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = new_free;
                } else {
                    free_list = new_free;
                }
            } else {
                if (prev != nilPtr) {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = *curr_next_ptr;
                } else {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    free_list = *curr_next_ptr;
                }
            }

            var magic_ptr: *u64 = (curr + 8) as *u64;
            *magic_ptr = MAGIC_VAL;

            return curr + HEADER_SIZE;
        }

        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    // No free block found — if the request is bigger than one arena,
    // mmap a dedicated arena of exactly this size (no split).
    var needed_u64b: u64 = needed as u64;
    if (needed_u64b > ARENA_SIZE as u64) {
        var big_arena: *void = mmap_arena(needed);
        if (big_arena == 0 as *void) return nilPtr;
        var big_size_ptr: *u64 = big_arena as *u64;
        *big_size_ptr = needed_u64b;
        var big_magic_ptr: *u64 = (big_arena + 8) as *u64;
        *big_magic_ptr = MAGIC_VAL;
        return big_arena + HEADER_SIZE;
    }

    // No free block found — mmap arena and add to free list
    var arena: *void = mmap_arena(ARENA_SIZE);
    if (arena == 0 as *void) return nilPtr;

    var arena_size_ptr: *u64 = arena as *u64;
    *arena_size_ptr = ARENA_SIZE as u64;
    var arena_canary_ptr: *u64 = (arena + 16) as *u64;
    *arena_canary_ptr = CANARY_VAL;
    var arena_next_ptr: **void = (arena + 8) as **void;
    *arena_next_ptr = free_list;
    free_list = arena;

    // Retry once (arena is at head of free list)
    prev = nilPtr;
    curr = free_list;
    walked = 0;

    while (curr != nilPtr) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }

        var canary_ptr: *u64 = (curr + 16) as *u64;
        var canary: u64 = *canary_ptr;
        if (canary != CANARY_VAL) {
            fail_fast(73);
        }

        var size_ptr: *u64 = curr as *u64;
        var block_size: u64 = *size_ptr;

        if (block_size >= needed_u64) {
            var remaining: u64 = block_size - needed_u64;

            if (remaining >= MIN_BLOCK_SIZE as u64) {
                *size_ptr = needed_u64;

                var new_free: *void = curr + needed;
                var new_size_ptr: *u64 = new_free as *u64;
                *new_size_ptr = remaining;
                var new_canary_ptr: *u64 = (new_free + 16) as *u64;
                *new_canary_ptr = CANARY_VAL;

                var curr_next_ptr: **void = (curr + 8) as **void;
                var new_next_ptr: **void = (new_free + 8) as **void;
                *new_next_ptr = *curr_next_ptr;

                if (prev != nilPtr) {
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = new_free;
                } else {
                    free_list = new_free;
                }
            } else {
                if (prev != nilPtr) {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    var prev_next_ptr: **void = (prev + 8) as **void;
                    *prev_next_ptr = *curr_next_ptr;
                } else {
                    var curr_next_ptr: **void = (curr + 8) as **void;
                    free_list = *curr_next_ptr;
                }
            }

            var magic_ptr: *u64 = (curr + 8) as *u64;
            *magic_ptr = MAGIC_VAL;

            return curr + HEADER_SIZE;
        }

        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    return nilPtr;
}

export func free(ptr: *void) -> void {
    if (ptr == nilPtr) return;

    var block: *void = ptr - HEADER_SIZE;
    var magic_ptr: *u64 = (block + 8) as *u64;
    var magic: u64 = *magic_ptr;

    if (magic != MAGIC_VAL) {
        fail_fast(74);
    }

    var size_ptr: *u64 = block as *u64;
    var block_size: u64 = *size_ptr;

    *magic_ptr = 0 as u64;

    // Find insertion point in free list (sorted by address)
    var prev: *void = nilPtr;
    var curr: *void = free_list;
    var walked: int = 0;

    while (curr != nilPtr && curr < block) {
        walked = walked + 1;
        if (walked > MAX_WALK_BLOCKS) {
            fail_fast(72);
        }
        prev = curr;
        var next_ptr: **void = (curr + 8) as **void;
        curr = *next_ptr;
    }

    // Set block's next pointer
    var block_next_ptr: **void = (block + 8) as **void;
    *block_next_ptr = curr;

    // Coalesce with next
    var block_end: *void = block + block_size;
    if (curr != nilPtr && block_end == curr) {
        var curr_size_ptr: *u64 = curr as *u64;
        var curr_size: u64 = *curr_size_ptr;
        var curr_next_ptr: **void = (curr + 8) as **void;
        var curr_next: *void = *curr_next_ptr;

        block_size = block_size + curr_size;
        *size_ptr = block_size;
        *block_next_ptr = curr_next;
    }

    // Link block into free list
    if (prev != nilPtr) {
        var prev_next_ptr: **void = (prev + 8) as **void;
        *prev_next_ptr = block;
    } else {
        free_list = block;
    }

    // Coalesce with previous
    if (prev != nilPtr) {
        var prev_size_ptr: *u64 = prev as *u64;
        var prev_size: u64 = *prev_size_ptr;
        var prev_end: *void = prev + prev_size;

        if (prev_end == block) {
            var new_block_next: *void = *block_next_ptr;
            var new_size: u64 = prev_size + block_size;
            *prev_size_ptr = new_size;
            var prev_next_ptr: **void = (prev + 8) as **void;
            *prev_next_ptr = new_block_next;
        }
    }

    // Stamp the canary on the freed block.
    var canary_ptr: *u64 = (block + 16) as *u64;
    *canary_ptr = CANARY_VAL;
}
