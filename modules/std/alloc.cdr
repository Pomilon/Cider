// Sovereign Heap Allocator
var heap_start: *void = nilPtr;
var heap_top: *void = nilPtr;
var heap_limit: *void = nilPtr;

export func init_heap() -> void {
    if (heap_start != 0 as *void) return;

    var size: int = 1048576; 
    var addr: *void = 0 as *void;
    
    asm {
        "mov rax, 9"
        "xor rdi, rdi"
        "mov rsi, {size}"
        "mov rdx, 3"
        "mov r10, 34"
        "mov r8, -1"
        "xor r9, r9"
        "syscall"
        "mov {addr}, rax"
    }
    
    heap_start = addr;
    heap_top = addr;
    heap_limit = addr + size;
}

export func malloc(size: int) -> *void {
    if (heap_start == nilPtr) {
        init_heap();
    }
    
    var s: int = size;
    if (s % 8 != 0) {
        s = s + (8 - (s % 8));
    }
    
    var next_top: *void = heap_top + s;
    if (next_top > heap_limit) {
        return nilPtr;
    }
    
    var ptr: *void = heap_top;
    heap_top = next_top;
    return ptr;
}

export func free(ptr: *void) -> void {
    // Simple bump allocator doesn't support free
}
