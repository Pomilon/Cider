// Hash map (open addressing, linear probing, tombstones).
//
// v3 port of the v2-final module for integer and pointer keys. The v2
// string hash (`as char*` iteration) has no v3 counterpart — strings
// never convert to pointers — so only int/pointer hashing ports; the
// probe, tombstone, growth and OOM logic ports verbatim otherwise.
from std.alloc import malloc, free, oom;
from std.string import memcpy;

export struct Entry<K, V> {
    var occupied: bool;
    // A removed entry leaves a tombstone: lookups must probe past it,
    // while inserts may reuse it. CIDER-BUG-062.
    var tombstone: bool;
    var key: K;
    var value: V;
}

export struct HashMap<K, V> {
    var entries: *Entry<K, V>;
    var cap: int;
    var len: int;
    // Number of tombstoned slots; counts toward the load factor so that
    // tombstone churn triggers a grow, which drops them. CIDER-BUG-062.
    var tombstones: int;
}

const MAP_INITIAL_CAP: int = 16;
const MAP_LOAD_FACTOR: int = 75;

func hash_key_int(key: int) -> u64 {
    var k: u64 = key as u64;
    k = k * 1099511628211;
    return k;
}

func hash_key_ptr(key: *void) -> u64 {
    var addr: u64 = key as u64;
    addr = addr * 1099511628211;
    return addr;
}

func hash_index(h: u64, cap: int) -> int {
    return (h % (cap as u64)) as int;
}

export func new_map<K, V>() -> HashMap<K, V> {
    var entry_size: int = sizeof(Entry<K, V>) as int;
    var fresh: *Entry<K, V> = malloc((MAP_INITIAL_CAP * entry_size) as i64) as *Entry<K, V>;
    if (fresh == nilPtr) {
        oom();
    }
    var m: HashMap<K, V> = new HashMap<K, V> { entries: fresh, cap: MAP_INITIAL_CAP, len: 0, tombstones: 0 };
    var i: int = 0;
    while (i < MAP_INITIAL_CAP) {
        fresh[i].occupied = false;
        fresh[i].tombstone = false;
        i = i + 1;
    }
    return m;
}

func grow_map<K, V>(m: *HashMap<K, V>) {
    var old_entries: *Entry<K, V> = (*m).entries;
    var old_cap: int = (*m).cap;
    var new_cap: int = old_cap * 2;
    if (new_cap < MAP_INITIAL_CAP) {
        new_cap = MAP_INITIAL_CAP;
    }
    var entry_size: int = sizeof(Entry<K, V>) as int;
    var fresh: *Entry<K, V> = malloc((new_cap * entry_size) as i64) as *Entry<K, V>;
    if (fresh == nilPtr) {
        oom();
    }
    (*m).entries = fresh;
    (*m).cap = new_cap;
    (*m).len = 0;
    (*m).tombstones = 0;
    var i: int = 0;
    while (i < new_cap) {
        fresh[i].occupied = false;
        fresh[i].tombstone = false;
        i = i + 1;
    }
    i = 0;
    while (i < old_cap) {
        if (old_entries[i].occupied) {
            var idx: int = hash_index(hash_key_int(old_entries[i].key as int), new_cap);
            while (fresh[idx].occupied) {
                idx = (idx + 1) % new_cap;
            }
            fresh[idx] = old_entries[i];
            fresh[idx].tombstone = false;
            (*m).len = (*m).len + 1;
        }
        i = i + 1;
    }
    free(old_entries as *void);
}

export func insert_map<K, V>(m: *HashMap<K, V>, key: K, val: V) {
    if ((*m).cap <= 0) {
        grow_map::<K, V>(m);
    }
    if (((*m).len + (*m).tombstones + 1) * 100 / (*m).cap > MAP_LOAD_FACTOR) {
        grow_map::<K, V>(m);
    }
    var idx: int = hash_index(hash_key_int(key as int), (*m).cap);
    var first_tomb: int = -1;
    var steps: int = 0;
    while (steps < (*m).cap) {
        if ((*m).entries[idx].occupied) {
            if ((*m).entries[idx].key == key) {
                (*m).entries[idx].value = val;
                return;
            }
        } else if ((*m).entries[idx].tombstone) {
            if (first_tomb < 0) {
                first_tomb = idx;
            }
        } else {
            break;
        }
        idx = (idx + 1) % (*m).cap;
        steps = steps + 1;
    }
    var target: int = idx;
    if (first_tomb >= 0) {
        target = first_tomb;
        (*m).tombstones = (*m).tombstones - 1;
    }
    (*m).entries[target].occupied = true;
    (*m).entries[target].tombstone = false;
    (*m).entries[target].key = key;
    (*m).entries[target].value = val;
    (*m).len = (*m).len + 1;
}

export func get_map<K, V>(m: *HashMap<K, V>, key: K) -> *V {
    if ((*m).len == 0) {
        return nilPtr;
    }
    var idx: int = hash_index(hash_key_int(key as int), (*m).cap);
    var steps: int = 0;
    while (steps < (*m).cap) {
        if (!(*m).entries[idx].occupied && !(*m).entries[idx].tombstone) {
            return nilPtr;
        }
        if ((*m).entries[idx].occupied && (*m).entries[idx].key == key) {
            return &((*m).entries[idx].value);
        }
        idx = (idx + 1) % (*m).cap;
        steps = steps + 1;
    }
    return nilPtr;
}

export func contains_map<K, V>(m: *HashMap<K, V>, key: K) -> bool {
    return get_map::<K, V>(m, key) != nilPtr;
}

export func remove_map<K, V>(m: *HashMap<K, V>, key: K) -> bool {
    if ((*m).len == 0) {
        return false;
    }
    var idx: int = hash_index(hash_key_int(key as int), (*m).cap);
    var steps: int = 0;
    while (steps < (*m).cap) {
        if (!(*m).entries[idx].occupied && !(*m).entries[idx].tombstone) {
            return false;
        }
        if ((*m).entries[idx].occupied && (*m).entries[idx].key == key) {
            (*m).entries[idx].occupied = false;
            (*m).entries[idx].tombstone = true;
            (*m).len = (*m).len - 1;
            (*m).tombstones = (*m).tombstones + 1;
            return true;
        }
        idx = (idx + 1) % (*m).cap;
        steps = steps + 1;
    }
    return false;
}

export func len_map<K, V>(m: *HashMap<K, V>) -> int {
    return (*m).len;
}

export func free_map<K, V>(m: *HashMap<K, V>) {
    if ((*m).entries != nilPtr) {
        free((*m).entries as *void);
        (*m).entries = nilPtr;
    }
    (*m).len = 0;
    (*m).tombstones = 0;
    (*m).cap = 0;
}
