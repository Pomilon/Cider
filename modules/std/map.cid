from std.alloc import malloc, free, oom;
from std.string import memcpy;

export struct Entry<K, V> {
    var occupied: bool;
    // A removed entry leaves a tombstone: lookups must probe past it,
    // while inserts may reuse it. CIDER-BUG-062.
    var tombstone: bool;
    var key: K;
    var value: V;
}

export struct HashMap<K, V> {
    var entries: *Entry<K, V>;
    var cap: int;
    var len: int;
    // Number of tombstoned slots; counts toward the load factor so that
    // tombstone churn triggers a grow, which drops them. CIDER-BUG-062.
    var tombstones: int;
}

const MAP_INITIAL_CAP: int = 16;
const MAP_LOAD_FACTOR: int = 75; // 75% load factor threshold

func hash_key_int(key: int) -> u64 {
    var k: u64 = key as u64;
    k = k * 1099511628211;
    return k;
}

func hash_key_ptr(key: *void) -> u64 {
    var addr: u64 = key as u64;
    addr = addr * 1099511628211;
    return addr;
}

func hash_key_str(key: string) -> u64 {
    var h: u64 = 14695981039346656037;
    var p: char* = key as char*;
    while (*p != 0 as char) {
        h = h ^ (*p as u64);
        h = h * 1099511628211;
        p = p + 1;
    }
    return h;
}

func hash_index(h: u64, cap: int) -> int {
    return (h as u64 % cap as u64) as int;
}

export func new_map<K, V>() -> HashMap<K, V> {
    var m: HashMap<K, V>;
    var entry_size: int = sizeof(Entry<K, V>);
    // CIDER-BUG-193: malloc refuses (nilPtr) sizes < 0 or > 1 GiB -- here
    // when Entry<K, V> is so large that one bucket array exceeds the guard.
    // Report through the stdlib OOM policy (std.alloc.oom) instead of
    // clearing through nil (a misattributed `null pointer dereference`).
    var fresh: *Entry<K, V> = malloc(MAP_INITIAL_CAP * entry_size) as *Entry<K, V>;
    if (fresh == nilPtr) {
        oom();
    }
    m.entries = fresh;
    m.cap = MAP_INITIAL_CAP;
    m.len = 0;
    m.tombstones = 0;
    // Clear entries
    var i: int = 0;
    while (i < MAP_INITIAL_CAP) {
        m.entries[i].occupied = false;
        m.entries[i].tombstone = false;
        i = i + 1;
    }
    return m;
}

func grow_map<K, V>(m: *HashMap<K, V>) -> void {
    var old_entries: *Entry<K, V> = m.entries;
    var old_cap: int = m.cap;
    var new_cap: int = old_cap * 2;
    // CIDER-ISS-015: free_map leaves cap == 0, and a double would keep it
    // there. Clamp to the initial capacity so a grow always hands back a
    // real bucket array and restores the invariant cap > 0. Same clamp as
    // std.vector's grow.
    if (new_cap < MAP_INITIAL_CAP) {
        new_cap = MAP_INITIAL_CAP;
    }
    var entry_size: int = sizeof(Entry<K, V>);
    // CIDER-BUG-193: same OOM policy as new_map (see above). The fresh
    // array must be checked BEFORE m.entries is overwritten: on refusal
    // the old array stays live and the program aborts, instead of
    // installing nil entries + nonzero cap and rehashing through nil.
    var fresh: *Entry<K, V> = malloc(new_cap * entry_size) as *Entry<K, V>;
    if (fresh == nilPtr) {
        oom();
    }
    m.entries = fresh;
    m.cap = new_cap;
    m.len = 0;
    m.tombstones = 0;
    var i: int = 0;
    while (i < new_cap) {
        m.entries[i].occupied = false;
        m.entries[i].tombstone = false;
        i = i + 1;
    }
    // Rehash old entries; tombstones are dropped (live entries only).
    i = 0;
    while (i < old_cap) {
        if (old_entries[i].occupied) {
            // Cannot call insert here due to template param issues, do inline
            var idx: int = hash_index(hash_key_int(old_entries[i].key as int), new_cap);
            while (m.entries[idx].occupied) {
                idx = (idx + 1) % new_cap;
            }
            m.entries[idx] = old_entries[i];
            m.entries[idx].tombstone = false;
            m.len = m.len + 1;
        }
        i = i + 1;
    }
    free(old_entries as *void);
}

export func insert_map<K, V>(m: *HashMap<K, V>, key: K, val: V) -> void {
    // CIDER-ISS-015: re-establish the capacity invariant before m.cap is
    // used as a divisor. free_map (and a map that was never new_map'd) leaves
    // cap == 0 with entries == nilPtr; the load-factor division below then
    // divided by zero, which both backends define as 0 (CIDER-BUG-058), so
    // the growth check silently passed and the insert stored through the null
    // bucket array. Grow first, exactly as std.vector's push re-grows a freed
    // Vec.
    if (m.cap <= 0) {
        grow_map<K, V>(m);
    }
    // Tombstones count toward the load factor: churn therefore triggers a
    // grow, and grow_map rehashes live entries without tombstones.
    if ((m.len + m.tombstones + 1) * 100 / m.cap > MAP_LOAD_FACTOR) {
        grow_map<K, V>(m);
    }
    var idx: int = hash_index(hash_key_int(key as int), m.cap);
    var first_tomb: int = -1;
    var steps: int = 0;
    while (steps < m.cap) {
        if (m.entries[idx].occupied) {
            // Replace if same key
            if (m.entries[idx].key == key) {
                m.entries[idx].value = val;
                return;
            }
        } else if (m.entries[idx].tombstone) {
            // Remember the first reusable slot, keep probing for the key.
            if (first_tomb < 0) {
                first_tomb = idx;
            }
        } else {
            // A truly empty slot ends the probe chain: key absent.
            break;
        }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
    var target: int = idx;
    if (first_tomb >= 0) {
        target = first_tomb;
        m.tombstones = m.tombstones - 1;
    }
    m.entries[target].occupied = true;
    m.entries[target].tombstone = false;
    m.entries[target].key = key;
    m.entries[target].value = val;
    m.len = m.len + 1;
}

export func get_map<K, V>(m: *HashMap<K, V>, key: K) -> *V {
    if (m.len == 0) return nilPtr;
    var idx: int = hash_index(hash_key_int(key as int), m.cap);
    var steps: int = 0;
    while (steps < m.cap) {
        if (!m.entries[idx].occupied && !m.entries[idx].tombstone) {
            // Empty slot: the probe chain cannot continue past it.
            return nilPtr;
        }
        if (m.entries[idx].occupied && m.entries[idx].key == key) {
            return &m.entries[idx].value;
        }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
    return nilPtr;
}

export func contains_map<K, V>(m: *HashMap<K, V>, key: K) -> bool {
    return get_map<K, V>(m, key) != nilPtr;
}

export func remove_map<K, V>(m: *HashMap<K, V>, key: K) -> bool {
    if (m.len == 0) return false;
    var idx: int = hash_index(hash_key_int(key as int), m.cap);
    var steps: int = 0;
    while (steps < m.cap) {
        if (!m.entries[idx].occupied && !m.entries[idx].tombstone) {
            return false;
        }
        if (m.entries[idx].occupied && m.entries[idx].key == key) {
            // Tombstone rather than clear: later lookups must probe past
            // this slot to reach colliding keys inserted after it.
            m.entries[idx].occupied = false;
            m.entries[idx].tombstone = true;
            m.len = m.len - 1;
            m.tombstones = m.tombstones + 1;
            return true;
        }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
    return false;
}

export func len_map<K, V>(m: *HashMap<K, V>) -> int {
    return m.len;
}

export func free_map<K, V>(m: *HashMap<K, V>) -> void {
    if (m.entries != nilPtr) {
        free(m.entries as *void);
        m.entries = nilPtr;
    }
    m.len = 0;
    m.tombstones = 0;
    m.cap = 0;
}
