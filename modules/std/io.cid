// Standard I/O: print, printInt, printChar, putchar, puts, printFloat,
// printF64, exit.
//
// Every write goes through the `write` syscall directly: this module owns
// its `print` implementation. A string's bytes are reached through `&s[0]`
// (an empty string has no byte zero, so it returns before touching it).
// Buffer stores go through a slice (`buf[0:N]`), because a computed store
// to an array is not lowered — only slice stores are (SEMANTICS §8).
from std.alloc import malloc;

func writeAll(ptr: *u8, count: int) {
    var fd: int = 1;
    asm {
        "mov rax, 1"
        "mov rdi, {fd:q}"
        "mov rsi, {ptr}"
        "mov rdx, {count:q}"
        "syscall"
    }
}

export func print(s: string) {
    if (s.len == 0) {
        return;
    }
    var ptr: *u8 = &s[0] as *u8;
    var count: int = s.len as int;
    writeAll(ptr, count);
}

// C-ABI byte-pointer output: writes the bytes up to the NUL terminator,
// then a newline. String slices use `print` instead.
export func puts(s: *char) {
    var n: int = 0;
    while (s[n] != 0 as char) {
        n = n + 1;
    }
    writeAll(s as *u8, n);
    print("\n");
}

// v2 spelling: a string, newline included.
export func puts_string(s: string) {
    print(s);
    print("\n");
}

export func printChar(c: char) {
    var b: u8 = c as u8;
    // A NUL builds an empty string: print returns without a syscall, so a
    // NUL char writes nothing at all.
    if (b == 0) {
        return;
    }
    var buf: [u8; 1] = [ b ];
    var ptr: *u8 = &buf[0];
    var one: int = 1;
    writeAll(ptr, one);
}

// C-ABI byte output. Unlike printChar, a zero byte is written: putchar
// promises the byte, not a text line. The answer is the unsigned byte, the
// way the C contract names the character echoed.
export func putchar(c: int) -> int {
    var b: u8 = c as u8;
    var buf: [u8; 1] = [ b ];
    var ptr: *u8 = &buf[0];
    var one: int = 1;
    writeAll(ptr, one);
    return b as int;
}

// Prints v with no INT_MIN trap: the digits are taken from the negative
// value itself (`-(n % 10)`), so `0 - v` — undefined on INT_MIN — never runs.
export func printInt(v: int) {
    var buf: [u8; 12] = [0, ...];
    var s: []u8 = buf[0:12];
    var n: int = v;
    var neg: int = 0;
    if (n < 0) {
        neg = 1;
    }
    var i: int = 11;
    if (n == 0) {
        s[11] = 48;
    } else {
        while (n != 0) {
            var d: int = n % 10;
            var digit: int = 48 + d;
            if (neg == 1) {
                digit = 48 - d;
            }
            s[i] = digit as u8;
            i = i - 1;
            n = n / 10;
        }
        i = i + 1;
    }
    if (neg == 1) {
        i = i - 1;
        s[i] = 45;
    }
    var start: *u8 = &s[i];
    var count: int = 12 - i;
    writeAll(start, count);
}

// Six digits after the point, truncated never rounded: the digits come off
// least-significant first, so they fill the buffer right to left and the
// buffer goes out in one write — a short fraction zero-pads on the left.
func printScaled(whole: int, frac: int) {
    printInt(whole);
    print(".");
    var tmp: [u8; 6] = [0, ...];
    var t: []u8 = tmp[0:6];
    var rest: int = frac;
    var k: int = 0;
    while (k < 6) {
        var digit: int = rest % 10;
        rest = rest / 10;
        t[5 - k] = (48 + digit) as u8;
        k = k + 1;
    }
    var p: *u8 = &t[0];
    var six: int = 6;
    writeAll(p, six);
}

export func printF64(f: f64) {
    var v: f64 = f;
    if (v < 0.0) {
        print("-");
        v = 0.0 - v;
    }
    var whole: int = v as int;
    var frac: int = ((v - whole as f64) * 1000000.0) as int;
    printScaled(whole, frac);
}

export func printFloat(f: float) {
    var v: float = f;
    if (v < 0.0) {
        print("-");
        v = 0.0 - v;
    }
    var whole: int = v as int;
    var frac: int = ((v - whole as float) * 1000000.0) as int;
    printScaled(whole, frac);
}

// Reads up to `count` bytes from stdin into `buf`; answers the byte count
// (0 at end of input). A thin read(0) syscall, spelled the same way the
// write calls are.
export func read_stdin(buf: *u8, count: int) -> int {
    var ret: int = 0;
    asm {
        "mov rax, 0\n"
        "mov rdi, 0\n"
        "mov rsi, {buf:q}\n"
        "mov edx, {count}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

// One line from stdin as a NUL-terminated HEAP buffer (the bytes leak like
// every string, MEMORY 3.4): the newline is stripped, and end of input
// answers an empty buffer. v2 returned a stack buffer whose pointer died
// on return; a heap buffer is the v3-correct shape.
export func read_line() -> *char {
    var buf: *char = malloc(4096) as *char;
    var n: int = read_stdin(buf as *u8, 4096);
    if (n <= 0) {
        buf[0] = 0 as char;
        return buf;
    }
    var i: int = 0;
    while (i < n) {
        if (buf[i] == 10 as char) {
            buf[i] = 0 as char;
            return buf;
        }
        i = i + 1;
    }
    if (n < 4096) {
        buf[n] = 0 as char;
    } else {
        buf[4095] = 0 as char;
    }
    return buf;
}

// Every byte until end of input as a NUL-terminated heap buffer.
export func read_all() -> *char {
    var buf: *char = malloc(4096) as *char;
    var total: int = 0;
    while (total < 4096) {
        var n: int = read_stdin((buf + total) as *u8, 4096 - total);
        if (n <= 0) {
            break;
        }
        total = total + n;
    }
    if (total < 4096) {
        buf[total] = 0 as char;
    } else {
        buf[4095] = 0 as char;
    }
    return buf;
}

export func exit(code: int) {
    asm {
        "mov rax, 60"
        "mov rdi, {code:q}"
        "syscall"
    }
}
