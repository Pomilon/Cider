// Sovereign Standard I/O
export func strlen(s: char*) -> int {
    var len: int = 0;
    var p: char* = s;
    while (*p != 0 as char) {
        len = len + 1;
        p = p + 1;
    }
    return len;
}

export func printChar(c: char) -> void {
    var buf: [char; 2];
    buf[0] = c;
    buf[1] = 0 as char;
    print(buf as string);
}

export func print(msg: string) -> void {
    var s: char* = msg as char*;
    var len: int = strlen(s);
    if (len == 0) return;

    asm {
        "mov rax, 1\n"
        "mov rdi, 1\n"
        "mov rsi, {s}\n"
        "movsxd rdx, {len}\n"
        "syscall\n"
    }
}

export func puts(msg: string) -> void {
    print(msg);
    print("\n");
}

export func printInt(n: int) -> void {
    if (n == 0) {
        print("0");
        return;
    }
    var val: int = n;
    if (val < 0) {
        print("-");
    }

    var buf: [char; 32];
    var i: int = 0;

    // Extract digits from the (possibly still negative) value: negating
    // INT_MIN overflows back to itself, so only the single digit (which
    // is in -9..9 and always safe to negate) is ever flipped. Division
    // truncates toward zero, so the loop terminates for both signs.
    while (val != 0) {
        var digit: int = val % 10;
        if (digit < 0) {
            digit = -digit;
        }
        buf[i] = (digit + 48) as char;
        val = val / 10;
        i = i + 1;
    }
    
    // Reverse and print
    while (i > 0) {
        i = i - 1;
        printChar(buf[i]);
    }
}

// Fixed-point float printing (CID-003): 6 decimal places, truncating the
// 7th, pure integer math (no libc printf).
//
// Behavior: negatives print a single leading '-' and are then split by
// magnitude; zero and negative zero print "0.000000"; the integer part is
// the truncating `x as int` cast; the fraction is emitted one digit at a
// time (multiply by 10, truncating cast), never rounded. Values whose
// integer part does not fit in an int (|x| >= 2^31) are out of scope:
// there the truncating cast is implementation-defined and VM and native
// can disagree, so callers must stay in int range. This is not a full
// printf. `printFloat` widens to f64 and shares the formatter.
export func printF64(x: f64) -> void {
    if (x < 0.0) {
        print("-");
        x = -x;
    }
    var whole: int = x as int;
    printInt(whole);
    print(".");
    var frac: f64 = x - (whole as f64);
    var i: int = 0;
    while (i < 6) {
        frac = frac * 10.0;
        var digit: int = frac as int;
        printChar((digit + 48) as char);
        frac = frac - (digit as f64);
        i = i + 1;
    }
}

export func printFloat(x: float) -> void {
    printF64(x);
}

export func read_stdin(buf: *void, count: int) -> int {
    var result: int = 0;
    asm {
        "mov rax, 0\n"
        "mov rdi, 0\n"
        "mov rsi, {buf}\n"
        "movsxd rdx, {count}\n"
        "syscall\n"
        "mov {result}, eax\n"
    }
    return result;
}

export func read_line() -> string {
    var buf: [char; 4096];
    var n: int = read_stdin(buf as *void, 4096);
    if (n <= 0) { return ""; }
    var i: int = 0;
    while (i < n) {
        if (buf[i] == 10 as char) {
            buf[i] = 0 as char;
            return buf as string;
        }
        i = i + 1;
    }
    if (n < 4096) {
        buf[n] = 0 as char;
    }
    return buf as string;
}

export func read_all() -> string {
    var buf: [char; 4096];
    var total: int = 0;
    while (total < 4096) {
        var ptr: *void = (buf as *void) + total;
        var n: int = read_stdin(ptr, 4096 - total);
        if (n <= 0) break;
        total = total + n;
    }
    if (total < 4096) {
        buf[total] = 0 as char;
    } else {
        buf[4095] = 0 as char;
    }
    return buf as string;
}

export func exit(code: int) -> void {
    asm {
        "mov rax, 60\n"
        "mov edi, {code}\n"
        "syscall\n"
    }
    // Fallback if syscall fails (should not happen for exit)
    while (true) {}
}
