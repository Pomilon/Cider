// File I/O via Linux syscalls, ported from v2 std.fs.
//
// Every function is a thin syscall wrapper: registers carry the
// arguments, `eax` carries the 32-bit answer (negative for -errno),
// and no libc stands between the program and the kernel. An empty
// path answers ENOENT rather than addressing byte zero of nothing.

export const O_RDONLY: int = 0;
export const O_WRONLY: int = 1;
export const O_RDWR: int = 2;
export const O_CREAT: int = 64;
export const O_TRUNC: int = 512;
export const O_APPEND: int = 1024;

export func open(filename: string, flags: int, mode: int) -> int {
    if (filename.len == 0) {
        return 0 - 2;
    }
    var path: *u8 = &filename[0];
    var fl: int = flags;
    var md: int = mode;
    var ret: int = 0;
    asm {
        "mov rax, 2\n"
        "mov rdi, {path:q}\n"
        "mov esi, {fl}\n"
        "mov edx, {md}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

export func read(fd: int, buf: *void, count: int) -> int {
    var f: int = fd;
    var b: *void = buf;
    var cnt: int = count;
    var ret: int = 0;
    asm {
        "mov rax, 0\n"
        "mov rdi, {f:q}\n"
        "mov rsi, {b:q}\n"
        "mov edx, {cnt}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

export func write(fd: int, buf: *void, count: int) -> int {
    var f: int = fd;
    var b: *void = buf;
    var cnt: int = count;
    var ret: int = 0;
    asm {
        "mov rax, 1\n"
        "mov rdi, {f:q}\n"
        "mov rsi, {b:q}\n"
        "mov edx, {cnt}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

export func close(fd: int) -> int {
    var f: int = fd;
    var ret: int = 0;
    asm {
        "mov rax, 3\n"
        "mov rdi, {f:q}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

export func lseek(fd: int, offset: int, whence: int) -> int {
    var f: int = fd;
    var off: int = offset;
    var wh: int = whence;
    var ret: int = 0;
    asm {
        "mov rax, 8\n"
        "mov rdi, {f:q}\n"
        "mov rsi, {off:q}\n"
        "mov edx, {wh}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}

export func unlink(pathname: string) -> int {
    if (pathname.len == 0) {
        return 0 - 2;
    }
    var path: *u8 = &pathname[0];
    var ret: int = 0;
    asm {
        "mov rax, 87\n"
        "mov rdi, {path:q}\n"
        "syscall\n"
        "mov {ret}, eax\n"
    }
    return ret;
}
