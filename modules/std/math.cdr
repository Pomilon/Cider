// Math functions

export func abs(x: int) -> int {
    if (x < 0) return -x;
    return x;
}

export func fabs(x: float) -> float {
    if (x < 0.0) return -x;
    return x;
}

export func min<T>(a: T, b: T) -> T {
    if (a < b) return a;
    return b;
}

export func max<T>(a: T, b: T) -> T {
    if (a > b) return a;
    return b;
}

export func clamp<T>(val: T, lo: T, hi: T) -> T {
    if (val < lo) return lo;
    if (val > hi) return hi;
    return val;
}

extern func sqrt(x: float) -> float;
extern func sin(x: float) -> float;
extern func cos(x: float) -> float;

export func sqrt_f(x: float) -> float {
    return sqrt(x);
}

export func sin_f(x: float) -> float {
    return sin(x);
}

export func cos_f(x: float) -> float {
    return cos(x);
}
