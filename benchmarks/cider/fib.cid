// Benchmark: recursive Fibonacci — compute/recursion stress
from std.io import printInt;

func fib(n: int) -> int {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}

func _start() {
    var r: int = fib(30);
    printInt(r);
    asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
