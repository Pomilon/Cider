// Benchmark: Sieve of Eratosthenes — array loops + integer math
from std.io import printInt;
from std.alloc import malloc, free;

func _start() {
    var N: int = 2000000;
    // Cider's bool is 4 bytes (unlike C's 1): N bools need N*4 bytes.
    var sieve: *bool = malloc(N * 4) as *bool;
    var i: int = 0;
    while (i < N) {
        sieve[i] = true;
        i = i + 1;
    }
    sieve[0] = false;
    sieve[1] = false;
    var p: int = 2;
    while (p * p < N) {
        if (sieve[p]) {
            var j: int = p * p;
            while (j < N) {
                sieve[j] = false;
                j = j + p;
            }
        }
        p = p + 1;
    }
    var count: int = 0;
    i = 0;
    while (i < N) {
        if (sieve[i]) { count = count + 1; }
        i = i + 1;
    }
    printInt(count);
    free(sieve);
    asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
