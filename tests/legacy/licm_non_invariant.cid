func _start() {
    var sum: u64 = 0;
    var i: u64 = 0;
    while (i < 10) {
        var squared: u64 = i * i;
        sum = sum + squared;
        i = i + 1;
    }
    if (sum == 285) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
