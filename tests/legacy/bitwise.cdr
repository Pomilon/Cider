from std.io import print, printInt, puts;

func _start() -> void {
    puts("Testing Bitwise Operators...");
    
    var a: int = 170; // 0xAA
    var b: int = 85;  // 0x55
    
    print("AND (Expected 0): "); printInt(a & b); print("\n");
    print("OR (Expected 255): "); printInt(a | b); print("\n");
    print("XOR (Expected 255): "); printInt(a ^ b); print("\n");
    
    var c: int = 1;
    print("LSHIFT 4 (Expected 16): "); printInt(c << 4); print("\n");
    
    var d: int = 16;
    print("RSHIFT 2 (Expected 4): "); printInt(d >> 2); print("\n");
    
    var e: int = 0;
    print("NOT 0 (Expected -1): "); printInt(~e); print("\n");
    
    asm {
        "mov rax, 60\n"
        "xor rdi, rdi\n"
        "syscall\n"
    }
}
