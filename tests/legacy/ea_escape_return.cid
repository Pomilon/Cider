from std.alloc import malloc, free;

class Point {
    var x: int;
}

func make() -> *Point {
    var p: *Point = new Point;
    p.x = 42;
    return p;   // escapes via return — must stay heap
}

func _start() {
    var q: *Point = make();
    var r: int = q.x;
    delete q;
    if (r == 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
