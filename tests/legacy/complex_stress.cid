from std.io import print, printInt;
from std.alloc import malloc, free;

class Calculator {
    var base: int;
    
    virtual func add(a: int, b: int) -> int {
        return this.base + a + b;
    }
}

class AdvancedCalculator extends Calculator {
    override func add(a: int, b: int) -> int {
        return this.base + (a * 2) + (b * 2);
    }
}

func fib(n: int) -> int {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

func _start() -> void {
    print("Integration Stress Test...\n");
    
    var calc: *Calculator = new AdvancedCalculator;
    calc->base = 10;
    var oop_res: int = calc->add(5, 5); 
    print("OOP Result (Expected 30): ");
    printInt(oop_res);
    print("\n");
    
    var fib_res: int = fib(10); 
    print("Fib(10) (Expected 55): ");
    printInt(fib_res);
    print("\n");
    
    var total: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) {
        var v1: int = i + 1;
        var v2: int = i + 2;
        var v3: int = i + 3;
        var v4: int = i + 4;
        var v5: int = i + 5;
        var v6: int = i + 6;
        var v7: int = i + 7;
        var v8: int = i + 8;
        var v9: int = i + 9;
        var v10: int = i + 10;
        var v11: int = i + 11;
        var v12: int = i + 12;
        total = total + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12;
    }
    
    print("Loop Stress Result (Expected 510): ");
    printInt(total);
    print("\n");
    
    if (oop_res == 30 && fib_res == 55 && total == 510) {
        print("Integration Stress Success!\n");
        exit(0);
    } else {
        print("Integration Stress Failure!\n");
        exit(1);
    }
}
