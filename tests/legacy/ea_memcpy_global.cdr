from std.alloc import malloc, free;

class Point {
    var x: int;
}

class Box {
    var p: *Point;
    var q: *Point;
}

var gbox: Box;

func _start() {
    var box1: Box;
    box1.p = new Point;    // taints box1's slot
    gbox = box1;           // MEMCPY into a GLOBAL — the pointer escapes
    box1.p.x = 42;
    var r: int = gbox.p.x;
    if (r == 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
