from std.alloc import malloc, free;

class Point {
    var x: int;
}

// destroy frees its param — the param summary MUST be escaping,
// so the caller's new stays on the heap.
func destroy(p: *Point) -> void {
    delete p;
}

func _start() {
    var q: *Point = new Point;
    q.x = 42;
    destroy(q);
    // The hardened allocator stamps a canary over the freed block's user
    // area, so the post-free read sees the canary, not 42. That presence is
    // the signature that the free ran on a heap object (a wrongly converted
    // stack object would fail the allocator's magic check with exit 74).
    if (q.x != 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
