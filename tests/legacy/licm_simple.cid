func _start() {
    var a: u64 = 5;
    var b: u64 = 10;
    var sum: u64 = 0;
    var i: u64 = 0;
    while (i < 100) {
        var c: u64 = a + b;
        sum = sum + c;
        i = i + 1;
    }
    if (sum == 1500) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
