from std.io import print, printInt, exit;
from std.alloc import malloc, free;

class Node {
    var val: int;
}

func _start() -> void {
    print("Testing heap stability (many small allocations)...\n");
    
    var total: int = 0;
    for (var i: int = 0; i < 100; i = i + 1) {
        var n: *Node = new Node;
        n->val = i;
        total = total + n->val;
    }
    
    print("Expected total: 4950\n");
    print("Actual total: ");
    printInt(total);
    print("\n");
    
    if (total == 4950) {
        print("Heap Stress Success!\n");
        exit(0);
    } else {
        print("Heap Stress Failure!\n");
        exit(1);
    }
}
