from std.io import puts, exit;

func _start() {
    var x: int = 42;
    var y: int = x > 10 ? 1 : 0;
    if (y != 1) { puts("FAIL: ternary true branch"); exit(1); }
    y = x < 10 ? 1 : 0;
    if (y != 0) { puts("FAIL: ternary false branch"); exit(1); }
    var s: int = x == 42 ? 99 : -1;
    if (s != 99) { puts("FAIL: ternary equality"); exit(1); }
    puts("PASS: ternary");
    exit(0);
}
