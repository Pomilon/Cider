from std.alloc import malloc, free;

class Shape {
    virtual func identify() -> int {
        return 1;
    }
}

class Circle extends Shape {
    override func identify() -> int {
        return 2;
    }
}

func _start() {
    var s: *Shape = new Circle;
    var r: int = s.identify();   // VIRTUAL_CALL — conservative escape
    delete s;
    if (r == 2) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
