from std.io import puts, exit;

interface Drawable {
    func draw() -> void;
}

class Circle {
    func draw() -> void {
        puts("Circle\n");
    }
}

class Square {
    func draw() -> void {
        puts("Square\n");
    }
}

func _start() {
    var c: Circle;
    var s: Square;
    var d1: Drawable = c;
    var d2: Drawable = s;
    d1.draw();
    d2.draw();
    puts("PASS: interface\n");
    asm { "mov rax, 60" "xor rdi, rdi" "syscall" }
}
