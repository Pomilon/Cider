from std.io import puts, exit;

struct Point3D {
    var x: int;
    var y: int;
    var z: int;
}

struct Line {
    var start: Point3D;
    var end: Point3D;
}

struct Polygon {
    var vertices: [Point3D; 6];
    var count: int;
}

func test_many_fields() -> int {
    var p: Point3D;
    p.x = 10;
    p.y = 20;
    p.z = 30;
    if (p.x + p.y + p.z != 60) { return 1; }
    return 0;
}

func test_nested_struct() -> int {
    var line: Line;
    line.start.x = 1;
    line.start.y = 2;
    line.start.z = 3;
    line.end.x = 4;
    line.end.y = 5;
    line.end.z = 6;

    if (line.start.x + line.end.z != 7) { return 1; }
    return 0;
}

func test_array_of_struct() -> int {
    var poly: Polygon;
    poly.count = 3;
    poly.vertices[0].x = 0;
    poly.vertices[0].y = 0;
    poly.vertices[0].z = 0;
    poly.vertices[1].x = 10;
    poly.vertices[1].y = 0;
    poly.vertices[1].z = 0;
    poly.vertices[2].x = 0;
    poly.vertices[2].y = 10;
    poly.vertices[2].z = 0;

    if (poly.count != 3) { return 1; }
    if (poly.vertices[1].x != 10) { return 2; }
    if (poly.vertices[2].y != 10) { return 3; }

    poly.vertices[0].x = 999;
    if (poly.vertices[0].x != 999) { return 4; }

    return 0;
}

func test_large_struct_array() -> int {
    var points: [Point3D; 20];
    var sum: int = 0;
    for (var i: int = 0; i < 20; i = i + 1) {
        points[i].x = i;
        points[i].y = i * 2;
        points[i].z = i * 3;
    }
    for (var i: int = 0; i < 20; i = i + 1) {
        sum = sum + points[i].x + points[i].y + points[i].z;
    }
    if (sum != 1140) { return 1; }
    return 0;
}

func test_struct_assignment() -> int {
    var a: Point3D;
    a.x = 111;
    a.y = 222;
    a.z = 333;

    var b: Point3D = a;
    if (b.x != 111) { return 1; }
    if (b.y != 222) { return 2; }
    if (b.z != 333) { return 3; }

    a.x = 0;
    if (b.x != 111) { return 4; }

    return 0;
}

func test_many_params(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int {
    return a + b + c + d + e + f + g + h;
}

func test_many_params_call() -> int {
    var r: int = test_many_params(1, 2, 3, 4, 5, 6, 7, 8);
    if (r != 36) { return 1; }
    return 0;
}

func _start() {
    var result: int = 0;

    result = test_many_fields();
    if (result != 0) { puts("FAIL: many fields\n"); exit(result); }

    result = test_nested_struct();
    if (result != 0) { puts("FAIL: nested struct\n"); exit(result); }

    result = test_array_of_struct();
    if (result != 0) { puts("FAIL: array of struct\n"); exit(result); }

    result = test_large_struct_array();
    if (result != 0) { puts("FAIL: large struct array\n"); exit(result); }

    result = test_struct_assignment();
    if (result != 0) { puts("FAIL: struct assignment\n"); exit(result); }

    result = test_many_params_call();
    if (result != 0) { puts("FAIL: many params\n"); exit(result); }

    puts("PASS: struct_ptr_stress\n");

    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
