from std.io import print, printInt, exit;
from std.alloc import malloc, free;

class Base {
    virtual func identify() -> void {
        print("Base\n");
    }
}

class Derived extends Base {
    override func identify() -> void {
        print("Derived\n");
    }
}

func _start() -> void {
    var b: *Base = new Base;
    var d: *Derived = new Derived;
    var poly: *Base = d;

    print("b->identify(): ");
    b->identify();

    print("d->identify(): ");
    d->identify();

    print("poly->identify(): ");
    poly->identify();

    // syscall: exit(0)
    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
