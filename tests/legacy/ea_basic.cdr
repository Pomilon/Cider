class Point {
    var x: int;
    var y: int;
}

func _start() {
    var p: *Point = new Point;
    p.x = 3;
    p.y = 4;
    var s: int = p.x + p.y;
    delete p;
    if (s == 7) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
