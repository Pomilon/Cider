func branchy(n: u64) -> u64 {
    if (n == 0) {
        return 42;
    }
    return n;
}

func _start() {
    var x: u64 = branchy(0);
    if (x == 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 0" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
