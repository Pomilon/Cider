from std.io import print, printInt, exit;
from std.alloc import malloc, free;

class Point {
    var x: int;
    var y: int;
}

func _start() -> void {
    print("Bootstrap: Testing Sovereign Heap Allocator...\n");
    
    var p: *Point = new Point;
    p->x = 42;
    p->y = 58;
    
    print("Point.x: ");
    printInt(p->x);
    print("\n");
    
    print("Point.y: ");
    printInt(p->y);
    print("\n");
    
    var sum: int = p->x + p->y;
    print("Sum: ");
    printInt(sum);
    print("\n");
    
    delete p;
    
    if (sum == 100) {
        print("SUCCESS: Sovereign Stdlib is operational!\n");
        exit(0);
    } else {
        print("FAILURE: Calculation mismatch.\n");
        exit(1);
    }
}
