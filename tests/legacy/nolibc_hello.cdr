func _start() -> void {
    // syscall: write(1, "Hello, Sovereign Cider!\n", 24)
    asm {
        "mov rax, 1"
        "mov rdi, 1"
        "lea rsi, [rel msg]"
        "mov rdx, 24"
        "syscall"
    }

    // syscall: exit(0)
    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}

// We need a way to define the data. 
// Since we don't have a good way to pass string addresses to asm yet,
// we can use a raw asm block to define the data section if the compiler allows.
// But wait, our ASM op only goes into .text.

asm {
    "section .data"
    "msg: db 'Hello, Sovereign Cider!', 10"
    "section .text"
}
