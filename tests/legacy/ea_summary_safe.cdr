class Point {
    var x: int;
}

// set_x only writes p's own field — its param summary must be non-escaping.
func set_x(p: *Point, v: int) -> void {
    p.x = v;
}

func _start() {
    var q: *Point = new Point;
    set_x(q, 9);    // q passed to a non-escaping param — still tracked
    var r: int = q.x;
    delete q;
    if (r == 9) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
