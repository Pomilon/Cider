from std.alloc import malloc, free;

class Point {
    var x: int;
}

// take returns an interior pointer — the allocation escapes.
func take(p: *Point) -> *Point {
    return p + 1;
}

func _start() {
    var q: *Point = new Point;
    q.x = 10;
    var r: *Point = take(q);
    delete q;
    if (q.x == 10) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
