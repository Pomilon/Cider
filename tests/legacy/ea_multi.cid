from std.alloc import malloc, free;

class Point {
    var x: int;
}

func make() -> *Point {
    var p: *Point = new Point;
    return p;    // escapes
}

func _start() {
    var a: *Point = new Point;   // non-escaping → stack
    var b: *Point = make();      // escaping → heap
    a.x = 1;
    b.x = 2;
    var r: int = a.x + b.x;
    delete a;
    delete b;
    if (r == 3) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
