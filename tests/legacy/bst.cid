from std.io import print, printInt, puts;
from std.alloc import malloc;

class BSTNode {
    var value: int;
    var left: *BSTNode;
    var right: *BSTNode;
}

func insert(root: *BSTNode, val: int) -> *BSTNode {
    if (root == nilPtr) {
        var newNode: *BSTNode = malloc(24) as *BSTNode;
        newNode->value = val;
        newNode->left = nilPtr;
        newNode->right = nilPtr;
        return newNode;
    }

    if (val < root->value) {
        root->left = insert(root->left, val);
    } else {
        root->right = insert(root->right, val);
    }
    return root;
}

func inorder(root: *BSTNode) -> void {
    if (root == nilPtr) return;
    inorder(root->left);
    printInt(root->value);
    print(" ");
    inorder(root->right);
}

func _start() -> void {
    puts("Testing BST...");
    var root: *BSTNode = nilPtr;
    root = insert(root, 50);
    root = insert(root, 30);
    root = insert(root, 20);
    root = insert(root, 40);
    root = insert(root, 70);
    root = insert(root, 60);
    root = insert(root, 80);

    print("Inorder: ");
    inorder(root);
    print("\n");
    
    asm {
        "mov rax, 60\n"
        "xor rdi, rdi\n"
        "syscall\n"
    }
}
