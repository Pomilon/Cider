func _start() -> void {
    var buffer: [int; 5];
    buffer[0] = 10;
    buffer[1] = 20;
    buffer[2] = 30;
    buffer[3] = 40;
    buffer[4] = 50;

    var sum: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) {
        sum = sum + buffer[i];
    }
    
    // syscall: exit(sum)
    asm {
        "mov rax, 60"
        "mov edi, {sum}"
        "syscall"
    }
}
