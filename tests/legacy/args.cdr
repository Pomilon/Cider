func _start(argc: int, argv: **char) {
    if (argc < 1) {
        asm {
            "mov rax, 60"
            "mov rdi, 1"
            "syscall"
        }
    }

    if (argv[0] == 0) {
        asm {
            "mov rax, 60"
            "mov rdi, 2"
            "syscall"
        }
    }

    if (argc >= 3) {
        if (argv[1] == 0) {
            asm {
                "mov rax, 60"
                "mov rdi, 3"
                "syscall"
            }
        }
        if (argv[2] == 0) {
            asm {
                "mov rax, 60"
                "mov rdi, 4"
                "syscall"
            }
        }
    }

    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
