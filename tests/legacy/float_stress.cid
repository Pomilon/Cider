from std.io import puts, exit, printInt;

func test_arith() -> int {
    var a: float = 3.5;
    var b: float = 2.0;
    var c: float = a + b;
    if (c != 5.5) { return 1; }
    c = a - b;
    if (c != 1.5) { return 2; }
    c = a * b;
    if (c != 7.0) { return 3; }
    c = a / b;
    if (c != 1.75) { return 4; }
    return 0;
}

func test_cmp() -> int {
    var a: float = 3.5;
    var b: float = 2.0;
    if (!(a > b))  { return 1; }
    if (!(a >= b)) { return 2; }
    if (a < b)     { return 3; }
    if (a <= b)    { return 4; }
    if (a == b)    { return 5; }
    if (!(a != b)) { return 6; }
    return 0;
}

func test_cast() -> int {
    var a: int = 42;
    var b: float = a as float;
    var c: int = b as int;
    if (c != 42) { return 1; }

    var d: float = 3.14;
    var e: int = d as int;
    if (e != 3) { return 2; }

    return 0;
}

func test_mixed() -> int {
    var i: int = 10;
    var f: float = 3.0;
    var result: float = (i as float) + f;
    if (result != 13.0) { return 1; }
    return 0;
}

func _start() {
    var r: int = 0;

    r = test_arith();
    if (r != 0) { puts("FAIL: arith "); printInt(r); puts("\n"); exit(r); }

    r = test_cmp();
    if (r != 0) { puts("FAIL: cmp "); printInt(r); puts("\n"); exit(r); }

    r = test_cast();
    if (r != 0) { puts("FAIL: cast "); printInt(r); puts("\n"); exit(r); }

    r = test_mixed();
    if (r != 0) { puts("FAIL: mixed "); printInt(r); puts("\n"); exit(r); }

    puts("PASS: float_stress\n");
    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
