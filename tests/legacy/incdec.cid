from std.io import puts, exit;

func _start() -> void {
    var x: int = 5;
    var y: int = ++x;
    if (x != 6) { puts("FAIL: ++x should increment x"); exit(1); }
    if (y != 6) { puts("FAIL: ++x should return new value"); exit(1); }
    
    x = 10;
    y = --x;
    if (x != 9) { puts("FAIL: --x should decrement x"); exit(1); }
    if (y != 9) { puts("FAIL: --x should return new value"); exit(1); }
    
    puts("PASS: incdec");
    exit(0);
}
