/// LICM + inlining stress test
/// Verifies that LICM hoists loop invariants and inlining eliminates calls.

func compute(base: u64, n: u64) -> u64 {
    var total: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        // base + 3 is loop-invariant — LICM should hoist to preheader
        var c: u64 = base + 3;
        total = total + c;
        i = i + 1;
    }
    return total;
}

func nested_loop(n: u64) -> u64 {
    var total: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        var j: u64 = 0;
        // inner_const is loop-invariant in the inner loop
        var inner_const: u64 = 7;
        while (j < n) {
            total = total + inner_const;
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

func heavy_loop(base: u64, n: u64) -> u64 {
    // heavy computation with multiple invariants
    var total: u64 = 0;
    var a: u64 = base;
    var b: u64 = 2;
    var i: u64 = 0;
    while (i < n) {
        // a * b is invariant, also a + b is invariant
        var mul: u64 = a * b;
        var add: u64 = a + b;
        total = total + mul + add;
        i = i + 1;
    }
    return total;
}

func small_helper(x: u64) -> u64 {
    return x + 1;
}

func _start() {
    // 1. Simple LICM: compute(5, 100) → 100 * (5+3) = 800
    var r1: u64 = compute(5, 100);
    if (r1 != 800) { asm { "mov rax, 60" } asm { "mov rdi, 1" } asm { "syscall" } }

    // 2. Nested LICM: nested_loop(10) → 10 * 10 * 7 = 700
    var r2: u64 = nested_loop(10);
    if (r2 != 700) { asm { "mov rax, 60" } asm { "mov rdi, 2" } asm { "syscall" } }

    // 3. heavy_loop(3, 50) → 50 * ((3*2) + (3+2)) = 50 * (6+5) = 550
    var r3: u64 = heavy_loop(3, 50);
    if (r3 != 550) { asm { "mov rax, 60" } asm { "mov rdi, 3" } asm { "syscall" } }

    // 4. Inlining + LICM combined: small_helper should inline,
    //    then add1 is invariant in loop
    var r4: u64 = 0;
    var i: u64 = 0;
    while (i < 50) {
        var inc: u64 = small_helper(1);  // 1+1=2, invariant
        r4 = r4 + inc;
        i = i + 1;
    }
    // 50 * 2 = 100
    if (r4 != 100) { asm { "mov rax, 60" } asm { "mov rdi, 4" } asm { "syscall" } }

    asm { "mov rax, 60" }
    asm { "mov rdi, 0" }
    asm { "syscall" }
}
