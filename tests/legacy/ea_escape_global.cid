from std.alloc import malloc, free;

class Point {
    var x: int;
}

var gp: *Point;

func _start() {
    var p: *Point = new Point;
    gp = p;        // escapes via global store
    p.x = 5;
    var r: int = gp.x;
    if (r == 5) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
