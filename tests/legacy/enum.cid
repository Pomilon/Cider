from std.io import puts, exit;

enum Color { RED, GREEN, BLUE }

func _start() {
    var c: int = RED;
    if (c != 0) { puts("FAIL: RED != 0"); exit(1); }
    c = GREEN;
    if (c != 1) { puts("FAIL: GREEN != 1"); exit(1); }
    c = BLUE;
    if (c != 2) { puts("FAIL: BLUE != 2"); exit(1); }
    puts("PASS: enum");
    exit(0);
}
