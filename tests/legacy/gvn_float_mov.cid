func _start() {
    var i: i64 = 5;
    var f1: float = i as float;
    var f2: float = i as float;  // redundant conversion → GVN emits MOV
    if (f1 == 5.0 && f2 == 5.0) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
