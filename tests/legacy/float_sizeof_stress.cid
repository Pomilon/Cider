from std.io import puts, exit;

func test_char_string() -> int {
    var c: char = 'A';
    if (c != 65) { return 1; }
    if (c != 'A') { return 2; }

    c = 'Z';
    if (c != 90) { return 3; }

    var lower: char = 'a';
    var upper: char = lower - 32;
    if (upper != 'A') { return 4; }

    return 0;
}

func test_sizeof() -> int {
    var si32: int = sizeof(int);
    if (si32 != 4) { return 1; }

    var si64: int = sizeof(i64);
    if (si64 != 8) { return 2; }

    var schar: int = sizeof(char);
    if (schar != 1) { return 3; }

    // bool is 4 bytes per runtime
    var sbool: int = sizeof(bool);
    if (sbool != 4) { return 4; }

    var sfloat: int = sizeof(float);
    if (sfloat != 4) { return 5; }

    return 0;
}

func test_string_exists() -> int {
    var s: string = "hello";
    return 0;
}

func _start() {
    var result: int = 0;

    result = test_char_string();
    if (result != 0) { puts("FAIL: char string\n"); exit(result); }

    result = test_sizeof();
    if (result != 0) { puts("FAIL: sizeof\n"); exit(result); }

    result = test_string_exists();
    if (result != 0) { puts("FAIL: string exists\n"); exit(result); }

    puts("PASS: float_sizeof_stress\n");

    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
