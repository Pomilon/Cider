// CIDER-BUG-029: a cross-module struct alias (`type SAlias = S;` in this
// module) must canonicalize its target in the defining module so use sites
// that do not import S still resolve it (and compare it canonically with
// the callee's return type).
export struct S {
  var x: u64;
  var y: u64;
}

type SAlias = S;

export func makeS(x: u64, y: u64) -> SAlias {
  var s: SAlias;
  s.x = x;
  s.y = y;
  return s;
}
