// CIDER-ISS-010: a rethrow from the outermost catch must take the same
// defined uncaught-exception path as a plain uncaught throw. The catch
// reinstalls the enclosing (here: null) handler before its body runs, so
// `throw e` sees no active handler.
// Expected on all three paths (VM unopt, VM opt, native):
//   stderr = "vm error: uncaught exception\n", exit = 2.
func main() -> int {
    try {
        throw 7;
    } catch (e) {
        throw e;
    }
    return 0;
}
