// CIDER-BUG-183: `*Cb` and `*func(int) -> int` are the same type.
//
// A `func(...)` VALUE is a closure OBJECT {callable slot, captures...}, and
// that object pointer is carried in TypeInfo::pointerLevel (parseType adds
// the +1 object pointer to the `func` spelling, so the bare type is level 1
// and `*func(...)` is level 2). `type Cb = func(int) -> int` therefore
// inherits level 1 from its target, and `*Cb` must be level 2 — the same
// type the direct spelling writes.
//
// Before the fix both alias resolvers (type_checker::resolveTypeImpl and
// ir_gen::resolveTypeAliasImpl) bailed out at `pointerLevel > 0`, so the
// resolution returned the ALIAS SPELLING with a bare level and the
// closure-object level was dropped: `*Cb` compared as a pointer to a
// nameless pointee and was rejected in EVERY position the direct spelling
// was accepted, while the two mirrors also disagreed with each other about
// what type it was:
//
//   var p: *Cb = &f;      -> "Expected *Cb, got fn(int) -> int"
//
// The whole family is pinned here, once per spelling and once per use
// position, because "the alias resolves" is not the property that
// matters: a wrong 8-vs-16-byte type, a dropped closure-object level or a
// call routed through the wrong representation still runs and still
// returns the right answer on a VM and miscompiles on native.
//
// Every spelling agrees with every other spelling on all three backends:
//   * the bare alias        `Cb`
//   * the direct spelling   `func(int) -> int`
//   * an alias of the alias `Cb2` (a second hop)
//   * the two-level form    `**Cb`
//
// and every use position is exercised:
//   * a `var` declaration
//   * a call through the deref      `(*p)(3)`
//   * a struct FIELD of the pointer type
//   * an ARRAY ELEMENT of the pointer type
//   * a PARAMETER of the pointer type
//   * an initializer from a function name `&double`
//   * an alias-to-alias chain
//
// A call written on the POINTER itself (`p(3)`, no deref) is deliberately
// NOT exercised here: it is broken identically for the direct spelling and
// for every alias on the BASE commit (the VM reports `call: bad function
// id` and native dies with SIGSEGV), so it is a separate pre-existing
// defect rather than part of this one. What matters for CIDER-BUG-183 is
// that the alias and the direct spelling AGREE there too, and the sibling
// smoke test pins that agreement explicitly.
type Cb = func(int) -> int;
type Cb2 = Cb;

// One closure object per base, so a wrong capture shows up as a wrong
// answer rather than as a coincidence.
func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

// SysV-pinned so `&doubleSys` has the same signature on every target
// (uefi's default ABI is MS-ABI). See section 7.
sysvabi func doubleSys(x: int) -> int { return x * 2; }

struct Holder { var c: *Cb; }
struct Holder2 { var c: *func(int) -> int; }
struct Holder3 { var c: *Cb2; }

// A parameter: the call happens in a non-inlined callee, so the value has to
// survive the call as a plain pointer.
func viaParam(p: *Cb, x: int) -> int { var q: Cb = *p; return q(x); }
func viaParam2(p: *func(int) -> int, x: int) -> int {
  var q: func(int) -> int = *p; return q(x);
}
func viaParam3(p: *Cb2, x: int) -> int { var q: Cb2 = *p; return q(x); }

// A two-level parameter: `*p` is the closure itself, not a pointer to one.
func viaParamDeep(p: **Cb, x: int) -> int { var q: Cb = **p; return q(x); }

func main() -> int {
  // ---- 1. the bare alias spelling ---------------------------------------
  var c1: Cb = makeAdder(1);
  var p1: *Cb = &c1;
  if ((*p1)(3) != 4) { return 101; }     // call through the deref
  var d1: Cb = *p1;
  if (d1(3) != 4) { return 103; }        // deref into a local, then call
  if (viaParam(p1, 3) != 4) { return 104; }

  // ---- 2. the direct spelling, every position --------------------------
  var c2: func(int) -> int = makeAdder(2);
  var p2: *func(int) -> int = &c2;
  if ((*p2)(3) != 5) { return 111; }
  var d2: func(int) -> int = *p2;
  if (d2(3) != 5) { return 113; }
  if (viaParam2(p2, 3) != 5) { return 114; }

  // ---- 3. an alias of the alias (a second hop) -------------------------
  var c3: Cb2 = makeAdder(3);
  var p3: *Cb2 = &c3;
  if ((*p3)(3) != 6) { return 121; }
  var d3: Cb2 = *p3;
  if (d3(3) != 6) { return 123; }
  if (viaParam3(p3, 3) != 6) { return 124; }

  // ---- 4. the two-level form -------------------------------------------
  // `**Cb` is a pointer to a slot holding a pointer to a closure, so `*p4`
  // is the `*Cb` and `**p4` is the closure itself. This is the position the
  // dropped level was most visible: the old resolver reported `*Cb` where
  // the value is a `Cb`, so the inner deref was rejected outright.
  var c4: Cb = makeAdder(4);
  var p4: **Cb = &p1;
  if ((**p4)(3) != 4) { return 131; }
  var d4: Cb = **p4;
  if (d4(3) != 4) { return 132; }
  if (viaParamDeep(p4, 3) != 4) { return 133; }

  // ---- 5. a struct FIELD of the pointer type, per spelling -------------
  var h1: Holder;
  h1.c = &c1;
  if ((*h1.c)(3) != 4) { return 141; }
  var f1: Cb = *h1.c;
  if (f1(3) != 4) { return 142; }

  var h2: Holder2;
  h2.c = &c2;
  if ((*h2.c)(3) != 5) { return 143; }
  var f2: func(int) -> int = *h2.c;
  if (f2(3) != 5) { return 144; }

  var h3: Holder3;
  h3.c = &c3;
  if ((*h3.c)(3) != 6) { return 145; }
  var f3: Cb2 = *h3.c;
  if (f3(3) != 6) { return 146; }

  // A field read back through a pointer to the struct is the same storage
  // reached by a different route, so a level lost on the field is caught.
  var hp: *Holder = &h1;
  var fhp: Cb = *hp.c;
  if (fhp(3) != 4) { return 147; }

  // ---- 6. an ARRAY ELEMENT of the pointer type -------------------------
  var arr1: [*Cb; 2];
  arr1[0] = &c1;
  arr1[1] = &c4;
  if ((*arr1[0])(3) != 4) { return 151; }
  var e1: Cb = *arr1[1];
  if (e1(3) != 7) { return 152; }

  var arr2: [*func(int) -> int; 2];
  arr2[0] = &c2;
  if ((*arr2[0])(3) != 5) { return 153; }

  var arr3: [*Cb2; 2];
  arr3[0] = &c3;
  if ((*arr3[0])(3) != 6) { return 154; }

  // ---- 7. an initializer from a FUNCTION NAME ---------------------------
  // The ticket's reproducer shape: `&f` on a named function. A named
  // function is a raw code pointer, and the `func(...)` spelling's
  // CIDER-BUG-063 rule stores that raw pointer in the declared slot, so the
  // alias spelling must be ACCEPTED where the direct one is — which is
  // exactly what the old resolver refused. `doubleSys` is declared with an
  // explicit SysV ABI so this position is checked on every target: an
  // un-annotated `func f` takes the TARGET's default, and uefi's default is
  // MS-ABI, whose `&f` is an `msabi fn(...)` that does not match a SysV
  // closure spelling — for the DIRECT spelling too, so that is a target
  // property and not an alias one (the sibling smoke test pins the uefi
  // case).
  var pd: *Cb = &doubleSys;
  var pd2: *func(int) -> int = &doubleSys;
  var pd3: *Cb2 = &doubleSys;
  if (pd == nilPtr) { return 161; }
  if (pd2 == nilPtr) { return 162; }
  if (pd3 == nilPtr) { return 163; }
  // The three initializers name the same function, so they compare equal.
  if (pd != pd2) { return 164; }
  if (pd != pd3) { return 165; }

  // ---- 8. assignment between the spellings -----------------------------
  // A pointer written one way and read the other is the same type, so these
  // must all be assignments, not conversions. If the closure-object level
  // were still being dropped they would be distinct types and every one of
  // these would be a diagnostic instead.
  var x1: *Cb = p2;              // direct -> alias
  if ((*x1)(3) != 5) { return 171; }
  var x2: *func(int) -> int = p1; // alias -> direct
  if ((*x2)(3) != 4) { return 172; }
  var x3: *Cb2 = p1;             // alias -> alias-of-alias
  if ((*x3)(3) != 4) { return 173; }
  var x4: *Cb = p3;
  if ((*x4)(3) != 6) { return 174; }

  // ---- 9. a bare (non-pointer) alias is unchanged ----------------------
  // The level the fix ADDS is only the written one: `Cb` is still level 1
  // and `*Cb` level 2, so a bare alias still holds a closure OBJECT and
  // still calls through the object.
  var b1: Cb = makeAdder(7);
  if (b1(3) != 10) { return 181; }
  var b2: func(int) -> int = makeAdder(8);
  if (b2(3) != 11) { return 182; }
  var b3: Cb2 = makeAdder(9);
  if (b3(3) != 12) { return 183; }

  return 0;
}
