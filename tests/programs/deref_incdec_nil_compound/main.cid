// CIDER-BUG-226: the compound-assignment sibling of the nil-guard regression
// in deref_incdec_nil_increment. `(*p) += n` parses its target as a grouping
// around the `*`, and the assignment target's shape classification missed the
// grouping: the read-modify-write fell through to the generic path, re-based
// itself onto the pointer variable (so it wrote `p = p + n`) and never reached
// the emitNilDerefCheck that the unparenthesized `*p = v` store already had.
// A grouping is transparent, so the guard now covers both spellings.
//
// The live forms run first (the guard is a not-taken branch there), then the
// nil case reports:
//   stderr = "vm error: null pointer dereference\n", exit = 2.
func addLive(p: *int, n: int) -> int { (*p) += n; return *p; }
func subLive(p: *int, n: int) -> int { (*p) -= n; return *p; }
func mulLive(p: *int, n: int) -> int { (*p) *= n; return *p; }
func storeLive(p: *int, v: int) -> int { (*p) = v; return *p; }

func nilAdd(p: *int, n: int) -> int { (*p) += n; return *p; }

func main() -> int {
  var x: int = 20;
  var q: *int = &x;
  if (addLive(q, 22) != 42) { return 101; }
  if (subLive(q, 2) != 40) { return 102; }
  if (mulLive(q, 2) != 80) { return 103; }
  if (storeLive(q, 7) != 7) { return 104; }
  if (q != &x) { return 105; }

  var nilInt: *int = nilPtr;
  return nilAdd(nilInt, 1);
}
