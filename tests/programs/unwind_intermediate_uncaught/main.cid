// CIDER-BUG-190, the uncaught half: a landing pad re-throws through the
// chain value it saved, so a frame crossed by a throw still runs its
// pending scope exits when NOTHING catches — the re-throw finds a null
// handler and takes the defined uncaught path (CIDER-ISS-010), after the
// exits ran. That keeps the "the exits run before the report" order
// CIDER-BUG-154 pinned for the thrower's own frame, now for a frame that
// is not the thrower: the destructor and defer output reaches stdout
// before the `vm error: uncaught exception` line on stderr, on all three
// backends.
from std.io import print, printInt;

class D {
    var n: int;
    func ~D() {
        printInt(this.n);
        print(",");
    }
}

struct SW { var d: D; }

func boom() -> int { throw 9; }

func mid() -> int {
    var m: D; m.n = 1;
    var s: SW; s.d.n = 2;
    defer { print("d;"); }
    return boom();
}

func main() -> int {
    var outer: D; outer.n = 3;
    return mid();   // the thrower is boom(), one frame below mid()
}
