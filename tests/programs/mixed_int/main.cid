func f(x: u64) -> u64 {
    var d: u64 = 1000 / x;
    return d + x;
}
func main() -> int {
  if (f(10) != 110) { return 1; }
  var big: u64 = 1099511627776;
  var a: u64 = 1 + big;
  if (a != 1099511627777) { return 2; }
  var s: i64 = -7;
