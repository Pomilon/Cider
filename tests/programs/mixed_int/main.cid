  var q: i64 = s / u;
  if (q != 9223372036854775804) { return 3; }
  var i: int = 1000;
  i /= u;
  if (i != 500) { return 4; }
  var j: int = 5;
  j += u;
  if (j != 7) { return 5; }
  return 0;
}
