// CIDER-BUG-051 regression: a template body must clone every expression and
// statement form a normal function body accepts. Before the fix the cloner
// returned nullptr for `new`, list/table/struct/slice/interpolated/closure
// expressions and `await` (silently erasing them from the instantiation),
// and rejected `defer`/`match`/`asm` outright.
//
// Each check has a distinct non-zero exit so a dropped or mis-substituted
// form is pinned by the triple-differential harness (VM unopt, VM opt,
// native).

struct Box<T> { var value: T; }

// `new T` in a generic body; `delete` in another.
func make<T>() -> *T { return new T; }
func drop<T>(p: *T) -> void { delete p; }

// List literal.
func tripled<T>(x: T) -> *T { return [x, x, x]; }

// Struct literal.
func boxed<T>(x: T) -> Box<T> { return Box<T> { value: x }; }

// Interpolated string.
func interp<T>(x: T) -> string { return "v={x}"; }

// Table literal.
func table_of<T>(x: T) -> *void { return { 1: x, 2: x }; }

// Slice expression + for-in loop.
func slice_sum<T>(x: T) -> T {
    var arr: [T; 4] = [x, x, x, x];
    var total: T = 0 as T;
    for (var v in arr[1:3]) {
        total = total + v;
    }
    return total;
}

// defer + match.
func counted<T>(p: *int, n: int) -> int {
    defer { *p = *p + 1; }
    match (n) {
        1 => { return 10; }
        2 => { return 20; }
        default => { return 30; }
    }
}

// asm with a `{var}` operand binding.
func asm_forty_two<T>() -> int {
    var out: int = 0;
    asm { "mov {out}, 42" }
    return out;
}

// Closure literal using the substituted parameter type.
func doubled<T>(x: T) -> T {
    var f: func(T) -> T = func(y: T) -> T { return y + y; };
    return f(x);
}

// fn-pointer-typed parameter: the cloned parameter keeps its (substituted)
// signature, not a degraded bare "fn".
func apply<T>(cb: fn(T) -> T, x: T) -> T { return cb(x); }
func twice_int(x: int) -> int { return x * 2; }

// try/catch/throw round-tripping the substituted type.
func rethrow<T>(x: T) -> T {
    try {
        throw x;
    } catch (e) {
        return e as T;
    }
}

// Nested template call inside a for loop in a generic body.
func id<T>(x: T) -> T { return x; }
func sum_ids<T>(x: T) -> T {
    var total: T = 0 as T;
    for (var i: int = 0; i < 3; i = i + 1) {
        total = total + id<T>(x);
    }
    return total;
}

// Exported generic body: the template-call scan must look through the
// export wrapper or `id<int>` is never instantiated.
export func exported_id<T>(x: T) -> T { return id<T>(x); }

// Exported concrete body with an explicit template call (same unwrap path).
export func exported_lookup() -> int { return id<int>(21); }

// await inside a generic async body.
async func fetch(n: int) -> int { return n * 2; }
async func twiced<T>(n: T) -> T { return await fetch(n as int) as T; }

func main() -> int {
    var p: *int = make<int>();
    if (p == nilPtr) return 1;
    *p = 11;
    if (*p != 11) return 2;
    drop<int>(p);

    var l: *int = tripled<int>(9);
    if (l[0] + l[1] + l[2] != 27) return 3;

    var b: Box<int> = boxed<int>(5);
    if (b.value != 5) return 4;

    var msg: string = interp<int>(42);
    var want: string = "v=42";
    var i: int = 0;
    while (msg[i] != 0 as char || want[i] != 0 as char) {
        if (msg[i] != want[i]) return 5;
        i = i + 1;
    }

    if (slice_sum<int>(2) != 4) return 6;

    var t: *int = table_of<int>(7) as *int;
    if (t[0] != 1 || t[1] != 7 || t[2] != 2 || t[3] != 7) return 7;

    var runs: int = 0;
    if (counted<int>(&runs, 1) != 10) return 8;
    if (counted<int>(&runs, 2) != 20) return 9;
    if (counted<int>(&runs, 7) != 30) return 10;
    if (runs != 3) return 11;

    if (asm_forty_two<int>() != 42) return 12;
    if (doubled<int>(4) != 8) return 13;
    if (rethrow<int>(6) != 6) return 14;
    if (sum_ids<int>(5) != 15) return 15;
    if (apply<int>(twice_int, 21) != 42) return 17;
    if (exported_id<int>(19) != 19) return 18;
    if (exported_lookup() != 21) return 19;

    var a: int = await twiced<int>(21);
    if (a != 42) return 16;

    return 0;
}
