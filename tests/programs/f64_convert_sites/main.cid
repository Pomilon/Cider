struct Pair {
  var x: f64;
  var y: f64;
}

interface Scaler {
  func scale(v: f64) -> f64;
  func narrow(v: float) -> float;
}

class Doubler {
  var bias: f64;
  func scale(v: f64) -> f64 { return v * 2.0 + this.bias; }
  func narrow(v: float) -> float { return v; }
}

func giveInt() -> f64 { return 2; }            // int literal -> f64 return
func giveNarrow() -> float {                   // f64 local -> f32 return
  var wide: f64 = 1.5;
  return wide;
}
func take64(v: f64) -> f64 { return v; }

func main() -> int {
  // Aggregate literals store at the declared width.
  var p: Pair = Pair{x: 1.5, y: 2.5};
  if (p.x != 1.5) { return 1; }
  if (p.y != 2.5) { return 2; }
  var arr: [f64; 2] = [1.5, 2.5];
  if (arr[0] != 1.5) { return 3; }
  if (arr[1] != 2.5) { return 4; }
  // Field/element assignment: the declared width drives the store.
  p.x = 3.5;
  if (p.x != 3.5) { return 5; }
  p.y = 2;
  if (p.y != 2.0) { return 6; }
  arr[0] = 4.5;
  if (arr[0] != 4.5) { return 7; }
  var narrow: float = 0.0;
  narrow = arr[1];                             // f64 -> f32 plain assignment
  if (narrow != 2.5) { return 8; }
  // Deref store through f64*.
  var slot: f64 = 0.0;
  var sp: f64* = &slot;
  *sp = 5.5;
  if (slot != 5.5) { return 9; }
  *sp += 0.5;
  if (slot != 6.0) { return 10; }
  // int <-> f64 at assignment/return/call.
  var ival: f64 = 0.0;
  ival = 2;
  if (ival != 2.0) { return 11; }
  if (giveInt() != 2.0) { return 12; }
  if (take64(3) != 3.0) { return 13; }
  var n32: float = giveNarrow();
  if (n32 != 1.5) { return 14; }
  // Method and interface call arguments.
  var d: *Doubler = new Doubler;
  d->bias = 0.5;
  if (d->scale(1.25) != 3.0) { return 15; }
  if (d->scale(2) != 4.5) { return 16; }
  var r: float = d->narrow(6.0);               // f64 arg -> f32 param
  if (r != 6.0) { return 17; }
  var dv: Doubler;
  dv.bias = 0.5;
  var it: Scaler = dv;
  if (it.scale(1.25) != 3.0) { return 18; }
  if (it.scale(2) != 4.5) { return 19; }
  var s: float = it.narrow(6.0);
  if (s != 6.0) { return 20; }
  return 0;
}
