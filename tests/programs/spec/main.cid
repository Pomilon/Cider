func max<T>(a: T, b: T) -> T {
  if (a > b) { return a; }
  return b;
}

func max<int>(a: int, b: int) -> int {
  return a + b + 1000;
}

func _start() {
  var r1: int = max<int>(3, 5);
  var r2: int = max(3, 5);
  if (r1 != 1008) { asm { "mov rax, 60" } asm { "mov rdi, 1" } asm { "syscall" } }
  if (r2 != 1008) { asm { "mov rax, 60" } asm { "mov rdi, 2" } asm { "syscall" } }
  asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
