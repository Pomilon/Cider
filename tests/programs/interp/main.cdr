from std.io import print;

func _start() -> void {
  var x: int = 42;
  var name: string = "world";
  var ok: bool = true;
  var ch: char = 33;
  print("x = {x}, hello {name}, ok = {ok}, bang{ch}\n");
  print("literal {{brace}} and {x + 1}\n");
  print("css { color: #333; } stays literal\n");
  asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
