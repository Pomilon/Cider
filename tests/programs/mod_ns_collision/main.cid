import nsa;
import nsb;
from nsb import make;

struct Event {
  var tag: int;
}

struct Holder {
  var tag: int;
}

func shadowed() -> int {
  var nsa: Holder = Holder{tag: 9};
  return nsa.tag;
}

func main() -> int {
  if (nsa.describe(nsa.make()) != 1) { return 1; }
  if (nsb.describe(nsb.make()) != 22) { return 2; }
  if (nsb.describe(make()) != 22) { return 3; }
  var e: Event = Event{tag: 7};
  if (e.tag != 7) { return 4; }
  if (shadowed() != 9) { return 5; }
  return 0;
}
