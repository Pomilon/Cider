// CIDER-BUG-153 regression: exit_group(2) (rax=231) in a single multi-line
// asm block, with earlier work that must stay before the fini pass.
//
// Same contract as global_fini_asm_exit: the entry's statically visible
// terminal exit syscall gets the `_cider_global_fini` call in front of its
// register setup. This program pins the two harder properties:
//   * the block starts with a write(2) syscall, so the fini call must go
//     after it (the write's `mid,` output precedes the destructor's `fini`)
//     and must not fire on a non-exit syscall;
//   * `exit_group` is recognized like `exit`, and the call must not clobber
//     the status register rdi: the process still exits 7.
//
// All three backends (VM unopt, VM optim, native): `run,mid,fini`, exit 7.
from std.io import print;

class D {
    func ~D() {
        print("fini");
    }
}

var g: D;
var midMsg: string = "mid,";

func _start() {
    print("run,");
    var m: char* = midMsg as char*;
    asm {
        "mov rax, 1\n"
        "mov rdi, 1\n"
        "mov rsi, {m}\n"
        "mov rdx, 4\n"
        "syscall\n"
        "mov rax, 231\n"
        "mov edi, 7\n"
        "syscall\n"
    }
}
