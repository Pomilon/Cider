// CIDER-BUG-123 regression: base constructors and destructors are chained.
// Before this fix `new D(args)` ran only `D_init` and `delete p` ran only
// `~D`, and tests/programs/constructors pinned exactly that.
//
// The rule this test pins, for `class Leaf extends Mid extends Root`:
//
//   CONSTRUCTION (`new Leaf`) — base initialization first:
//       zero -> vptr -> field initializers for the WHOLE hierarchy in layout
//       order (a base's fields are a prefix, so Root's run before Mid's,
//       which run before Leaf's) -> Root.init -> Mid.init -> Leaf.init
//   DESTRUCTION (`delete`, and the end of a scope holding a class value) —
//   the reverse, most derived first:
//       ~Leaf -> ~Mid -> ~Root -> the class values it embeds by value, in
//       reverse construction order
//
// Within one object this is the CIDER-BUG-088/108/137 ordering with the base
// chain spliced in after the class's own destructor: the class's own
// destructor still runs first (its body may read its subobjects), then the
// base chain from the nearest base up to the root, then the embedded values.
//
// Two things make a base join a chain, and they are INDEPENDENT:
//   * a base constructor declaring NO PARAMETERS is auto-invoked. There is no
//     `super(...)` (still diagnosed), so a base constructor that declares
//     parameters has no argument source at `new` and is not invoked.
//   * a base destructor is ALWAYS invoked — it takes no arguments.
// Neither is inheritance: a derived class must still declare its own
// `func init(...)` for `new D(...)` to type-check.
//
// All three backends (VM unopt, VM optim, native) must agree on the trace.
from std.io import print, printInt;
import chain;

// --- 1. a three-level chain: `new` and `delete` -------------------------

class Root {
    var r: int = 0;
    func init() -> void {
        print("Root.init r="); printInt(this.r); print("\n");
        this.r = 1;
    }
    func ~Root() { print("~Root r="); printInt(this.r); print("\n"); }
}

class Mid extends Root {
    var m: int = 0;
    func init() -> void {
        print("Mid.init r="); printInt(this.r); print("\n");
        this.m = 2;
    }
    func ~Mid() { print("~Mid r="); printInt(this.r); print(" m="); printInt(this.m); print("\n"); }
}

class Leaf extends Mid {
    var l: int = 0;
    func init() -> void {
        print("Leaf.init r="); printInt(this.r); print(" m="); printInt(this.m); print("\n");
        this.l = 3;
    }
    func ~Leaf() {
        print("~Leaf r="); printInt(this.r); print(" m="); printInt(this.m);
        print(" l="); printInt(this.l); print("\n");
    }
}

// --- 2. a derived class with no destructor of its own, and a base with no
//        constructor: each chain is per-declaration, not virtual. ---------

class PlainBase {
    var b: int = 5;
    func ~PlainBase() { print("~PlainBase b="); printInt(this.b); print("\n"); }
}

class PlainChild extends PlainBase {
    var c: int = 6;
    func init() -> void { print("PlainChild.init\n"); }
}

// --- 3. the base subobject is NOT at offset 0: a base without a vtable
//        whose DERIVED class reserves the hierarchy's vptr shifts every
//        inherited field by 8. The base constructor/destructor must still be
//        entered at the base's own address, or it reads the vptr as its
//        first field. ------------------------------------------------------

class NoVBase {
    var b: int = 7;
    func init() -> void { this.b = this.b + 1; }
    func ~NoVBase() { print("~NoVBase b="); printInt(this.b); print("\n"); }
}

class NoVChild extends NoVBase {
    var c: int = 9;
    func init() -> void { print("NoVChild.init\n"); }
    func ~NoVChild() {
        print("~NoVChild b="); printInt(this.b); print(" c="); printInt(this.c); print("\n");
    }
    // The first virtual method of this hierarchy: NoVChild reserves the
    // vptr slot, so b lives at offset 8, not 0.
    virtual func f() -> int { return 1; }
}

// --- 4. a base WITH a vtable is entered at offset 0, where the derived
//        object's vptr sits, so a virtual call from a base destructor still
//        dispatches on the most-derived type. ---------------------------

class VBase {
    var b: int = 1;
    virtual func id() -> int { return 10; }
    func ~VBase() { print("~VBase sees id="); printInt(this.id()); print("\n"); }
}

class VChild extends VBase {
    func init() -> void { print("VChild.init\n"); }
    override func id() -> int { return 20; }
}

// --- 5. the base chain runs BEFORE the class values it embeds -----------

class Emb {
    var e: int;
    func ~Emb() { print("~Emb e="); printInt(this.e); print("\n"); }
}

class EmbBase {
    func ~EmbBase() { print("~EmbBase\n"); }
}

class EmbChild extends EmbBase {
    var e1: Emb;
    var e2: Emb;
}

// --- 6. a dotted base in another module: the chained constructor and
//        destructor mangle with the BASE's own module. -------------------

class CrossChild extends chain.CrossBase {
    var x: int = 1;
    func init() -> void { print("CrossChild.init\n"); }
}

func main() -> int {
    // 1. construction runs the base chain root-first, each constructor
    //    observing an already-initialized base.
    print("--new Leaf--\n");
    var leaf: *Leaf = new Leaf;
    print("leaf r="); printInt(leaf->r); print(" m="); printInt(leaf->m);
    print(" l="); printInt(leaf->l); print("\n");
    print("--delete Leaf--\n");
    delete leaf;
    print("--after delete--\n");

    // 2. a value-class instance runs NO constructor (field initializers
    //    only, the pre-existing rule) but is still finalized at scope exit
    //    through the whole base chain.
    print("--value scope--\n");
    {
        var v: Leaf;
        print("v r="); printInt(v.r); print(" m="); printInt(v.m);
        print(" l="); printInt(v.l); print("\n");
        print("inner\n");
    }
    print("--after value scope--\n");

    // 3. only `~PlainBase` exists, so only it runs.
    print("--PlainChild--\n");
    var pc: *PlainChild = new PlainChild;
    printInt(pc->b); print(" "); printInt(pc->c); print("\n");
    delete pc;

    // 4. the shifted base subobject: b is 7 from the field initializer plus
    //    one from NoVBase's constructor.
    print("--NoVChild--\n");
    var nv: *NoVChild = new NoVChild;
    printInt(nv->b); print(" "); printInt(nv->c); print(" "); printInt(nv->f()); print("\n");
    delete nv;

    // 5. a base with a vtable dispatches on the most-derived type.
    print("--VChild--\n");
    var vc: *VChild = new VChild;
    var vb: *VBase = vc;
    printInt(vb->id()); print("\n");
    delete vc;

    // 6. the base chain runs before the embedded class values, which are
    //    destroyed last in reverse construction order.
    print("--EmbChild--\n");
    {
        var ec: EmbChild;
        ec.e1.e = 41;
        ec.e2.e = 42;
        print("inner\n");
    }
    print("--after EmbChild--\n");

    // 7. the dotted, cross-module base.
    print("--CrossChild--\n");
    var cc: *CrossChild = new CrossChild;
    printInt(cc->m); print("\n");
    delete cc;
    print("--after CrossChild--\n");

    print("base_ctor_dtor_chain_ok\n");
    return 0;
}
