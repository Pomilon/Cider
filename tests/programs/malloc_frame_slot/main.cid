// CIDER-BUG-221: a malloc result held in a frame slot must read back as the
// bytes the heap block would have held -- on the VM and on the native binary.
//
// THE BUG. Escape analysis (src/escape.h) rewrites a non-escaping
// `malloc(<constant>)` into a stack ALLOCA and drops the matching `free`.
// CIDER-BUG-204's class of bug, but the register-allocation theory was wrong:
// the pointer was never lost. What was lost were the block's BYTES. A bare
// ALLOCA is uninitialised, so the promotion silently replaced fresh heap
// memory with whatever the native stack happened to hold, while the VM --
// which zeroes a frame's bump region when it claims it (CIDER-BUG-115) --
// kept agreeing with the heap. `func w1()` below printed 4227099 on the native
// binary and 0 on both VM paths; two promoted blocks in one frame printed
// -1219017526 natively against 0 on the VM.
//
// CIDER-BUG-067 had already hit this for `new C` and zeroed that block
// (see ir_gen's emitZeroInstance). The promotion itself was the un-zeroed
// sibling: it is now zeroed the same way, from a shared static block of zeros.
//
// THE POLICY this file pins, on all three backends:
//   * a promoted block reads 0 until the program writes it, exactly like the
//     fresh heap block it replaced;
//   * a written element still round-trips, so a wrong pointer cannot pass by
//     reading zeroed memory (every probe has such a control);
//   * two promoted blocks in one frame are independent.
// NOT pinned, and deliberately so: the body of a RECYCLED heap block (one a
// previous free() returned). CIDER-BUG-215 leaves that undefined because it
// depends on free-list history, which differs per backend -- so nothing below
// frees anything. See tests/programs/uninit_zero_policy for that half of the
// policy; this file is about the promoted-slot half.
//
// Every probe is a separate function so only one promoted block is live per
// frame, and each is preceded by eight retired, dirtied frames -- the native
// stack those promotions land in is genuinely used, which is what makes the
// pre-fix native read garbage rather than a lucky zero.
from std.io import print, printInt;
from std.alloc import malloc;

// A 4-byte field pair: a stride or width mistake shows up as a shifted value
// instead of being masked by a zero read.
class Pair {
    var lo: int;
    var hi: int;
}

// The dirtier. A 256-byte frame, eight deep, so the bytes a promoted slot will
// land on really have been written.
type Churn = [int; 64];

func churn(n: int) -> int {
    var f: Churn;
    for (var i: int = 0; i < 64; i = i + 1) { f[i] = -7 - i; }
    if (n <= 0) { return f[0] + f[63]; }
    return f[1] + churn(n - 1);
}

// 1. The ticket's program, verbatim in shape: one constant-size malloc whose
//    result lives in a frame slot, dereferenced through the slot with no
//    write in between.
func w1() -> int {
    var b: *u64 = malloc(16) as *u64;
    if (b == nilPtr) { return -1; }
    return *b as int;
}

// 2. Constant-index reads off a promoted block: b[0], b[1], *(b + 2), b[3].
//    None of the four words was ever written.
func constIndex() -> int {
    var b: *int = malloc(16) as *int;
    if (b == nilPtr) { return -1; }
    var s: int = 0;
    s = s + b[0];
    s = s + b[1];
    s = s + *(b + 2);
    s = s + b[3];
    return s;
}

// 3. POSITIVE CONTROL for constIndex: the same block, same four access shapes,
//    written first. 100 + 20 + 3 - 4.
func constIndexControl() -> int {
    var b: *int = malloc(16) as *int;
    if (b == nilPtr) { return -1; }
    b[0] = 100;
    b[1] = 20;
    b[2] = 3;
    b[3] = -4;
    return b[0] + b[1] + *(b + 2) + b[3];
}

// 4. Two promoted blocks live at once in one frame. Neither is written before
//    the summing loop; the two tail writes then have to land in the right
//    block, so 5 + 6 is also a control on the slots not aliasing.
func twoInOne() -> int {
    var a: *int = malloc(32) as *int;
    if (a == nilPtr) { return -1; }
    var c: *int = malloc(32) as *int;
    if (c == nilPtr) { return -1; }
    var s: int = 0;
    for (var i: int = 0; i < 8; i = i + 1) {
        s = s + a[i];
        s = s + c[i];
    }
    a[7] = 5;
    c[7] = 6;
    return s + a[7] + c[7];
}

// 5. An aggregate block. p[0] is written and read back (control); p[1] is
//    never written, so its two fields -- at the block's own tail, past the
//    8-byte canary the allocator used to leave there -- must read 0.
func aggTail() -> int {
    var p: *Pair = malloc(16) as *Pair;
    if (p == nilPtr) { return -1; }
    p[0].lo = 11;
    p[0].hi = 22;
    if (p[0].lo != 11) { return -1000; }   // positive control
    if (p[0].hi != 22) { return -2000; }   // positive control
    return p[1].lo + p[1].hi;
}

// 6. The same slot re-entered: a promotion inside a loop re-zeroes on every
//    iteration, so a never-written read is 0 each time round, and a write in
//    one iteration is what the next iteration's read sees.
func inLoop() -> int {
    var s: int = 0;
    for (var k: int = 0; k < 4; k = k + 1) {
        var b: *int = malloc(8) as *int;
        if (b == nilPtr) { return -1; }
        s = s + b[0];       // never written: 0 on every iteration
        s = s + b[1];
    }
    return s;
}

// 7. A promoted block whose whole object is one 8-byte word read as a pointer.
//    The low 32 bits are what a garbage stack slot used to leak.
func asWord() -> int {
    var b: *u64 = malloc(8) as *u64;
    if (b == nilPtr) { return -1; }
    return *b as int;
}

func main() -> int {
    // Retire eight dirtied frames first: the promoted slots below land in
    // native stack that has really been used.
    var c: int = churn(8);
    print("churn: ");
    if (c == 0) { printInt(0); } else { printInt(1); }
    print("\n");

    print("w1: ");
    printInt(w1()); print(",");
    printInt(constIndex()); print(",");
    printInt(constIndexControl()); print(",");
    printInt(twoInOne()); print(",");
    printInt(aggTail()); print(",");
    printInt(inLoop()); print(",");
    printInt(asWord());
    print("\n");

    // Pin the values, not just the agreement: a promoted block that was never
    // written reads 0 on every backend.
    if (w1() != 0) { return 1; }
    if (constIndex() != 0) { return 2; }
    if (constIndexControl() != 119) { return 3; }
    if (twoInOne() != 11) { return 4; }
    if (aggTail() != 0) { return 5; }
    if (inLoop() != 0) { return 6; }
    if (asWord() != 0) { return 7; }
    // ...and the controls really do have to pass, so a wrong pointer cannot
    // hide behind a zeroed read.
    if (constIndexControl() != 119) { return 8; }
    if (twoInOne() != 11) { return 9; }

    print("malloc_frame_slot_ok\n");
    return 0;
}
