// CIDER-BUG-156 module: the hardened allocator is imported HERE, but the
// internal heap-copy ABI for a non-sret virtual aggregate return must not
// use it. The caller lives in main, which does not import std.alloc, and
// releases with the fixed bare `free`; a module-resolved `malloc` on this
// side would pair an mmap-arena block with libc's free and crash the
// native build (the whole-program VM would throw "free: bad pointer").
// The compiler therefore uses the fixed bare malloc/free pair on both
// sides of the hidden heap return, exactly like the VM builtins and libc.
from std.alloc import malloc, free;

export class H {
    var label: int;
    func ~H() { }
}

export class AllocBase {
    virtual func make(n: int) -> H {
        var h: H;
        h.label = n;
        return h;
    }
}
