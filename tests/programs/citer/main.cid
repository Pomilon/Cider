from std.io import print, printInt;

class Counter {
  var start: int;
  var end: int;
  var cur: int;

  func iter() -> Counter {
    var it: Counter;
    it.start = this.start;
    it.end = this.end;
    it.cur = this.start;
    return it;
  }

  func next() -> *int {
    if (this.cur >= this.end) { return nilPtr; }
    var p: *int = &this.cur;
    this.cur = this.cur + 1;
    return p;
  }
}

func _start() {
  var c: Counter;
  c.start = 0;
  c.end = 4;
  var total: int = 0;
  for (var x in c) {
    total = total + x;
  }
  if (total != 10) { asm { "mov rax, 60" } asm { "mov rdi, 1" } asm { "syscall" } }
  asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
