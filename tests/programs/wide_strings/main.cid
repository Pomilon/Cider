func take(p: *u16) -> int { return p[0]; }

var wg_s: [u16; 3] = u"GH";
var wg_p: *u16 = u"IJ";

func main() -> int {
  var s: [u16; 3] = u"AB";
  if (s[0] != 65) { return 1; }
  if (s[1] != 66) { return 2; }
  if (s[2] != 0) { return 3; }
  var p: *u16 = u"C\u0044";
  if (p[0] != 67) { return 4; }
  if (p[1] != 68) { return 5; }
  if (p[2] != 0) { return 6; }
  if (u"X"[0] != 88) { return 7; }
  if (take(u"Y") != 89) { return 8; }
  var c: u16 = u'Z';
  if (c != 90) { return 9; }
  // Global wide array cell and wide pointer cell.
  if (wg_s[0] != 71) { return 10; }
  if (wg_s[1] != 72) { return 11; }
  if (wg_s[2] != 0) { return 12; }
  if (take(wg_p) != 73) { return 13; }
  if (wg_p[1] != 74) { return 14; }
  if (wg_p[2] != 0) { return 15; }
  // Address of the first unit of a literal.
  var q: *u16 = &u"QR"[0];
  if (take(q) != 81) { return 16; }
  if (q[1] != 82) { return 17; }
  if (q[2] != 0) { return 18; }
  // Surrogate pair: two raw UTF-16 units, no normalization.
  var sp: [u16; 3] = u"\uD83D\uDE00";
  if (sp[0] != 0xD83D) { return 19; }
  if (sp[1] != 0xDE00) { return 20; }
  if (sp[2] != 0) { return 21; }
  return 0;
}
