// CIDER-BUG-165 cross-module regression: the declared array shapes live in
// the callee's module (aliases, struct fields, interface signatures), so
// the list-literal checks and materialisation must resolve through the
// module-aware canonicalization, not the caller's spellings.
from std.io import print, printInt;
from m import Holder, IfaceHolder, Sq, flat, nested, total;

func main() -> int {
  var h: Holder = Holder{r: [1, 2], g: [[3, 4], [5, 6]]};
  if (h.r[1] != 2 || h.g[1][0] != 5) { return 1; }
  if (flat([7, 8]) != 78) { return 2; }
  if (nested([[9, 10], [11, 12]]) != 111) { return 3; }
  var s: Sq; s.side = 4;
  var ih: IfaceHolder = IfaceHolder{shapes: [s, s]};
  if (ih.shapes[0].area() != 16 || ih.shapes[1].area() != 16) { return 4; }
  if (total([s, s]) != 32) { return 5; }
  printInt(h.r[0] + h.g[0][1]); print(",");
  printInt(flat([1, 2]) + nested([[3, 4], [5, 6]])); print(",");
  printInt(total([s, s]) + ih.shapes[1].area()); print("\n");
  print("list_positions_crossmod_ok\n");
  return 0;
}
