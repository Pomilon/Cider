// CID-006 fix round 3: uses of a bare cyclic alias — assignment, same-typed
// copy and call parameter — must compile on every backend; mapType's alias
// walk used to recurse until SIGSEGV. The slots are unused 8-byte values.
type A = B;
type B = A;

func use(v: B) -> int {
  return 0;
}

func main() -> int {
  var x: B;
  x = x;
  var y: B = x;
  return use(y);
}
