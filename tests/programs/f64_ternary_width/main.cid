// CID-003 follow-up (I4): ternary PHI arms must convert to the common float
// width. The PHI type used to come from the then-arm only, so a mixed
// f64/f32 ternary emitted `pop xmm`/mismatched widths on native. Pure-f32
// ternaries failed too (the deconstructor's push/pop of xmm values).
func main() -> int {
  var c: bool = true;
  var c2: bool = false;
  var d: f64 = 2.5;

  // f64 then-arm, f32 else-arm (literal) and the reverse order.
  var e: f64 = c ? d : 1.5;
  if (e != 2.5) { return 1; }
  var e2: f64 = c ? 1.5 : d;
  if (e2 != 1.5) { return 2; }
  var e3: f64 = c2 ? d : 1.5;
  if (e3 != 1.5) { return 3; }
  var e4: f64 = c2 ? 1.5 : d;
  if (e4 != 2.5) { return 4; }

  // Pure f32 ternary.
  var a32: float = 1.25;
  var b32: float = 3.75;
  var f: float = c ? a32 : b32;
  if (f != 1.25) { return 5; }
  var f2: float = c2 ? a32 : b32;
  if (f2 != 3.75) { return 6; }

  // Pure f64 ternary.
  var x64: f64 = 1.25;
  var y64: f64 = 3.75;
  var g: f64 = c ? x64 : y64;
  if (g != 1.25) { return 7; }

  // f32 variable mixed with an f64 literal.
  var h: f64 = c ? a32 : 3.5;
  if (h != 1.25) { return 8; }
  var h2: float = c ? b32 : 2.5;
  if (h2 != 3.75) { return 9; }
  return 0;
}
