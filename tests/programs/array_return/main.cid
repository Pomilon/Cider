// CIDER-BUG-045: fixed-size array values are by-value aggregates: they
// return through the hidden sret slot (local variable, wide literal, and
// alias spelling) and copy into the callee for by-value params. Before
// the fix the scalar path dropped the value: native returned garbage and
// the literal return folded to `ret 0` on both backends.
type X = [u16; 3];

func fromLocal() -> [u16; 3] {
  var a: [u16; 3];
  a[0] = 65;
  a[1] = 66;
  a[2] = 0;
  return a;
}

func fromLiteral() -> [u16; 3] { return u"AB"; }

func fromAlias() -> X { return u"AB"; }

func sum(a: [u16; 3]) -> int { return (a[0] + a[1] + a[2]) as int; }

func main() -> int {
  var a: [u16; 3] = fromLocal();
  if (a[0] != 65) { return 1; }
  if (a[1] != 66) { return 2; }
  if (a[2] != 0) { return 3; }

  var b: [u16; 3] = fromLiteral();
  if (b[0] != 65) { return 4; }
  if (b[1] != 66) { return 5; }
  if (b[2] != 0) { return 6; }

  var c: X = fromAlias();
  if (c[0] != 65) { return 7; }
  if (c[1] != 66) { return 8; }
  if (c[2] != 0) { return 9; }

  if (sum(a) != 131) { return 10; }
  if (sum(u"AB") != 131) { return 11; }
  return 0;
}
