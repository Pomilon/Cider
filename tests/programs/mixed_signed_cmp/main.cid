// CID-003 follow-up (M5): mixed signed/unsigned integer comparisons use
// C usual conversions. Equal widths (or a wider unsigned operand) compare
// in the unsigned domain, so `-1 < u32(1)` is false and `i32(-1)` equals
// `u32(4294967295)`; a wider signed operand keeps the signed domain.
// Before this, codegen picked setcc from the left operand's type while the
// VM compared signed, so these diverged or were plain wrong.
func main() -> int {
  var a: i32 = 0 - 1;
  var b: u32 = 1;
  if (a < b) { return 1; }              // unsigned: 0xFFFFFFFF < 1 false
  if (b > a) { return 2; }              // unsigned: 1 > 0xFFFFFFFF false
  var c: u32 = 4294967295;
  if (!(a == c)) { return 3; }          // equal in the unsigned domain
  if (a != c) { return 4; }
  if (!((1 as u32) < 2)) { return 5; }  // positive control
  var d: i64 = 0 - 1;
  var e: u64 = 18446744073709551615;
  if (!(d == e)) { return 6; }          // i64/u64: equal unsigned
  if (d != e) { return 7; }
  var f: i8 = 0 - 1;
  var g: u8 = 255;
  if (!(f == g)) { return 8; }          // i8 -1 wraps to u8 255
  var h: i16 = 0 - 1;
  var i: u32 = 4294967295;
  if (!(h == i)) { return 9; }          // sign-extend, then wrap to u32
  var j: i64 = 0 - 1;
  var k: u32 = 1;
  if (!(j < k)) { return 10; }          // signed wider: -1 < 1 true
  if (j == k) { return 11; }
  var m: i16 = 300;
  var n: u16 = 300;
  if (!(m == n)) { return 12; }         // equal widths, positive values
  if (m < n) { return 13; }
  var p: i8 = 0 - 1;
  var q: i8 = 0 - 1;
  if (p != q) { return 14; }            // all-signed pair unchanged
  var r: u64 = 5;
  var s: u64 = 7;
  if (!(r < s)) { return 15; }          // all-unsigned pair unchanged
  if (a <= b) { return 16; }            // unsigned: 0xFFFFFFFF <= 1 false
  if (!(a >= b)) { return 17; }         // unsigned: 0xFFFFFFFF >= 1 true
  var t: u8 = 200;
  var u: i32 = 0 - 1;
  if (!(t > u)) { return 18; }          // narrower unsigned, wider signed
  if (u >= t) { return 19; }

  // CID-003 follow-up (W5): ordered comparisons across i64/u64 compare in
  // the unsigned domain (ir_gen converts both operands to U64 before the
  // CMP). The VM compared the extended values signed, so i64(-1) < u64(1)
  // was true and u64(max) < 1 was true.
  var dneg: i64 = 0 - 1;
  var one64: u64 = 1;
  if (dneg < one64) { return 20; }
  if (dneg <= one64) { return 21; }
  if (!(dneg >= one64)) { return 22; }
  if (!(dneg > one64)) { return 23; }
  var umax: u64 = 18446744073709551615;
  if (umax < 1) { return 24; }
  if (umax <= 1) { return 25; }
  if (!(umax > 1)) { return 26; }
  if (!(umax >= 1)) { return 27; }
  var zero64: u64 = 0;
  if (umax < zero64) { return 28; }
  if (!(zero64 < umax)) { return 29; }
  return 0;
}
