func main() -> int {
    var x: float = 1.5;
    var a: u8  = x as u8;
    var b: u16 = x as u16;
    var c: u32 = x as u32;
    var d: u64 = x as u64;
    var e: i8  = x as i8;
    var i: int = x as int;
    if ((a as int) != 1) { return 11; }
    if ((b as int) != 1) { return 12; }
    if ((c as int) != 1) { return 13; }
    if ((d as int) != 1) { return 14; }
    if ((e as int) != 1) { return 15; }
    if (i != 1) { return 16; }
    return 0;
}
