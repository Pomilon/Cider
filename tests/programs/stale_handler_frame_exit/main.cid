// CIDER-ISS-016: the handler chain is one global, so a function that
// registers a handler must clear it when its frame exits. A non-null
// pointer into a frame that already returned is exactly as undefined as a
// null one: the frame is gone and its jmp_buf region has been recycled, so
// a later throw jumps through the dead pointer.
//
// This program walks the ways a try body can be left with a handler still
// installed — a return from the body, a nested try, and a try inside a loop
// the frame returns out of — and then throws with no try of its own in
// scope. All three backends (VM unopt, VM optim, native) must take the
// defined uncaught path: stderr "vm error: uncaught exception", exit 2.
// stale_handler_still_catches pins that a real try after a callee released
// its handler still catches.
from std.io import print;

// Returns from inside the try BODY: the naive path leaves the body handler
// installed on return.
func retFromBody() -> int {
    try {
        return 1;
    } catch (e) {
        return 2;
    }
}

// Nested tries, returned through the inner body: both handlers are live.
func nestedRet() -> int {
    try {
        try {
            return 4;
        } catch (e) {
            return 5;
        }
    } catch (e2) {
        return 6;
    }
    return 7;
}

// A try inside a loop, with the loop left by a return: the handler is
// installed per iteration, and the frame dies with one still installed.
func loopRet() -> int {
    var i: int = 0;
    while (i < 3) {
        try {
            i = i + 1;
            if (i == 2) { return i; }
        } catch (e) {
            return 8;
        }
    }
    return 0;
}

func main() -> int {
    if (retFromBody() != 1) { return 96; }
    if (nestedRet() != 4) { return 97; }
    if (loopRet() != 2) { return 98; }
    print("stale-ok;");
    // No try is in scope here. Any handler pointer still held from one of
    // the calls above addresses a returned frame, so this throw is the
    // uncaught case on every backend.
    throw 1;
    return 0;
}
