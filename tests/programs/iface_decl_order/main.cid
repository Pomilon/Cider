// CIDER-BUG-209: DECLARATION ORDER must not decide whether a type implements
// an interface.
//
// Root cause: the collector resolved the "this names an interface, so it is
// the 16-byte fat pointer" flag on every collected method signature EAGERLY,
// at the declaration. `interface I { func m() -> Shape; }` with
// `interface Shape` BELOW it could not resolve then, so I's `m` return kept
// isInterface=false, while the implementor's `m` return — collected after
// Shape — carried true. isInterface is part of TypeInfo's identity
// (TypeInfo::operator==), so the checker's interface-satisfaction comparison
// (checkInterfaceValue) saw two different types and rejected a genuine
// implementor with "Type 'Impl' does not implement interface 'I': missing
// method 'm'". The implementor-first order failed the same way with the two
// sides swapped, and a by-value STRUCT return declared below was never
// affected (it carries no flag), which is what made the failure look specific
// to interfaces instead of to declaration order. Only when BOTH sides were
// collected before the interface did the pair happen to match — which is why
// the defect was invisible in every existing program.
//
// The fix re-resolves every recorded method signature once the whole program
// and its imports are collected (the same second pass the CIDER-BUG-105 layout
// finalize already runs), so the flag no longer depends on where the interface
// was written. The two order-independent orders are pinned here too, so the
// re-resolution is shown not to disturb them, and the rejection of a genuinely
// missing method is pinned by tests/fixtures/check_iface_decl_order.
//
// This program pins the result on all three backends (VM unoptimized, VM
// optimized, native):
//   * the interface declared BEFORE the interface it returns, and the
//     implementor declared BEFORE the interface — both failure orders
//   * an interface-typed PARAMETER declared below, and an alias spelling of a
//     below-declared interface
//   * a self-referential interface method return (`-> Maker` inside `Maker`),
//     a name that is not even defined while its own declaration is collected
//   * a by-value STRUCT return declared below, the shape that never had a flag
//   * two implementors, so the dispatch is really re-targeted per call
//   * the interface-to-interface projection path in the same order
//   * the same shapes again across a module boundary (lib.cid), where the
//     interface is declared before the interface it returns
// Every check returns a distinct non-zero code, so a failure names the shape
// that broke.
//
// Every interface-typed return here hands back either a LOCAL concrete value
// (boxed per CIDER-BUG-184/212) or an interface-typed field. Returning a
// GLOBAL concrete implementor through an interface-typed method is a
// separate, order-independent pre-existing miscompile (it crashes on the
// unmodified compiler too), so it is deliberately kept out of this program.
import lib;
from std.io import print, printInt;

// ---------------------------------------------------------------- order A ---
// The interface comes FIRST; every type its signatures name is declared
// below it. `Maker.self` returns `Maker` itself: the name is not defined even
// while Maker's own declaration is being collected.
interface Maker {
    func make() -> Shape;
    func take(s: Shape) -> int;
    func viaAlias() -> S;
    func cell() -> Box;
    func self() -> Maker;
}

// The four below-declared return types, and the implementors.
interface Shape {
    func area() -> int;
    func label() -> int;
}

interface Box {
    func unwrap() -> Shape;
    func pack(s: Shape) -> int;
}

type S = Shape;

// A plain struct: a by-value aggregate return declared below the interface.
// This shape never carried a flag, so it is the control that must be
// unaffected by the re-resolution.
struct Later {
    var lo: int;
    var hi: int;
}

interface StructMaker {
    func make(n: int) -> Later;
}

class Sq {
    var s: int;
    func area() -> int { return this.s * this.s; }
    func label() -> int { return 1; }
}

class Rect {
    var w: int;
    var h: int;
    func area() -> int { return this.w * this.h; }
    func label() -> int { return 2; }
}

class BoxA {
    var n: int;
    func init(x: int) -> void { this.n = x; }
    func unwrap() -> Shape {
        var q: Sq;
        q.s = this.n;
        return q;
    }
    func pack(s: Shape) -> int { return s.area() * 10 + s.label(); }
}

class MakerA {
    var p: int;
    // The self-return hands back an interface-typed field, never a global.
    var alias: Maker;
    func init(x: int) -> void { this.p = x; }
    func make() -> Shape {
        var q: Sq;
        q.s = this.p;
        return q;
    }
    func take(s: Shape) -> int { return s.area() + s.label(); }
    func viaAlias() -> S {
        var r: Rect;
        r.w = this.p;
        r.h = this.p + 1;
        return r;
    }
    func cell() -> Box {
        var b: BoxA;
        b.init(this.p);
        return b;
    }
    func self() -> Maker { return this.alias; }
}

class MakerB {
    var p: int;
    var alias: Maker;
    func init(x: int) -> void { this.p = x; }
    func make() -> Shape {
        var r: Rect;
        r.w = this.p;
        r.h = this.p + 1;
        return r;
    }
    func take(s: Shape) -> int { return s.area() * 2; }
    func viaAlias() -> S {
        var q: Sq;
        q.s = this.p;
        return q;
    }
    func cell() -> Box {
        var b: BoxA;
        b.init(this.p + 1);
        return b;
    }
    func self() -> Maker { return this.alias; }
}

class StructMakerA {
    var p: int;
    func init(x: int) -> void { this.p = x; }
    func make(n: int) -> Later {
        var r: Later;
        r.lo = n;
        r.hi = n + this.p;
        return r;
    }
}

// ---------------------------------------------------------------- order B ---
// The mirror image: the IMPLEMENTOR is declared first, and the interface it
// implements (and the interface its method returns) come after it. Here the
// class-side signature is the stale one and the interface side is correct.
class Early {
    var p: int;
    func init(x: int) -> void { this.p = x; }
    func kind() -> int { return this.p; }
    func render() -> Late { return this; }
}

class EarlyBox {
    var p: int;
    func init(x: int) -> void { this.p = x; }
    // EarlyBox implements Late too, so `unwrap() -> Late` is a
    // class-side-signature whose return interface is declared later.
    func kind() -> int { return this.p; }
    func render() -> Late { return this; }
    func unwrap() -> Late { return this; }
}

interface Late {
    func kind() -> int;
    func render() -> Late;
}

interface LateBox {
    func unwrap() -> Late;
}

// ---------------------------------------------------------------- order C ---
// BOTH sides collected before the interface. This order already worked (both
// flags stale, so they matched) and must keep working: it is what hid the
// defect, and the re-resolution must not disturb it.
interface BothFirst {
    func probe() -> BothTarget;
}

class BothImpl {
    func probe() -> BothTarget {
        var t: TargetImpl;
        t.init(4);
        return t;
    }
}

interface BothTarget {
    func mark() -> int;
}

class TargetImpl {
    var t: int;
    func init(x: int) -> void { this.t = x; }
    func mark() -> int { return this.t; }
}

func main() -> int {
    // --- order A: interface first, everything it names below -------------
    var a: MakerA;
    a.init(3);
    var b: MakerB;
    b.init(4);
    a.alias = a;
    b.alias = b;
    var m: Maker = a;
    var m2: Maker = b;

    if (m.make().area() != 9) { return 1; }
    if (m.make().label() != 1) { return 2; }
    if (m2.make().area() != 20) { return 3; }
    if (m2.make().label() != 2) { return 4; }

    // A dispatch whose result is dispatched again: the return is a fat
    // pointer that must survive the second call.
    if (m.cell().unwrap().area() != 9) { return 5; }
    if (m2.cell().unwrap().area() != 25) { return 6; }

    // The below-declared interface-typed PARAMETER.
    if (m.take(m.make()) != 10) { return 7; }
    if (m2.take(m2.make()) != 40) { return 8; }
    // A concrete value passed to a below-declared interface parameter, and
    // an interface passed to another below-declared interface parameter.
    if (m2.take(m.make()) != 18) { return 9; }
    if (m.cell().pack(m.make()) != 91) { return 10; }
    if (m2.cell().pack(m2.make()) != 202) { return 11; }

    // The alias spelling of a below-declared interface.
    if (m.viaAlias().area() != 12) { return 12; }
    if (m2.viaAlias().area() != 16) { return 13; }
    if (m.viaAlias().label() != 2) { return 14; }

    // The self-referential return, through the interface twice.
    if (m.self().make().area() != 9) { return 15; }
    if (m2.self().make().area() != 20) { return 16; }
    if (m.self().self().make().area() != 9) { return 34; }

    // The below-declared STRUCT return: the control that always worked.
    var sm: StructMakerA;
    sm.init(10);
    var smi: StructMaker = sm;
    var lr: Later = smi.make(6);
    if (lr.lo != 6 || lr.hi != 16) { return 17; }
    lr.lo = 60;
    var lr2: Later = smi.make(6);
    if (lr2.lo != 6 || lr2.hi != 16) { return 18; }

    // The projection path: interface to interface, both declared before their
    // return types.
    var bb: Box = m.cell();
    var bb2: Box = bb;
    if (bb2.unwrap().area() != 9) { return 19; }

    // --- order B: implementor first, interface after ----------------------
    var e: Early;
    e.init(7);
    var l: Late = e;
    if (l.kind() != 7) { return 20; }
    if (l.render().kind() != 7) { return 21; }
    if (l.render().render().kind() != 7) { return 23; }
    var eb: EarlyBox;
    eb.init(11);
    var lb: LateBox = eb;
    if (lb.unwrap().kind() != 11) { return 22; }
    if (lb.unwrap().render().kind() != 11) { return 35; }

    // --- order C: both sides before the interface (always worked) ----------
    var bimpl: BothImpl;
    var bi: BothFirst = bimpl;
    if (bi.probe().mark() != 4) { return 24; }
    if (bi.probe().mark() != 4) { return 36; }

    // --- the same shapes across a module boundary -------------------------
    var ri: lib.RemoteImpl;
    ri.init(5);
    ri.alias = ri;
    var rmi: lib.RemoteMaker = ri;
    if (rmi.shape().area() != 25) { return 25; }
    if (rmi.shape().label() != 1) { return 26; }
    if (rmi.box().inner().area() != 25) { return 27; }
    if (rmi.consume(rmi.shape()) != 251) { return 28; }
    if (rmi.viaAlias().area() != 30) { return 29; }
    if (rmi.self().shape().area() != 25) { return 30; }
    var rlr: lib.RemoteLater = rmi.structBack(8);
    if (rlr.lo != 8 || rlr.hi != 13) { return 31; }

    // The order that already worked, across the same boundary.
    var lbi: lib.LateFirst = ri;
    if (lbi.wrap().mark() != 2) { return 32; }
    // `depth()` stays a declared signature of the below-declared RemoteBox
    // (it takes part in the satisfaction check above) but is not dispatched
    // through: it would need a nil-safe interface field on the box.

    print("iface_decl_order_ok\n");
    return 0;
}
