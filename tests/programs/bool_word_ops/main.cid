// CIDER-BUG-046: the word spellings `and`/`or`/`not` must be real boolean
// operators — same truth tables, bool typing (castable to int), precedence
// and short-circuit evaluation as `&&`/`||`/`!`.
from std.io import print, puts, printInt, exit;

var bumps: int = 0;

func bump() -> bool {
    bumps = bumps + 1;
    return true;
}

func expect(name: string, got: int, want: int) -> void {
    print(name);
    print(" = ");
    printInt(got);
    if (got != want) {
        print(" (want ");
        printInt(want);
        puts(") FAIL");
        exit(1);
    }
    puts("");
}

func main() -> int {
    var t: bool = true;
    var f: bool = false;

    // Truth tables, all four corners each.
    expect("true and true", (t and t) as int, 1);
    expect("true and false", (t and f) as int, 0);
    expect("false and true", (f and t) as int, 0);
    expect("false and false", (f and f) as int, 0);
    expect("true or true", (t or t) as int, 1);
    expect("true or false", (t or f) as int, 1);
    expect("false or true", (f or t) as int, 1);
    expect("false or false", (f or f) as int, 0);

    // `not` is a real boolean negation, not the identity.
    expect("not true", (not t) as int, 0);
    expect("not false", (not f) as int, 1);
    expect("not not true", (not (not t)) as int, 1);

    // Short-circuit: `false and X` / `true or X` must not evaluate X.
    bumps = 0;
    var r1: bool = false and bump();
    expect("false and bump()", r1 as int, 0);
    expect("false and bump() bumps", bumps, 0);

    bumps = 0;
    var r2: bool = true or bump();
    expect("true or bump()", r2 as int, 1);
    expect("true or bump() bumps", bumps, 0);

    // ...while the evaluating side still runs, and its result survives the
    // merge. (CIDER-BUG-064: the inliner used to leave this merged value 0.)
    bumps = 0;
    var r3: bool = true and bump();
    expect("true and bump()", r3 as int, 1);
    expect("true and bump() bumps", bumps, 1);

    bumps = 0;
    var r4: bool = false or bump();
    expect("false or bump()", r4 as int, 1);
    expect("false or bump() bumps", bumps, 1);

    // Precedence: `and` binds tighter than `or`, so this is
    // `true or (false and false)` = true, not `(true or false) and false`.
    var a: bool = true;
    var b: bool = false;
    var c: bool = false;
    expect("true or false and false", (a or b and c) as int, 1);

    // Precedence: `not` binds tighter than `or`, so this is
    // `(not false) or true` = true, not `not (false or true)` = false.
    expect("not false or true", (not b or t) as int, 1);

    puts("PASS: word boolean operators");
    return 0;
}
