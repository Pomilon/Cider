// CIDER-BUG-137 regression: one ownership rule for the compiler-created
// class-valued temporaries (by-value parameters, by-value returns/sret)
// plus program-exit finalization of module-scope globals.
//
// The ownership rule pinned by this test:
//   * A by-value class/struct PARAMETER is the callee's OWN copy: callers
//     pass the source address and the prologue memcpys into the parameter
//     slot. It is finalized at callee-scope exit, LIFO with the body's
//     locals and, among parameters, last-declared first.
//   * A by-value RETURN slot (the hidden sret pointer, the legacy heap path
//     a non-sret aggregate return uses, and the custom iterator protocol's
//     `iter()` result) is the CALLER's OWN temporary. It is finalized at
//     the exit of the caller's enclosing scope, after every use of the
//     result, LIFO with the caller's locals: a local the temporary
//     initialized is destroyed first (it registered first and the scope
//     unwinds in reverse registration order).
//   * A temporary created by a loop condition or increment, by the
//     right-hand side of `&&`/`||`, or by a scalar-valued `?:` arm
//     finalizes at the end of that evaluation, not at the enclosing
//     scope's exit: the slot is written on every iteration (or only on one
//     control-flow path), so only the per-evaluation scope can reach it
//     exactly once.
//   * Module-scope globals with embedded class destructors are finalized
//     at PROGRAM EXIT in reverse construction order (last declared first;
//     own destructor before embedded values, arrays last index first).
//     Whole-program builds call one synthesized `_cider_global_fini` from
//     every entry return; in separate compilation the entry object calls
//     each module's fini once, in reverse construction order (see
//     separate_compilation_smoke.sh).
//
// Within one object the order stays the CIDER-BUG-088 rule: the class's
// own destructor runs first (its body may read the subobjects), then every
// embedded class value in reverse construction order (declaration order,
// arrays last element first, structs/classes recursing).
//
// All three backends (VM unopt, VM optim, native) must agree on the trace.
from std.io import print, printInt;

var drops: int = 0;

// Every Dropper prints its label from its destructor, so the trace is the
// destruction order; `drops` counts the calls so a missing or duplicated
// finalizer is caught even when labels coincide.
class D {
    var label: int;
    func ~D() {
        drops = drops + 1;
        printInt(this.label);
        print(",");
    }
}

struct SD {
    var d: D;
}

class GHolder {
    var a: D;
    var b: D;
    func ~GHolder() {
        drops = drops + 1;
        print("G,");
    }
}

struct GSW {
    var d: D;
    var pad: int;
}

// CIDER-BUG-137: the custom iterator protocol's `iter()` returns its object
// by value (sret), so the iterator is a caller-owned temporary too. Declared
// before its class: `next()` reads it, and it must exist when the method
// body is generated.
var iarr: [D; 2];

class Iter {
    var i: int;
    var n: int;
    func ~Iter() {
        drops = drops + 1;
        print("I,");
    }
    func iter() -> Iter {
        var it: Iter;
        it.n = 2;
        return it;
    }   // I: iter()'s own local dies on return
    func next() -> *D {
        if (this.i >= this.n) { return nilPtr; }
        var p: *D = &iarr[this.i];
        this.i = this.i + 1;
        return p;
    }
}

// --- by-value parameters -------------------------------------------------

func takeOne(x: D) -> void {
    x.label = 10;
    print("T,");
}   // T,10,  (callee's copy finalizes at callee exit)

func takeTwo(x: D, y: SD) -> void {
    x.label = 20;
    y.d.label = 21;
    print("U,");
}   // U,21,20,  (parameters reverse: y's member, then x)

func takeWithLocal(x: D) -> void {
    var local: D;
    local.label = 30;
    x.label = 31;
    print("V,");
}   // V,30,31,  (locals first, then parameters)

func earlyReturn(x: D) -> int {
    x.label = 12;
    if (x.label > 0) {
        print("W,");
        return 1;
    }
    return 0;
}   // W,12,  (the callee's copy dies on every return path)

// --- by-value returns ----------------------------------------------------

func mk(n: int) -> D {
    var d: D;
    d.label = n;
    return d;
}   // n,  (mk's local dies on return)

func wrap(n: int) -> D {
    var r: D = mk(n);      // n: mk's local; then n again at wrap's exit (temp)
    r.label = n + 1;
    return r;
}   // n,n,n+1 for wrap(50): 50,50,51

func mk50() -> D {
    return mk(50);
}   // 50,50  (mk's local, then mk50's own returned temporary)

// --- loop / short-circuit evaluation scopes ------------------------------

func tag(n: int) -> D {
    var d: D;
    d.label = n;
    return d;
}   // n,

func loopCond() -> void {
    var i: int = 0;
    while (tag(70 + i).label > 0) {
        print("w,");
        i = i + 1;
        if (i == 2) { break; }
    }
    print("X,");
}   // 70,70,w,71,71,w,X,  (each condition's temp dies with its evaluation)

func forInc() -> void {
    var i: int = 0;
    for (; i < 2; tag(80 + i)) {
        i = i + 1;
    }
    print("Y,");
}   // 81,81,82,82,Y,  (the body's increment runs first, so the first
    // increment expression sees i == 1; each temp dies with its evaluation)

func shortCircuit() -> void {
    var f: bool = false;
    if (f && tag(90).label > 0) { print("bad,"); }
    if (!f && tag(91).label > 0) { print("z,"); }
    print("Z,");
}   // 91,91,z,Z,: tag's local, then its RHS temp, both before the branch;
    // the short-circuited path creates no temp at all

func ternaryArm() -> void {
    var c: bool = true;
    var v: int = c ? tag(95).label : 0;
    printInt(v);
    print(",");
}   // 95,95,95,: tag's local, the arm's temp at the arm's end, then v

func foreachIterator() -> void {
    iarr[0].label = 96;
    iarr[1].label = 97;
    print("Q,");
    var it: Iter;
    for (var x in it) {
        print("q,");
    }
    print("R,");
}   // Q,I,q,96,q,97,R,I,I: iter()'s local, the per-iteration copies, then
    // (at this function's exit) the returned iterator temp and the local

// --- module-scope globals (finalized at program exit) ---------------------

var g1: D;                       // 60
var gs: GSW;                     // 61 embedded struct
var gh: GHolder;                 // G,63,62: own dtor first, then b then a
var garr: [D; 2];                // 65,64: last element first
var gp: *D;                      // pointer: owns nothing, never finalized

func main() -> int {
    var x: D;
    x.label = 1;
    takeOne(x);                  // T,10,
    print("A,");

    var sd: SD;
    sd.d.label = 2;
    takeTwo(x, sd);              // U,21,20,
    print("B,");

    takeWithLocal(x);            // V,30,31,
    print("C,");
    if (earlyReturn(x) != 1) { return 1; }   // W,12,
    print("C2,");

    mk(40);                      // temp dies at main's exit
    print("D,");
    var x2: D = mk(41);          // 41 on return; x2's copy dies at exit after it
    x2.label = 42;
    print("E,");
    var w: D = wrap(50);         // 50 (mk local), 50 (wrap temp), 51 (wrap local)
    w.label = 52;
    print("F,");
    takeOne(mk(100));            // 100 (mk local), 10 (param relabelled), 100 (main temp)
    print("G,");
    var mw: D = mk50();          // 50,50 (mk50 body), then mw's copy at exit
    mw.label = 53;
    print("H,");

    loopCond();
    forInc();
    shortCircuit();
    ternaryArm();
    foreachIterator();

    printInt(drops);
    print("!\n");
    if (drops != 32) { return 1; }   // before main's exit and the global fini

    g1.label = 60;
    gs.d.label = 61;
    gs.pad = 600;
    gh.a.label = 62;
    gh.b.label = 63;
    garr[0].label = 64;
    garr[1].label = 65;
    gp = &g1;                    // a pointer never extends ownership
    print("main_end\n");
    return 0;
}
// Expected destruction after main's `return 0`:
//   main scope (reverse registration): 50 (mk50's returned temp), 53 (mw),
//               100 (takeOne(mk(100)) temp), 51 (wrap's temp), 52 (w),
//               41 (x2's temp), 42 (x2), 40 (mk(40) temp), 2 (sd), 1 (x)
//   program exit (reverse construction): 65, 64, G, 63, 62, 61, 60, 97, 96
// `drops` reaches 32 before main's return, 42 after main's scope, 51 after
// the global fini pass.
