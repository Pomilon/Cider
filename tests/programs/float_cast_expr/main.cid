var g_adv: float = 10.0;

func kern(ch: int, next: int) -> int {
  return ch * 3 + next;
}

func str_width(n: int, size: float) -> int {
  var width: int = 0;
  var i: int = 0;
  var scale: float = size * 0.5;
  while (i < n) {
    var ch: int = i + 65;
    width = width + (g_adv as float * scale) as int;
    if (i + 1 < n) {
      width = width + (scale * (kern(ch, i + 1) as float)) as int;
    }
    i = i + 1;
  }
  return width;
}

func main() -> int {
  var r: int = str_width(3, 4.0);
  if (r != 852) { return 1; }
  return 0;
}
