// CIDER-BUG-108 regression: loop-scope finalizer timing.
//
//   * `for (var x: C; ...)` header declarations belong to the for
//     statement's scope: their finalizer runs once, at the for-scope exit
//     (condition false, `break`, or `return` inside the body), before the
//     statement after the loop — not at the enclosing block's exit.
//     `continue` jumps to the increment block inside the loop, so the
//     header variable survives across iterations and is destroyed once.
//   * a `for (var x in ...)` iteration variable is a fresh copy of the
//     element, so it finalizes at the end of each iteration (before a
//     `continue`/`break` jump too), for array/slice elements and for the
//     custom iter()/next() iterator protocol.
//
// All three backends (VM unopt, VM optimized, native).
from std.io import print, printInt;

var drops: int = 0;

class D {
    var label: int;
    func ~D() {
        drops = drops + 1;
        printInt(this.label);
        print(",");
    }
}

class Pair {
    var a: D;
    var b: D;
}

func forNormal() -> void {
    print("A,");
    for (var x: D; false; ) { }
    print("B,");              // A,0,B,  (destroyed at the for exit)
}

func forBreak() -> void {
    print("C,");
    var i: int = 0;
    for (var x: D; i < 5; i = i + 1) {
        x.label = 10 + i;
        if (i == 1) { break; }
    }
    print("D,");              // C,11,D,  (once, at the break's target)
}

func forContinue() -> void {
    print("E,");
    var i: int = 0;
    for (var x: D; i < 3; i = i + 1) {
        x.label = 20 + i;
        if (i == 1) { continue; }
    }
    print("F,");              // E,22,F,  (continue must not destroy it early)
}

func forReturn() -> int {
    print("G,");
    for (var x: D; true; ) {
        x.label = 30;
        return 1;             // G,30,H,  (return finalizes the header var)
    }
    return 0;
}

func forNested() -> void {
    print("I,");
    for (var x: D; true; ) {
        x.label = 40;
        for (var y: D; true; ) {
            y.label = 41;
            break;            // inner header var dies at the inner exit
        }
        break;                // then the outer one at the outer exit
    }
    print("J,");              // I,41,40,J,
}

func forAggregate() -> void {
    print("K,");
    var i: int = 0;
    for (var p: Pair; i < 1; i = i + 1) {
        p.a.label = 50;
        p.b.label = 51;
    }
    print("L,");              // K,51,50,L,  (members reversed)
}

func foreachArray() -> void {
    var a: [D; 3];
    a[0].label = 60;
    a[1].label = 61;
    a[2].label = 62;
    print("M,");
    for (var x in a) {
        print("m,");
    }
    print("N,");              // M,m,60,m,61,m,62,N, then 62,61,60 at exit
}

func foreachControl() -> void {
    var a: [D; 3];
    a[0].label = 70;
    a[1].label = 71;
    a[2].label = 72;
    print("O,");
    for (var x in a) {
        print("o,");
        if (x.label == 71) { continue; }
        if (x.label == 72) { break; }
    }
    print("P,");              // O,o,70,o,71,o,72,P, then 72,71,70 at exit
}

func foreachPair() -> void {
    var a: [Pair; 2];
    a[0].a.label = 80;
    a[0].b.label = 81;
    a[1].a.label = 82;
    a[1].b.label = 83;
    print("Q,");
    for (var x in a) {
        print("q,");
    }
    print("R,");              // Q,q,81,80,q,83,82,R, then 83,82,81,80 at exit
}

// Custom iterator protocol: the loop variable is a copy of the *D element,
// so each iteration finalizes it. The iterator object itself embeds no class
// values, keeping the trace focused.
var garr: [D; 2];

class Iter {
    var i: int;
    var n: int;
    func iter() -> Iter {
        var it: Iter;
        it.i = 0;
        it.n = 2;
        return it;
    }
    func next() -> *D {
        if (this.i >= this.n) { return nilPtr; }
        var p: *D = &garr[this.i];
        this.i = this.i + 1;
        return p;
    }
}

func foreachIterator() -> void {
    garr[0].label = 90;
    garr[1].label = 91;
    print("S,");
    var it: Iter;
    for (var x in it) {
        print("s,");
    }
    print("T,");              // S,s,90,s,91,T,  (copies per iteration)
}

func main() -> int {
    forNormal();
    forBreak();
    forContinue();
    var r: int = forReturn();
    if (r != 1) { return 1; }
    forNested();
    forAggregate();
    foreachArray();
    foreachControl();
    foreachPair();
    foreachIterator();
    print("\n");
    if (drops != 30) { return 2; }
    print("loop_scope_destructors_ok\n");
    return 0;
}
