var g_u8: u8 = 0;
var g_next: u64 = 0;
var g_u16: u16 = 0;
var g_phys: u64 = 0;
var g_count: int = 0;
var g_flag: bool = false;

func main() -> int {
  g_next = 12345678;
  g_u8 = 200;
  if (g_next != 12345678) { return 1; }
  if (g_u8 != 200) { return 2; }
  g_phys = 987654321;
  g_u16 = 50000;
  if (g_phys != 987654321) { return 3; }
  if (g_u16 != 50000) { return 4; }
  g_flag = true;
  g_count = 12345;
  if (g_flag != true) { return 5; }
  if (g_count != 12345) { return 6; }
  return 0;
}
