// CIDER-BUG-057: a slice copy into a fixed array must have a matching
// element count when the bounds are compile-time constants, and matching
// element types. Dynamic bounds stay accepted (the target size governs).
func main() -> int {
    const SZ: int = 2;
    var a: [u8; 5];

    var under: [u8; 3] = a[1:3];
    var over: [u8; 3] = a[0:5];
    var head: [u8; 2] = a[:3];
    var tail: [u8; 2] = a[2:];
    var wrongElem: [int; 2] = a[1:3];
    var c: [u8; 3] = a[1:1 + SZ];

    var s: [u8; 3];
    s = a[1:3];
    return 0;
}
