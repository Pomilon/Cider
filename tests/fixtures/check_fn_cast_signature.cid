// CIDER-BUG-074: a cast to a func(...)/fn(...) type must keep the exact
// signature. The target spelling fixes what every later call uses (arity,
// parameter types, return type, ABI), so a mismatched source signature must
// be rejected instead of being invoked with the target's conventions.
func add1(x: int) -> int { return x + 1; }
func retInt() -> int { return 7; }
func id(x: int) -> int { return x; }

func main() -> int {
  // Arity mismatch: one parameter cast to a two-parameter spelling.
  var a: fn(int, int) -> int = add1 as fn(int, int) -> int;
  // Return-type mismatch.
  var b: fn() -> *void = retInt as fn() -> *void;
  // Parameter-type mismatch.
  var c: fn(f64) -> int = id as fn(f64) -> int;
  // ABI mismatch: plain function cast to the msabi spelling.
  var d: msabi fn(int) -> int = add1 as msabi fn(int) -> int;
  // The legacy closure spelling takes the same signature rule.
  var e: fn(int, int) -> int = func(x: int) -> int { return x; } as fn(int, int) -> int;
  return 0;
}
