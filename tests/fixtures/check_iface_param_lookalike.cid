// CIDER-BUG-128: the look-alike rejection the cross-module canonical
// comparison must keep. iface_lookalike_lib.cid declares
// `Shape.draw(p: Param)` with ITS OWN Param; this file declares an
// unrelated Param (same spelling, other module) and classes whose draw
// takes it. The spellings are identical, so the old raw comparison
// accepted them and built vtables whose signatures never matched the
// interface's — dispatch would marshal lib's struct layout into this
// file's. Both must be rejected with the normal interface diagnostic:
// bare spelling, and through a `type` alias of the local Param.
import iface_lookalike_lib;
from iface_lookalike_lib import Shape;

struct Param {
  var a: int;
  var b: int;
  var c: int;
}

type MP = Param;

// Same-spelled parameter type: looks like the interface's, is another
// type entirely.
class LookAlike {
  var id: int;
  func draw(p: Param) -> int { return p.a + p.b + p.c; }
}

// The same wrong type reached through a local alias.
class AliasedLookAlike {
  var id: int;
  func draw(p: MP) -> int { return p.a; }
}

func main() -> int {
  var c: LookAlike;
  var s: Shape = c;
  var d: AliasedLookAlike;
  s = d;
  return 0;
}
