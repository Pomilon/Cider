// CIDER-BUG-209: the cross-module half of the fix, and the CIDER-BUG-128
// look-alike rejection it must not weaken.
//
// iface_decl_order_lib declares `Shape` BEFORE the interface its `make()`
// method returns (`Deep`, below it in that module), so `Shape.make`'s return
// type was unresolvable while Shape's declaration was collected. The
// second-pass re-resolution flags it as the fat pointer it is — and the
// comparison that flag feeds must STILL distinguish two same-spelled
// interfaces declared in different modules. The classes below have `make()`
// returning THIS file's `Deep`, which is not lib's `Deep`, so both are
// rejected with the ordinary missing-method diagnostic. Before the fix the
// lib side was unflagged and these were rejected for a second, accidental
// reason; after it they are rejected for the right one, with the same text.
import iface_decl_order_lib;
from iface_decl_order_lib import Shape;

struct Param {
  var v: int;
  var w: int;
}

type P = Param;

// This file's own interfaces, spelled exactly like lib's.
interface Deep {
  func level() -> int;
}

class Local {
  var d: int;
  func level() -> int { return this.d; }
}

// Right shape, wrong identity: `draw` takes this file's Param, and `make`
// returns this file's Deep.
class LookAlike {
  var id: int;
  func draw(p: Param) -> int { return p.v + p.w; }
  func make() -> Deep {
    var l: Local;
    l.d = 2;
    return l;
  }
}

// The same wrong types reached through a local alias.
class AliasedLookAlike {
  var id: int;
  func draw(p: P) -> int { return p.v; }
  func make() -> Deep {
    var l: Local;
    l.d = 3;
    return l;
  }
}

// Only `make` is wrong here: `draw` matches lib's Param exactly, so the
// diagnostic must name `make` and not `draw`.
class OnlyMakeWrong {
  var id: int;
  func draw(p: iface_decl_order_lib.Param) -> int { return p.v; }
  func make() -> Deep {
    var l: Local;
    l.d = 4;
    return l;
  }
}

func main() -> int {
  var r: iface_decl_order_lib.RealImpl;
  // The genuine implementor: still accepted (no diagnostic for it below).
  var s: Shape = r;
  if (s.draw(libParam(5)) != 5) { return 1; }
  if (s.make().level() != 4) { return 2; }

  var la: LookAlike;
  var ala: AliasedLookAlike;
  var omw: OnlyMakeWrong;
  s = la;
  s = ala;
  s = omw;
  return 0;
}

func libParam(v: int) -> iface_decl_order_lib.Param {
  var p: iface_decl_order_lib.Param;
  p.v = v;
  return p;
}
