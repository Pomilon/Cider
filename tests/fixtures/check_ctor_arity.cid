// CIDER-FEAT-003: constructor arity is checked in both directions: a
// constructor with parameters called without them (`new C`) and with the
// wrong number of arguments.
class C {
  var x: int;
  func init(a: int) -> void { this.x = a; }
}

func main() -> int {
  var a: *C = new C;
  var b: *C = new C(1, 2);
  return 0;
}
