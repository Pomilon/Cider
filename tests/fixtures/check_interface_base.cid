// CIDER-BUG-122: an interface is not a class, so `extends SomeInterface`
// must be diagnosed rather than silently inheriting nothing.
interface I {
  func area() -> int;
}

type IA = I;

class A extends I {
  var a: int = 2;
}

class B extends IA {
  var b: int = 3;
}

func main() -> int { return 0; }
