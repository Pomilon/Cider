// CIDER-FEAT-003: an explicit `super(...)` call is not implemented, so
// there is no way to pass arguments to a base constructor — a base
// constructor declaring parameters is not auto-invoked (CIDER-BUG-123 chains
// only the zero-parameter ones). Report the attempt specifically instead of
// silently ignoring it.
class Base {
  var b: int;
  func init(v: int) -> void { this.b = v; }
}

class Child extends Base {
  var c: int;
  func init() -> void { super(1); }
}

func main() -> int { return 0; }
