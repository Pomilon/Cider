// CIDER-BUG-238: the rejections a from-imported concrete-to-interface store
// must KEEP making. The store is accepted now (see the
// crossmod_iface_global_fromstore program), so every rule the accepted path
// runs has to be pinned in the rejected direction too — otherwise "the
// declared type was recovered" alone would be the whole test.
//
// iface_global_store_lib.cid declares `Store.draw(p: Param)` with ITS OWN
// Param, and exports an interface-typed global `gStore`. This file declares
// an unrelated Param (identical spelling, other module) plus a class whose
// draw takes it, and a class missing `draw` altogether, then reaches the
// global through a `from`-import ALIAS. All three must be rejected with the
// ordinary interface diagnostic against lib's CANONICAL interface name — the
// same cross-module canonical comparison the bare declaration and the
// module-qualified spelling run (CIDER-BUG-128), never accepted on the
// strength of the shared spelling. The last one is a non-exported global,
// which no spelling may reach (CIDER-BUG-060).
import iface_global_store_lib;
from iface_global_store_lib import gStore;

struct Param {
  var a: int;
  var b: int;
  var c: int;
}

class LookAlike {
  var id: int;
  func draw(p: Param) -> int { return p.a + p.b + p.c; }
}

// The interface's shape, but a method it does not declare.
class Missing {
  var id: int;
  func o() -> int { return this.id; }
}

func main() -> int {
  var la: LookAlike;
  var mi: Missing;
  gStore = la;
  gStore = mi;
  return 0;
}
