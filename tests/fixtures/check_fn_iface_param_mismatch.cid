// CIDER-BUG-085: resolving the interface flag inside a fn(...) spelling must
// not blur the signature. `fn(int) -> int` and `fn(I) -> int` differ by the
// parameter's nominal, so the assignment stays rejected.
interface I { func v() -> int; }

func named(x: I) -> int { return x.v(); }

func main() -> int {
  var f: fn(int) -> int = named;
  return 0;
}
