// CIDER-BUG-243 module half of the look-alike / visibility fixture: an
// interface-typed global declared BEFORE its interface (and one declared before
// an alias chain to it), so the fixture pins the rejections for the
// declaration order that cannot be resolved eagerly — plus a NON-exported
// one, which no spelling may reach (CIDER-BUG-060).
//
// The globals are declared first on purpose: the eager collector pass has no
// interface to resolve them against, so the flag comes from the post-collection
// pass. A look-alike implementor must still be rejected against the CANONICAL
// cross-module interface identity (CIDER-BUG-128) rather than accepted on the
// strength of the shared `DParam` spelling.
export struct DParam {
  var v: int;
}

export var gEarly: Draw;
export var gAlias: DDraw;
export type DDraw = Draw;

export interface Draw {
  func draw(p: DParam) -> int;
}

export class RealImpl {
  var t: int;
  func draw(p: DParam) -> int { return p.v * 10 + this.t; }
}

// Not exported: no spelling may reach it, whatever the value satisfies.
var gHidden: Draw;
