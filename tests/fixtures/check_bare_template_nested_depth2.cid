// CIDER-BUG-168: the argument walk recurses, so an unknown template below a
// known one that is itself below a known one is reported at the same
// declaration. Both `Tag` levels are known, so the silent path used to reach
// the innermost `Nope`.
struct Tag<T> {
  var n: int;
}

type W = Tag<Tag<Nope<int>>>;

func main() -> int {
  return 0;
}
