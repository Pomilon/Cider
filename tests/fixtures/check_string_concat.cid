// CIDER-BUG-056: `+` on two string values has no concatenation
// lowering (the ADD would add addresses), so it is a checker error.
// `s + 2` interior-pointer arithmetic stays valid: tests/programs/str_ptr.
func main() -> int {
  var a: string = "a";
  var b: string = "b";
  var s: string = a + b;       // rejected
  var t: string = "c" + "d";   // rejected: same shape through literals
  a += b;                      // rejected: compound form
  return 0;
}
