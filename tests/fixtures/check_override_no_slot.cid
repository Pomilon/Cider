// CIDER-BUG-126: an `override` that cannot bind a virtual base slot must be
// rejected instead of silently staying a direct/static call. Covers the
// plain (non-virtual) base method, an unknown base method name, and a class
// with no base at all.
class PlainBase {
    func f() -> int { return 1; }
}

class PlainDerived extends PlainBase {
    override func f() -> int { return 2; }
}

class NamedBase {
    func g() -> int { return 1; }
}

class UnknownMethod extends NamedBase {
    override func h() -> int { return 2; }
}

class Orphan {
    override func k() -> int { return 3; }
}

func main() -> int { return 0; }
