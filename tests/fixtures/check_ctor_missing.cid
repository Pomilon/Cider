// CIDER-FEAT-003: `new C(args)` requires a constructor declared as
// `func init(...)` in C's own class body. Base-class constructors are not
// inherited and are not auto-invoked, so constructing a derived class with
// arguments is an error too (the diagnostic says so). `new C()` is an
// explicit constructor call, so it is also an error when C has none.
class NoCtor {
  var x: int;
}

class Base {
  var b: int;
  func init() -> void { this.b = 1; }
}

class Child extends Base {
  var c: int;
}

func main() -> int {
  var a: *NoCtor = new NoCtor(5);
  var b: *NoCtor = new NoCtor();
  var d: *Child = new Child(1);
  return 0;
}
