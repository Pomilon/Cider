// CIDER-BUG-140: typed pointers and the indirect *void carriers (fields,
// array elements, pointees) cannot launder a raw fn into the closure
// spelling. A typed pointer carries no tracked representation (only a direct
// cast chain rooted in a closure object can prove one), and a *void storage
// location is tracked on the location itself, so a cast from it is accepted
// only when that location proves a closure object — an unproven location is
// rejected conservatively. A component that received both shapes through
// *void cannot be stored into a plain fn(...) field either.

func add1(x: int) -> int { return x + 1; }

struct Ops { var f: *void; var cb: fn(int) -> int; }

func main() -> int {
  // A typed pointer stops the *void provenance.
  var p: *u8 = add1 as *u8;
  var g1: func(int) -> int = p as func(int) -> int;

  // Laundering the typed pointer through *void stays unproven.
  var g1b: func(int) -> int = (p as *void) as func(int) -> int;

  // A non-fn source spelling cannot produce a closure object either.
  var g1c: func(int) -> int = 0 as func(int) -> int;

  // A direct cast chain keeps the proof: this one is a raw pointer.
  var g2: func(int) -> int = (add1 as *u8) as func(int) -> int;

  // A *void field storing a raw fn.
  var o: Ops;
  o.f = add1;
  var g3: func(int) -> int = o.f as func(int) -> int;

  // A *void array element storing a raw fn.
  var a: [*void; 2];
  a[0] = add1;
  var g4: func(int) -> int = a[0] as func(int) -> int;

  // A *void pointee storing a raw fn.
  var slot: *void = nilPtr;
  var pp: **void = &slot;
  *pp = add1;
  var g5: func(int) -> int = (*pp) as func(int) -> int;

  // A *void field the module never stores an fn value in stays unproven and
  // is rejected conservatively.
  var o2: Ops;
  var g6: func(int) -> int = o2.f as func(int) -> int;

  // A component that received both shapes through *void cannot feed a plain
  // fn(...) field, by assignment or by struct literal.
  var v: *void = nilPtr;
  v = add1;
  v = func(x: int) -> int { return x + 1; };
  o.cb = v;
  var ol: Ops = Ops{cb: v};

  return g1(1) + g2(1) + g3(1) + g4(1) + g5(1) + g6(1);
}
