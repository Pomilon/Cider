// CIDER-BUG-077: interface-typed returns follow the same conversion rule as
// every other interface position. A satisfying class value or single
// pointer (and the same interface) is accepted; `nilPtr`, a different
// interface, a scalar, a pointer-to-pointer, an array, or a concrete type
// missing an interface method is rejected — never silently reinterpreted.
// A virtual/override method cannot return an interface (VIRTUAL_CALL has no
// hidden sret slot), and an indirect `fn(...)` call cannot either: both are
// rejected loudly instead of dispatching with the wrong convention.
interface Shape {
  func area() -> int;
}
interface Other {
  func size() -> int;
}
class Bad {
  var x: int;
}
class Good {
  var x: int;
  func area() -> int { return this.x; }
}
class Virt {
  var x: int;
  virtual func v() -> Shape { var g: Good; g.x = 1; return g; }
}

func badNil() -> Shape { return nilPtr; }
func badOther(o: Other) -> Shape { return o; }
func badInt() -> Shape { return 5; }
func badConcrete() -> Shape { var b: Bad; return b; }
func badPtrPtr() -> Shape {
  var g: Good;
  var gp: Good* = &g;
  var gpp: Good** = &gp;
  return gpp;
}
func badArray() -> Shape { var arr: [Good; 2]; return arr; }

func main() -> int {
  var cb: fn() -> Shape = badNil;
  var s: Shape = cb();
  return 0;
}
