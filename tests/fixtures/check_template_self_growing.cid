// CIDER-BUG-256: a template whose body instantiates ITSELF with a larger
// argument (`G<G<T>>`) makes the collector generate ever-longer
// instantiation names, so the active set never empties (a time/memory
// burn; historically a SIGSEGV). This must be a clean, stable
// diagnostic naming the template and the recursion — on every entry
// point (`check`, `build`, `compile`) — not a crash or a hang.
struct G<T> {
  var next: G<G<T>>;
}

type X = G<int>;

func main() -> int {
  return 0;
}
