// CIDER-BUG-128: the look-alike rejection the cross-module canonical
// comparison must keep. The companion check_iface_param_lookalike.cid
// imports this module: `Shape.draw(p: Param)` names THIS module's Param,
// and a class in another module whose draw takes a same-named Param of its
// own must be rejected with the normal interface diagnostic — never
// accepted on the strength of the shared spelling (the old raw comparison
// accepted it and would have built a vtable with the wrong signature).
export struct Param {
  var v: int;
}

export interface Shape {
  func draw(p: Param) -> int;
}
