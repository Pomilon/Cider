// CIDER-BUG-140: a cast-free conversion into the closure spelling func(...)
// takes the same proof obligation as an explicit cast. A *void source that
// resolves to a plain raw pointer, to a mixed component (both shapes over the
// program) or to an unproven shape is rejected in declarations, assignments,
// arguments and returns; storing it in a closure-typed value would read the
// pointer as {fnptr, captures...} and pass it as the hidden object argument of
// every call (VM `bad function id`, native segfault). The legitimate
// conversions whose *void source proves a closure object are pinned in
// tests/programs/fn_cast_closure_indirect_repr.

func add1(x: int) -> int { return x + 1; }

func take(f: func(int) -> int) -> int { return f(1); }

func ret(v: *void) -> func(int) -> int { return v; }

func getRaw() -> *void { return nilPtr; }

func main() -> int {
  // A local *void initialized with a named function.
  var v: *void = add1;

  // Declaration.
  var f1: func(int) -> int = v;

  // Assignment.
  var f2: func(int) -> int = nilPtr;
  f2 = v;

  // Argument to a closure-typed parameter.
  var a1: int = take(v);

  // Return from a closure-typed function.
  var f3: func(int) -> int = ret(v);

  // Mixed provenance: the *void received both shapes.
  var v2: *void = add1;
  v2 = func(x: int) -> int { return x + 1; };
  var f4: func(int) -> int = v2;

  // Unproven *void: never received a fn value.
  var v3: *void = nilPtr;
  var f5: func(int) -> int = v3;

  // A ternary whose other branch is an untracked *void expression cannot
  // prove the closure shape either (the branch types are recorded
  // separately).
  var c: func(int) -> int = func(x: int) -> int { return x + 1; };
  var vc: *void = c;
  var f6: func(int) -> int = 1 == 1 ? vc : getRaw();

  // The same holds for an opaque *void storage next to a proven closure
  // branch.
  var u: *void = getRaw();
  var f7: func(int) -> int = 1 == 1 ? c : u;

  return a1 + f1(1) + f2(1) + f3(1) + f4(1) + f5(1) + f6(1) + f7(1);
}
