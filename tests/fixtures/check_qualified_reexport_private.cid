// CIDER-BUG-102: importing the re-exporting module must not make the
// library's private type reachable; mid.cid's qualified spelling resolves
// in mid's module but stays subject to the library's export flags. The
// call below also exercises the use-site path: main does NOT import the
// library, yet mid's signature spelling still resolves (and is rejected)
// against mid's own imports.
import qualified_reexport_private_mid;

func main() -> int {
  qualified_reexport_private_mid.reveal();
  return 0;
}
