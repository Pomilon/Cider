// CIDER-BUG-093: a cast to the legacy closure spelling func(...) cannot
// turn a plain fn value into a closure object. An unchecked cast keeps the
// source runtime shape (CIDER-BUG-068), and a raw code pointer is not the
// {fnptr, captures...} record a closure call reads (it loads the fnptr from
// the object and passes the object as a hidden first argument), so the cast
// is rejected instead of accepting a value every later closure call would
// misread (VM `bad function id`, native segfault). The fn(...) spelling, or
// a func(...) declaration (CIDER-BUG-063 adapts a named function to the raw
// pointer representation), are the supported spellings.

type Cb = func(int) -> int;

func add1(x: int) -> int { return x + 1; }

func main() -> int {
  // Ticket repro: a named function cast to the direct closure spelling.
  var f: func(int) -> int = add1 as func(int) -> int;
  // A plain fn variable cast to the closure spelling, through a type alias.
  var p: fn(int) -> int = add1;
  var g: Cb = p as Cb;
  // The cast used directly as a call target.
  var h: int = (add1 as func(int) -> int)(1);
  return f(1) + g(1) + h;
}
