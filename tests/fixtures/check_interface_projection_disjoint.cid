// Disjoint interfaces cannot be reinterpreted by an explicit cast.
interface Read { func read() -> int; }
interface Write { func write() -> int; }
class C {
  func read() -> int { return 1; }
  func write() -> int { return 2; }
}
func main() -> void {
  var c: C;
  var write: Write = c;
  var read: Read = write as Read;
}
