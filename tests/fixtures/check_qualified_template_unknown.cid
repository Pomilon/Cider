// CIDER-BUG-096: a declaration naming an unknown qualified template must be
// reported at the declaration. Previously the collector instantiated lazily
// from annotations, so an UNUSED declaration resolved to nothing silently
// and `cider check` passed (any use fell through to the generic
// "is not a struct or class").
import qualified_template_unknown_lib;

func main() -> int {
  var x: qualified_template_unknown_lib.Nope<int>;
  return 0;
}
