// CIDER-BUG-122: a module-qualified base that resolves to a struct, an
// interface or an alias of one (CIDER-BUG-124 made these spellings
// resolvable) must be diagnosed, not silently ignored.
import dotted_nonclass_lib;

class A extends dotted_nonclass_lib.Thing {
  var a: int = 2;
}

class B extends dotted_nonclass_lib.Shape {
  var b: int = 3;
}

class C extends dotted_nonclass_lib.AliasThing {
  var c: int = 4;
}

func main() -> int { return 0; }
