// CIDER-BUG-157: a closure-typed array element declared fn(...) keeps the
// plain raw-pointer representation, so a closure value stored there is
// reported exactly like the existing field/pointee rule (CIDER-BUG-068).
type Cb = fn(int) -> int;

func store(a: [Cb; 2], cb: Cb) -> void {
  a[0] = cb;
}

func main() -> int {
  var a: [Cb; 2];
  store(a, func(x: int) -> int { return x + 1; });
  return a[0](1) - 2;
}
