// CIDER-BUG-165: an array-typed call argument list literal takes the
// declaration-time size checks against the declared parameter shape —
// flat, empty, nested and alias spellings, direct and method calls.
type Row = [int; 3];
func flat(a: [u8; 2]) -> int { return a[0]; }
func nested(a: [[u8; 2]; 2]) -> int { return a[0][0]; }
func alias(a: Row) -> int { return a[0]; }
class C { var t: int; func m(a: [u8; 2]) -> int { return a[0]; } }
func main() -> int {
  var a: int = flat([1, 2, 3]);
  var b: int = flat([]);
  var c: int = nested([[1, 2], [3, 4, 5]]);
  var d: int = alias([1, 2]);
  var cc: C;
  var e: int = cc.m([1, 2, 3]);
  return a + b + c + d + e;
}
