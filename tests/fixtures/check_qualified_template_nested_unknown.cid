// no `Nope`, so the inner argument is an unknown template in that module and
// is reported at the declaration, in the same shape the outer spelling
// already used (CIDER-BUG-096/111/134).
import nested_template_unknown_lib;

type W = nested_template_unknown_lib.Tag<nested_template_unknown_lib.Nope<int>>;

func main() -> int {
  return 0;
}
