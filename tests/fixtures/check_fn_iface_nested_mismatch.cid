// CIDER-BUG-085: the interface flag is resolved at every signature depth,
// and so is the mismatch check. A nested `fn(fn(I) -> int) -> int` does not
// accept a `fn(fn(int) -> int) -> int`.
interface I { func v() -> int; }

func named(x: I) -> int { return x.v(); }

func takeNested(f: fn(fn(I) -> int) -> int) -> int { return 0; }
func ignore(f: fn(int) -> int) -> int { return 0; }

func main() -> int {
  takeNested(ignore);
  return 0;
}
