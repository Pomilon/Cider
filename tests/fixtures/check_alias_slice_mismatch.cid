// CIDER-BUG-071: the CIDER-BUG-057 slice-copy checks (element type and
// statically-known element count) must apply to an alias-declared fixed
// array exactly as to the direct spelling. Wrong-length declarations,
// a wrong element type, and a wrong-length reassignment are still
// rejected through the alias.
type Row = [u8; 3];
type Ints = [int; 2];

func main() -> int {
  var a: [u8; 5];
  var under: Row = a[1:3];
  var over: Row = a[0:5];
  var head: Row = a[:4];
  var tail: Row = a[1:];
  var wrongElem: Ints = a[1:3];
  var s: Row;
  s = a[2:4];
  return 0;
}
