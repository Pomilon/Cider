// CIDER-BUG-119: a function-local aggregate cannot shadow an enclosing type.
// Local types are identified by their bare name in type comparisons, so a
// shadowing declaration could be silently confused with the outer type
// (wrong layout / method set). The module-scope `struct T` is declared AFTER
// its shadowing function: the diagnostic is raised after collection, so
// forward declarations are seen as well.
func structShadow() -> int {
    struct T { var a: int; }
    var v: T;
    v.a = 1;
    return v.a;
}

struct T { var a: int; var b: int; }

class U { var u: int = 0; }

func classShadow() -> int {
    class U { var w: int = 1; func get() -> int { return this.w; } }
    var c: U;
    return c.get();
}
