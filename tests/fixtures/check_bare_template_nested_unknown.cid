// CIDER-BUG-168: an unknown template NESTED in a known one is reported at
// the declaration, exactly like the same unknown template spelled on its own
// (CIDER-BUG-134). The declaration-time checks read only the base name
// before the first '<', so the argument list was opaque and this stayed
// silent; a use of `W` then failed with an unrelated "Return type
// mismatch" naming the unknown type.
//
// `Tag`'s body never names its parameter, so nothing but the argument-list
// walk can report the inner `Nope` (see nested_template_unknown_lib.cid).
struct Tag<T> {
  var n: int;
}

type W = Tag<Nope<int>>;

func main() -> int {
  return 0;
}
