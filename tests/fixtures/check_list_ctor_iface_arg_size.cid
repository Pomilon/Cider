// CIDER-BUG-165: constructor and interface-method arguments take the same
// declaration-time array checks (the interface call has no callee symbol,
// so its list literal is validated against the declared method signature).
class C {
  var t: int;
  func init(a: [u8; 2]) { this.t = a[0]; }
}
interface T { func take(a: [u8; 2]) -> int; }
class TI { func take(a: [u8; 2]) -> int { return a[0]; } }
func main() -> int {
  var c: *C = new C([1, 2, 3]);
  var t: T;
  var ti: TI;
  t = ti;
  var x: int = t.take([1, 2, 3]);
  return c.t + x;
}
