// CIDER-BUG-157: a *void value stored into a closure-typed array element
// takes the same cast-free conversion proof as a field (CIDER-BUG-140): an
// unproven source is reported, and a source that received both shapes is
// mixed. A proven *void closure is accepted (see the closure_array_store
// program).
func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

func add1(x: int) -> int { return x + 1; }

func main() -> int {
  var x: int = 1;
  var raw: *void = &x;
  var a: [func(int) -> int; 2];
  a[0] = raw;

  var mixed: *void = makeAdder(5);
  mixed = add1 as *void;
  a[1] = mixed;
  return a[0](1);
}
