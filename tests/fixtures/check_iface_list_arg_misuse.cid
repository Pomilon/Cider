// CIDER-BUG-150: the argument-position list conversion keeps the shared
// interface rule's rejections — a class missing a required method, a
// same-spelled method with a non-matching signature, and a different
// interface are all rejected, exactly like the declaration site.
interface Shape {
  func area() -> int;
}

interface Named {
  func name() -> int;
}

class Bad {
  var x: int;
}

class WrongSig {
  var side: int;
  func area(x: int) -> int { return this.side * x; }
}

class Sq {
  var side: int;
  func area() -> int { return this.side; }
}

func takes(shapes: [Shape; 2]) -> int {
  return shapes[0].area() + shapes[1].area();
}

func takesNamed(items: [Named; 2]) -> int {
  return items[0].name() + items[1].name();
}

func main() -> int {
  var b: Bad;
  var w: WrongSig;
  var s: Sq;
  var i: Shape = s;
  var x: int = takes([b, s]);
  var y: int = takes([w, s]);
  var z: int = takesNamed([i, i]);
  return 0;
}
