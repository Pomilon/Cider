// CIDER-BUG-230 module half of the look-alike / visibility fixture: an
// EXPORTED interface-typed global whose satisfaction check must run the full
// cross-module canonical comparison (CIDER-BUG-128), plus a NON-exported one,
// which a qualified store may still not reach (CIDER-BUG-060).
export struct Param {
  var v: int;
}

export interface Store {
  func draw(p: Param) -> int;
}

export class RealImpl {
  var t: int;
  func draw(p: Param) -> int { return p.v * 10 + this.t; }
}

export var gStore: Store;

// Not exported: a qualified store into it is a visibility error, whatever the
// value's shape.
var hidden: Store;