// CIDER-BUG-228: the genuinely-undefined half of the same name kind. The fix
// makes module-scope globals forward-VISIBLE, which must not weaken the check
// for a name NO declaration binds: it is still a located type error, reported
// by `cider check` (not deferred to IR generation the way the pre-fix
// "cannot resolve identifier" was), and it must name the USE. Both the write
// and the read shape are here, because they took different paths before the
// fix: the write reached the null-addressing assignment target and the read
// reached the reporter error inside IR generation.
func writeMissing() -> void {
  gMissingWrite = 5;
}

func readMissing() -> int {
  return gMissingRead;
}

// The control: a global declared LATER in the same file is legal, so the
// diagnostic must be about the two names above and not about this one.
func readDeclaredBelow() -> int {
  return gDeclaredBelow;
}

var gDeclaredBelow: int = 1;

func main() -> int {
  writeMissing();
  if (readMissing() != 0) { return 1; }
  return readDeclaredBelow() - 1;
}
