// CIDER-BUG-210, nested shapes: the rejection is lexical, so a transfer is
// rejected wherever it sits inside a defer body — behind a nested `defer`,
// inside a branch, a loop or a match arm. Every one of those emits through
// the same unwinder, so re-entering it is the same crash one level down.

func deferInDefer() -> int {
    defer {
        defer { return 1; }
    }
    return 0;
}

func transferInBranch() -> int {
    defer {
        if (true) { return 2; }
    }
    return 0;
}

func transferInLoop() -> int {
    defer {
        for (var i: int = 0; i < 3; i++) {
            if (i == 1) { throw 3; }
        }
    }
    return 0;
}

func transferInMatchArm() -> int {
    defer {
        match (4) {
            4 => { return 4; }
            default => { return 5; }
        }
    }
    return 0;
}

func main() -> int {
    return deferInDefer() + transferInBranch() + transferInLoop() + transferInMatchArm();
}
