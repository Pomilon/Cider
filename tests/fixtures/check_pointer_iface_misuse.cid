// CIDER-BUG-100: pointer-to-interface stays a pointer. An interface VALUE
// must not initialize or assign to a `*Shape` storage (the 16-byte fat
// pointer is not an 8-byte pointer), and a `*Shape` must not initialize an
// interface value or be stored through one. Only dereferenced targets take
// the interface store.
interface Shape {
  func area() -> int;
}

class Sq {
  var s: int;
  func area() -> int { return this.s; }
}

func main() -> int {
  var c: Sq;
  var t: Shape = c;
  var p: *Shape = t;
  var s: Shape = p;
  *p = 5;
  return 0;
}
