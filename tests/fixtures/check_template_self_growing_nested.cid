// CIDER-BUG-256: the nested-mention shape. Since the CIDER-BUG-168 fix
// made declaration-time template checks recurse into argument lists, a
// nested mention (`Tag<G<int>>`, where `Tag` ignores its parameter)
// reaches the growing self-instantiation where it used to be silent.
// Same diagnostic as the direct shape.
struct Tag<T> {
  var n: int;
}

struct G<T> {
  var next: G<G<T>>;
}

type X = Tag<G<int>>;

func main() -> int {
  return 0;
}
