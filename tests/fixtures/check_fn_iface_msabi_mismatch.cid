// CIDER-BUG-085: flag normalization must not drop the ABI marker. A plain
// `fn(I) -> int` does not accept an `msabi` function even though both
// signatures now carry the interface flag.
interface I { func v() -> int; }

msabi func namedMs(x: I) -> int { return x.v(); }

func main() -> int {
  var f: fn(I) -> int = namedMs;
  return 0;
}
