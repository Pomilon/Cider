// CIDER-BUG-124: a module-qualified base must be exported from its module;
// resolution through the module registry never widens visibility. The
// collector resolves the base silently (to lay out the derived class), so
// the checker reports the visibility violation at the extends clause.
import dotted_base_private_lib;

class A extends dotted_base_private_lib.Hidden {
  var x: int = 1;
}

func main() -> int { return 0; }