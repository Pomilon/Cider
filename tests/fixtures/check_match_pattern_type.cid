// CIDER-BUG-055 requirement 2: a pattern whose type differs from the
// scrutinee keeps its checker diagnostic (string content comparison must
// not silently widen to unrelated types).
func main() -> int {
  var n: int = 1;
  match (n) {
    "hi" => { return 1; }
    default => { return 0; }
  }
  var s: string = "hi";
  match (s) {
    1 => { return 2; }
    default => { return 3; }
  }
}
