// CIDER-BUG-068: struct/class fn(...) fields and fn(...) array elements keep
// the plain raw-pointer representation (their storage has no representation
// refinement), so storing a closure-valued parameter there is reported
// instead of handing the field a closure object that later calls would treat
// as a raw code pointer.
type Cb = fn(int) -> int;

struct Ops { var op: Cb; }

func store(o: *Ops, cb: Cb) -> void {
  o->op = cb;
}

func main() -> int {
  var o: Ops;
  store(&o, func(x: int) -> int { return x + 1; });
  return o.op(1) - 2;
}
