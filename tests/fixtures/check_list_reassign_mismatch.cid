// CIDER-BUG-112: the legitimate rejections of list reassignment. Size and
// element-type mismatches report the same declaration-time diagnostics
// (named after the assignment target where one exists); an empty list is a
// size mismatch; the compound form has no element-wise lowering; and a
// non-list RHS keeps the existing generic mismatch.
type Row = [int; 3];
type RowAlias = Row;

struct S8 { var a: int; var b: int; }
class C4 { var x: int; }
struct Holder { var r: Row; }

func main() -> int {
  var a: Row;
  a = [1, 2];
  var b: [int; 3];
  b = [1, 2, 3, 4];
  var c: RowAlias;
  c = [];
  var d: [C4; 2];
  var o: S8; o.a = 1; o.b = 2;
  d = [o, o];
  var e: [int; 3];
  e += [1, 2, 3];
  var h: Holder;
  h.r = [1, 2];
  var m: [[int; 2]; 2];
  m[0] = [1, 2, 3];
  var i: [int; 3];
  i = 5;
  return 0;
}
