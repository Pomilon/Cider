// CIDER-BUG-168 negative control for the nested-argument fixtures. This
// module declares `Tag` and `Cell` and NO `Nope`.
//
// `Tag`'s parameter is a type-level tag its body never stores, so the
// argument list is the ONLY place it appears — and therefore the only place
// a bad argument can be checked. That is deliberate: with a body that names
// the parameter in a field, the head's own field substitution happens to
// reach a nested wrong-arity argument and reports it at `0:0` (with no
// relation to the declaration that wrote it), which would let a fixture pass
// without the argument list being checked at all. `Cell` takes one type
// argument, so `Cell<int, int>` is a wrong-arity spelling.
export struct Tag<T> {
  var n: int;
}

export struct Cell<A> {
  var a: A;
}
