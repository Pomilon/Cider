// CIDER-BUG-049: class field initializers are materialised as constant
// stores at every object creation site (new C and value-class locals), so
// only compile-time constant shapes are accepted. Calls, mutable globals,
// addresses and aggregate initializers must be a clear diagnostic instead
// of silently leaving the field zero. Const references (including forward
// ones), string literals, nilPtr and function names stay accepted.
func get() -> int { return 5; }

var mutableGlobal: int = 1;

class Bad {
  var call: int = get();              // call: not constant
  var nonconst: int = mutableGlobal;  // mutable global: not constant
  var addr: *int = &mutableGlobal;    // address: not a foldable pointer
  var arr: [int; 2] = [1, 2];         // aggregate: no materialisation
  var goodConst: int = LATER + 1;     // forward const reference: accepted
  var goodStr: string = "ok";         // string literal: accepted
  var goodPtr: *int = nilPtr;         // accepted
}

const LATER: int = 42;

func main() -> int {
  return 0;
}
