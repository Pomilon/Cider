// CIDER-BUG-138 negative fixture module: `Private` and `HiddenAlias` are
// module-private (and `HiddenAlias` is a private alias over `Private`), so
// an `alias_visibility_lib.X` spelling written in another module must be
// rejected at the alias declaration.
struct Private {
  var v: int;
}

type HiddenAlias = Private;

export type Exported = Private;
