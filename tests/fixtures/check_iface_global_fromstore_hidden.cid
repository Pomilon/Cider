// CIDER-BUG-238 companion to check_iface_global_fromstore_lookalike.cid: the
// visibility rule for the from-alias spelling of a module global. Kept in its
// own file because a symbol-collection error short-circuits before the
// type-check phase, so it cannot share an expected-errors list with the
// satisfaction rejections.
//
// iface_global_store_lib.cid keeps `hidden` unexported. The qualified
// spelling is pinned by check_iface_global_store_lookalike.cid
// (CIDER-BUG-230); this pins the `from` spelling, which is enforced by a
// different place — the collector's bindFromAliases — so the two spellings of
// one rule are pinned separately. Binding continues past the diagnostic, so a
// use of the (invisible) name must not be what fails the fixture.
import iface_global_store_lib;
from iface_global_store_lib import hidden;

func main() -> int {
  return 0;
}
