// CIDER-BUG-230: the rejections a module-qualified concrete-to-interface
// store must KEEP making. The store is accepted now (see the
// crossmod_iface_global_store program), so every rule the accepted path runs
// has to be pinned in the rejected direction too — otherwise "the flag
// resolved" alone would be the whole test.
//
// iface_global_store_lib.cid declares `Store.draw(p: Param)` with ITS OWN
// Param, and exports an interface-typed global `gStore`. This file declares
// an unrelated Param (identical spelling, other module) plus a class whose
// draw takes it, and a class missing `draw` altogether. All three must be
// rejected with the ordinary interface diagnostic against lib's CANONICAL
// interface name — the same comparisons a bare declaration and a from-import
// store run (CIDER-BUG-128), never accepted on the strength of the shared
// spelling.
import iface_global_store_lib;

struct Param {
  var a: int;
  var b: int;
  var c: int;
}

class LookAlike {
  var id: int;
  func draw(p: Param) -> int { return p.a + p.b + p.c; }
}

// The interface's shape, but a method it does not declare.
class Missing {
  var id: int;
  func o() -> int { return this.id; }
}

func main() -> int {
  var la: LookAlike;
  var mi: Missing;
  iface_global_store_lib.gStore = la;
  iface_global_store_lib.gStore = mi;
  // CIDER-BUG-060: a non-exported global is unreachable by qualified store,
  // whatever the value satisfies.
  iface_global_store_lib.hidden = mi;
  return 0;
}