// CIDER-BUG-102: `qualified_reexport_private_lib.Hidden` resolves in THIS
// module's context (the spelling is written here), but Hidden is not
// exported from the library, so the use must still be a clear visibility
// violation — defining-module semantics never widen visibility.
import qualified_reexport_private_lib;

export func reveal() -> qualified_reexport_private_lib.Hidden {
  var h: qualified_reexport_private_lib.Hidden;
  h.v = 1;
  return h;
}
