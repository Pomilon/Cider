// CIDER-BUG-243: the rejections that must KEEP making now that a global's
// interface flag is resolved at its DECLARATION rather than recovered by name
// at each read site.
//
// The accepted path is the crossmod_iface_global_declorder program, whose
// globals are declared BEFORE their interface (and before an alias chain to
// it) precisely so the flag can only come from the declaration. That makes the
// declaration order the thing to pin in the rejected direction too: a
// forward-declared interface-typed global must still run the full
// cross-module canonical satisfaction comparison (CIDER-BUG-128) and the
// export visibility rule (CIDER-BUG-060), for BOTH read spellings a global can
// be reached by — the module-qualified one and a `from`-import alias.
//
// iface_global_declorder_lib.cid declares `DT.draw(p: DParam)` with ITS OWN
// DParam and an unexported interface-typed global `gHidden`, and exports
// `gEarly` (declared before the interface) plus `gAlias` (declared before its
// alias chain). This file declares an unrelated DParam — identical spelling,
// other module — a class whose draw takes it, and a class missing draw
// altogether. All four stores must be rejected with the ordinary interface
// diagnostic against the CANONICAL interface name, never accepted on the
// strength of the shared spelling.
import iface_global_declorder_lib;
from iface_global_declorder_lib import gEarly, gAlias;

struct DParam {
  var a: int;
  var b: int;
  var c: int;
}

class LookAlike {
  var id: int;
  func draw(p: DParam) -> int { return p.a + p.b + p.c; }
}

// The interface's shape, but a method it does not declare.
class Missing {
  var id: int;
  func o() -> int { return this.id; }
}

func main() -> int {
  var la: LookAlike;
  var mi: Missing;
  // The module-qualified spelling, into the forward-declared global.
  iface_global_declorder_lib.gEarly = la;
  // The from-import ALIAS of the same global.
  gEarly = mi;
  // The alias-chain global, through both spellings.
  gAlias = la;
  iface_global_declorder_lib.gAlias = mi;
  // CIDER-BUG-060: a non-exported global is unreachable by either spelling,
  // whatever the value satisfies.
  iface_global_declorder_lib.gHidden = la;
  return 0;
}
