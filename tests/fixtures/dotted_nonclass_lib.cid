// CIDER-BUG-122 negative fixture module: exported non-class names a base
// clause may spell module-qualified (a struct, an interface, and an alias
// chain ending at a struct).
export struct Thing {
  var x: int;
}

export interface Shape {
  func area() -> int;
}

type HiddenAlias = Thing;

export type AliasThing = HiddenAlias;
