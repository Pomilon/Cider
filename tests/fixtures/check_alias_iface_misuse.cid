// CIDER-BUG-078: alias spellings must not weaken the interface conversion
// rules. A different interface, a class missing a required method, and a
// non-struct/class value stay rejected through `type S = Shape` (direct and
// alias-of-alias), exactly like the direct spelling (see
// tests/fixtures/check_iface_assign_misuse.cid).
interface Shape {
  func area() -> int;
}

interface Other {
  func size() -> int;
}

type S = Shape;
type T = S;

class Bad {
  var x: int;
}

class Sq {
  var s: int;
  func area() -> int { return this.s; }
}

func main() -> int {
  var s: S;
  var t: T;
  var o: Other;
  var b: Bad;
  s = o;
  t = b;
  var n: int = 5;
  var s2: S = n;
  return 0;
}
