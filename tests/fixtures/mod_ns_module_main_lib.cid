export func helper() -> int {
  return 7;
}

// CID-020/021: a NON-main module must not define the program entry points.
// `main`/`_start` are never mangled, so these would emit a second bare
// `define main` and silently hijack the entry (pre-namespace behavior was a
// redeclaration error).
func main() -> int {
  return 99;
}

func _start() -> void { }
