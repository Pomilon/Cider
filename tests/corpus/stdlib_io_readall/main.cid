// CIDER-CHORE-003: std.io read_all was only reachable through solum's
// end-to-end render. input.txt has two newlines and no trailing newline, so
// this pins that read_all returns every byte verbatim until EOF.
//
// v3 spells I/O buffers as *char (the string model has no bytes-to-string
// cast; std.io's read_all answers a NUL-terminated heap buffer). The bytes
// are copied out through the pointer before printing.
from std.io import print, puts, printChar, read_all;

func main() -> int {
    var data: *char = read_all();
    print("BEGIN\n");
    var i: int = 0;
    while (data[i] != (0 as char)) {
        printChar(data[i]);
        i = i + 1;
    }
    print("END\n");
    return 0;
}
