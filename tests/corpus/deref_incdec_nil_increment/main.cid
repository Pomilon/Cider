// CIDER-BUG-226: `(*p)++` through a nil pointer is the CIDER-BUG-219 defined
// error, on every backend. An inc/dec target asks the `*` for its ADDRESS
// (visit(UnaryExpr&) with isAddress_), and that path deliberately does not
// dereference — so the guard that visit(UnaryExpr&) owns never ran, and the
// shape reached the raw load: the VM reported its own IR-level
// `load: null pointer dereference` and native x86 took SIGSEGV with no output
// at all. The guard now sits on the read-modify-write that really dereferences.
//
// Every live form runs FIRST, so the guard is pinned as a not-taken branch and
// nothing more; each one is a `(*q)` inc/dec through a real pointer, which is
// the same code path as the nil case. The program then reports the nil
// dereference and exits non-zero, so a regression that let it through cannot
// accidentally match the expected output:
//   stderr = "vm error: null pointer dereference\n", exit = 2.
func incLive(p: *int) -> int { var r: int = (*p)++; return r * 1000 + *p; }
func decLive(p: *int) -> int { var r: int = --(*p); return r * 1000 + *p; }
func incElemLive(pp: **int, i: int) -> int { (*pp[i])++; return *pp[i]; }

func nilInc(p: *int) -> int { (*p)++; return *p; }

func main() -> int {
  var x: int = 5;
  var q: *int = &x;
  if (incLive(q) != 5006) { return 101; }
  if (x != 6) { return 102; }
  if (decLive(q) != 5005) { return 103; }
  if (x != 5) { return 104; }
  if (q != &x) { return 105; }

  var e: int = 7;
  var eps: [*int; 1] = [nilPtr];
  eps[0] = &e;
  var ep: **int = &eps[0];
  if (incElemLive(ep, 0) != 8) { return 106; }
  if (e != 8) { return 107; }

  var nilInt: *int = nilPtr;
  return nilInc(nilInt);
}
