// CIDER-ISS-015: a map whose capacity is zero must not divide by zero on
// insert. free_map leaves cap == 0 and entries == nilPtr, so the load-factor
// check in insert_map used to divide by zero (defined as 0 on both backends,
// CIDER-BUG-058, which silently skipped the growth check) and then stored
// through the null bucket array. insert_map must instead reallocate, exactly
// as std.vector's push re-grows a freed Vec.
//
// The lifecycle pinned here: new_map -> insert -> free_map -> insert again,
// over several reuse cycles, plus the read paths on a freed map, growth after
// reuse, tombstones after reuse, and a never-initialized map.
from std.io import print, puts, printInt;
from std.map import HashMap, new_map, insert_map, get_map, contains_map, remove_map, len_map, free_map;

func main() -> int {
    var p: *int = nilPtr;

    // --- lifecycle 1: init, insert, free, insert again ---
    var m: HashMap<int, int> = new_map::<int, int>();
    insert_map::<int, int>(&m, 1, 10);
    insert_map::<int, int>(&m, 17, 170);
    if (len_map::<int, int>(&m) != 2) { return 1; }
    p = get_map::<int, int>(&m, 17);
    if (p == nilPtr || *p != 170) { return 2; }

    free_map::<int, int>(&m);

    // Read paths on a freed map must stay clean (they are len-guarded).
    if (len_map::<int, int>(&m) != 0) { return 3; }
    if (get_map::<int, int>(&m, 1) != nilPtr) { return 4; }
    if (contains_map::<int, int>(&m, 17)) { return 5; }
    if (remove_map::<int, int>(&m, 17)) { return 6; }

    // Inserting into the freed (cap == 0) map must reallocate.
    insert_map::<int, int>(&m, 2, 20);
    if (len_map::<int, int>(&m) != 1) { return 7; }
    p = get_map::<int, int>(&m, 2);
    if (p == nilPtr || *p != 20) { return 8; }
    // The old contents are gone: the freed table was not resurrected.
    if (contains_map::<int, int>(&m, 1)) { return 9; }
    if (contains_map::<int, int>(&m, 17)) { return 10; }

    // --- reuse cycles: the map is freed at the end of each cycle, so every
    // --- cycle starts from cap == 0 and must reallocate on the first insert.
    var cycle: int = 0;
    while (cycle < 5) {
        // A collision triple plus key 2, so the reused table must also probe.
        insert_map::<int, int>(&m, 1, cycle);
        insert_map::<int, int>(&m, 17, cycle + 1000);
        insert_map::<int, int>(&m, 33, cycle + 2000);
        insert_map::<int, int>(&m, 2, 20);
        if (len_map::<int, int>(&m) != 4) { return 11; }
        p = get_map::<int, int>(&m, 2);
        if (p == nilPtr || *p != 20) { return 12; }
        p = get_map::<int, int>(&m, 1);
        if (p == nilPtr || *p != cycle) { return 13; }
        p = get_map::<int, int>(&m, 33);
        if (p == nilPtr || *p != cycle + 2000) { return 14; }
        // Replacement on a reused table must not grow len.
        insert_map::<int, int>(&m, 2, 21);
        if (len_map::<int, int>(&m) != 4) { return 15; }
        p = get_map::<int, int>(&m, 2);
        if (p == nilPtr || *p != 21) { return 16; }
        free_map::<int, int>(&m);
        if (len_map::<int, int>(&m) != 0) { return 17; }
        if (contains_map::<int, int>(&m, 1)) { return 18; }
        cycle = cycle + 1;
    }

    // --- growth after reuse: the reallocated table must grow past cap 16 ---
    var i: int = 0;
    while (i < 100) {
        insert_map::<int, int>(&m, i, i * 7);
        i = i + 1;
    }
    if (len_map::<int, int>(&m) != 100) { return 19; }
    i = 0;
    while (i < 100) {
        p = get_map::<int, int>(&m, i);
        if (p == nilPtr || *p != i * 7) { return 20; }
        i = i + 1;
    }

    // --- tombstones and churn on the reused table ---
    i = 0;
    while (i < 100) {
        if (i % 4 == 0) {
            if (!remove_map::<int, int>(&m, i)) { return 21; }
        }
        i = i + 1;
    }
    if (len_map::<int, int>(&m) != 75) { return 22; }
    i = 0;
    while (i < 100) {
        if (i % 4 == 0) {
            if (contains_map::<int, int>(&m, i)) { return 23; }
        } else {
            p = get_map::<int, int>(&m, i);
            if (p == nilPtr || *p != i * 7) { return 24; }
        }
        i = i + 1;
    }
    // Reinsert over the tombstones, forcing another grow on the reused table.
    i = 0;
    while (i < 100) {
        if (i % 4 == 0) { insert_map::<int, int>(&m, i, i * 7 + 1); }
        i = i + 1;
    }
    if (len_map::<int, int>(&m) != 100) { return 25; }
    i = 0;
    while (i < 100) {
        p = get_map::<int, int>(&m, i);
        if (p == nilPtr) { return 26; }
        if (i % 4 == 0) {
            if (*p != i * 7 + 1) { return 27; }
        } else {
            if (*p != i * 7) { return 28; }
        }
        i = i + 1;
    }
    print("reuse_len="); printInt(len_map::<int, int>(&m)); puts("");

    // --- a map that was never new_map'd has cap == 0 too ---
    var fresh: HashMap<int, int> = HashMap<int, int> { entries: nilPtr, cap: 0, len: 0, tombstones: 0 };
    insert_map::<int, int>(&fresh, 5, 55);
    if (len_map::<int, int>(&fresh) != 1) { return 29; }
    p = get_map::<int, int>(&fresh, 5);
    if (p == nilPtr || *p != 55) { return 30; }
    free_map::<int, int>(&fresh);

    // --- free is idempotent, and insert after a double free reallocates ---
    free_map::<int, int>(&m);
    free_map::<int, int>(&m);
    insert_map::<int, int>(&m, -3, -33);
    if (len_map::<int, int>(&m) != 1) { return 31; }
    p = get_map::<int, int>(&m, -3);
    if (p == nilPtr || *p != -33) { return 32; }
    if (contains_map::<int, int>(&m, 3)) { return 33; }

    // A second map is unaffected by the first one's lifecycle.
    var other: HashMap<int, int> = new_map::<int, int>();
    insert_map::<int, int>(&other, -3, 333);
    p = get_map::<int, int>(&m, -3);
    if (p == nilPtr || *p != -33) { return 34; }
    p = get_map::<int, int>(&other, -3);
    if (p == nilPtr || *p != 333) { return 35; }

    print("final_len="); printInt(len_map::<int, int>(&m)); puts("");
    puts("map free/reuse ok");
    free_map::<int, int>(&m);
    free_map::<int, int>(&other);
    return 0;
}
