from std.io import print, printInt;

// CIDER-BUG-047: plain (non-virtual) methods occupy no vtable slots, but
// the collector assigned override slots by vtable position over the mixed
// `methods` array. A plain method declared before a virtual desynced every
// later override, and a plain method sharing a virtual's name could
// capture a different slot outright. Every check below dispatches through
// a base pointer so the vtable slot decides the result.

// Plain before virtual: `name` must not shift `v`'s slot.
class Base {
  func name() -> int { return 1; }
  virtual func v() -> int { return 10; }
}

class Derived extends Base {
  override func v() -> int { return 20; }
}

// Two virtuals with a plain method interleaved; the mid class overrides
// one and adds a new virtual after its override, and the leaf overrides
// both inherited slots (multi-level chains).
class IBase {
  virtual func first() -> int { return 30; }   // slot 0
  func middle() -> int { return 31; }          // plain: no slot
  virtual func second() -> int { return 32; }  // slot 1
}

class IMid extends IBase {
  override func first() -> int { return 40; }
  virtual func third() -> int { return 33; }   // new slot 2
}

class ILeaf extends IMid {
  override func second() -> int { return 50; }
  override func third() -> int { return 60; }
}

// A plain method sharing a virtual's name must not capture another slot:
// overriding `pick` may only rewrite slot 1, never `keep`'s slot 0.
class SharedBase {
  func pick() -> int { return 70; }            // plain, no slot
  virtual func keep() -> int { return 71; }    // slot 0
  virtual func pick() -> int { return 72; }    // slot 1
}

class SharedDerived extends SharedBase {
  override func pick() -> int { return 73; }
}

func main() -> int {
  var d: *Derived = new Derived;
  var b: *Base = d;
  if (b->v() != 20) return 1;

  var leaf: *ILeaf = new ILeaf;
  var ib: *IBase = leaf;
  if (ib->first() != 40) return 2;
  if (ib->second() != 50) return 3;
  if (ib->middle() != 31) return 4;
  var im: *IMid = leaf;
  if (im->third() != 60) return 5;

  var sd: *SharedDerived = new SharedDerived;
  var sb: *SharedBase = sd;
  if (sb->keep() != 71) return 6;

  print("vtable_ok\n");
  delete d;
  delete leaf;
  delete sd;
  return 0;
}
