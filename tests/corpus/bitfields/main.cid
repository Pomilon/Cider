struct Flags {
  var a: int:3;
  var b: int:5;
  var c: bool:1;
  var d: int;
}

func _start() {
  var f: Flags = Flags { a: 5, b: 17, c: true, d: 99 };
  if (f.a != 5) { asm { "mov rax, 60" } asm { "mov rdi, 1" } asm { "syscall" } }
  if (f.b != 17) { asm { "mov rax, 60" } asm { "mov rdi, 2" } asm { "syscall" } }
  if (f.c != true) { asm { "mov rax, 60" } asm { "mov rdi, 3" } asm { "syscall" } }
  if (f.d != 99) { asm { "mov rax, 60" } asm { "mov rdi, 4" } asm { "syscall" } }
  f.a = 2;
  if (f.a != 2 || f.b != 17) { asm { "mov rax, 60" } asm { "mov rdi, 5" } asm { "syscall" } }
  asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
