import lib;
from lib import g_percpu, setstack, getstack, set_entry, get_entry;
from std.io import printInt, print;

func main() -> int {
  setstack(42);
  printInt(getstack() as int); print("\n");
  printInt((g_percpu.kernel_stack) as int); print("\n");
  g_percpu.user_stack = 7;
  printInt((g_percpu.user_stack) as int); print("\n");
  printInt((lib.g_percpu.kernel_stack) as int); print("\n");
  var arr: [lib.PerCpu; 2] = [ lib.PerCpu { kernel_stack: 0, user_stack: 0 }, lib.PerCpu { kernel_stack: 0, user_stack: 0 } ];
  set_entry(&arr[0], 0, 11);
  printInt(get_entry(&arr[0], 0) as int); print("\n");
  return 0;
}
