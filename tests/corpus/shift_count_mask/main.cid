// CIDER-BUG-229: one out-of-range shift-count rule on every backend.
//
// `x << n` / `x >> n` keep the width of the left operand, and a count `n`
// is taken modulo the count register of that width -- 5 bits (mod 32) for an
// 8-, 16- or 32-bit operand, 6 bits (mod 64) for a 64-bit one. The result is
// then truncated to the operand width like any other integer ALU op (CID-016).
// So `1 as u8 << 33` is `1 << 1` = 2, and `0xFF as u8 >> 33` is `0xFF >> 1`
// = 127. Every count in `[0, width)` is unaffected.
//
// The VM used to mask to 6 bits at EVERY width, so a count of 33 on a u8/i32
// gave 0 under the VM and 2 natively -- the two backends disagreed on the same
// program. The rule now lives once in ir.h (shiftCountMask) and both backends
// read it.
//
// Coverage: every operand width (u8/i8, u16/i16, u32/i32/int, u64/i64) x both
// directions (<<, >>) x plain and compound (`<<=`, `>>=`), constant and
// variable counts, in-range counts as a control, signed and unsigned right
// shift (arithmetic vs logical fill), and a 64-bit destination fed a narrow
// value (the count register is the DESTINATION's, not the value's).
from std.io import print, printInt, puts, exit;

var fails: int = 0;

func check(name: string, got: i64, want: i64) -> void {
  if (got != want) {
    print("FAIL ");
    print(name);
    print(": got ");
    printInt(got);
    print(" want ");
    printInt(want);
    puts("");
    fails = fails + 1;
  }
}

func main() -> int {
  // --- u8: 5-bit count register, 8-bit truncation -----------------------
  var a: u8 = 1;
  check("u8 << 33", (a << 33) as i64, 2);
  check("u8 << 65", (a << 65) as i64, 2);
  check("u8 << 1", (a << 1) as i64, 2);
  check("u8 << 0", (a << 0) as i64, 1);
  check("u8 << 7", (a << 7) as i64, 128);
  var b: u8 = 0xFF;
  check("u8 >> 33", (b >> 33) as i64, 127);
  check("u8 >> 65", (b >> 65) as i64, 127);
  check("u8 >> 1", (b >> 1) as i64, 127);
  check("u8 >> 7", (b >> 7) as i64, 1);
  var sa: i8 = 0 - 1;
  check("i8 >> 33", (sa >> 33) as i64, (0 - 1));
  var sb: i8 = 16;
  check("i8 << 33", (sb << 33) as i64, 32);
  check("i8 >> 2", (sa >> 2) as i64, (0 - 1));

  // --- u16: same 5-bit count register, 16-bit truncation -----------------
  var c: u16 = 1;
  check("u16 << 33", (c << 33) as i64, 2);
  check("u16 << 65", (c << 65) as i64, 2);
  var d: u16 = 0xFFFF;
  check("u16 >> 33", (d >> 33) as i64, 32767);
  var sc: i16 = 0 - 1;
  check("i16 >> 33", (sc >> 33) as i64, (0 - 1));
  var sd: i16 = 256;
  check("i16 << 33", (sd << 33) as i64, 512);
  check("u16 << 15", (c << 15) as i64, 32768);

  // --- u32 / i32 / int: same 5-bit count register -----------------------
  var e: u32 = 1;
  check("u32 << 33", (e << 33) as i64, 2);
  check("u32 << 65", (e << 65) as i64, 2);
  var f: u32 = 0xFFFFFFFF;
  check("u32 >> 33", (f >> 33) as i64, 0x7FFFFFFF);
  var g: i32 = 1;
  check("i32 << 33", (g << 33) as i64, 2);
  var h: i32 = 0 - 8;
  check("i32 >> 33", (h >> 33) as i64, (0 - 4));
  var iv: int = 1;
  check("int << 33", (iv << 33) as i64, 2);
  var jv: int = 0 - 8;
  check("int >> 33", (jv >> 33) as i64, (0 - 4));
  check("u32 << 31", (e << 31) as i64, 0x80000000);
  check("u32 << 1", (e << 1) as i64, 2);

  // --- u64 / i64: 6-bit count register ----------------------------------
  var k: u64 = 1;
  check("u64 << 65", k << 65, 2);
  check("u64 << 33", k << 33, 0x200000000);
  var l: u64 = 0xFFFFFFFFFFFFFFFF;
  check("u64 >> 65", l >> 65, 0x7FFFFFFFFFFFFFFF);
  var m: i64 = 0 - 8;
  check("i64 >> 65", m >> 65, (0 - 4));
  var n: i64 = 1;
  check("i64 << 65", n << 65, 2);
  var o: i64 = 0 - 1;
  check("i64 >> 65 sign fill", o >> 65, (0 - 1));
  check("i64 >> 63", o >> 63, (0 - 1));

  // --- a narrow value in a 64-bit destination: the count register is the
  //     DESTINATION's (6 bits), not the value's -------------------------
  var p: u8 = 1;
  var wide: i64 = (p as i64) << 33;
  check("u8 widened to i64, << 33", wide, 0x200000000);
  var wide2: i64 = (p as i64) << 65;
  check("u8 widened to i64, << 65", wide2, 2);

  // --- variable counts take the same rule -------------------------------
  var n33: i64 = 33;
  var n65: i64 = 65;
  var q: u8 = 1;
  check("u8 << n33", (q << n33) as i64, 2);
  check("u8 << n65", (q << n65) as i64, 2);
  var r: u32 = 0xFFFFFFFF;
  check("u32 >> n33", (r >> n33) as i64, 0x7FFFFFFF);
  var s: u64 = 1;
  check("u64 << n65", s << n65, 2);
  // A count that is negative as an i64 masks like its unsigned bits: -1 is
  // all ones, so it reduces to the top in-range count of the width.
  var nneg: i64 = 0 - 1;
  check("u32 << nneg", (e << nneg) as i64, 0x80000000);  // -1 & 31 == 31
  check("u64 << nneg", k << nneg, 0x8000000000000000);  // -1 & 63 == 63
  check("u8 << nneg wraps out", (q << nneg) as i64, 0);  // 1 << 31, no bits left

  // --- compound `<<=` / `>>=` lower to the same node (CIDER-FEAT-008), so
  //     the same rule must hold there ------------------------------------
  var t1: u8 = 1;
  t1 <<= 33;
  check("u8 <<= 33", t1 as i64, 2);
  t1 <<= 65;
  check("u8 <<= 65 again", t1 as i64, 4);  // 2 << (65 & 31) == 2 << 1
  var t2: u8 = 0xFF;
  t2 >>= 33;
  check("u8 >>= 33", t2 as i64, 127);
  var t3: u16 = 1;
  t3 <<= 33;
  check("u16 <<= 33", t3 as i64, 2);
  var t4: u32 = 1;
  t4 <<= 33;
  check("u32 <<= 33", t4 as i64, 2);
  var t5: u32 = 0xFFFFFFFF;
  t5 >>= 33;
  check("u32 >>= 33", t5 as i64, 0x7FFFFFFF);
  var t6: i32 = 0 - 8;
  t6 >>= 33;
  check("i32 >>= 33", t6 as i64, (0 - 4));
  var t7: u64 = 1;
  t7 <<= 65;
  check("u64 <<= 65", t7, 2);
  var t8: i64 = 0 - 8;
  t8 >>= 65;
  check("i64 >>= 65", t8, (0 - 4));
  var t9: u8 = 1;
  t9 <<= n33;
  check("u8 <<= n33", t9 as i64, 2);

  // --- the masked form is exactly the in-range count it reduces to ------
  var v1: u8 = 0x0F;
  var v2: u8 = 0x0F;
  check("u8 << 33 == u8 << 1", (v1 << 33) as i64, (v2 << 1) as i64);
  var v3: u64 = 0x0F;
  check("u64 << 65 == u64 << 1", v3 << 65, v3 << 1);
  var v4: i32 = 0 - 16;
  check("i32 >> 33 == i32 >> 1", v4 >> 33, v4 >> 1);

  // --- the common bit-index idiom is untouched: an in-range count still
  //     lands where it always did, and an overflowing one wraps at the
  //     operand width (CID-016) exactly like an add ---------------------
  var acc: u32 = 1;
  for (var k2: int = 0; k2 < 40; k2 += 1) {
    acc <<= 1;          // wraps at 32 bits, an in-range count every time
  }
  check("loop << 1 x40", acc as i64, 0);
  var acc8: u8 = 1;
  for (var k3: int = 0; k3 < 9; k3 += 1) {
    acc8 <<= 1;         // 8 bits: the ninth shift is already zero
  }
  check("loop << 1 x9 on u8", acc8 as i64, 0);

  // The two count registers differ, and the pair below pins that contrast:
  // a 32-bit operand reduces 33 to 1 and so doubles, while a 64-bit one keeps
  // 33 and shifts the value out past its 64 bits (2^33 << 33 == 2^66, which
  // truncates to 0). The WIDTH truncates the result, never the count.
  var acc2: u64 = 1;
  acc2 <<= 33;
  check("u64 <<= 33 once", acc2, 0x200000000);
  acc2 <<= 33;
  check("u64 <<= 33 twice truncates", acc2, 0);
  var acc3: u32 = 1;
  acc3 <<= 33;
  check("u32 <<= 33 once", acc3 as i64, 2);
  acc3 <<= 33;
  check("u32 <<= 33 twice", acc3 as i64, 4);

  if (fails > 0) {
    print("FAILED checks: ");
    printInt(fails);
    puts("");
    exit(1);
  }
  puts("PASS: shift-count masking is one rule on every backend");
  return 0;
}
