// CIDER-BUG-177: an array literal directly in return position takes the
// declaration-time semantics of the DECLARED return shape, exactly like a
// declaration (`var a: [T;n] = [...]`), an assignment (`a = [...]`) or a
// call argument (`f([...])`). Before the fix visit(ReturnStmt) ran the
// context-free visit(ListExpr), which types every list as a flat `*T`, so
// the compatibility test saw `*int` where the function returns `[int;2]`
// and rejected every return-position list literal; ir_gen would then have
// copied a buffer sized from the first element's own type into the sret
// slot. Covers flat scalars, narrow and wide element widths, runtime
// element expressions, nested rows, alias and alias-of-alias return
// spellings, by-value struct and class elements, fn-pointer elements and
// interface elements, plus copy independence (mutating the callee's
// returned array must not be observable through a second call) — on all
// three backends (VM unopt, VM optimized, native).
type Row = [u8; 3];
type RowAlias = Row;
type DeepAlias = RowAlias;
type Words = [u16; 3];
type Rows = [Row; 2];
type Wide = [u16; 4];

struct S8 { var a: int; var b: int; }
class C16 { var a: int; var b: int; var c: int; var d: int; }

interface Shape {
  func area() -> int;
}

class Sq {
  var side: int;
  func area() -> int { return (*self).side * (*self).side; }
}

// CIDE-ISSUE: an interface-typed element is a 16-byte fat pointer. The
// implementors are module-level globals so the element's data word stays
// valid after the callee's frame dies (returning an array whose element
// data word is a dead frame slot is a separate, pre-existing gap), and so
// the two rows are distinct objects.
var g_s1: Sq = Sq { side: 0 };
var g_s2: Sq = Sq { side: 0 };

// --- flat scalar rows -------------------------------------------------------

func ints() -> [int; 2] { return [ 1, 2 ]; }

func zero() -> [int; 3] { return [ 0, 0, 0 ]; }

func runtimeElems(n: int) -> [int; 3] { return [ n, n + 1, n * 2 ]; }

// --- narrow and wide element widths -----------------------------------------

func bytes() -> [u8; 3] { return [ 1, 2, 255 ]; }

func words() -> Words { return [ 1, 2, 65535 ]; }

// --- alias spellings --------------------------------------------------------

func viaAlias() -> Row { return [ 10, 20, 30 ]; }

func viaAliasOfAlias() -> DeepAlias { return [ 40, 50, 60 ]; }

func viaWideAlias() -> Wide { return [ 1, 2, 3, 4 ]; }

// --- nested rows ------------------------------------------------------------

func nested() -> [[int; 2]; 2] { return [ [ 1, 2 ], [ 3, 4 ] ]; }

func nestedAlias() -> Rows { return [ [ 7, 8, 9 ], [ 10, 11, 12 ] ]; }

// --- by-value aggregate elements (class / struct) ---------------------------

func structs() -> [S8; 2] {
  var p: S8 = S8 { a: 11, b: 22 };
  var q: S8 = S8 { a: 33, b: 44 };
  return [ p, q ];
}

func classes() -> [C16; 2] {
  var p: C16 = C16 { a: 1, b: 2, c: 3, d: 4 };
  var q: C16 = C16 { a: 5, b: 6, c: 7, d: 8 };
  return [ p, q ];
}

// --- fn-pointer elements ----------------------------------------------------

func inc(x: int) -> int { return x + 1; }
func dbl(x: int) -> int { return x * 2; }

func fns() -> [*func(int) -> int; 2] { return [ &inc, &dbl ]; }

// --- interface elements -----------------------------------------------------

func shapes() -> [Shape; 2] {
  g_s1.side = 3;
  g_s2.side = 4;
  var i1: Shape = g_s1;
  var i2: Shape = g_s2;
  return [ i1, i2 ];
}

// --- helpers ----------------------------------------------------------------

func sumRow(a: Row) -> int { return (a[0] + a[1] + a[2]) as int; }
func sumNested(a: [[int; 2]; 2]) -> int {
  return a[0][0] + a[0][1] + a[1][0] + a[1][1];
}

func main() -> int {
  // Flat scalars.
  var a: [int; 2] = ints();
  if (a[0] != 1) { return 1; }
  if (a[1] != 2) { return 2; }

  var z: [int; 3] = zero();
  if (z[0] != 0 || z[2] != 0) { return 3; }

  // Runtime element expressions: every element store must run.
  var r: [int; 3] = runtimeElems(10);
  if (r[0] != 10) { return 4; }
  if (r[1] != 11) { return 5; }
  if (r[2] != 20) { return 6; }

  // Narrow (8-bit) elements: the declared width must be honoured, so a
  // full-word store would corrupt the neighbouring element.
  var b: [u8; 3] = bytes();
  if (b[0] != 1) { return 7; }
  if (b[1] != 2) { return 8; }
  if (b[2] != 255) { return 9; }

  // Wide (16-bit) elements.
  var w: Words = words();
  if (w[0] != 1) { return 10; }
  if (w[1] != 2) { return 11; }
  if (w[2] != 65535) { return 12; }

  // Alias and alias-of-alias return spellings.
  var ra: Row = viaAlias();
  if (sumRow(ra) != 60) { return 13; }
  var da: DeepAlias = viaAliasOfAlias();
  if (sumRow(da) != 150) { return 14; }
  var wa: Wide = viaWideAlias();
  if (wa[0] != 1 || wa[2] != 3 || wa[3] != 4) { return 15; }

  // Nested rows: each row must be copied as bytes, not as a pointer word.
  var n: [[int; 2]; 2] = nested();
  if (sumNested(n) != 10) { return 16; }
  var na: Rows = nestedAlias();
  if (sumRow(na[0]) != 24) { return 17; }
  if (sumRow(na[1]) != 33) { return 18; }

  // By-value struct elements (exactly one word wide).
  var s: [S8; 2] = structs();
  if (s[0].a != 11 || s[0].b != 22) { return 19; }
  if (s[1].a != 33 || s[1].b != 44) { return 20; }

  // Wider-than-a-word class elements.
  var c: [C16; 2] = classes();
  if (c[0].a != 1 || c[0].d != 4) { return 21; }
  if (c[1].a != 5 || c[1].d != 8) { return 22; }

  // fn-pointer elements: the raw code pointers must survive the copy.
  var f: [*func(int) -> int; 2] = fns();
  var f0: *func(int) -> int = f[0];
  var f1: *func(int) -> int = f[1];
  if ((*f0)(5) != 6) { return 23; }
  if ((*f1)(5) != 10) { return 24; }

  // Interface elements: both fat-pointer halves must be copied.
  var sh: [Shape; 2] = shapes();
  if (sh[0].area() != 9) { return 25; }
  if (sh[1].area() != 16) { return 26; }

  // Copy independence: mutating one returned array must not be visible
  // through the next call (the literal is materialised fresh each time).
  var m1: [int; 2] = ints();
  m1[0] = 99;
  var m2: [int; 2] = ints();
  if (m2[0] != 1) { return 27; }

  // A return-position literal is also a by-value argument.
  if (sumNested(nested()) != 10) { return 28; }

  return 0;
}
