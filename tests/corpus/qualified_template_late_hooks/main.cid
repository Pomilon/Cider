// CIDER-BUG-111: the same shapes declared directly in the root module, whose
// own `import late_lib` also comes after their uses.
import wrap;

func main() -> int {
  if (wrap.bodyUsed() != 42) { return 1; }
  if (wrap.bodyUnused() != 1) { return 2; }
  if (wrap.bodyBareUsed() != 7) { return 3; }
  if (wrap.fieldUsed() != 65) { return 4; }
  if (wrap.classFieldUsed() != 4) { return 5; }
  if (wrap.aliasUsed() != 9) { return 6; }

  var r: late_lib.Triple<int> = late_lib.Triple<int> { a: 1, b: 2, c: 3 };
  if (r.a + r.b + r.c != 6) { return 7; }
  var _unused: late_lib.Triple<char> = late_lib.Triple<char> { a: 'x', b: 'y', c: 'z' };
  if (sizeof(late_lib.Triple<int>) != 12) { return 8; }
  return 0;
}

import late_lib;
