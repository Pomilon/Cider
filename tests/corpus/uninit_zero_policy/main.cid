from std.alloc import operator new, operator delete, malloc;
// CIDER-BUG-215: reads of never-initialized storage must observe the SAME
// value on all three backends. This pins the value, not just the agreement.
//
// THE BUG. std.alloc marks a block as "on the free list" by stamping
// CANARY_VAL over the first 8 bytes of its PAYLOAD, and mmap_arena stamps it
// at `arena + 16` to bootstrap the free list. The block header is 16 bytes
// (size at +0, next/magic at +8), so `arena + 16` is the user-data address of
// the first block carved out of every new arena -- and nothing cleared the
// stamp when the block was handed out. CANARY_VAL is 0xFFFFFFFFFFFFFFF6, which
// reads back as -10 in the low word and -1 in the high word, so the first
// malloc of a run served the allocator's own bookkeeping to the program as if
// it were data: `var back: D = p[1]` over a never-written element read -1.
//
// Whether that happened at all depended on the run's allocation history, so
// it was not stable across backends. On the VM, mmap is emulated by a
// first-fit free list over the interpreter heap, so a program's first Cider
// arena can come out of a recycled (already-zeroed) frame chunk instead of a
// fresh extension -- and which of the two happens depends on the IR's frame
// and ALLOCA layout, which the optimizer rewrites. Native mmap(MAP_ANONYMOUS)
// gets kernel-zeroed pages. Hence the reported -1 on `cider run --no-opt`
// against 0 on `cider run` and on the native binary.
//
// The VM had the same defect one level down: its mmap emulation first-fits,
// and handed back a RETIRED FRAME'S bytes where native's mmap returns
// kernel-zeroed pages. Pinned in section 4.
//
// THE POLICY this file pins:
//   * FRESH memory reads as 0 on every backend -- a block carved from a new
//     arena, a block from a dedicated big arena, and an anonymous mmap the
//     program issues itself;
//   * `new C`, a class field with no initializer, and an ALLOCA local read 0,
//     even after the native stack has genuinely been used;
//   * the allocator's canary is never observable as data.
//
// NOT pinned, and deliberately so: the body of a RECYCLED block (one a
// previous free() returned) past the cleared canary. Those bytes hold the
// previous tenant's data, and whether a given malloc even gets that block back
// depends on free-list history, which differs per backend -- C's malloc
// contract. Defining it would mean zeroing every allocation, i.e. a
// byte-at-a-time zero fill in an interpreted allocator, which the
// MAX_TOTAL_BYTES cap test shows is not affordable: a program must be able to
// request a 1 GiB block. That is why nothing below frees anything -- with an
// empty free list every malloc first-fits virgin arena space, which is the
// defined case this file is about.
//
// Each probe is a separate function that consumes its block before returning,
// so only one Cider block is live per frame.
from std.io import print, printInt;

// The ticket's shape: one 4-byte class, so a stride or width mistake shows up
// as a shifted value rather than being masked.
class D {
    var label: int;
}

type D3 = [D; 3];

// A frame big enough that its 4096-byte bump chunk is a plausible mmap
// request, and dirtied so a recycled chunk is recognizable if one leaks.
class Dirty {
    var a: int;
    var b: int;
    var c: int;
    var d: int;
}

// Sum a fresh block of `words` ints.
func freshIntSum(words: int) -> int {
    var b: *int = malloc(words * 4) as *int;
    if (b == nilPtr) { return -1; }
    var acc: int = 0;
    for (var i: int = 0; i < words; i = i + 1) {
        acc = acc + b[i];
    }
    return acc;
}

// A dedicated arena: a request larger than ARENA_SIZE is mapped whole and
// bootstrapped without a canary stamp, which is a separate path in malloc.
func freshBigSum() -> int {
    var b: *int = malloc(2097152) as *int;
    if (b == nilPtr) { return -1; }
    var acc: int = 0;
    for (var i: int = 0; i < 64; i = i + 1) {
        acc = acc + b[i];
    }
    return acc;
}

// The ticket's program, in the shape the report used, with a positive control
// so a wrong pointer cannot pass by reading zeroed memory: the two written
// elements must round-trip and the one never-written element must be 0.
// Returns 0 on success, or the first element that did not behave.
func ticketElemCheck() -> int {
    var p: *D3 = malloc(12) as *D3;
    if (p == nilPtr) { return 1; }
    p[0].label = 7;
    p[2].label = 9;
    var back: D = p[1];
    if (p[0].label != 7) { return 2; }   // positive control
    if (p[2].label != 9) { return 3; }   // positive control
    if (back.label != 0) { return 4; }   // was the canary's high word: -1
    back.label = 99;                     // the copy is not a heap window
    if (back.label != 99) { return 5; }
    if (p[1].label != 0) { return 6; }
    // Deliberately NOT freed. Nothing in this program frees anything, so the
    // Cider free list stays empty and every later malloc first-fits virgin
    // arena space -- which is what section 2 is about. A block that HAS been
    // recycled serves its previous tenant's data, and that is the unpinned
    // case explained at the top.
    return 0;
}

// An anonymous mmap issued by the program, exactly as Cider spells it. Native
// gets kernel-zeroed MAP_ANONYMOUS pages; the VM emulates the syscall.
func rawMmapSum(size: int, words: int) -> int {
    var raw: i64 = 0;
    asm {
        "mov rax, 9"
        "xor rdi, rdi"
        "mov esi, {size}"
        "mov rdx, 3"
        "mov r10, 34"
        "mov r8, -1"
        "xor r9, r9"
        "syscall"
        "mov {raw}, rax"
    }
    if (raw <= 0) { return -1; }
    var b: *int = raw as *int;
    var acc: int = 0;
    for (var i: int = 0; i < words; i = i + 1) {
        acc = acc + b[i];
    }
    return acc;
}

func main() -> int {
    // ------------------------------------------------------------------
    // 1. The ticket's program. Its malloc is the FIRST of the run, which is
    //    the one that used to be served the arena's bootstrap canary.
    // ------------------------------------------------------------------
    var rc: int = ticketElemCheck();
    print("elem: ");
    printInt(rc);
    print("\n");
    if (rc != 0) { return 1; }

    // ------------------------------------------------------------------
    // 2. Fresh blocks from the arena, at four sizes, plus the dedicated
    //    big-arena path.
    // ------------------------------------------------------------------
    print("fresh: ");
    printInt(freshIntSum(2)); print(",");   // exactly one 8-byte canary
    printInt(freshIntSum(4)); print(",");   // 16 bytes
    printInt(freshIntSum(16)); print(",");  // a later block of the arena
    printInt(freshBigSum());                // 2 MiB, its own arena
    print("\n");
    if (freshIntSum(2) != 0 || freshIntSum(4) != 0) { return 2; }
    if (freshIntSum(16) != 0 || freshBigSum() != 0) { return 3; }

    // ------------------------------------------------------------------
    // 3. The VM's half of the bug: retire dirtied frames, then mmap. The
    //    VM's mmap first-fits and used to hand back the retired chunk's
    //    bytes; native's mmap returns kernel-zeroed pages. 4096 is exactly
    //    a retired chunk's bump size, so it comes from the same first-fit.
    // ------------------------------------------------------------------
    var d: int = dirty(8);
    print("mmap: ");
    printInt(d); print(",");
    printInt(rawMmapSum(64, 16)); print(",");
    printInt(rawMmapSum(4096, 64));
    print("\n");
    if (rawMmapSum(64, 16) != 0 || rawMmapSum(4096, 64) != 0) { return 4; }

    // ------------------------------------------------------------------
    // 4. The rest of the never-initialized surface, which already agreed and
    //    must keep agreeing: `new C`, a class field with no initializer, and
    //    an ALLOCA local. The dirty recursion above is what makes the
    //    native stack slots non-fresh, so this pins the stack case after
    //    the stack has actually been used.
    // ------------------------------------------------------------------
    var h: *D = new D;
    var v: D;
    var l: Dirty;
    print("obj: ");
    printInt(h->label); print(",");
    printInt(v.label); print(",");
    printInt(l.a); print(",");
    printInt(l.d);
    print("\n");
    if (h->label != 0 || v.label != 0 || l.a != 0 || l.d != 0) { return 5; }
    delete h;

    print("uninit_zero_policy_ok\n");
    return 0;
}

// Retire dirtied frames. Each returns its 4096-byte bump chunk to the VM free
// list, which is what a recycled mmap block would come from.
func dirty(n: int) -> int {
    var f: Dirty;
    f.a = -10; f.b = -1; f.c = -2; f.d = -3;
    if (n <= 0) { return f.a; }
    return f.b + dirty(n - 1);
}
