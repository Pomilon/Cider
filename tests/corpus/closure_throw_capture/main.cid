from std.alloc import operator new, operator delete;
// CIDER-BUG-065: the closure capture collector must walk throw/try/catch
// (and defer, match, for-in and the whole expression dispatch) so a closure
// that uses an outer local inside those statements captures it. Before the
// fix these forms failed to resolve the identifier.
//
// Every check returns a distinct non-zero exit code; the triple-differential
// harness runs VM (unoptimized and optimized) and native.

var sink: int = 0;

struct Pair { var a: int; var b: int; }

// Capture in a throw expression; the factory returns the closure.
func makeThrower(n: int) -> func() -> int {
    return func() -> int {
        try {
            throw n;
        } catch (e) {
            return e;
        }
        return -1;
    };
}

// Capture in a try body.
func makeTryBody(a: int, b: int) -> func() -> int {
    return func() -> int {
        try {
            return a + b;
        } catch (e) {
            return -1;
        }
    };
}

// Capture in a catch body.
func makeCatchBody(base: int) -> func() -> int {
    return func() -> int {
        try {
            throw 5;
        } catch (e) {
            return base + e;
        }
        return -1;
    };
}

// Nested try inside a loop; captures n.
func makeNested(n: int) -> func() -> int {
    return func() -> int {
        var acc: int = 0;
        var i: int = 0;
        while (i < 3) {
            try {
                try {
                    if (i == 1) { throw n + i; }
                } catch (inner) {
                    acc = acc + inner;
                }
                acc = acc + 1;
            } catch (outer) {
                acc = acc + 100;
            }
            i = i + 1;
        }
        return acc;
    };
}

// Rethrow using a captured variable.
func makeRethrow(step: int) -> func() -> int {
    return func() -> int {
        try {
            try {
                throw 10;
            } catch (e) {
                throw e + step;
            }
        } catch (e2) {
            return e2;
        }
        return -1;
    };
}

// The catch binding shadows a captured variable of the same name: the body
// must resolve to the binding, not to the capture.
func makeCatchShadow(seed: int) -> func() -> int {
    return func() -> int {
        var raised: int = seed + 7;
        try {
            throw raised;
        } catch (seed) {
            return seed;
        }
        return -1;
    };
}

// defer body capture.
func makeDefer(n: int) -> func() -> int {
    return func() -> int {
        defer { sink = sink + n; }
        return 0;
    };
}

// match scrutinee, arm pattern and arm body captures.
func makeMatch(k: int) -> func(int) -> int {
    return func(x: int) -> int {
        match (x) {
            k => { return x + k; }
            default => { return k - x; }
        }
        return -1;
    };
}

// for-in iterable and body captures (the iterable is a list literal using
// the capture).
func makeForEach(base: int) -> func() -> int {
    return func() -> int {
        var arr: [int; 3] = [base, base + 1, base + 2];
        var total: int = 0;
        for (var v in arr) {
            total = total + v;
        }
        return total;
    };
}

// Slice expression in a for-in iterable.
func makeSlice(base: int) -> func() -> int {
    return func() -> int {
        var arr: [int; 4] = [base, base + 1, base + 2, base + 3];
        var total: int = 0;
        for (var v in arr[1:3]) {
            total = total + v;
        }
        return total;
    };
}

// Table literal capture.
func makeTable(k: int) -> func() -> int {
    return func() -> int {
        var t: *int = { 0: k, 1: k + 1 };
        return t[1] + t[3];
    };
}

// Struct literal capture.
func makeStruct(v: int) -> func() -> int {
    return func() -> int {
        var p: Pair = Pair { a: v, b: v + 1 };
        return p.a + p.b;
    };
}

// delete on a captured-dependent local.
func makeDelete(n: int) -> func() -> int {
    return func() -> int {
        var p: *int = new int;
        *p = n;
        delete p;
        return 1;
    };
}

// A two-level closure: the inner literal uses the factory local, so the
// outer closure must pass the capture through.
func makeNestedFactory(n: int) -> func() -> func() -> int {
    return func() -> func() -> int {
        return func() -> int { return n; };
    };
}

// Captured variable used inside a throw in a nested factory closure.
func makeNestedThrow(n: int) -> func() -> func() -> int {
    return func() -> func() -> int {
        return func() -> int {
            try {
                throw n * 2;
            } catch (e) {
                return e;
            }
        };
    };
}

func main() -> int {
    var t: func() -> int = makeThrower(3);
    if (t() != 3) { return 1; }

    var tb: func() -> int = makeTryBody(20, 22);
    if (tb() != 42) { return 2; }

    var cb: func() -> int = makeCatchBody(37);
    if (cb() != 42) { return 3; }

    var nt: func() -> int = makeNested(10);
    if (nt() != 14) { return 4; }

    var rt: func() -> int = makeRethrow(5);
    if (rt() != 15) { return 5; }

    var cs: func() -> int = makeCatchShadow(30);
    if (cs() != 37) { return 6; }

    var df: func() -> int = makeDefer(4);
    if (df() != 0) { return 7; }
    if (sink != 4) { return 8; }

    var mt: func(int) -> int = makeMatch(6);
    if (mt(6) != 12) { return 9; }
    if (mt(1) != 5) { return 10; }

    var fe: func() -> int = makeForEach(10);
    if (fe() != 33) { return 11; }

    var sl: func() -> int = makeSlice(5);
    if (sl() != 13) { return 12; }

    var tt: func() -> int = makeTable(10);
    if (tt() != 21) { return 13; }

    var st: func() -> int = makeStruct(4);
    if (st() != 9) { return 14; }

    var dl: func() -> int = makeDelete(1);
    if (dl() != 1) { return 15; }

    var nf: func() -> func() -> int = makeNestedFactory(7);
    var nfi: func() -> int = nf();
    if (nfi() != 7) { return 16; }

    var nth: func() -> func() -> int = makeNestedThrow(9);
    var nthi: func() -> int = nth();
    if (nthi() != 18) { return 17; }

    return 0;
}
