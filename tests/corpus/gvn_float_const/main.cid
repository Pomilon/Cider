// CID-003: GVN keys float constants by exact IEEE-754 bits, not by a
// fixed-precision decimal rendering. It used std::to_string(double), whose
// 6-decimal output collides below 1e-6: -0.0000001 and -0.0000002 both
// render "-0.000000", share one value number, and `a == b` was optimized
// to true. Distinct constants must stay distinct at both widths; equal
// ones must still compare equal.
func main() -> int {
  // The original repro: distinct negatives that both render "-0.000000".
  var a: f64 = -0.0000001;
  var b: f64 = -0.0000002;
  if (a == b) { return 1; }
  if (a <= b) { return 2; }  // correct: a > b
  // Positive variants both render "0.000000".
  var c: f64 = 0.0000001;
  var d: f64 = 0.0000002;
  if (c == d) { return 3; }
  if (c >= d) { return 4; }  // correct: c < d
  // F32 constants must be keyed at their own width.
  var e: float = 0.0000001;
  var f: float = 0.0000002;
  if (e == f) { return 5; }
  if (e >= f) { return 6; }  // correct: e < f
  // Equal constants must still compare equal.
  var g: f64 = 0.3;
  var h: f64 = 0.3;
  if (g != h) { return 7; }
  return 0;
}
