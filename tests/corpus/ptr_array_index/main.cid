from std.alloc import operator new, operator delete, malloc, free;
// CIDER-BUG-199: `a[i]` on a pointer to a fixed array indexes by ELEMENT.
//
// The language has no `*[T; N]` spelling, so a pointer to an array only
// appears through an alias (`type A3 = [D; 3]; var a: *A3;`). Both alias
// resolvers stop at a pointer level, so `a[i]` used to keep the whole array
// as its "element": the checker typed the index as the array (every use
// rejected with "Expected A3, got int") and ir_gen scaled the index by
// getTypeSize(whole array). `a[1].label = v` in a 12-byte D[3] block stored at
// offset 12 and `a[2]` at 24 — past the allocation — while
// registerEmbeddedDestructors walks the same three elements at sizeof(D),
// so `delete a` ran finalizers over cells nobody had written. Pointer
// arithmetic (`a + 1`) scaled by the array size too, so it could not agree
// with `a[1]` either.
//
// What this pins:
//   * element stride: content round-trips, a guard tail in the same
//     allocation stays intact, and a separately allocated neighbour block
//     is never touched (a wrong stride shows up in one of the two);
//   * `delete` on a `*[T; N]` runs one finalizer per element, at the element
//     stride, seeing exactly the labels that were written, in reverse;
//   * the checker types the index as the element, so the same expressions
//     that used to be rejected compile and run;
//   * nested arrays through a pointer-to-array keep the inner dimension
//     (`type M = [[int; 2]; 3]`), and both dimensions scale correctly;
//   * alias chains (`type Chain = A3`, `type Chain2 = Chain`) and the
//     same shapes reached through a parameter, a return, a struct field and
//     a struct field's array;
//   * by-value element stores (`a[0] = s`), compound assignment
//     (`a[1] += n`) and interface element stores take the element's width
//     and the fat-pointer store;
//   * pointer arithmetic steps by the element, so `a + n` and `&a[n]` name
//     the same cell;
//   * neighbours that must stay silent: a pointer to a plain scalar, a
//     pointer to an array of pointers, and the array-VALUE spelling whose
//     element stride this ticket must not change.
// All three backends (VM unopt, VM optimized, native) must agree.
from std.io import print, printInt;

var drops: int = 0;

// A 4-byte class: the whole element is one field, so a wrong stride shows up
// as a shifted write.
class D {
    var label: int;
    func ~D() {
        drops = drops + 1;
        printInt(this.label);
        print(",");
    }
}

// A 12-byte struct, larger than the 8-byte scalar cut, so an element copy
// that used the array's size would smash its neighbour.
struct Wide {
    var a: int;
    var b: int;
    var c: int;
}

struct Nest {
    var rows: [int; 2];
    var tag: int;
}

interface Shape {
    func area() -> int;
}

class Sq {
    var s: int;
    func area() -> int { return this.s * this.s; }
}

type D3 = [D; 3];
type D3Chain = D3;
type D3Chain2 = D3Chain;
type Ints3 = [int; 3];
type Rows = [int; 2];
type M = [Rows; 3];              // nested: 3 rows of 2
type Wides2 = [Wide; 2];
type Shapes2 = [Shape; 2];
type Ptrs2 = [*int; 2];
type Holder = [*Ints3; 2];        // array of pointer-to-array

struct Box {
    var p: *Ints3;
    var q: *D3;
    var tag: int;
}

const GUARD: int = 123456789;

func fillD(a: *D3, base: int) -> void {
    a[0].label = base;
    a[1].label = base + 1;
    a[2].label = base + 2;
}

func sumD(a: *D3) -> int {
    return a[0].label + a[1].label + a[2].label;
}

func viaParam(a: *D3) -> int {
    a[1].label = 42;
    return a[1].label;
}

func makePtrs() -> *D3 {
    return malloc(12) as *D3;
}

// Read an int at `block + i` through a *int (stride 4 — the reference
// stride, independent of any pointer-to-array).
func peek(block: *int, i: int) -> int {
    return block[i];
}

func poke(block: *int, i: int, v: int) -> void {
    block[i] = v;
}

func main() -> int {
    // ------------------------------------------------------------------
    // 1. Content + guard tail in ONE allocation. `sizeof(D3) == 12`, so a
    //    guard of four ints follows the three elements. The array-sized
    //    stride wrote elements 1 and 2 into the guard (element 2 landed two
    //    words past the guard's start); the element stride leaves it whole.
    // ------------------------------------------------------------------
    var block: *int = malloc(32) as *int;
    if (block == nilPtr) { return 1; }
    poke(block, 3, GUARD);
    poke(block, 4, GUARD);
    poke(block, 5, GUARD);
    poke(block, 6, GUARD);
    var a: *D3 = block as *D3;
    fillD(a, 10);
    print("guard: ");
    printInt(peek(block, 3)); print(",");
    printInt(peek(block, 4)); print(",");
    printInt(peek(block, 5)); print(",");
    printInt(peek(block, 6));
    print("\n");
    print("sum: ");
    printInt(sumD(a));
    print("\n");
    print("cells: ");
    printInt(a[0].label); print(",");
    printInt(a[1].label); print(",");
    printInt(a[2].label);
    print("\n");
    // delete walks the same three elements at sizeof(D) — the labels it
    // reports must be exactly the ones written, in reverse.
    print("destructors: ");
    delete a;
    print("\n");
    if (drops != 3) { return 2; }
    drops = 0;

    // ------------------------------------------------------------------
    // 2. A separately allocated NEIGHBOUR must survive. The array-sized
    //    stride reached past the first block into whatever the allocator
    //    handed out next.
    // ------------------------------------------------------------------
    var n1: *Ints3 = malloc(12) as *Ints3;
    if (n1 == nilPtr) { return 3; }
    n1[0] = 111; n1[1] = 222; n1[2] = 333;
    var n2: *Ints3 = malloc(12) as *Ints3;
    if (n2 == nilPtr) { return 4; }
    n2[0] = 444; n2[1] = 555; n2[2] = 666;
    print("neighbours: ");
    printInt(n1[0]); print(","); printInt(n1[1]); print(","); printInt(n1[2]);
    print(" / ");
    printInt(n2[0]); print(","); printInt(n2[1]); print(","); printInt(n2[2]);
    print("\n");

    // ------------------------------------------------------------------
    // 3. The checker used to reject every use of the index. These
    //    statements are the regression: they only compile because the index
    //    types as the element.
    // ------------------------------------------------------------------
    var s: int = n1[1];                 // was "Expected Ints3, got int"
    var t: int = n2[2] + 1;             // index read inside an expression
    var acc: int = 0;
    for (var i: int = 0; i < 3; i = i + 1) {
        acc = acc + n1[i] + n2[i];
    }
    print("arith: ");
    printInt(s); print(","); printInt(t); print(","); printInt(acc);
    print("\n");
    n1[1] = 999;                        // was rejected by the checker
    n1[1] += 1;                         // compound assignment at the element
    print("compound: ");
    printInt(n1[1]);
    print("\n");
    if (n1[1] != 1000 || n2[2] != 666) { return 5; }

    // ------------------------------------------------------------------
    // 4. Alias chains resolve the pointee the same way.
    // ------------------------------------------------------------------
    var c0: *D3Chain = malloc(12) as *D3Chain;
    if (c0 == nilPtr) { return 6; }
    var c1: *D3Chain2 = malloc(12) as *D3Chain2;
    if (c1 == nilPtr) { return 7; }
    c1[0].label = 5;
    c1[1].label = 6;
    c1[2].label = 7;
    print("chain: ");
    printInt(c1[0].label); print(",");
    printInt(c1[1].label); print(",");
    printInt(c1[2].label);
    print("\n");
    print("chain dtor: ");
    delete c1;
    print("\n");
    if (drops != 3) { return 8; }
    drops = 0;
    // `delete c1` above already released the block; `c0` was never written.
    free(c0 as *void);

    // ------------------------------------------------------------------
    // 5. Nested arrays through a pointer-to-array: `m[i]` is a ROW, and
    //    `m[i][j]` steps by the int. The array-sized stride would have
    //    skipped two elements per row.
    // ------------------------------------------------------------------
    var m: *M = malloc(24) as *M;
    if (m == nilPtr) { return 8; }
    for (var i: int = 0; i < 3; i = i + 1) {
        for (var j: int = 0; j < 2; j = j + 1) {
            m[i][j] = i * 10 + j;
        }
    }
    print("nested: ");
    var msum: int = 0;
    for (var i: int = 0; i < 3; i = i + 1) {
        for (var j: int = 0; j < 2; j = j + 1) {
            msum = msum + m[i][j];
        }
    }
    printInt(m[0][0]); print(",");
    printInt(m[1][1]); print(",");
    printInt(m[2][0]); print(",");
    printInt(msum);
    print("\n");
    // sizeof of the whole array is unchanged; the row is the element.
    if (sizeof(M) != 24 || sizeof(Rows) != 8) { return 9; }
    var row: Rows = m[1];
    print("row: ");
    printInt(row[0]); print(","); printInt(row[1]);
    print("\n");
    free(m as *void);

    // ------------------------------------------------------------------
    // 6. By-value element stores and reads at the ELEMENT's size. A
    //    12-byte struct element: the pre-fix store copied getTypeSize(the
    //    array) = 24 bytes into one 12-byte slot.
    // ------------------------------------------------------------------
    var ws: *Wides2 = malloc(24) as *Wides2;
    if (ws == nilPtr) { return 10; }
    var w: Wide;
    w.a = 1; w.b = 2; w.c = 3;
    ws[0] = w;
    w.a = 9;
    ws[1] = w;
    var wcopy: Wide = ws[0];
    print("wide: ");
    printInt(ws[0].a); print(","); printInt(ws[0].b); print(","); printInt(ws[0].c);
    print(" / ");
    printInt(ws[1].a); print(","); printInt(ws[1].b); print(","); printInt(ws[1].c);
    print(" / ");
    printInt(wcopy.a); print(","); printInt(wcopy.b); print(","); printInt(wcopy.c);
    print("\n");
    free(ws as *void);

    // ------------------------------------------------------------------
    // 7. Interface elements keep the 16-byte fat-pointer store.
    // ------------------------------------------------------------------
    var sh: *Shapes2 = malloc(32) as *Shapes2;
    if (sh == nilPtr) { return 11; }
    var sq: Sq;
    sq.s = 5;
    sh[0] = sq;
    print("iface: ");
    printInt(sh[0].area());
    print("\n");
    free(sh as *void);

    // ------------------------------------------------------------------
    // 8. Pointer arithmetic steps by the element, so `a + n` and `&a[n]`
    //    name the same cell. (Both used to scale by the array size.)
    // ------------------------------------------------------------------
    var ap: *Ints3 = malloc(16) as *Ints3;
    if (ap == nilPtr) { return 12; }
    ap[0] = 1; ap[1] = 2; ap[2] = 3;
    // `ap + n` must name the same cell as `ap[n]`: a stride of the whole
    // array instead of the element puts the second step on the wrong word.
    var at1: *Ints3 = ap + 1;
    var at2: *Ints3 = ap + 2;
    at1[0] = 99;
    print("stride: ");
    printInt(ap[1]); print(",");      // 99: the arithmetic pointer hit ap[1]
    printInt(at2[0]); print(",");    // 3:  and the third step hit ap[2]
    printInt(at1[0] + at2[0]);
    print("\n");
    if (ap[1] != 99 || at2[0] != 3) { return 13; }
    free(ap as *void);

    // ------------------------------------------------------------------
    // 9. The same shapes through a parameter, a return, and struct fields
    //    (a pointer-to-array field and an array of them).
    // ------------------------------------------------------------------
    var bp: *D3 = makePtrs();
    if (bp == nilPtr) { return 14; }
    print("param: ");
    printInt(viaParam(bp));
    print("\n");
    free(bp as *void);

    var box: Box;
    box.p = n1;
    box.q = c0 == nilPtr ? nilPtr : c0;
    box.tag = 5;
    box.p[0] = 70;
    print("field: ");
    printInt(n1[0]); print(",");
    printInt(box.tag);
    print("\n");

    var holders: Holder;
    holders[0] = n1;
    holders[1] = n2;
    holders[0][1] = 71;
    holders[1][1] = 72;
    print("holder: ");
    printInt(n1[1]); print(",");
    printInt(n2[1]);
    print("\n");

    // A struct field holding a nested array, indexed through a pointer to
    // the whole struct.
    var nest: Nest;
    nest.rows[0] = 8;
    nest.rows[1] = 9;
    nest.tag = 3;
    var np: *Nest = &nest;
    print("nest field: ");
    printInt(np->rows[0]); print(",");
    printInt(np->rows[1]); print(",");
    printInt(np->tag);
    print("\n");

    // ------------------------------------------------------------------
    // 10. Neighbours that must stay silent: a pointer to a scalar, a
    //     pointer to an array of pointers, and the array VALUE whose element
    //     stride this ticket must not change.
    // ------------------------------------------------------------------
    var sc: *int = malloc(8) as *int;
    if (sc == nilPtr) { return 15; }
    sc[0] = 31;
    sc[1] = 32;
    print("scalar ptr: ");
    printInt(sc[0]); print(","); printInt(sc[1]);
    print("\n");
    free(sc as *void);

    var cells: [int; 4];
    var ps: *Ptrs2 = malloc(16) as *Ptrs2;
    if (ps == nilPtr) { return 16; }
    ps[0] = &cells[0];
    ps[1] = &cells[2];
    cells[0] = 81;
    cells[2] = 82;
    print("ptr elems: ");
    printInt(*ps[0]); print(","); printInt(*ps[1]);
    print("\n");
    free(ps as *void);

    // Control: the array VALUE spelling, unchanged by this ticket.
    var av: Ints3;
    av[0] = 1; av[1] = 2; av[2] = 3;
    var guard: [int; 4];
    guard[0] = GUARD; guard[1] = GUARD; guard[2] = GUARD; guard[3] = GUARD;
    print("array value: ");
    printInt(av[0]); print(","); printInt(av[1]); print(","); printInt(av[2]);
    print(" / ");
    printInt(guard[0]); print(","); printInt(guard[1]); print(",");
    printInt(guard[2]); print(","); printInt(guard[3]);
    print("\n");

    // `delete a` in section 1 already released `block`.
    free(n1 as *void);
    free(n2 as *void);
    print("ptr_array_index_ok\n");
    return 0;
}
