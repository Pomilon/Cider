from std.alloc import operator new, operator delete;
// CIDER-BUG-241: a declaration is not an expression — the struct-decl
// visitor must not name a value's type.
//
// `lastExprType_` is ir_gen's shared "type of the value the last visitor
// produced" slot: every expression visitor writes it, and the contexts that
// consume that value read it back to decide the representation. A return
// site reads it directly (`retType = lastExprType_`) and asks two shape
// questions — is the value a concrete struct to box, and is it a by-value
// aggregate to heap-copy.
//
// `visit(StructDeclStmt)` wrote the declared struct's type into that slot
// while emitting NO value. It was the only declaration visitor that did
// (ClassDecl/InterfaceDecl/EnumDecl/TypeAlias all leave it alone, and the
// checker's own StructDecl visitor does not set its `lastExprType_` either),
// so a struct declaration POISONED the type of whatever value came next. The
// first function after one inherited `Pt`, and a return of a scalar there
// boxed the constant into an aggregate return:
//
//     %v0 = call malloc, 12
//     memcpy %v0, 4, 12
//     ret %v0
//
// which read back as a pointer — 16 instead of 4 below. CIDER-FEAT-007 fixed
// one instance of this at the consumer (visit(SizeofExpr) now names its own
// int), but its own program could not observe the difference, because the
// declaration ahead of it declares the very same type sizeof reports. This
// program pins the return TYPE of each position instead, so the producer
// half is covered on its own.
//
// ORDER IS THE TEST. A declaration only poisons the value that immediately
// follows it, so each `ret*` function sits directly after its declaration,
// with no intervening declaration or function body. `struct Pt` is a
// by-value aggregate (12 bytes), so a stale `Pt` in the slot is visible as a
// wrong exit code rather than a coincidence.
from std.io import print, printInt;

// --- position 1: the first function after a struct declaration ---
// This is the exact shape of the original miscompile: `ret 4` must stay
// `ret 4`, not become a malloc + memcpy + ret of a pointer.
struct Pt { var x: int; var y: int; var z: int; }
func retType() -> int { return sizeof(int) as int; }

// --- position 2: the first function after an interface declaration ---
// The interface is a 16-byte fat-pointer aggregate, so this covers the other
// declaration kind a stale interface type would mis-type.
interface Shape {
  func area() -> int;
}
func retIface() -> int { return 4; }

// --- position 3: the first function after a class declaration ---
class Sq {
  var side: int;
  func init(v: int) { (*self).side = v; }
  func area() -> int { return (*self).side * (*self).side; }
}
func retClass() -> int { return 4; }

// --- positions 4-8: the other value-producing visitors the audit checked,
// each in return position directly after a declaration ---
struct Wide { var a: int; var b: int; var c: int; var d: int; var e: int; }
// sizeof of the poisoning type itself: 12, so a stale `int` would be as
// wrong as the reverse.
func retStruct() -> int { return sizeof(Pt) as int; }
// A binary result (visit(BinaryExpr)), a negation (visit(UnaryExpr)) and a
// ternary arm (visit(TernaryExpr)) all rebuild their own type.
func retSum() -> int { return 0 + 4; }
func retNeg() -> int { return -4; }
func retTern(c: bool) -> int { return c ? 4 : 0; }
// A cast (visit(CastExpr)).
func retCast() -> int { return 4 as int; }

// --- positions 9-11: the other contexts that read the type of the value
// they just built ---
struct Nest { var q: int; }
// Nested call: the INNER function's return type is the one mis-typed.
func inner() -> int { return 4; }
func retNested() -> int { return inner(); }
// sizeof as a call argument, where the callee parameter's declared width
// drives the conversion.
func id(x: int) -> int { return x; }
func retArg() -> int { return id(sizeof(int) as int); }
// A var-declaration initializer, the other context that reads the type of
// the value it just built.
func retLocal() -> int { var v: int = sizeof(int) as int; return v; }

func main() -> int {
  // Each check returns a distinct code so a failure names its position.
  if (retType() != 4) { return 1; }
  if (retIface() != 4) { return 2; }
  if (retClass() != 4) { return 3; }
  if (retStruct() != 12) { return 4; }
  if (retSum() != 4) { return 5; }
  if (retNeg() != -4) { return 6; }
  if (retTern(true) != 4) { return 7; }
  if (retCast() != 4) { return 8; }
  if (retNested() != 4) { return 9; }
  if (retArg() != 4) { return 10; }
  if (retLocal() != 4) { return 11; }

  // The aggregate positions still work when a value IS expected, so the fix
  // is not "stop typing aggregates" but "type the value that was produced".
  var p: Pt = Pt { x: 0, y: 0, z: 0 };
  if (sizeof(Pt) != 12) { return 12; }
  var w: Wide = Wide { a: 0, b: 0, c: 0, d: 0, e: 0 };
  if (sizeof(Wide) != 20) { return 13; }
  var sh: Shape = new Sq(5);
  if (sh.area() != 25) { return 14; }

  print("ret=");
  printInt(retType());
  print(" struct=");
  printInt(retStruct());
  print(" sum=");
  printInt(retSum());
  print(" neg=");
  printInt(retNeg());
  print(" tern=");
  printInt(retTern(true));
  print(" nested=");
  printInt(retNested());
  print(" arg=");
  printInt(retArg());
  print(" local=");
  printInt(retLocal());
  print("\n");
  return 0;
}
