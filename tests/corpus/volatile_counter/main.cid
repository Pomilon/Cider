// CIDER-BUG-061: a volatile access is observable and must execute exactly
// where written. `bump` writes through a pointer to volatile, and the loop
// re-reads the volatile local `counter` (and the volatile global `ticks`)
// every iteration. If LICM hoisted the volatile load out of the loop,
// `total` would stay 0 and the program would exit 0 instead of 15.
var ticks: volatile int = 0;

func bump(p: *volatile int) {
  *p = *p + 1;
}

func main() -> int {
  var counter: volatile int = 0;
  var total: int = 0;
  var i: int = 0;
  while (i < 5) {
    bump(&counter);
    total = total + counter;
    ticks = ticks + 1;
    i = i + 1;
  }
  return total + ticks - 5;  // 15 + 5 - 5
}
