// CIDER-BUG-063: the legacy `func(...)` type spelling must keep its
// signature, like `fn(...)`, while `func(...)` literals still produce
// closure objects for the closure call path.
//
// Triple-differential (VM unopt, VM opt, native) pins:
//   - typed indirect calls through a named function stored in a
//     `func(...)`-typed variable (int and f64 results),
//   - argument conversion from the stored signature (int -> f64),
//   - closures assigned to the same spelling (returned by a factory and
//     written as a literal) still detected and called,
//   - the `function(...)` synonym, `type` aliases and a global.

type Cb = func(int) -> int;

func inc(x: int) -> int { return x + 1; }
func toF(x: int) -> f64 { return x as f64 + 0.5; }
func half(x: f64) -> f64 { return x / 2.0; }

var g: func(int) -> int = inc;

func main() -> int {
  // Plain named function in a legacy `func(...)` variable: the stored
  // signature drives the call (the old bare marker assumed an int result).
  var fi: func(int) -> int = inc;
  if (fi(2) != 3) return 1;

  // f64 return: a stub signature would type the call as int.
  var ff: func(int) -> f64 = toF;
  if (ff(2) != 2.5) return 2;

  // Argument conversion follows the stored signature: `3` widens to f64.
  var fh: func(f64) -> f64 = half;
  if (fh(5.0) != 2.5) return 3;
  if (fh(3) != 1.5) return 4;

  // Zero-capture closures keep the closure-object call path under the
  // same spelling.
  var add40: func(int) -> int = func(x: int) -> int { return x + 40; };
  if (add40(2) != 42) return 5;

  var lit: func(int) -> int = func(x: int) -> int { return x + 1; };
  if (lit(2) != 3) return 6;

  // f64-signature closure: typed return, not the legacy assumed int.
  var dbl: func(f64) -> f64 = func(x: f64) -> f64 { return x * 2.0; };
  if (dbl(1.5) != 3.0) return 7;

  // `function(...)` synonym and a `type` alias of the legacy spelling.
  var syn: func(int) -> int = inc;
  if (syn(2) != 3) return 8;
  var ali: Cb = inc;
  if (ali(2) != 3) return 9;
  var alic: Cb = func(x: int) -> int { return x + 30; };
  if (alic(2) != 32) return 10;

  // Global `func(...)` holding a named function.
  if (g(2) != 3) return 11;

  // The `fn(...)` spelling is unaffected.
  var fnp: *func(int) -> int = &inc;
  if ((*fnp)(2) != 3) return 12;

  return 0;
}
