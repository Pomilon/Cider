// CID-019: spill-slot reuse behavioral lock.
//
// Each loop iteration runs one of two branches; each branch keeps ten
// values simultaneously live (five int registers are available), so the
// allocator spills. The two branches' live ranges are disjoint, so the
// spills recycle the same stack slots. The loop-carried `acc`/`i` must
// survive the back edge. A slot-reuse bug (a recycled slot still holding
// a live value) changes the printed result or crashes, and the
// triple-differential matrix catches it.
from std.io import printInt, print;

func churn(seed: int, rounds: int) -> int {
    var acc: int = seed;
    var i: int = 0;
    while (i < rounds) {
        if (i % 2 == 0) {
            var a0: int = acc + 1;
            var a1: int = a0 * 3 + 2;
            var a2: int = a1 * 3 + 2;
            var a3: int = a2 * 3 + 2;
            var a4: int = a3 * 3 + 2;
            var a5: int = a4 * 3 + 2;
            var a6: int = a5 * 3 + 2;
            var a7: int = a6 * 3 + 2;
            var a8: int = a7 * 3 + 2;
            var a9: int = a8 * 3 + 2;
            acc = (a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9) & 1023;
        } else {
            var b0: int = acc + 7;
            var b1: int = b0 * 3 + 5;
            var b2: int = b1 * 3 + 5;
            var b3: int = b2 * 3 + 5;
            var b4: int = b3 * 3 + 5;
            var b5: int = b4 * 3 + 5;
            var b6: int = b5 * 3 + 5;
            var b7: int = b6 * 3 + 5;
            var b8: int = b7 * 3 + 5;
            var b9: int = b8 * 3 + 5;
            acc = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 - acc) & 1023;
        }
        i = i + 1;
    }
    return acc;
}

func main() -> int {
    printInt(churn(7, 6));
    print("\n");
    return 0;
}
