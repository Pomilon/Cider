// CIDER-BUG-219: a dereference through a nil pointer is a defined runtime
// error on every backend, never a raw signal. The general case the
// nil-interface fix (CIDER-BUG-211) left open:
//
//   var p: *int = nilPtr;
//   return *p;
//
// The VM caught that only by accident, in `load`'s CIDER-BUG-059 exact-zero
// address guard, and reported the IR-shaped `vm error: load: null pointer
// dereference`; native x86 executed `mov rax, [rbx]` with rbx = 0 and died
// with SIGSEGV and NO OUTPUT at all (exit 139). The same shape diverged for a
// nil-receiver VIRTUAL_CALL, which reads the vtable out of address 0.
//
// The exact-zero test was also too weak: with a nil `p`, `p[1]` has effective
// address 8, which is inside the VM's first heap block, so the VM silently
// read the block's size header and returned 0 while native still trapped.
// So the guard has to test the POINTER, before the address arithmetic — which
// is what ir-gen now does, routing every source-level dereference through a
// pointer to the `_nil_deref_fail` runtime routine, exactly the shape
// CIDER-ISS-001 fixed for bounds and CIDER-BUG-211 for nil dispatch. Expected
// on all three paths (VM unopt, VM opt, native):
//   stderr = "vm error: null pointer dereference\n", exit = 2.
//
// Every live (non-nil) form below runs FIRST and must keep working, so the
// guard is pinned as costing a not-taken branch and nothing more. The program
// then exits non-zero with NO diagnostic, so a regression that lets a nil
// dereference through cannot accidentally match the expected output.
// Migrated to v3: `extends` spells `:`, pointer receivers spell `->`,
// class values are constructed with literals so their vtable word is set,
// and value locals spell `= uninit`. v3 has no defined runtime-error text
// (diff #19): the nil dereference traps silently on every backend, so the
// v2 `vm error: null pointer dereference` line is not blessed.
class Base {
  var n: int;
  virtual func kind() -> int { return this->n; }
}
class Derived : Base {
  override func kind() -> int { return this->n + 1; }
}
class Box {
  var a: int;
  var b: int;
  func sum() -> int { return this->a + this->b; }
  func bump() -> int { this->a = this->a + 1; return this->a; }
}
class Pair { var l: int; var r: int; }

func readThrough(p: *int) -> int { return *p; }
func writeThrough(p: *int, v: int) -> int { *p = v; return *p; }
func readIndex(p: *int, i: int) -> int { return p[i]; }
func writeIndex(p: *int, i: int, v: int) -> int { p[i] = v; return p[i]; }
func readField(b: *Box) -> int { return b->a; }
func writeField(b: *Box, v: int) -> int { b->a = v; return b->a; }
func callMethod(b: *Box) -> int { return b->sum(); }
func callVirtual(p: *Base) -> int { return p->kind(); }
func readAggregate(p: *Box) -> int { var q: Box = *p; return q.a; }

func main() -> int {
  // ---- the live path, on every shape the guard is attached to -------------
  var cell: int = 41;
  var live: *int = &cell;
  if (readThrough(live) != 41) { return 101; }
  if (writeThrough(live, 42) != 42) { return 102; }
  if (readIndex(live, 0) != 42) { return 103; }
  if (writeIndex(live, 0, 43) != 43) { return 104; }

  var box: Box = uninit;
  box.a = 7;
  box.b = 8;
  var liveBox: *Box = &box;
  if (readField(liveBox) != 7) { return 105; }
  if (writeField(liveBox, 9) != 9) { return 106; }
  if (callMethod(liveBox) != 17) { return 107; }

  var base: Base = Base { n: 5 };
  var derived: Derived = Derived { n: 6 };
  var liveBase: *Base = &derived;
  if (callVirtual(liveBase) != 7) { return 108; }   // the override runs
  if (callVirtual(&base) != 5) { return 109; }     // and the base
  if (readAggregate(liveBox) != 9) { return 110; }

  // Pointer arithmetic and a deref of a deref, both live.
  var arr: [int; 3] = uninit;
  arr[0] = 1; arr[1] = 2; arr[2] = 3;
  var walk: *int = &arr[0];
  var seen: int = 0;
  var i: int = 0;
  while (i < 3) {
    if (walk == nilPtr) { break; }
    seen = seen + *walk;
    walk = walk + 1;
    i = i + 1;
  }
  if (seen != 6) { return 111; }
  var pp: **int = &live;
  if (**pp != 43) { return 112; }

  // ---- the nil path: the first one below reports and exits ---------------
  var nilInt: *int = nilPtr;

  // 1. The ticket's reproducer verbatim.
  return *nilInt;
}
