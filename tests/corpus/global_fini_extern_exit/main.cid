// CIDER-BUG-178 regression: exiting through an `extern func exit` binding
// does NOT run the global fini.
//
// Same documented gap as `global_fini_helper_exit`, for the other
// out-of-entry exit shape: a direct binding to the host `exit` (the VM's
// `exit` builtin under `cider run`, libc `exit` on native) terminates the
// process without passing any compiler-visible exit point, so the
// `_cider_global_fini` call — which lives on entry RET sites and on
// entry-local asm exit sequences only (CIDER-BUG-137, CIDER-BUG-153) — never
// runs. The exit status still propagates (6, proving the process left via
// the binding and not by falling through to `return 0`).
//
// All three backends (VM unopt, VM optim, native): `run,`, exit 6, no `fini`.
from std.io import print;

extern func exit(code: int) -> void;

class D {
    func ~D() {
        print("fini");
    }
}

var g: D;

func main() -> int {
    print("run,");
    exit(6);
    return 0;
}
