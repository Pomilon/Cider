// CIDER-BUG-230: a MODULE-QUALIFIED concrete value stored into a
// MODULE-QUALIFIED interface-typed global (`lib.gIface = lib.rImpl;`) must
// behave exactly like the same store spelled bare inside the defining module.
//
// Root cause (two halves, one shape of missing step). The symbol collector
// never resolves the interface flag on a VARIABLE declaration — unlike a class
// field, a struct field and every function signature, which all go through
// resolveInterfaceTypeFlag — so a global's `sym->type.isInterface` is false
// and every value-read site has to recover the fat pointer BY NAME:
//   * the checker did that in visit(IdentifierExpr) only. The qualified read
//     (visitModuleMemberAccess) did not, so `lib.gIface` presented a plain
//     nominal: visit(AssignStmt) saw no interface target, skipped the shared
//     conversion rule (checkInterfaceValue) and fell through to the generic
//     areTypesCompatible path — the ticket's diagnostic, "Type mismatch in
//     assignment. Expected lib::ROther, got lib::RImpl", for two types whose
//     shapes are related;
//   * ir_gen recovered the flag by name too, but only for a struct FIELD
//     target (getMemberFieldType). A qualified global target is not a field,
//     so the store fell through to the plain aggregate path: a `rep movsb` of
//     the concrete object's 4 bytes into the 16-byte interface slot, leaving
//     the vtable word whatever BSS held. Every dispatch through the stored
//     value then hit a nil vtable — for a program the checker accepted.
//
// The fix makes both qualified paths behave like the bare ones, so the fat
// pointer is built from the CONCRETE type (`vtable_lib::ROther_lib::RImpl`,
// the same label the in-module store emits) and the CIDER-BUG-128/157 rules
// still run: canonical cross-module signature identity and export visibility.
// The companion fixture check_iface_global_store_lookalike.cid pins those
// rejections in the qualified spelling.
//
// Pinned, on all three backends:
//   * the ticket's repro: the qualified store, then dispatch through both
//     interface methods on the stored value;
//   * vtable correctness: three implementors with different tags and layouts
//     stored into the SAME global in turn, so a stale or wrong vtable label
//     shows up as a wrong tag instead of passing unnoticed;
//   * interface-to-interface copy through the qualified spelling (a fat-pointer
//     copy that must not re-label the vtable);
//   * a concrete POINTER (one indirection) — the CIDER-BUG-080 shape;
//   * alias spellings of both the interface and the implementor;
//   * the stored global read back through a cross-module call whose signature
//     the use site never spells;
//   * the in-module control agrees with the qualified store: same tag, same
//     value, same single finalization;
//   * ownership: a concrete-to-interface store ALIASES the value (it never
//     consumes it, exactly like the bare spelling), so the source global is
//     still readable and writable afterwards, and each global is finalized
//     exactly once at program exit — the trace below is that proof.
import lib;
from std.io import print;

// Alias spellings of lib's interface and of one of its implementors.
type QI = lib.ROther;
type QA = lib.RImpl;

func main() -> int {
  // --- the ticket's repro -------------------------------------------------
  lib.rImpl.v = 42;
  lib.rQuiet.s = 17;
  lib.rSpot.p = 5;

  lib.gIface = lib.rImpl;
  if (lib.gIface.o() != 42) { return 1; }
  if (lib.gIface.tag() != 7) { return 2; }

  // --- vtable correctness: three implementors, one global, in turn -------
  lib.gIface = lib.rQuiet;
  if (lib.gIface.o() != 17 || lib.gIface.tag() != 13) { return 3; }
  lib.gIface = lib.rSpot;
  if (lib.gIface.o() != 5 || lib.gIface.tag() != 21) { return 4; }
  // Back to the first one: the vtable must follow the store, not the last
  // concrete type that happened to be stored before it.
  lib.gIface = lib.rImpl;
  if (lib.gIface.o() != 42 || lib.gIface.tag() != 7) { return 5; }

  // --- interface to interface, qualified on both sides --------------------
  lib.gCopy = lib.gIface;
  if (lib.gCopy.o() != 42 || lib.gCopy.tag() != 7) { return 6; }
  // The copy is independent storage: storing into it must not disturb the
  // original.
  lib.gCopy = lib.rQuiet;
  if (lib.gCopy.tag() != 13) { return 7; }
  if (lib.gIface.tag() != 7) { return 8; }

  // --- a concrete pointer (CIDER-BUG-080's one-indirection shape) ---------
  var p: *lib.RImpl = &lib.rImpl;
  lib.gIface = p;
  if (lib.gIface.o() != 42 || lib.gIface.tag() != 7) { return 9; }

  // --- alias spellings ----------------------------------------------------
  // A qualified store of a concrete VALUE (the frame-slot shape), an alias
  // spelling of the interface holding a copy of the result, and an
  // alias-spelled concrete stored back through the qualified spelling.
  var local: QA = lib.RImpl { v: 0 };
  local.v = 8;
  lib.gIface = local;
  var aliased: QI = lib.gIface;
  if (aliased.o() != 8 || aliased.tag() != 7) { return 10; }
  // The copy names the OBJECT, not the slot it was read from: a later store
  // into the global does not move it.
  lib.gIface = lib.rImpl;
  if (aliased.o() != 8) { return 11; }
  if (lib.gIface.o() != 42 || lib.gIface.tag() != 7) { return 12; }

  // --- the stored global read back through a cross-module call -----------
  // `peek()` names lib's interface in lib's own signature, so the qualified
  // global reaches an imported function through a signature the use site never
  // spells. The bare store in lib is the control: both must report the same
  // value and the same tag.
  if (lib.peek() != 4207) { return 13; }

  // --- the in-module control agrees --------------------------------------
  if (lib.seedIface() != 42) { return 14; }
  if (lib.gIface.o() != 42 || lib.gIface.tag() != 7) { return 15; }

  // --- ownership: the store aliased the value, it did not consume it ------
  if (lib.rImpl.v != 42) { return 16; }
  lib.rImpl.v = 43;
  if (lib.rImpl.v != 43) { return 17; }
  if (lib.gIface.o() != 43) { return 18; }
  lib.rImpl.v = 42;

  // The three implementor globals are finalized exactly once, at program exit
  // — the A/C/B trace in expected.json (the globals' own release order, which
  // no store depends on). A store that consumed, cloned or double-released
  // its source would change it.
  print("crossmod_iface_global_store_ok\n");
  return 0;
}