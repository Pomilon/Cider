// CIDER-BUG-077: interface-returning functions in an imported module — the
// callee's bare `Shape` return spelling must survive canonicalization at the
// call site so the imported result keeps its fat-pointer representation.
export interface Shape {
  func area() -> int;
}

export class Sq {
  var s: int;
  func init(s: int) -> void { this.s = s; }
  func area() -> int { return this.s * this.s; }
}

export func id(x: Shape) -> Shape { return x; }

export func make(v: int) -> Shape {
  var c: Sq;
  c.init(v);
  return c;
}

export func areaOf(x: Shape) -> int { return x.area(); }
