// CIDER-BUG-073: a module exporting struct templates that another module
// uses through the qualified spelling (`box.Box<int>`). The module's own
// factory keeps the from-import/bare spelling, so both spellings must name
// the same instantiation.
export struct Box<T> {
  var v: T;
  var tag: int;
}

export struct Pair<A, B> {
  var a: A;
  var b: B;
}

// CIDER-BUG-095: a function template used through the qualified call
// spelling (`box.id<int>(x)`) as well as the bare/from-import spelling.
export func id<T>(x: T) -> T {
  return x;
}

export func makeBox(n: int) -> *Box<int> {
  var b: *Box<int> = new Box<int>;
  b->v = n;
  b->tag = 5;
  return b;
}
