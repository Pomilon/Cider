from std.alloc import operator new, operator delete;
// CIDER-BUG-184 regression: ownership of the heap box behind an
// interface-typed return of a concrete VALUE.
//
// `return <concrete value>` for an interface return cannot hand back the
// callee's frame address, so ir_gen copies the value into a heap box. The
// box belongs to the CALLER: every interface-returning call site (direct
// and vtable-dispatched) registers a release, and the box is freed — after
// its destructors — at the exit of the scope enclosing the call, exactly
// like the CIDER-BUG-137/156 caller-owned return temporaries. The box
// header carries the type-erased release thunk (the boxed value's
// destructors in CIDER-BUG-088 order, then the block's free), so the
// caller needs no static knowledge of the concrete type.
//
// Pinned here, on all three backends (VM --no-opt, VM optimized, native):
//   * the boxed class's OWN destructor runs exactly once per box, at the
//     enclosing scope exit — after the last use of the value;
//   * the EMBEDDED destructors of the boxed value (a class-valued field
//     with its own destructor) run in the same release, own destructor
//     first, then the field (CIDER-BUG-088 order), both on the callee's
//     local copy and on the boxed copy;
//   * a chain of interface returns (one box, several caller temporaries)
//     releases exactly once — the last holder claims ownership;
//   * a concrete POINTER source passes its address through untouched: the
//     release must not free the aliased object even when the interface
//     value outlives the call's own scope;
//   * a vtable-dispatched interface method returning an interface boxes
//     the same way and releases at the dispatch site's scope.
//
// `drops` counts every destructor (callee locals, boxed copies) and the
// printed trace pins the destruction ORDER; a double release corrupts the
// allocator and fails the run on every backend.
// v3 note: v3 boxes only class pointers and refuses a class-value return
// as an interface (it would dangle), and it has no caller-owned box
// release or scope-exit destruction (only explicit delete/fini finalize).
// The v2 trace this program pins is therefore not expressible and is not
// blessed; the file keeps the v2 `~Sq`/`~Dropper`/`~Wrap` spellings as
// the loud witness.
from std.io import print, printInt;

var drops: int = 0;

interface Shape {
  func area() -> int;
  func kind() -> int;
}

class Sq {
  var s: int;
  var pad: [u64; 8];
  func ~Sq() { drops = drops + 1; print("S"); }
  func init(s: int) -> void { this.s = s; }
  func area() -> int { return this.s * this.s; }
  func kind() -> int { return 1; }
}

class Rect {
  var w: int;
  var h: int;
  func init(w: int, h: int) -> void { this.w = w; this.h = h; }
  func area() -> int { return this.w * this.h; }
  func kind() -> int { return 2; }
}

// Embedded destructor inside the boxed value: Wrap's own finalizer runs
// first, then the Dropper field (CIDER-BUG-088 order) — on the callee's
// local AND on the boxed copy at the caller's scope exit.
class Dropper {
  var label: int;
  func ~Dropper() { drops = drops + 1; print("D"); printInt(this.label); print(";"); }
}

class Wrap {
  var w: int;
  var d: Dropper;
  func ~Wrap() { drops = drops + 1; print("W"); }
  func area() -> int { return this.w; }
  func kind() -> int { return 3; }
}

// The identity case: the interface parameter comes back as a fat-pointer
// copy of the caller's own box (chain of one box, two temporaries).
func id(x: Shape) -> Shape { return x; }

// The boxing site: a satisfying concrete VALUE.
func makeSq(v: int) -> Shape {
  var c: Sq;
  c.init(v);
  return c;
}

// A satisfying concrete POINTER: the address passes through, no box.
func makeRect(w: int, h: int) -> Shape {
  var r: Rect* = new Rect(w, h);
  return r;
}

func makeWrap(v: int) -> Shape {
  var o: Wrap;
  o.w = v;
  o.d.label = v;
  return o;
}

// Interface method returning an interface (vtable dispatch).
interface Maker {
  func make(v: int) -> Shape;
}

class SqMaker {
  var pad: int;
  func make(v: int) -> Shape {
    var c: Sq;
    c.init(v);
    return c;
  }
}

func main() -> int {
  // 1. Boxed value in a loop: each iteration's box dies with the
  //    iteration's scope, after the dispatch on it. Two destructor runs
  //    per call (the callee's local, then the box).
  var i: int = 0;
  while (i < 2) {
    var s: Shape = makeSq(3 + i);
    if (s.area() != (3 + i) * (3 + i)) { return 1; }
    if (s.kind() != 1) { return 2; }
    i = i + 1;
  }
  if (drops != 4) { return 3; }

  // 2. Chain: make's box travels through id's fat-pointer copy; the block
  //    releases it exactly once at exit.
  {
    var c: Shape = id(makeSq(7));
    if (c.area() != 49) { return 4; }
  }
  if (drops != 6) { return 5; }

  // 3. Concrete pointer source: no box, so the call-site release must be a
  //    no-op. The value escapes into a function-scope interface local that
  //    outlives the call's own block — if the release freed the aliased
  //    Rect, the dispatch below would read freed memory (and the box
  //    allocations afterwards would reuse it).
  var escaped: Shape;
  {
    var p: Shape = makeRect(2, 5);
    if (p.area() != 10) { return 6; }
    if (p.kind() != 2) { return 7; }
    escaped = p;
  }
  if (escaped.area() != 10) { return 8; }
  if (escaped.kind() != 2) { return 9; }
  if (drops != 6) { return 10; }

  // 4. Embedded destructors of the boxed value: own finalizer first, then
  //    the Dropper field — once for the callee's local, once for the box.
  {
    var w: Shape = makeWrap(5);
    if (w.area() != 5) { return 11; }
    if (w.kind() != 3) { return 12; }
  }
  if (drops != 10) { return 13; }

  // 5. Vtable-dispatched interface method returning an interface: the
  //    boxed result is the dispatch caller's temporary, released at the
  //    block exit.
  {
    var mk: SqMaker;
    var mm: Maker = mk;
    var m: Shape = mm.make(6);
    if (m.area() != 36) { return 14; }
    if (m.kind() != 1) { return 15; }
  }
  if (drops != 12) { return 16; }

  // 6. An interface copy of a box shares the same data word; the copy is
  //    not an owner, so the single registered release runs once.
  {
    var a: Shape = makeSq(2);
    var b: Shape = a;
    if (a.area() != 4) { return 17; }
    if (b.area() != 4) { return 18; }
  }
  if (drops != 14) { return 19; }

  print("\n");
  if (drops != 14) { return 20; }
  print("iface_box_ownership_ok\n");
  return 0;
}
