// CIDER-BUG-115: interface stores alias their concrete source object, so the
// stored data pointer is only live while that object is. This pins the
// lifetime cases that must keep working on all three backends after the
// may-dangle diagnostic (--warn) and the VM's observable frame reuse:
//   * an interface built from a POINTER aliases the pointed-to object;
//   * a same-frame VALUE store dies together with the interface that reads
//     it, so it is valid for the whole call;
//   * heap objects (and interfaces to them) outlive the frame that built
//     them, unaffected by the diagnostic or by frame retirement.
// The dangerous shape (a callee-local by-value object stored into storage
// that outlives the callee) is reported by `cider check --warn` and pinned
// by tests/unit/type_checker_test.cpp; its VM-observable outcome is pinned
// by tests/unit/vm_test.cpp.
interface Shape {
  func area() -> int;
  func kind() -> int;
}

class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
  func kind() -> int { return 1; }
}

class Sq {
  var s: int;
  func area() -> int { return (*self).s * (*self).s; }
  func kind() -> int { return 2; }
}

// Pointer source: the fat pointer copies the caller-owned address. `r` is
// alive for the whole call, so this is the valid retarget spelling.
func retargetPtr(p: *Shape, r: *Rect) {
  *p = r;
}

// Value source local to this frame: the interface and `r` die together, so
// the aliased address is live for every read inside the function.
func localRoundTrip() -> int {
  var r: Rect = new Rect { w: 6, h: 7 };
  var s: Shape = r;
  return s.area();
}

// Heap source: the object lives across the call that built the interface.
func heapArea() -> int {
  var hp: *Rect = alloc(sizeof(Rect), 8) as *Rect;
  (*hp).w = 3;
  (*hp).h = 4;
  var s: Shape = hp;
  return s.area();
}

func main() -> int {
  var r: Rect = new Rect { w: 2, h: 5 };
  var rp: *Rect = &r;

  // Pointer-derived interface aliases the live local.
  var s: Shape = rp;
  if (s.area() != 10) { return 1; }

  // Retarget through a pointer parameter with a pointer source.
  var t: Shape = rp;
  retargetPtr(&t, rp);
  if (t.area() != 10) { return 2; }

  // `&local` pointer target: a value store through it is same-frame.
  var u: Shape = r;
  var pu: *Shape = &u;
  var other: Rect = new Rect { w: 8, h: 9 };
  *pu = other;
  if (u.area() != 72) { return 3; }
  pu[0] = rp;
  if (u.area() != 10) { return 4; }

  // Heap object interface built inside another frame and read here.
  if (heapArea() != 12) { return 5; }
  var hp: *Rect = alloc(sizeof(Rect), 8) as *Rect;
  (*hp).w = 3;
  (*hp).h = 4;
  var hs: Shape = hp;
  if (hs.area() != 12) { return 6; }

  // Same-frame value source round trip.
  if (localRoundTrip() != 42) { return 7; }

  // A value source in a loop keeps each iteration's interface same-frame.
  var k: int = 0;
  var acc: int = 0;
  while (k < 3) {
    var step: Rect = new Rect { w: k + 1, h: 2 };
    var si: Shape = step;
    acc = acc + si.area();
    k = k + 1;
  }
  if (acc != 12) { return 8; }

  return 0;
}
