// Migrated to v3: `this.` spells `this->`.
export type Row = [u8; 2];
export type Grid = [Row; 2];

export struct Holder {
  var r: Row;
  var g: Grid;
}

export func flat(a: Row) -> int { return a[0] * 10 + a[1]; }
export func nested(a: Grid) -> int { return a[0][1] * 10 + a[1][0]; }

export interface Shape {
  func area() -> int;
}

export class Sq {
  var side: int;
  func area() -> int { return this->side * this->side; }
}

export struct IfaceHolder {
  var shapes: [Shape; 2];
}

export func total(sh: [Shape; 2]) -> int { return sh[0].area() + sh[1].area(); }
