// CIDER-ISS-013: signed division overflow (INT_MIN / -1) is DEFINED as 0
// on all three backends (VM --no-opt, VM optimized, native), extending the
// CIDER-BUG-058 division-by-zero policy. x86 idiv raises #DE on the
// overflowing quotient while the VM's raw C++ arithmetic is undefined
// behavior (trapping at 64 bits, silently widening past the destination
// width below that), so both sides guard the corner explicitly. % yields
// the exact remainder 0. Unsigned division cannot overflow; narrow signed
// dividends widen before dividing, so INT16_MIN / -1 still truncates to
// -32768 on every backend. Variable operands exercise the runtime probe;
// a literal -1 divisor exercises the constant-divisor probe path.
//
// v3: signed MIN / -1 traps at runtime (and is rejected when provable); the
// v2 defined-zero guard is purged (SEMANTICS 2.1).
func main() -> int {
  // i64 (64-bit signed path, cqo/idiv)
  var lo64: i64 = 0 - 9223372036854775807 - 1;
  var neg64: i64 = 0 - 1;
  var q64: i64 = lo64 / neg64;
  if (q64 != 0) { return 1; }
  var r64: i64 = lo64 % neg64;
  if (r64 != 0) { return 2; }

  // i32 (32-bit signed path, cdq/idiv)
  var lo32: int = 0 - 2147483647 - 1;
  var neg32: int = 0 - 1;
  var q32: int = lo32 / neg32;
  if (q32 != 0) { return 3; }
  var r32: int = lo32 % neg32;
  if (r32 != 0) { return 4; }

  // i16 (narrow signed path): widens to 32 bits, so no overflow traps;
  // the quotient 32768 truncates back to -32768, and % is exact.
  var lo16: i16 = 0 - 32767 - 1;
  var neg16: i16 = 0 - 1;
  var q16: i16 = lo16 / neg16;
  if (q16 != lo16) { return 5; }
  var r16: i16 = lo16 % neg16;
  if (r16 != 0) { return 6; }

  // i8 (narrow signed path): 128 widens and truncates back to -128.
  var lo8: i8 = 0 - 127 - 1;
  var neg8: i8 = 0 - 1;
  var q8: i8 = lo8 / neg8;
  if (q8 != lo8) { return 7; }
  var r8: i8 = lo8 % neg8;
  if (r8 != 0) { return 8; }

  // Unsigned division cannot overflow: full-range quotients compute.
  var big: u64 = 18446744073709551615;
  var one: u64 = 1;
  if (big / one != 18446744073709551615) { return 9; }
  if (big % one != 0) { return 10; }
  var au32: u32 = 4000000000;
  var maxu32: u32 = 4294967295;
  if (au32 / maxu32 != 0) { return 11; }
  if (au32 % maxu32 != 4000000000) { return 12; }

  // Compound assignment shares the same IR operations.
  var c: i64 = 0 - 9223372036854775807 - 1;
  var m: i64 = 0 - 1;
  c /= m;
  if (c != 0) { return 13; }
  c = 0 - 9223372036854775807 - 1;
  c %= m;
  if (c != 0) { return 14; }

  // A literal -1 divisor exercises the constant-divisor probe path.
  var d: i64 = 0 - 9223372036854775807 - 1;
  if (d / -1 != 0) { return 15; }
  if (d % -1 != 0) { return 16; }
  var d32: int = 0 - 2147483647 - 1;
  if (d32 / -1 != 0) { return 17; }
  if (d32 % -1 != 0) { return 18; }

  // The guard is not a blanket zeroing: neighboring quotients compute,
  // including a known-nonzero constant divisor (unguarded fast path).
  var n64: i64 = 0 - 9223372036854775807 - 1;
  if (n64 / 1 != n64) { return 19; }
  if (n64 / -2 != 4611686018427387904) { return 20; }
  if (n64 % -2 != 0) { return 21; }
  var n32: int = 0 - 2147483647 - 1;
  if (n32 / 2 != 0 - 1073741824) { return 22; }
  if (n32 % 2 != 0) { return 23; }

  return 0;
}
