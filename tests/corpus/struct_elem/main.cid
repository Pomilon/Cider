struct Task {
  var name: [char; 16];
  var state: u64;
}

var g_tasks: [Task; 4] = [0, ...];

func main() -> int {
  var i: int = 0;
  while (i < 9) {
    g_tasks[0].name[i] = 65 as char;
    i = i + 1;
  }
  g_tasks[0].name[9] = 0 as char;
  if (g_tasks[0].state != 0) { return 1; }
  g_tasks[0].state = 1;
  g_tasks[0].name[9] = 66 as char;
  if (g_tasks[0].state != 1) { return 2; }
  if (g_tasks[0].name[9] != (66 as char)) { return 3; }
  return 0;
}
