func add(a: int, b: int) -> int { return a + b; }

func main() -> int {
  var f: fn(int, int) -> int = nilPtr;
  if (f != nilPtr) { return 1; }
  f = add;
  if (f == nilPtr) { return 2; }
  if (f(1, 2) != 3) { return 3; }
  var g: fn(int, int) -> int = add;
  if (f != g) { return 4; }
  return 0;
}
