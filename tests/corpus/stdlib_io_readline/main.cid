// CIDER-CHORE-003: std.io read_line had no coverage. input.txt holds one
// line; read_line must strip the trailing newline. A second call after EOF
// returns the empty string.
//
// read_line returns a pointer into its own stack buffer, so the bytes are
// copied out immediately before any other call can reuse that frame.
from std.io import print, puts, printChar, read_line;

func main() -> int {
    var line: string = read_line();
    var keep: [char; 64];
    var p: char* = line as char*;
    var i: int = 0;
    while (p[i] != 0 as char) {
        keep[i] = p[i];
        i = i + 1;
    }
    keep[i] = 0 as char;

    print("[");
    print(keep as string);
    puts("]");

    // stdin is exhausted: read_line reports the empty string, not a stale
    // buffer.
    var rest: string = read_line();
    var empty: [char; 8];
    p = rest as char*;
    i = 0;
    while (p[i] != 0 as char) {
        empty[i] = p[i];
        i = i + 1;
    }
    empty[i] = 0 as char;
    print("<");
    print(empty as string);
    puts(">");
    printChar('!');
    printChar('\n');
    return 0;
}
