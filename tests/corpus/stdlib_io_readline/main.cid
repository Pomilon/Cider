// CIDER-CHORE-003: std.io read_line had no coverage. input.txt holds one
// line; read_line must strip the trailing newline. A second call after EOF
// returns the empty string.
//
// v3 spells I/O buffers as *char (the string model has no bytes-to-string
// cast; std.io's read_line answers a NUL-terminated heap buffer). The bytes
// are copied out through the pointer before any other call runs.
from std.io import print, puts, printChar, read_line;

func main() -> int {
    var line: *char = read_line();
    print("[");
    var i: int = 0;
    while (line[i] != (0 as char)) {
        printChar(line[i]);
        i = i + 1;
    }
    puts("]");

    // stdin is exhausted: read_line reports the empty string, not a stale
    // buffer.
    var rest: *char = read_line();
    print("<");
    var k: int = 0;
    while (rest[k] != (0 as char)) {
        printChar(rest[k]);
        k = k + 1;
    }
    puts(">");
    printChar('!');
    printChar('\n');
    return 0;
}
