// Migrated to v3: try/catch/throw are purged from the core language
// (Unified Standard line 644), so the v2 exception-unwinding section is
// dropped; the four defer-nesting cases remain.
from std.io import printInt, print;

// CIDER-BUG-210: `defer` bodies may still be arbitrarily nested inside
// blocks, branches and loops, and a `defer` written in a defer body still
// unwinds at its own block's exit (the rejection added with this fix covers
// CONTROL TRANSFER out of a defer body, not nested defers). This program is
// the positive half of that rule: it must keep behaving exactly as it did
// before the unwinder gained its re-entrancy guard.

var out: int = 0;

func digit(d: int) -> void { out = out * 10 + d; }

// A defer inside a defer body, behind a taken branch: the inner defer runs
// at the branch's exit, then the rest of the outer body.
func deferInBranch() -> void {
    out = 0;
    defer {
        if (true) { defer { digit(1); } }
        digit(2);
    }
    // 12
}

// The same shape behind a branch that is not taken: the inner defer is
// registered and discarded with the branch, so only the outer body runs.
func deferInDeadBranch() -> void {
    out = 0;
    defer {
        if (false) { defer { digit(1); } }
        digit(2);
    }
    // 2
}

// A defer inside a loop inside a defer body: one run per iteration, LIFO
// against the outer body, which runs once at the function's exit.
func deferInLoop() -> void {
    out = 0;
    defer {
        for (var i: int = 0; i < 3; i++) { defer { digit(1); } }
        digit(2);
    }
    // 1112
}

// A defer inside a defer body that is itself reached by a `return`: the
// outer body runs its own pending defer first, then the return.
func outerReturn() -> int {
    out = 0;
    defer { { defer { digit(1); } } }
    if (true) { return 7; }
    return 0;
}

func main() -> int {
    deferInBranch();
    print("branch="); printInt(out); print("\n");

    deferInDeadBranch();
    print("dead="); printInt(out); print("\n");

    deferInLoop();
    print("loop="); printInt(out); print("\n");

    var r: int = outerReturn();
    print("ret="); printInt(out); print("/"); printInt(r); print("\n");

    return 0;
}
