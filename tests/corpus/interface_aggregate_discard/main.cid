// CIDER-BUG-206 companion: the DISCARDED-result half of the bug, isolated.
//
// The main regression program (tests/programs/interface_aggregate_return)
// type-checks clean on both the fixed and the unfixed compiler only when the
// checker accepts the useful shapes — and on the unfixed compiler that check
// FAILS, so the run never happens and the silent path stays unexercised.
//
// This program is deliberately built so the UNFIXED compiler accepts it: a
// discarded call's result is never bound to a typed destination, and the
// unfixed checker types an interface dispatch as a bare `int`, which no
// statement here depends on. So on the unfixed compiler this program
// COMPILES and then miscompiles — the callee was emitted with the hidden sret
// parameter while the dispatch call site passed no slot, so the callee's
// prologue stored the receiver into `__sret`, read the never-set `%__sret`
// register as `this` and died with "read of unset register %this" (a native
// SIGSEGV) at the FIRST discarded aggregate dispatch.
//
// Everything here is therefore reachable pre-fix, and the expected result is
// a clean exit 0 on VM unoptimized, VM optimized and native.
//
// Covered: discarded struct, class, nested-array and array-of-class results,
// from two implementors of the same interface, a destructor-bearing class
// result, a discarded result next to a live one, and repeated discards around
// a call that churns the frame. The already-working interface-typed and
// scalar returns stay pinned on the same lowering.
from std.io import print, printInt;

struct Pair {
    var a: int;
    var b: int;
}

type Row = [int; 2];

interface Shape {
    func area() -> int;
}

interface Maker {
    func makePair(n: int) -> Pair;
    func makeRow(n: int) -> Row;
    func makeNested(n: int) -> [[int; 2]; 2];
    func makeCells(n: int) -> [int; 2];
    func makeShape() -> Shape;
    func twice(n: int) -> int;
}

class Sq {
    var s: int;
    func init(x: int) -> void { this.s = x; }
    func area() -> int { return this.s * this.s; }
}

class MakerA {
    var pad: int;
    func init(p: int) -> void { this.pad = p; }
    func makePair(n: int) -> Pair {
        var r: Pair;
        r.a = n;
        r.b = n + this.pad;
        return r;
    }
    func makeRow(n: int) -> Row { return [n, n + this.pad]; }
    func makeNested(n: int) -> [[int; 2]; 2] { return [[n, n + 1], [n + 2, n + this.pad]]; }
    func makeCells(n: int) -> [int; 2] { return [n, n + this.pad]; }
    func makeShape() -> Shape {
        var sq: Sq;
        sq.init(this.pad);
        return sq;
    }
    func twice(n: int) -> int { return n * 2; }
}

class MakerB {
    var pad: int;
    func init(p: int) -> void { this.pad = p; }
    func makePair(n: int) -> Pair {
        var r: Pair;
        r.a = n * 100;
        r.b = n * 100 + this.pad;
        return r;
    }
    func makeRow(n: int) -> Row { return [n * 100, n * 100 + this.pad]; }
    func makeNested(n: int) -> [[int; 2]; 2] { return [[n * 100, n * 101], [n * 102, n * 100 + this.pad]]; }
    func makeCells(n: int) -> [int; 2] { return [n * 100, n * 100 + this.pad]; }
    func makeShape() -> Shape {
        var sq: Sq;
        sq.init(this.pad + 1);
        return sq;
    }
    func twice(n: int) -> int { return n * 2 + this.pad; }
}

var drops: int = 0;

class Owned {
    var tag: int;
    func init(t: int) -> void { this.tag = t; }
    func ~Owned() {
        drops = drops + 1;
        print("D,");
        printInt(this.tag);
        print(",");
    }
}

interface Factory {
    func make(t: int) -> Owned;
}

class OwnedFactory {
    func make(t: int) -> Owned {
        var o: Owned;
        o.init(t);
        return o;
    }
}

func churn(n: int) -> int {
    var acc: int = 0;
    for (var k: int = 0; k < n; k = k + 1) {
        acc = acc + k;
    }
    return acc;
}

func main() -> int {
    var a: MakerA;
    a.init(1);
    var b: MakerB;
    b.init(2);
    var ma: Maker = a;
    var mb: Maker = b;

    // The shapes that already worked still work.
    var sh: Shape = ma.makeShape();
    if (sh.area() != 1) { return 1; }
    if (ma.twice(21) != 42) { return 2; }
    if (mb.twice(21) != 44) { return 3; }

    // Discarded struct results, both implementors. The unfixed compiler
    // dies inside the callee on the very first one of these.
    ma.makePair(5);
    mb.makePair(5);
    ma.makePair(6);
    mb.makePair(6);

    // Discarded fixed-array results.
    ma.makeRow(7);
    mb.makeRow(7);
    ma.makeCells(7);
    mb.makeCells(7);

    // Discarded nested fixed arrays.
    ma.makeNested(1);
    mb.makeNested(1);
    ma.makeNested(2);
    mb.makeNested(2);

    // Repeated discards around a call that churns the frame, so an
    // undersized or mis-placed slot is caught rather than accidentally
    // reading values the callee happened to leave behind.
    churn(200);
    ma.makePair(8);
    mb.makeRow(8);
    churn(500);
    ma.makeNested(3);
    mb.makeCells(8);
    churn(1000);

    // A discarded result interleaved with a live one: the two sites must not
    // share a slot. (The live read is a plain int-shaped interface result,
    // which the unfixed compiler also types, so this stays reachable
    // pre-fix and the crash still happens first.)
    ma.makePair(9);
    var s2: Shape = mb.makeShape();
    ma.makeRow(9);
    if (s2.area() != 9) { return 4; }
    mb.makePair(9);
    var s3: Shape = ma.makeShape();
    if (s3.area() != 1) { return 5; }

    // A destructor-bearing class result, all discarded: the caller-owned
    // slot must still be finalized, exactly like a direct non-virtual call.
    // No result is bound to a typed destination anywhere in this program, so
    // the unfixed compiler type-checks it and then miscompiles.
    var fac: OwnedFactory;
    var fp: *OwnedFactory = &fac;
    var f: Factory = fp;
    drops = 0;
    f.make(1);
    f.make(2);
    f.make(3);
    f.make(4);
    f.make(5);
    print("drops=");
    printInt(drops);
    print("\n");
    if (drops == 0) { return 7; }

    return 0;
    // f's scope then unwinds: the remaining Owned values print their drops
    // here, after the counted ones above.
}
