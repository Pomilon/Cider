// CIDER-CHORE-003: std.io printChar had no direct coverage (it was only
// reached indirectly through printInt/printF64). This pins single-character
// output, including the NUL no-op (strlen 0 => no write at all).
from std.io import printChar, puts;

func main() -> int {
    printChar('H');
    printChar('i');
    printChar('!');
    printChar('\n');
    printChar('a');
    printChar('=');
    printChar('1');
    printChar('\n');
    // A NUL char builds an empty string; print() returns without a syscall.
    printChar(0 as char);
    printChar('Z');
    printChar('\n');
    puts("printChar ok");
    return 0;
}
