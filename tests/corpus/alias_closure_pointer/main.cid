// Alias spellings of a *func(...) pointer type are the same type as the
// direct spelling, per pointer level, and every use position agrees on all
// three backends (native, VM unopt, VM opt):
//   * the bare alias        `Cb`      (one pointer)
//   * the direct spelling   `*func(int) -> int`
//   * an alias of the alias `Cb2`     (a second hop)
//   * the two-level form    `*Cb`     (a pointer to a pointer)
//
// and every use position is exercised:
//   * a `var` declaration
//   * a call through the deref      `(*p)(3)`
//   * a struct FIELD of the pointer type
//   * an ARRAY ELEMENT of the pointer type
//   * a PARAMETER of the pointer type
//   * an initializer from a function name `&double`
//   * an alias-to-alias chain
//   * a pointer-to-pointer holding `&p` and dereferencing back to a value
//
// The v2 program this replaces counted pointer levels differently: its
// `func(int) -> int` was already the raw pointer, so its `*Cb` claimed the
// same spelling as `*func(...)`. v3 keeps two shapes apart — `func(...)` is
// a callable VALUE (a closure object when it captures), `*func(...)` is a
// raw function pointer — so `Cb` names the pointer spelling and `*Cb` is one
// level above it. The v2 program's closure-slot family (`&c1` on a closure
// variable, `**Cb` through closure slots, deref of a closure pointer into a
// value) was dropped rather than blessed: v3 refuses `&closureVar` where a
// `*func(...)` is written, and a closure value is called directly, never
// through `*`. The closure shape is pinned at the end through `makeAdder`.
type Cb = *func(int) -> int;
type Cb2 = Cb;

// SysV-pinned so `&doubleSys` has the same signature on every target
// (uefi's default ABI is MS-ABI). See section 8.4.
sysv func doubleSys(x: int) -> int { return x * 2; }

struct Holder { var c: Cb; }
struct Holder2 { var c: *func(int) -> int; }
struct Holder3 { var c: Cb2; }

// A parameter: the call happens in a non-inlined callee, so the value has to
// survive the call as a plain pointer.
func viaParam(p: Cb, x: int) -> int { return (*p)(x); }
func viaParam2(p: *func(int) -> int, x: int) -> int { return (*p)(x); }
func viaParam3(p: Cb2, x: int) -> int { return (*p)(x); }

// A two-level parameter: `*p` is the pointer value itself.
func viaParamDeep(p: *Cb, x: int) -> int { var q: Cb = *p; return (*q)(x); }

func main() -> int {
  // ---- 1. the bare alias spelling ---------------------------------------
  var p1: Cb = &doubleSys;
  if ((*p1)(3) != 6) { return 101; }     // call through the deref
  if (viaParam(p1, 3) != 6) { return 104; }

  // ---- 2. the direct spelling, every position --------------------------
  var p2: *func(int) -> int = &doubleSys;
  if ((*p2)(4) != 8) { return 111; }
  if (viaParam2(p2, 4) != 8) { return 114; }

  // ---- 3. an alias of the alias (a second hop) -------------------------
  var p3: *Cb2 = &p1;
  if ((*p3)(3) != 6) { return 121; }     // deref gives the pointer value
  var d3: Cb2 = *p3;
  if ((*d3)(3) != 6) { return 123; }
  if (viaParam3(*p3, 3) != 6) { return 124; }

  // ---- 4. the two-level form -------------------------------------------
  // `*Cb` is a pointer to a slot holding a fn pointer, so `*pp` is the `Cb`
  // value and the call goes through it. This is the position the v2 bug was
  // most visible in: a dropped level made the inner deref a distinct type.
  var pp: *Cb = &p1;
  if ((*pp)(3) != 6) { return 131; }
  var d4: Cb = *pp;
  if ((*d4)(3) != 6) { return 132; }
  if (viaParamDeep(pp, 3) != 6) { return 133; }

  // ---- 5. a struct FIELD of the pointer type, per spelling -------------
  var h1: Holder = uninit;
  h1.c = &doubleSys;
  if ((*h1.c)(3) != 6) { return 141; }
  var f1: Cb = h1.c;
  if ((*f1)(3) != 6) { return 142; }

  var h2: Holder2 = uninit;
  h2.c = &doubleSys;
  if ((*h2.c)(4) != 8) { return 143; }

  var h3: Holder3 = uninit;
  h3.c = &doubleSys;
  if ((*h3.c)(5) != 10) { return 145; }

  // A field read back through a pointer to the struct is the same storage
  // reached by a different route, so a level lost on the field is caught.
  var hp: *Holder = &h1;
  var fhp: Cb = hp->c;
  if ((*fhp)(3) != 6) { return 147; }

  // ---- 6. an ARRAY ELEMENT of the pointer type -------------------------
  var arr1: [Cb; 2] = uninit;
  arr1[0] = &doubleSys;
  arr1[1] = p1;
  if ((*arr1[0])(3) != 6) { return 151; }
  var e1: Cb = arr1[1];
  if ((*e1)(3) != 6) { return 152; }

  var arr2: [*func(int) -> int; 2] = uninit;
  arr2[0] = &doubleSys;
  if ((*arr2[0])(3) != 6) { return 153; }

  var arr3: [Cb2; 2] = uninit;
  arr3[0] = &doubleSys;
  if ((*arr3[0])(3) != 6) { return 154; }

  // ---- 7. an initializer from a FUNCTION NAME ---------------------------
  // `&f` on a named function is the raw pointer, and the alias spelling must
  // be ACCEPTED where the direct one is. The three initializers name the
  // same function, so they compare equal.
  var pd: Cb = &doubleSys;
  var pd2: *func(int) -> int = &doubleSys;
  var pd3: Cb2 = &doubleSys;
  if (pd == nilPtr) { return 161; }
  if (pd2 == nilPtr) { return 162; }
  if (pd3 == nilPtr) { return 163; }
  if (pd != pd2) { return 164; }
  if (pd != pd3) { return 165; }

  // ---- 8. assignment between the spellings -----------------------------
  // A pointer written one way and read the other is the same type, so these
  // must all be assignments, not conversions. If a level were still being
  // dropped they would be distinct types and every one of these would be a
  // diagnostic instead.
  var x1: Cb = p2;              // direct -> alias
  if ((*x1)(4) != 8) { return 171; }
  var x2: *func(int) -> int = p1; // alias -> direct
  if ((*x2)(3) != 6) { return 172; }
  var x3: Cb2 = p1;             // alias -> alias-of-alias
  if ((*x3)(3) != 6) { return 173; }
  var x4: Cb = *p3;
  if ((*x4)(3) != 6) { return 174; }

  // ---- 9. closure values keep their own shape --------------------------
  // A bare `func(...)` value holds a closure object and is called directly;
  // it is not a raw pointer, so no `*` appears.
  var b1: func(int) -> int = func(x: int) -> int { return x + 7; };
  if (b1(3) != 10) { return 181; }
  var b2: func(int) -> int = func(x: int) -> int { return x + 8; };
  if (b2(3) != 11) { return 182; }

  return 0;
}
