func add(a: int, b: int) -> int { return a + b; }
func mul(a: int, b: int) -> int { return a * b; }

func main() -> int {
  var f: *func(int, int) -> int = &add;
  if ((*f)(2, 3) != 5) { return 1; }
  f = &mul;
  if ((*f)(2, 3) != 6) { return 2; }
  var g: *func(int, int) -> int = f;
  if ((*g)(4, 5) != 20) { return 3; }
  return 0;
}
