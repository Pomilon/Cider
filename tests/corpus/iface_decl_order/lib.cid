// CIDER-BUG-209 module half: the same declaration-order shapes, rooted in
// THIS module's scopes. `RemoteMaker` is declared BEFORE every type its
// signatures name — `RemoteShape`, `RemoteBox`, the `RemoteAlias` of a
// below-declared interface, and itself — so all of them were unresolvable
// while RemoteMaker's own declaration was collected. `RemoteImpl` is
// declared before `RemoteShape` too, so the class side is the stale one and
// the interface side is correct: the mirror of the same defect.
//
// The self-return hands back an interface-typed field, never a global: a
// global concrete implementor returned through an interface-typed method is a
// separate, order-independent pre-existing miscompile (see main.cid).
export struct RemoteLater {
    var lo: int;
    var hi: int;
}

export interface RemoteMaker {
    func shape() -> RemoteShape;
    func box() -> RemoteBox;
    func consume(s: RemoteShape) -> int;
    func viaAlias() -> RemoteAlias;
    func self() -> RemoteMaker;
    func structBack(n: int) -> RemoteLater;
}

// Both sides collected before the interface: the order that already worked.
export interface LateFirst {
    func wrap() -> LateTarget;
}

export class RemoteImpl {
    var pad: int;
    var alias: RemoteMaker;
    func init(p: int) -> void { this.pad = p; }
    func shape() -> RemoteShape {
        var q: RemoteSq;
        q.s = this.pad;
        return q;
    }
    func box() -> RemoteBox {
        var b: RemoteBoxImpl;
        b.init(this.pad);
        return b;
    }
    func consume(s: RemoteShape) -> int { return s.area() * 10 + s.label(); }
    func viaAlias() -> RemoteAlias {
        var r: RemoteRect;
        r.w = this.pad;
        r.h = this.pad + 1;
        return r;
    }
    func self() -> RemoteMaker { return this.alias; }
    func structBack(n: int) -> RemoteLater {
        var r: RemoteLater;
        r.lo = n;
        r.hi = n + this.pad;
        return r;
    }
    func wrap() -> LateTarget {
        var t: LateTargetImpl;
        t.init(2);
        return t;
    }
}

export class RemoteBoxImpl {
    var n: int;
    var alias: RemoteBox;
    func init(x: int) -> void { this.n = x; }
    func inner() -> RemoteShape {
        var q: RemoteSq;
        q.s = this.n;
        return q;
    }
    func depth() -> RemoteBox { return this.alias; }
}

// --- the below-declared interfaces -----------------------------------------
export interface RemoteShape {
    func area() -> int;
    func label() -> int;
}

export interface RemoteBox {
    func inner() -> RemoteShape;
    func depth() -> RemoteBox;
}

export type RemoteAlias = RemoteShape;

export interface LateTarget {
    func mark() -> int;
}

export class LateTargetImpl {
    var t: int;
    func init(x: int) -> void { this.t = x; }
    func mark() -> int { return this.t; }
}

export class RemoteSq {
    var s: int;
    func area() -> int { return this.s * this.s; }
    func label() -> int { return 1; }
}

export class RemoteRect {
    var w: int;
    var h: int;
    func area() -> int { return this.w * this.h; }
    func label() -> int { return 2; }
}
