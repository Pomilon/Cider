// CIDER-BUG-102: main imports ONLY mid; every spelling it writes is
// `mid.X`, while mid's own qualified `qlib.X` spellings must keep
// resolving in mid's defining module on all three backends.
import mid;

// Field typed by the re-exported ALIAS: the collector must follow mid's
// chain to qlib::Shape (16 bytes) instead of the 8-byte unknown default.
struct Wrapper {
  var m: mid.M;
  var tag: int;
}

// Main-file alias whose target is mid's alias: canonicalization must
// follow the chain through mid's defining module.
type N = mid.M;

func main() -> int {
  var s: mid.M = mid.mk(6, 7);  // alias spelling, direct qualified call
  var h: mid.Holder = mid.Holder { s: mid.mk(0, 0), c: mid.Col.RED };
  h.s = mid.mkAlias(2, 3);      // alias return type through mid
  h.c = mid.Col.GREEN;          // alias-qualified enum variant
  if (h.c != mid.Col.GREEN) return 96;

  var w: Wrapper = Wrapper { m: mid.mk(0, 0), tag: 0 };
  w.m = s;                      // alias-typed field store
  w.tag = 1;

  var n: N = mid.mk(1, 1);      // alias-of-alias declaration

  var sum: u64 = w.m.w + w.m.h + h.s.w + h.s.h + mid.half(s) + mid.area(h.s) + n.w + n.h;
  // 6+7 + 2+3 + 13 + 6 + 1+1 = 39
  if (sizeof(Wrapper) != 24) return 99;   // 16-byte aliased field + int, 8-aligned
  if (sizeof(mid.M) != 16) return 98;     // alias reaches qlib::Shape
  if (sizeof(mid.Holder) != 24) return 97;
  return (sum + 3) as int;                // 42
}
