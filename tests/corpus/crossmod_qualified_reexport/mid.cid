// CIDER-BUG-102: every `qlib.X` spelling below is written HERE and must
// resolve against THIS module's imports (defining-module semantics), even
// when the ultimate use site imports only `mid` and never `qlib`.
import qlib;

export type M = qlib.Shape;    // alias spelling of a struct
export type Col = qlib.Color;  // alias spelling of an enum

export struct Holder {         // direct spellings in field types
  var s: qlib.Shape;
  var c: qlib.Color;
}

export type LocalHolder = Holder;  // bare alias of the local struct

export func mk(w: u64, h: u64) -> qlib.Shape {  // direct return spelling
  var s: qlib.Shape = new qlib.Shape { w: 0, h: 0 };
  s.w = w;
  s.h = h;
  return s;
}

export func mkAlias(w: u64, h: u64) -> M {  // alias return spelling
  return mk(w, h);
}

export func half(s: M) -> u64 { return s.w + s.h; }        // alias parameter

export func area(s: qlib.Shape) -> u64 { return qlib.area(s); }  // direct param + qualified call
