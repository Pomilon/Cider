// CIDER-BUG-256 control: every FINITE recursive-template shape the
// growing-self guard must keep accepting. Recursive-by-pointer types
// are the whole point of a recursive type; mutual recursion and
// same-argument (or permuted, or concrete-nested) self-mentions all
// terminate through the active-set guard. All three backends must run
// this to exit 0.
struct Node<T> {
  var v: T;
  var next: *Node<T>;
}

struct A<T> {
  var v: T;
  var b: B<T>;
}

struct B<T> {
  var v: T;
  var a: *A<T>;
}

struct Box<T> {
  var v: T;
}

struct HasBoxed {
  var w: Box<Box<int>>;
}

struct Swapped<T, U> {
  var first: T;
  var second: U;
  var other: Swapped<U, T>;
}

struct FnSelf<T> {
  var v: T;
  var cb: *func(*FnSelf<T>) -> int;
}

struct ArrSelf<T> {
  var v: T;
  var kids: [ArrSelf<T>; 2];
}

type N2 = Node<Node<int>>;
type AB = A<int>;

func useNode(n: *Node<int>) -> int {
  return (*n).v;
}

func main() -> int {
  var a: Node<int> = Node<int> { v: 10, next: nilPtr };
  var b: Node<int> = Node<int> { v: 20, next: nilPtr };
  a.next = &b;
  var total: int = a.v + (*a.next).v;
  var m: AB = A<int> { v: 1, b: B<int> { v: 2, a: nilPtr } };
  total = total + m.v + m.b.v;
  var h: HasBoxed = HasBoxed { w: Box<Box<int>> { v: Box<int> { v: 4 } } };
  total = total + h.w.v.v;
  // Swapped<U, T> by value never bottoms out (like ArrSelf above):
  // infinitely sized and unconstructible; the declaration still pins
  // that the guard accepts the permuted self-mention.
  var n2: N2 = Node<Node<int>> { v: Node<int> { v: 7, next: nilPtr }, next: nilPtr };
  total = total + n2.v.v;
  var f: FnSelf<int> = FnSelf<int> { v: 8, cb: nilPtr };
  total = total + f.v;
  // ArrSelf<int> holds [ArrSelf<int>; 2] by value: infinitely sized and
  // unconstructible in principle, so its runtime line is dropped while the
  // declaration above still pins that the guard accepts the shape.
  total = total + useNode(&a);
  if (total != 62) { return 1; }
  return 0;
}
