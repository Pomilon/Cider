// v3 port: v3's allocator refuses with nilPtr where v2 aborted with
// fail_fast(75). A 600 MiB request passes the 1 GiB heap cap but cannot be
// mapped under this program's 512 MiB address-space limit, so the failed
// mmap answers nilPtr instead of handing out a bad address — and a small
// request mapped afterwards still works.
from std.alloc import malloc, free;

func main() -> int {
    var p: *void = malloc(629145600);
    if (p != nilPtr) return 1;
    var q: *u64 = malloc(32) as *u64;
    if (q == nilPtr) return 2;
    *q = 42;
    if (*q != 42) return 3;
    free(q);
    return 0;
}
