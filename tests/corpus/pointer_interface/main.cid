// CIDER-BUG-100: pointers to interfaces are ordinary pointers to the
// 16-byte fat-pointer slot. `var r: *Shape = &t;` must check (the two
// spellings of `*Shape` used to disagree about the interface flag), the
// deref target must take the same shared interface store as `p[0] = v`
// (data + vtable words, pointee's volatile flag), and reading/dispatching
// through `*p` must present the fat pointer's address rather than load its
// data word as a scalar.
interface Shape {
  func area() -> int;
  func kind() -> int;
}

class Sq {
  var s: int;
  func area() -> int { return (*self).s * (*self).s; }
  func kind() -> int { return 1; }
}

class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
  func kind() -> int { return 2; }
}

// Caller-owned object retarget through a callee's pointer parameter.
func retarget(p: *Shape, r: *Rect) {
  *p = *r;
}

// Dispatch through the callee's pointer while the callee is alive.
func areaThrough(p: *Shape) -> int {
  return (*p).area() + (*p).area();
}

var shared: Shape = nilPtr as Shape;

// A pointer-to-interface crossing a return type: the caller's storage.
func sharedPtr() -> *Shape {
  return &shared;
}

func main() -> int {
  var a: Sq = new Sq { s: 3 };
  var r: Rect = new Rect { w: 2, h: 5 };

  var t: Shape = a;
  var p: *Shape = &t;

  // Read and dispatch through the pointer (both spellings).
  if ((*p).area() != 9) { return 1; }
  if ((*p).area() != 9) { return 2; }
  if (areaThrough(p) != 18) { return 3; }

  // A concrete class value assigned through the deref points at the value.
  var b: Sq = new Sq { s: 4 };
  *p = b;
  if (t.area() != 16) { return 4; }

  // A concrete pointer assigned through the deref.
  *p = a;
  if (t.area() != 9) { return 5; }

  // Interface-to-interface copies through the deref, both directions.
  var q: *Shape = &t;
  var u: Shape = *q;
  *p = u;
  if (t.area() != 9) { return 6; }
  *q = *p;
  if (u.area() != 9) { return 7; }

  // The `p[0]` spelling addresses the same 16-byte slot.
  if (p[0].area() != 9) { return 8; }
  p[0] = r;
  if (t.area() != 10 || t.kind() != 2) { return 9; }

  // Callee retarget through the pointer parameter; the vtable follows.
  retarget(&t, &r);
  if (t.area() != 10 || t.kind() != 2) { return 10; }
  retarget(p, &r);
  if (t.kind() != 2) { return 11; }

  // Copies follow the retargeted value.
  var v: Shape = t;
  v = *p;
  if (v.area() != 10) { return 12; }

  // Declaration-time initialization through a deref and a second pointer.
  var w: Shape = *p;
  if (w.area() != 10) { return 13; }
  var pp: **Shape = &p;
  if ((**pp).area() != 10) { return 14; }

  // A pointer-to-interface crossing a return type, then stored through.
  shared = a;
  var sp: *Shape = sharedPtr();
  if ((*sp).area() != 9) { return 15; }
  *sp = r;
  if (shared.area() != 10 || shared.kind() != 2) { return 16; }

  return 0;
}
