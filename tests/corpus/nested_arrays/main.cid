// CIDER-BUG-052: nested fixed arrays must keep their inner dimension.
// Covers 2-D/3-D declaration, m[i][j] read/write, row copies
// (`var row: [u8; 2] = m[1];` and `m[0] = row;`), for-in over the outer
// and a middle dimension, sizeof of the array and of a row, address-of an
// element, passing/returning rows, and a struct field with a nested array.
var g: [[u8; 2]; 3] = [0, ...];
var cube: [[[u16; 2]; 2]; 2] = [0, ...];

// Alias spellings of nested arrays: a direct alias and a composed
// `[Row; N]` alias (the flat representation used to drop the outer
// dimension).
type Row = [u8; 2];
type Rows = [Row; 3];

struct Grid {
  var cells: [[u8; 2]; 2];
  var tag: u8;
}

func row_sum(row: [u8; 2]) -> int {
  var s: int = 0;
  for (var r in row) { s += r as int; }
  return s;
}

func make_row() -> [u8; 2] {
  var r: [u8; 2] = [11, 22];
  return r;
}

func main() -> int {
  // Global 2-D: write and read both dimensions.
  g[0][0] = 1; g[0][1] = 2;
  g[1][0] = 3; g[1][1] = 4;
  g[2][0] = 5; g[2][1] = 6;
  if (g[0][0] != 1 || g[1][1] != 4 || g[2][0] != 5) { return 1; }

  // Local 2-D: write both dimensions through loop variables.
  var m: [[u8; 2]; 3] = [0, ...];
  for (var i: int = 0; i < 3; i = i + 1) {
    for (var j: int = 0; j < 2; j = j + 1) {
      m[i][j] = (i * 2 + j + 1) as u8;
    }
  }
  if (m[0][0] != 1 || m[1][1] != 4 || m[2][1] != 6) { return 2; }

  // Row copy out of a nested array.
  var row: [u8; 2] = m[1];
  if (row[0] != 3 || row[1] != 4) { return 3; }

  // Row copy back into a nested array.
  m[0] = row;
  if (m[0][0] != 3 || m[0][1] != 4) { return 4; }

  // Passing a row to a function.
  if (row_sum(m[2]) != 11) { return 5; }

  // Returning a row by value.
  var made: [u8; 2] = make_row();
  if (made[0] != 11 || made[1] != 22) { return 6; }

  // For-in over the outer dimension yields rows.
  var total: int = 0;
  var count: int = 0;
  for (var r in m) {
    total += r[0] as int + r[1] as int;
    count++;
  }
  if (count != 3) { return 7; }
  if (total != 3 + 4 + 3 + 4 + 5 + 6) { return 8; }

  // sizeof of the outer array and of a row.
  if (sizeof([[u8; 2]; 3]) != 6) { return 9; }
  if (sizeof([u8; 2]) != 2) { return 10; }

  // Address-of an element, read and write through it.
  var p: *u8 = &m[1][0];
  if (*p != 3) { return 11; }
  *p = 9;
  if (m[1][0] != 9) { return 12; }

  // 3-D: read/write the innermost dimension, for-in over a middle row.
  cube[1][1][1] = 42;
  cube[0][1][0] = 7;
  if (cube[1][1][1] != 42 || cube[0][1][0] != 7) { return 13; }
  if (sizeof([[[u16; 2]; 2]; 2]) != 16) { return 14; }
  var inner: int = 0;
  for (var c in cube[1]) {
    inner += c[1] as int;
  }
  if (inner != 42) { return 15; }

  // Struct field with a nested array.
  var z2: [u8; 2] = [0, 0];
  var gr: Grid = Grid { cells: [z2, z2], tag: 0 as u8 };
  gr.cells[1][1] = 77;
  gr.tag = 5;
  if (gr.cells[1][1] != 77 || gr.tag != 5) { return 16; }
  if (sizeof(Grid) != 5) { return 17; }

  // Alias spellings: `Rows = [Row; 3]` must keep the outer dimension.
  var zr: Row = [0, 0];
  var rs: Rows = [zr, zr, zr];
  rs[0] = row;
  rs[1][0] = 1; rs[1][1] = 2;
  rs[2][0] = 5; rs[2][1] = 6;
  if (rs[0][1] != 4 || rs[2][1] != 6) { return 18; }
  var rs_total: int = 0;
  for (var r in rs) { rs_total += r[0] as int + r[1] as int; }
  if (rs_total != 3 + 4 + 1 + 2 + 5 + 6) { return 19; }

  return 0;
}
