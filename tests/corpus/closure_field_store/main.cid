// CIDER-BUG-157: a direct closure value initializes/assigns a closure-typed
// field — the field's storage already is the closure object, so no *void
// indirection is needed, exactly like locals/params/returns. A *void field
// keeps its provenance-proof path as the control. All three backends must
// agree.

type Cb = func(int) -> int;

func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

struct Ops {
  var cf: Cb;
  var cv: *void;
}

func main() -> int {
  // Struct-literal initialization from a direct closure; the *void field is
  // filled by a direct assignment (its provenance path).
  var o: Ops = Ops{cf: makeAdder(10)};
  o.cv = makeAdder(100);
  if (o.cf(5) != 15) return 1;

  // Direct assignment into an existing closure-typed field.
  o.cf = makeAdder(20);
  if (o.cf(5) != 25) return 2;

  // Direct closure through a pointer field (arrow target).
  var p: *Ops = &o;
  p->cf = makeAdder(30);
  if (o.cf(5) != 35) return 3;

  // The *void control: a proven closure behind *void still works.
  var v: Cb = o.cv as Cb;
  if (v(5) != 105) return 4;

  // A closure-valued local assigned into the field.
  var c: Cb = makeAdder(40);
  o.cf = c;
  if (o.cf(5) != 45) return 5;

  // Independence: each closure keeps its own capture.
  var a: Cb = makeAdder(1);
  var b: Cb = makeAdder(1000);
  o.cf = a;
  if (o.cf(0) != 1) return 6;
  o.cf = b;
  if (o.cf(0) != 1000) return 7;
  if (a(0) != 1) return 8;

  return 0;
}
