// CIDER-BUG-024: a global pointer initialized from a cast of a function
// name must fold to the function's address. Before the fix `*void g =
// add as *void` type-checked but silently BSS-zeroed (g == nilPtr), and
// the fn-target spelling was rejected outright.
func add(a: int, b: int) -> int { return a + b; }

var g: *void = &add as *void;
var h: *func(int, int) -> int = &add;

func main() -> int {
  if (g == nilPtr) { return 1; }
  if ((*h)(2, 3) != 5) { return 2; }
  if (g != (&add as *void)) { return 3; }
  return 0;
}
