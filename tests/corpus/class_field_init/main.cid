from std.alloc import operator new, operator delete;
from std.io import print, printInt;

// CIDER-BUG-049 regression: class field initializers must run for both
// `new C` and value-class instances on all three backends (VM unopt, VM
// optimized, native). Covers scalar fields (int/bool/u8/u64/pointer), a
// string-literal field, const/arithmetic folding, inherited fields, and
// fields WITHOUT an initializer (which stay zero).

// Migrated to v3: `extends` spells `:`, and a heap or value-class
// instance is built with a class literal that names every non-defaulted
// field (`unsetBase`/`unset` as 0); the literal runs all field defaults
// first, so the defaulted fields still see their initializers.
const BASE: int = 40;
const SHIFT: int = 2;

class Base {
  var base: int = BASE + 2;   // 42: const reference + arithmetic
  var unsetBase: int;         // no initializer: stays 0
}

class Sample : Base {
  var count: int = 1 << SHIFT;          // 4: constant arithmetic
  var flag: bool = true;
  var small: u8 = 200;
  var big: u64 = 1234567890123;
  var ptr: *int = nilPtr;
  var text: string = "field";
  var unset: int;                       // no initializer: stays 0
}

class Derived : Base {
  var own: int = 1 << SHIFT;            // 4
  var text: string = "derived";
}

// An exactly-8-byte object whose second field sits at offset 4: native
// codegen used to widen a narrow store at a nonzero offset into an
// 8-byte alloca slot to qword, clobbering the following object.
class TinyBase {
  var t0: int = 11;
}

class Tiny : TinyBase {
  var t1: int = 22;                     // offset 4
}

func main() -> int {
  // Objects are created first and every field is read before anything is
  // printed or freed, so fields without initializers see the fresh-object
  // zero state on every backend.
  var heap: *Sample = new Sample { unsetBase: 0, unset: 0 };
  var value: Sample = Sample { unsetBase: 0, unset: 0 };
  var dheap: *Derived = new Derived { unsetBase: 0 };
  var dvalue: Derived = Derived { unsetBase: 0 };
  // Adjacent 8-byte value objects: field-initializer stores must keep
  // their declared widths or the neighbours corrupt each other.
  var tinyA: Tiny = Tiny { };
  var tinyB: Tiny = Tiny { };
  var tinyHeap: *Tiny = new Tiny { };

  var h_count: int = heap->count;
  var h_flag: bool = heap->flag;
  var h_small: u8 = heap->small;
  var h_big: u64 = heap->big;
  var h_ptr: *int = heap->ptr;
  var h_unset: int = heap->unset;
  var h_base: int = heap->base;
  var h_unsetbase: int = heap->unsetBase;
  var v_count: int = value.count;
  var v_flag: bool = value.flag;
  var v_small: u8 = value.small;
  var v_big: u64 = value.big;
  var v_unset: int = value.unset;
  var v_base: int = value.base;
  var dh_base: int = dheap->base;
  var dh_unset: int = dheap->unsetBase;
  var dh_own: int = dheap->own;
  var dv_base: int = dvalue.base;
  var dv_unset: int = dvalue.unsetBase;
  var dv_own: int = dvalue.own;
  var ta0: int = tinyA.t0;
  var ta1: int = tinyA.t1;
  var tb0: int = tinyB.t0;
  var tb1: int = tinyB.t1;
  var th0: int = tinyHeap->t0;
  var th1: int = tinyHeap->t1;

  if (h_count != 4) return 1;
  if (!h_flag) return 2;
  if (h_small != 200) return 3;
  if (h_big != 1234567890123) return 4;
  if (h_ptr != nilPtr) return 5;
  if (h_unset != 0) return 6;
  if (h_base != 42) return 7;
  if (h_unsetbase != 0) return 8;
  if (v_count != 4) return 9;
  if (!v_flag) return 10;
  if (v_small != 200) return 11;
  if (v_big != 1234567890123) return 12;
  if (v_unset != 0) return 13;
  if (v_base != 42) return 14;
  // Inherited fields initialise on derived instances too.
  if (dh_base != 42) return 15;
  if (dh_unset != 0) return 16;
  if (dh_own != 4) return 17;
  if (dv_base != 42) return 18;
  if (dv_unset != 0) return 19;
  if (dv_own != 4) return 20;
  if (ta0 != 11) return 21;
  if (ta1 != 22) return 22;
  if (tb0 != 11) return 23;
  if (tb1 != 22) return 24;
  if (th0 != 11) return 25;
  if (th1 != 22) return 26;

  printInt(h_count); print("\n");
  printInt(h_small as int); print("\n");
  printInt(h_big as int); print("\n");
  printInt(v_count); print("\n");
  printInt(v_base); print("\n");
  printInt(dh_base); print("\n");
  printInt(dv_own); print("\n");
  print(heap->text); print("\n");
  print(value.text); print("\n");
  print(dheap->text); print("\n");
  print(dvalue.text); print("\n");
  printInt(ta1); print("\n");
  printInt(tb1); print("\n");
  printInt(th1); print("\n");

  delete heap;
  delete dheap;
  delete tinyHeap;
  print("class_field_init_ok\n");
  return 0;
}
