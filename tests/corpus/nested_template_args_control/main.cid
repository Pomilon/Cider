// CIDER-BUG-168 negative control: every nested-argument shape that must stay
// ACCEPTED now that the declaration-time checks recurse into argument lists.
// A walk that over-reached would break one of these; a walk that stopped at
// the first level would still pass the rejects, so all four appear here.
import lib;
from std.io import printInt;

// A known template nested in a known one, one and two levels deep, in both
// the bare and the module-qualified spelling.
type Bare1 = Wrap<One<int>>;
type Bare2 = Wrap<One<Pair<int, int>>>;
type Bare3 = Wrap<Wrap<Wrap<int>>>;
type Qual1 = lib.LibWrap<lib.LibOne<int>>;
type Qual2 = lib.LibWrap<lib.LibWrap<lib.LibOne<int>>>;

// A type argument that is itself a template TYPE reached through a `type`
// alias: the alias resolves on its own declaration, and the argument as
// written names no template, so the walk has nothing to check.
type IntPair = Pair<int, int>;
type ViaAlias = Wrap<IntPair>;

// A forward-declared template used before its definition, nested: the
// collector fills the whole template table before any spelling is checked,
// so declaration order must not matter.
type ForwardNested = Wrap<Forward<int>>;

// A recursive template that instantiates ITSELF with the same argument. The
// written spelling is finite, so the argument walk terminates after one
// level; this is the shape that must not need a depth cap.
type Recursive = Wrap<Node<int>>;

// A phantom-parameter template: its parameter appears only in the argument
// list, so a walk that stops at the head would never look at it. The
// argument is a known template, so it must stay accepted.
type Phantom = Tag<One<int>>;

struct Tag<T> {
  var n: int;
}

struct Wrap<T> {
  var v: T;
}

struct One<A> {
  var a: A;
}

struct Pair<X, Y> {
  var x: X;
  var y: Y;
}

struct Forward<T> {
  var v: T;
}

struct Node<T> {
  var v: T;
  var next: *Node<T>;
}

func sumBare1() -> int {
  var w: Bare1 = new Wrap<One<int>> { v: new One<int> { a: 1 } };
  return w.v.a;
}

func sumBare2() -> int {
  var w: Bare2 = new Wrap<One<Pair<int, int>>> { v: new One<Pair<int, int>> { a: new Pair<int, int> { x: 2, y: 3 } } };
  return w.v.a.x + w.v.a.y;
}

func sumBare3() -> int {
  var w: Bare3 = new Wrap<Wrap<Wrap<int>>> { v: new Wrap<Wrap<int>> { v: new Wrap<int> { v: 4 } } };
  return w.v.v.v;
}

func sumQual1() -> int {
  var w: Qual1 = new lib.LibWrap<lib.LibOne<int>> { v: new lib.LibOne<int> { a: 5 } };
  return w.v.a;
}

func sumQual2() -> int {
  var w: Qual2 = new lib.LibWrap<lib.LibWrap<lib.LibOne<int>>> { v: new lib.LibWrap<lib.LibOne<int>> { v: new lib.LibOne<int> { a: 6 } } };
  return w.v.v.a;
}

func sumViaAlias() -> int {
  var w: ViaAlias = new Wrap<IntPair> { v: new Pair<int, int> { x: 7, y: 8 } };
  return w.v.x + w.v.y;
}

func sumForward() -> int {
  var w: ForwardNested = new Wrap<Forward<int>> { v: new Forward<int> { v: 9 } };
  return w.v.v;
}

func sumRecursive() -> int {
  var node: Node<int> = new Node<int> { v: 11, next: nilPtr };
  var w: Recursive = new Wrap<Node<int>> { v: new Node<int> { v: 10, next: &node } };
  return w.v.v + (*w.v.next).v;
}

func sumPhantom() -> int {
  var t: Phantom = new Tag<One<int>> { n: 12 };
  return t.n;
}

func main() -> int {
  var total: int = 0;
  total = total + sumBare1();
  total = total + sumBare2();
  total = total + sumBare3();
  total = total + sumQual1();
  total = total + sumQual2();
  total = total + sumViaAlias();
  total = total + sumForward();
  total = total + sumRecursive();
  total = total + sumPhantom();
  printInt(total as int);
  if (total != 78) { return 1; }
  return 0;
}
