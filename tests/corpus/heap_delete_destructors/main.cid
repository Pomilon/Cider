from std.alloc import operator new, operator delete;
// Delete regression: deleting a class pointer runs that class's own deinit
// before releasing storage. v4 does not synthesize a recursive finalizer
// set: embedded class values are not finalized through their container, and
// a struct pointer has no destructor at all — its delete releases storage
// and finalizes nothing. All three backends (VM unopt, VM optimized, native).
//
// Pointers, slices and interfaces own nothing (delete does not follow a
// pointer into a heap subobject), and base-class destructors are not
// auto-invoked (Cider destructors are not virtual). The class cases below
// count their own deinit only; the struct cases contribute no output.
// Migrated to v3: destructors spell `deinit()` and run only through an
// explicit `delete`; every embedded field carries an explicit default
// (`D { }`, `SWrap { }`, array element literals) so a bare `new X { }`
// constructs the same zero/default state, and `this.f` spells `this->f`.
from std.io import print, printInt;

var drops: int = 0;

class D {
    var label: int = 0;
    func deinit() {
        drops = drops + 1;
        printInt(this->label);
        print(",");
    }
}

class Pair {
    var first: D = D { };
    var second: D = D { };
}

class Holder {
    var a: D = D { };
    var b: D = D { };
    func deinit() {
        print("H,");
    }
}

class Nest {
    var inner: Holder = Holder { };
    var tail: D = D { };
}

struct SWrap {
    var d: D = D { };
    var pad: int = 0;
}

struct SNested {
    var wrap: SWrap = SWrap { };
    var arr: [D; 2] = [D { }, D { }];
}

type Alias = D;
type PairAlias = Pair;

class Solo {
    func deinit() {
        print("S,");
    }
}

func heapPair() -> void {
    var p: *Pair = new Pair { };
    p->first.label = 1;
    p->second.label = 2;
    delete p;              // 2,1,
}

func heapHolder() -> void {
    var h: *Holder = new Holder { };
    h->a.label = 3;
    h->b.label = 4;
    delete h;              // H,4,3,  (own body first, then members reversed)
}

func heapNest() -> void {
    var n: *Nest = new Nest { };
    n->inner.a.label = 5;
    n->inner.b.label = 6;
    n->tail.label = 7;
    delete n;              // 7,H,6,5,
}

func heapStruct() -> void {
    var s: *SWrap = new SWrap { };
    s->d.label = 8;
    delete s;              // 8,
}

func heapStructNested() -> void {
    var s: *SNested = new SNested { };
    s->wrap.d.label = 9;
    s->arr[0].label = 10;
    s->arr[1].label = 11;
    delete s;              // 11,10,9,
}

func heapAlias() -> void {
    var d: *Alias = new Alias { };
    d->label = 12;
    delete d;              // 12,
    var p: *PairAlias = new PairAlias { };
    p->first.label = 13;
    p->second.label = 14;
    delete p;              // 14,13,
}

func heapSolo() -> void {
    var s: *Solo = new Solo { };
    delete s;              // S,  (no embedded class values)
}

func main() -> int {
    heapPair();
    heapHolder();
    heapNest();
    heapStruct();
    heapStructNested();
    heapAlias();
    heapSolo();
    print("\n");
    // Only D's body increments drops: Holder, Solo and the other class
    // bodies print without counting. Pair and Nest declare no deinit, and
    // no container finalizes embedded values.
    if (drops != 1) { return 1; }
    print("heap_delete_destructors_ok\n");
    return 0;
}
