// CIDER-BUG-076: the VM's write syscall used to leave rax at the syscall
// number for fd 1/2, so write(1, ...) reported 1 instead of the byte count
// that native returns. Pin the byte count for stdout, stderr, a zero-length
// write, and the invalid-fd error value. The exit bits name the check that
// failed.
from std.fs import write;

func main() -> int {
    var out: string = "vm-stdout\n";  // 10 bytes
    var err: string = "vm-err\n";     // 7 bytes
    var outp: *void = (&out[0]) as *void;
    var errp: *void = (&err[0]) as *void;

    if (write(1, outp, 10) != 10) { return 1; }
    if (write(2, errp, 7) != 7) { return 2; }
    if (write(1, outp, 0) != 0) { return 3; }

    // Invalid fd: raw syscalls return -EBADF (-9), not libc's -1.
    if (write(0 - 1, outp, 10) != 0 - 9) { return 4; }

    return 0;
}
