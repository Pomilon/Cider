// CIDER-CHORE-003 (v3 port): v2's std.alloc.init_heap was a no-op bootstrap
// hook for v2's own free-list allocator. v3's heap lives in the prelude and
// needs no initialisation, so there is no init_heap to call; what this pins
// is that malloc/free work afterwards.
from std.io import puts;
from std.alloc import malloc, free;

func main() -> int {
    var p: *int = malloc(16) as *int;
    if (p == nilPtr) return 1;
    *p = 1234;
    if (*p != 1234) return 2;
    free(p as *void);

    var q: *int = malloc(8) as *int;
    if (q == nilPtr) return 3;
    *q = 7;
    if (*q != 7) return 4;
    free(q as *void);

    puts("alloc_init ok");
    return 0;
}
