// CIDER-BUG-060: exported types/interfaces/functions/globals are importable
// through both `m.x` and `from m import x`; the module's unexported helper
// (`hidden_double`) stays private and is exercised only from inside lib.
import lib;
from lib import Score, Valuable, Item, Pair, Mode, BASE, calls, scoreOf, makeItem, pairSum;
from std.io import printInt, print;

func main() -> int {
  // Qualified form: module-qualified type, function and global.
  var s: lib.Score = lib.scoreOf(3, 4);   // hidden_double(3) + 4 + 30 = 40
  var i: int = lib.calls;                 // 1

  // From-import form of the same API.
  var t: Score = scoreOf(1, 1);           // 2 + 1 + 30 = 33
  var m: int = lib.Mode.ON;               // qualified enum variant

  // Exported struct type + function, struct built locally.
  var p: Pair = new Pair { a: 5, b: 6 };
  var ps: int = pairSum(p);               // 11

  // Exported class value; exported interface implemented by it.
  var it: lib.Item = lib.makeItem(7);
  var v: Valuable = it;
  var vv: int = v.value();                // 7

  if (s != 40 || i != 1 || t != 33 || ps != 11 || vv != 7) { return 1; }
  if (BASE != 30 || calls != 2) { return 2; }
  if (m != lib.Mode.ON) { return 3; }

  printInt(s); print(",");
  printInt(t); print(",");
  printInt(ps); print(",");
  printInt(vv); print(",");
  printInt(calls); print(",");
  printInt(m); print("\n");
  return 0;
}
