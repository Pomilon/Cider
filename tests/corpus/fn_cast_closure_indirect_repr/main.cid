// CIDER-BUG-140: the legitimate closure-in-*void round trips kept working by
// the extended inference: *void fields, array elements and pointees, the
// cast-free conversions whose *void source proves a closure object, and a
// direct cast chain through a typed pointer rooted in a closure. Raw-fn
// laundering through the same shapes is rejected at compile time (see the
// check_fn_cast_closure_* fixtures).
//
// Conservative limit (documented, not a bug): provenance is tracked per
// syntactic storage chain, so the store and the read must name the same
// chain (`s.v` after `s.v = c`, or `p->v` after `p->v = c`); reading through
// a different chain that aliases the same location at runtime (`(*ps).v` after
// `s.v = c`) is unproven and rejected. `this.f`, struct/array literals and
// pointer-arithmetic carriers are likewise unproven on the read side.

type Cb = func(int) -> int;

struct Slot { var v: *void; var cb: func(int) -> int; }

func take(f: func(int) -> int) -> int { return f(21); }

func ret(v: *void) -> func(int) -> int { return v; }

func main() -> int {
  var c: Cb = func(x: int) -> int { return x * 2; };

  // *void field: store then cast back, directly and through a pointer.
  var s: Slot = Slot { v: nilPtr, cb: nilPtr as func(int) -> int };
  s.v = c;
  var f1: func(int) -> int = s.v as func(int) -> int;
  if (f1(21) != 42) return 1;
  var ps: *Slot = &s;
  (*ps).v = c;
  var f2: func(int) -> int = (*ps).v as func(int) -> int;
  if (f2(21) != 42) return 2;
  (*ps).v = c;
  var f3: func(int) -> int = (*ps).v as func(int) -> int;
  if (f3(21) != 42) return 3;

  // *void array element.
  var a: [*void; 2] = [nilPtr, nilPtr];
  a[0] = c;
  var f4: func(int) -> int = a[0] as func(int) -> int;
  if (f4(21) != 42) return 4;

  // *void pointee.
  var storage: *void = nilPtr;
  var pp: **void = &storage;
  *pp = c;
  var f5: func(int) -> int = (*pp) as func(int) -> int;
  if (f5(21) != 42) return 5;

  // Cast-free declaration and assignment from a proven-closure *void.
  var v: *void = c;
  var f6: func(int) -> int = v;
  if (f6(21) != 42) return 6;
  var f7: func(int) -> int = nilPtr;
  f7 = v;
  if (f7(21) != 42) return 7;

  // Cast-free argument and return.
  if (take(v) != 42) return 8;
  var f8: func(int) -> int = ret(v);
  if (f8(21) != 42) return 9;

  // A direct cast chain through a typed pointer rooted in a closure object.
  var f9: func(int) -> int = (c as *u8) as func(int) -> int;
  if (f9(21) != 42) return 10;

  // A closure-typed field accepts a proven-closure *void, by assignment and
  // by struct literal.
  s.cb = v;
  if (s.cb(21) != 42) return 11;
  var s2: Slot = Slot { v: c, cb: c };
  if (s2.cb(21) != 42) return 12;

  // A nil ternary branch stays representation-neutral.
  var f11: func(int) -> int = 1 == 1 ? v : nilPtr;
  if (f11(21) != 42) return 13;

  return 0;
}
