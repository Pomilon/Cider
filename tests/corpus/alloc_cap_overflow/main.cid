// v3 port: v3's allocator refuses with nilPtr where v2 aborted with
// fail_fast(71). The contract (pinned by malloc_refused_nilptr) is that a
// request the heap cannot satisfy answers nilPtr and touches nothing —
// including the 1 GiB total cap, which v3 checks in 64 bits (no wrap).
// Two 600 MiB requests exceed the cap together: the first succeeds, the
// second is refused, and a small request still works afterwards.
from std.alloc import malloc, free;

func main() -> int {
    var p: *u64 = malloc(629145600) as *u64;
    if (p == nilPtr) return 1;
    *p = 42;
    if (*p != 42) return 2;
    var q: *u64 = malloc(629145600) as *u64;
    if (q != nilPtr) return 3;
    var s: *u64 = malloc(32) as *u64;
    if (s == nilPtr) return 4;
    *s = 7;
    if (*s != 7) return 5;
    free(p as *void);
    free(s as *void);
    return 0;
}
