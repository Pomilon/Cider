func main() -> int {
  var a: [int; 3] = [1, 2, 3];
  var l: *int = &a[0];
  if (l[0] + l[1] + l[2] != 6) { return 1; }
  var n: int = 2;
  // CIDER-BUG-214: a `break` names the innermost enclosing LOOP, never a
  // match arm. This arm used to hold one with no loop around it at all,
  // where ir_gen dropped the statement (`if (!breakLabels_.empty())`) and the
  // arm silently fell through to the exit below — the program passed for the
  // wrong reason. The loop makes the arm's `break` legal and still lands on
  // that same exit-0 sequence, so the expected result is unchanged.
  for (var i: int = 0; i < 1; i = i + 1) {
    match (n) {
      1 => { return 2; }
      2 => { break; }
      default => { return 3; }
    }
  }
  return 0;
}
