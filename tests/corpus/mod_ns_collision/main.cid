import nsa;
import nsb;
from nsb import make;

struct Event {
  var tag: int;
}

struct Holder {
  var tag: int;
}

func shadowed() -> int {
  var nsa: Holder = new Holder{tag: 9};
  return nsa.tag;
}

func main() -> int {
  if (nsa.describe(nsa.make()) != 1) { return 1; }
  if (nsb.describe(nsb.make()) != 22) { return 2; }
  if (nsb.describe(make()) != 22) { return 3; }
  var e: Event = new Event{tag: 7};
  if (e.tag != 7) { return 4; }
  if (shadowed() != 9) { return 5; }
  var ea: nsa.Event = nsa.make();
  if (ea.kind != 1) { return 6; }
  var eb: nsb.Event = nsb.make();
  if (eb.kind + eb.extra != 22) { return 7; }
  return 0;
}
