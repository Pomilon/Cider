// CIDER-BUG-075: pop() on an empty vector and remove() with an out-of-range
// index must return a defined zero T on all three backends. Before the fix
// both paths declared `var zero: T;` and returned the raw frame slot, so the
// observed value was stale stack bytes that differed between VM unopt, VM
// opt and native. dirty() below writes recognizable values into the stack
// slots the zero path used to read, so this program exercised the bug
// instead of passing by luck.
from std.io import puts;
from std.vector import Vec, new_vec, push, pop, get, len_vec, cap_vec, remove, free_vec;

// Generic type arguments cannot be spelled `Vec<*int>` inline (the parser
// only accepts type-token names between '<' and '>'), but a pointer alias
// keeps the pointer-T path testable.
type IntPtr = *int;

struct Pair {
    var a: int;
    var b: int;
}

func dirty(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int {
    var x1: int = a + 111;
    var x2: int = b + 222;
    var x3: int = c + 333;
    var x4: int = d + 444;
    var x5: int = e + 555;
    var x6: int = f + 666;
    var x7: int = g + 777;
    var x8: int = h + 888;
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8;
}

func main() -> int {
    // Dirty the stack first and use the result, so no backend can dead-code
    // the call away before the zero paths run.
    var sink: int = dirty(8631, 4239392, 7, 11, 2, 3, 5, 13);
    if (sink != 4252060) return 100;

    // --- int T: empty pop returns 0 and leaves len/cap/data untouched ---
    var v: Vec<int> = new_vec::<int>();
    if (pop::<int>(&v) != 0) return 1;
    if (pop::<int>(&v) != 0) return 2;  // repeated: the local must be re-zeroed
    if (len_vec::<int>(&v) != 0) return 3;
    if (cap_vec::<int>(&v) != 0) return 4;
    if (v.data != nilPtr) return 5;

    // Out-of-range remove (past the end, far past, and negative) returns 0.
    if (remove::<int>(&v, 5) != 0) return 6;
    if (remove::<int>(&v, 100) != 0) return 7;
    if (remove::<int>(&v, -1) != 0) return 8;
    if (len_vec::<int>(&v) != 0) return 9;
    if (cap_vec::<int>(&v) != 0) return 10;

    // With elements: out-of-range remove still returns 0 and touches
    // nothing; valid pop/remove still return the stored values.
    push::<int>(&v, 7);
    push::<int>(&v, 9);
    if (remove::<int>(&v, 2) != 0) return 11;
    if (remove::<int>(&v, -1) != 0) return 12;
    if (len_vec::<int>(&v) != 2) return 13;
    if (pop::<int>(&v) != 9) return 14;
    if (remove::<int>(&v, 0) != 7) return 15;

    // Empty again, with a live allocation: the zero paths still fire.
    if (pop::<int>(&v) != 0) return 16;
    if (remove::<int>(&v, 0) != 0) return 17;
    if (len_vec::<int>(&v) != 0) return 18;
    if (cap_vec::<int>(&v) != 8) return 19;
    if (get::<int>(&v, 0) != nilPtr) return 20;

    // --- pointer T: empty pop and out-of-range remove are nilPtr ---
    var pv: Vec<IntPtr> = new_vec::<IntPtr>();
    if (pop::<IntPtr>(&pv) != nilPtr) return 21;
    if (remove::<IntPtr>(&pv, 3) != nilPtr) return 22;
    if (remove::<IntPtr>(&pv, -1) != nilPtr) return 23;
    if (len_vec::<IntPtr>(&pv) != 0) return 24;
    if (cap_vec::<IntPtr>(&pv) != 0) return 25;

    // A stored pointer comes back unchanged; the next pop is nil again.
    var a: int = 42;
    push::<IntPtr>(&pv, &a);
    if (pop::<IntPtr>(&pv) != &a) return 26;
    if (pop::<IntPtr>(&pv) != nilPtr) return 27;

    // --- aggregate T: byte-zero means every field is zero ---
    var sv: Vec<Pair> = new_vec::<Pair>();
    var s0: Pair = pop::<Pair>(&sv);
    if (s0.a != 0 || s0.b != 0) return 28;
    var s1: Pair = remove::<Pair>(&sv, 0);
    if (s1.a != 0 || s1.b != 0) return 29;
    if (len_vec::<Pair>(&sv) != 0) return 30;

    // --- float T: byte-zero is +0.0 ---
    var dv: Vec<f64> = new_vec::<f64>();
    if (pop::<f64>(&dv) != 0.0) return 31;
    if (remove::<f64>(&dv, 4) != 0.0) return 32;

    free_vec::<int>(&v);
    free_vec::<IntPtr>(&pv);
    free_vec::<Pair>(&sv);
    free_vec::<f64>(&dv);
    puts("vector_empty ok");
    return 0;
}
