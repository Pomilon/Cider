// SOLUM markup parser + HTML renderer — Cider port
// Replicates ~700 lines of C++17 (parser.cpp + renderer.cpp + main.cpp)
from std.alloc import malloc, free;


from std.string import strlen, strcmp, strcpy, strcat, strchr, memcpy;
from std.io import print, printInt, read_all, read_stdin;

// --- Node types ---
const NT_TEXT: int = 0;
const NT_BLANK: int = 1;
const NT_HEADER: int = 2;
const NT_LIST: int = 3;
const NT_QUOTE: int = 4;
const NT_LINK: int = 5;
const NT_IMAGE: int = 6;
const NT_LITERAL: int = 7;
const NT_CODEBLOCK: int = 8;
const NT_BOLD: int = 9;
const NT_ITALIC: int = 10;
const NT_UNDERLINE: int = 11;
const NT_HIGHLIGHT: int = 12;
const NT_STRIKE: int = 13;
const NT_SUBSCRIPT: int = 14;
const NT_SUPERSCRIPT: int = 15;
const NT_INLINECODE: int = 16;
const NT_MATHINLINE: int = 17;
const NT_MATHBLOCK: int = 18;
const NT_TASK: int = 19;
const NT_TABLE: int = 20;

// List types
const LT_UNORDERED: int = 0;
const LT_ORDERED: int = 1;
const LT_ALPHA: int = 2;

class Node {
    var ntype: int;
    var content: *char;
    var url: *char;
    var label: *char;
    var language: *char;
    var level: int;
    var number: int;
    var listType: int;
    var checked: bool;
    var hasHeader: bool;
    var children: *PtrList;  // of *Node
    var nested: *PtrList;    // of *Node
    var rows: *PtrList;      // of *Row
}

class Row {
    var cells: *PtrList;     // of *NodeList
}

class PtrList {
    var data: **void;
    var len: int;
    var cap: int;
}

class StrBuf {
    var sdata: *char;
    var slen: int;
    var scap: int;
}

// --- PtrList helpers ---
func pl_new() -> *PtrList {
    var l: *PtrList = malloc(24) as *PtrList;
    (*l).data = nilPtr;
    (*l).len = 0;
    (*l).cap = 0;
    return l;
}

func pl_push(l: *PtrList, p: *void) {
    if ((*l).len >= (*l).cap) {
        var ncap: int = (*l).cap * 2;
        if (ncap < 8) { ncap = 8; }
        var nd: **void = malloc((ncap * 8) as i64) as **void;
        if ((*l).len > 0) { memcpy(nd as *void, (*l).data as *void, (*l).len * 8); }
        if ((*l).data != nilPtr) { free((*l).data); }
        (*l).data = nd;
        (*l).cap = ncap;
    }
    (*l).data[(*l).len] = p;
    (*l).len = (*l).len + 1;
}

func pl_get(l: *PtrList, i: int) -> *void {
    return (*l).data[i];
}

func pl_len(l: *PtrList) -> int {
    return (*l).len;
}

func pl_free(l: *PtrList) {
    if (l != nilPtr) {
        if ((*l).data != nilPtr) { free((*l).data as *void); }
        free(l as *void);
    }
}

// --- StrBuf helpers ---
func sb_new() -> *StrBuf {
    var b: *StrBuf = malloc(24) as *StrBuf;
    (*b).sdata = nilPtr;
    (*b).slen = 0;
    (*b).scap = 0;
    return b;
}

func sb_ensure(b: *StrBuf, extra: int) {
    if ((*b).slen + extra > (*b).scap) {
        var ncap: int = (*b).scap * 2;
        if (ncap < 64) { ncap = 64; }
        while (ncap < (*b).slen + extra) { ncap = ncap * 2; }
        var nd: *char = malloc((ncap) as i64) as *char;
        if ((*b).slen > 0) { memcpy(nd as *void, (*b).sdata as *void, (*b).slen); }
        if ((*b).sdata != nilPtr) { free((*b).sdata as *void); }
        (*b).sdata = nd;
        (*b).scap = ncap;
    }
}

func sb_char(b: *StrBuf, c: char) {
    sb_ensure(b, 1);
    (*b).sdata[(*b).slen] = c;
    (*b).slen = (*b).slen + 1;
}

func sb_str(b: *StrBuf, s: *char) {
    var n: int = strlen(s);
    sb_ensure(b, n);
    if ((*b).slen + n > (*b).scap) {
        print("SB OVERFLOW slen=");
        printInt((*b).slen);
        print(" n=");
        printInt(n);
        print(" cap=");
        printInt((*b).scap);
        print("\n");
        asm { "mov rax, 60" "mov rdi, 78" "syscall" }
    }
    memcpy(((*b).sdata + (*b).slen) as *void, s as *void, n);
    (*b).slen = (*b).slen + n;
}

func sb_int(b: *StrBuf, v: int) {
    if (v < 0) {
        sb_char(b, '-' as char);
        v = -v;
    }
    if (v >= 10) { sb_int(b, v / 10); }
    sb_char(b, (48 + (v % 10)) as char);
}

func sb_cstr(b: *StrBuf) -> *char {
    sb_ensure(b, 1);
    (*b).sdata[(*b).slen] = 0 as char;
    return (*b).sdata;
}

// --- string helpers ---
func str_dup(s: *char) -> *char {
    var n: int = strlen(s);
    var d: *char = malloc((n + 1) as i64) as *char;
    memcpy(d as *void, s as *void, n);
    d[n] = 0 as char;
    return d;
}

func str_sub(s: *char, start: int, len: int) -> *char {
    var d: *char = malloc((len + 1) as i64) as *char;
    memcpy(d as *void, (s + start) as *void, len);
    d[len] = 0 as char;
    return d;
}

func is_digit(c: char) -> bool {
    return (c as int) >= 48 && (c as int) <= 57;
}

func is_alpha(c: char) -> bool {
    return ((c as int) >= 97 && (c as int) <= 122) || ((c as int) >= 65 && (c as int) <= 90);
}

// find first occurrence of needle in hay, or -1
func str_find(hay: *char, needle: *char) -> int {
    var hn: int = strlen(hay);
    var nn: int = strlen(needle);
    if (nn == 0) { return 0; }
    var i: int = 0;
    while (i + nn <= hn) {
        var j: int = 0;
        var isMatch: bool = true;
        while (j < nn) {
            if (hay[i + j] != needle[j]) { isMatch = false; }
            j = j + 1;
        }
        if (isMatch) { return i; }
        i = i + 1;
    }
    return -1;
}

func is_ws(c: char) -> bool {
    return c == ' ' as char || c == '\t' as char || c == '\n' as char || c == '\r' as char;
}

func str_trim(s: *char) -> *char {
    var n: int = strlen(s);
    var start: int = 0;
    var end: int = n;
    while (start < n && is_ws(s[start])) { start = start + 1; }
    while (end > start && is_ws(s[end - 1])) { end = end - 1; }
    return str_sub(s, start, end - start);
}

// --- node factory ---
func make_node(t: int) -> *Node {
    var n: *Node = malloc(112) as *Node;
    (*n).ntype = t;
    (*n).content = nilPtr;
    (*n).url = nilPtr;
    (*n).label = nilPtr;
    (*n).language = nilPtr;
    (*n).level = 0;
    (*n).number = 0;
    (*n).listType = 0;
    (*n).checked = false;
    (*n).hasHeader = false;
    (*n).children = nilPtr;
    (*n).nested = nilPtr;
    (*n).rows = nilPtr;
    return n;
}

func make_text(s: *char) -> *Node {
    var n: *Node = make_node(NT_TEXT);
    (*n).content = str_dup(s);
    return n;
}

// --- inline parser ---
const MAX_NEST: int = 100;

class InlineLevel {
    var marker: int;    // 0=none, 1=!!, 2=::, 3==, 4=%%, 5=~~, 6=,, 7=^^
    var nodes: *PtrList;
}

class InlineStack {
    var levels: *InlineLevel;
    var ilen: int;
    var icap: int;
}

func istack_push(st: *InlineStack, marker: int) {
    if ((*st).ilen >= (*st).icap) {
        var ncap: int = (*st).icap * 2;
        if (ncap < 8) { ncap = 8; }
        var nd: *InlineLevel = malloc((ncap * 24) as i64) as *InlineLevel;
        if ((*st).ilen > 0) { memcpy(nd as *void, (*st).levels as *void, (*st).ilen * 24); }
        if ((*st).levels != nilPtr) { free((*st).levels as *void); }
        (*st).levels = nd;
        (*st).icap = ncap;
    }
    (*st).levels[(*st).ilen].marker = marker;
    (*st).levels[(*st).ilen].nodes = pl_new();
    (*st).ilen = (*st).ilen + 1;
}

func marker_type(sym: *char) -> int {
    if (sym[0] == '!' as char && sym[1] == '!' as char) { return 1; }
    if (sym[0] == ':' as char && sym[1] == ':' as char) { return 2; }
    if (sym[0] == '=' as char && sym[1] == '=' as char) { return 3; }
    if (sym[0] == '%' as char && sym[1] == '%' as char) { return 4; }
    if (sym[0] == '~' as char && sym[1] == '~' as char) { return 5; }
    // NOTE: ,,subscript,, and ^^superscript^^ are NOT markers — the C++
    // reference renders them as literal text (no sub/sup support), and
    // byte-identical parity with the reference is the acceptance test.
    return 0;
}

func marker_node(m: int) -> int {
    if (m == 1) { return NT_BOLD; }
    if (m == 2) { return NT_ITALIC; }
    if (m == 3) { return NT_UNDERLINE; }
    if (m == 4) { return NT_HIGHLIGHT; }
    if (m == 5) { return NT_STRIKE; }
    if (m == 6) { return NT_SUBSCRIPT; }
    if (m == 7) { return NT_SUPERSCRIPT; }
    return NT_TEXT;
}

func wrap_marker(m: int, nodes: *PtrList) -> *Node {
    var n: *Node = make_node(marker_node(m));
    (*n).children = nodes;
    return n;
}

func parse_inline(text: *char) -> *PtrList {
    var st: InlineStack = InlineStack { levels: nilPtr, ilen: 0, icap: 0 };
    st.levels = nilPtr;
    st.ilen = 0;
    st.icap = 0;
    istack_push(&st, 0);

    var n: int = strlen(text);
    var i: int = 0;
    while (i < n) {

        if (text[i] == '\\' as char) {
            if (i + 1 < n) {
                var esc: *char = malloc(2) as *char;
                esc[0] = text[i + 1];
                esc[1] = 0 as char;
                pl_push(st.levels[st.ilen - 1].nodes, make_text(esc) as *void);
                i = i + 1;
            } else {
                var bsl: *char = malloc(2) as *char;
                bsl[0] = '\\' as char;
                bsl[1] = 0 as char;
                pl_push(st.levels[st.ilen - 1].nodes, make_text(bsl) as *void);
            }
            i = i + 1;
            continue;
        }

        // Block markers appearing inline: literal text
        if (text[i] == '=' as char && i + 2 < n && text[i+1] == '=' as char && text[i+2] == '=' as char) {
            pl_push(st.levels[st.ilen - 1].nodes, make_text("===") as *void);
            i = i + 3;
            continue;
        }
        if (text[i] == '$' as char && i + 2 < n && text[i+1] == '$' as char && text[i+2] == '$' as char) {
            pl_push(st.levels[st.ilen - 1].nodes, make_text("$$$") as *void);
            i = i + 3;
            continue;
        }
        if (text[i] == '{' as char && i + 1 < n && text[i+1] == '{' as char) {
            pl_push(st.levels[st.ilen - 1].nodes, make_text("{{{{{{{{") as *void);
            i = i + 2;
            continue;
        }
        if (text[i] == '}' as char && i + 1 < n && text[i+1] == '}' as char) {
            pl_push(st.levels[st.ilen - 1].nodes, make_text("}}}}}}}}") as *void);
            i = i + 2;
            continue;
        }

        // ''literal''
        if (text[i] == '\'' as char && i + 1 < n && text[i+1] == '\'' as char) {
            i = i + 2;
            var start: int = i;
            while (i + 1 < n && !(text[i] == '\'' as char && text[i+1] == '\'' as char)) { i = i + 1; }
            if (i + 1 < n) {
                var lit: *Node = make_node(NT_LITERAL);
                (*lit).content = str_sub(text, start, i - start);
                pl_push(st.levels[st.ilen - 1].nodes, lit as *void);
                i = i + 1;
            } else {
                pl_push(st.levels[st.ilen - 1].nodes, make_text(str_sub(text, start, n - start)) as *void);
            }
            i = i + 1;
            continue;
        }

        // [@path"label"] link, [!path"label"] image
        if (text[i] == '[' as char && i + 1 < n && (text[i+1] == '@' as char || text[i+1] == '!' as char)) {
            var isLink: bool = (text[i+1] == '@' as char);
            var brEnd: int = str_find(text + i + 1, "]");
            if (brEnd >= 0) {
                var content: *char = str_sub(text, i + 2, brEnd);
                var firstQ: int = str_find(content, "\"");
                var lastQ: int = -1;
                var k: int = 0;
                while (k < strlen(content)) {
                    if (content[k] == '"' as char) { lastQ = k; }
                    k = k + 1;
                }
                if (firstQ >= 0 && lastQ > firstQ) {
                    var path: *char = str_trim(str_sub(content, 0, firstQ));
                    var label: *char = str_sub(content, firstQ + 1, lastQ - firstQ - 1);
                    var lk: *Node = make_node(isLink ? NT_LINK : NT_IMAGE);
                    (*lk).url = path;
                    (*lk).label = label;
                    pl_push(st.levels[st.ilen - 1].nodes, lk as *void);
                    free(content as *void);
                    i = i + brEnd + 2;
                    continue;
                }
                free(content as *void);
            }
        }

        // [ ] task, [x] task
        if (text[i] == '[' as char && i + 2 < n && text[i+1] == ' ' as char && text[i+2] == ']' as char) {
            var tk: *Node = make_node(NT_TASK);
            (*tk).checked = false;
            pl_push(st.levels[st.ilen - 1].nodes, tk as *void);
            i = i + 3;
            continue;
        }
        if (text[i] == '[' as char && i + 2 < n && text[i+1] == 'x' as char && text[i+2] == ']' as char) {
            var tk2: *Node = make_node(NT_TASK);
            (*tk2).checked = true;
            pl_push(st.levels[st.ilen - 1].nodes, tk2 as *void);
            i = i + 3;
            continue;
        }

        // format markers with nesting
        var matched: bool = false;
        var sym: *char = malloc(3) as *char;
        if (i + 1 < n) {
            sym[0] = text[i];
            sym[1] = text[i + 1];
            sym[2] = 0 as char;
            var m: int = marker_type(sym);
            if (m != 0) {
                var matchIdx: int = -1;
                var j: int = st.ilen - 1;
                while (j >= 0) {
                    if (st.levels[j].marker == m) { matchIdx = j; }
                    j = j - 1;
                }
                if (matchIdx > 0) {
                    // collapse nested levels up to matchIdx
                    var reopened: *PtrList = pl_new();
                    while (st.ilen - 1 > matchIdx) {
                        var lm: int = st.levels[st.ilen - 1].marker;
                        var lnodes: *PtrList = st.levels[st.ilen - 1].nodes;
                        st.ilen = st.ilen - 1;
                        pl_push(st.levels[st.ilen - 1].nodes, wrap_marker(lm, lnodes) as *void);
                        pl_push(reopened, (lm as *void));
                    }
                    var finalNodes: *PtrList = st.levels[st.ilen - 1].nodes;
                    st.ilen = st.ilen - 1;
                    pl_push(st.levels[st.ilen - 1].nodes, wrap_marker(m, finalNodes) as *void);
                    // reopen markers in reverse
                    var r: int = pl_len(reopened) - 1;
                    while (r >= 0) {
                        istack_push(&st, (pl_get(reopened, r) as int));
                        r = r - 1;
                    }
                    pl_free(reopened);
                    i = i + 1;
                    matched = true;
                } else if (st.ilen < MAX_NEST) {
                    istack_push(&st, m);
                    i = i + 1;
                    matched = true;
                }
            }
            free(sym as *void);
        }

        // {inline code}
        if (!matched && text[i] == '{' as char) {
            i = i + 1;
            var cstart: int = i;
            var closed: bool = false;
            while (i < n) {
                if (text[i] == '}' as char) { closed = true; break; }
                i = i + 1;
            }
            if (closed) {
                var ic: *Node = make_node(NT_INLINECODE);
                (*ic).content = str_sub(text, cstart, i - cstart);
                pl_push(st.levels[st.ilen - 1].nodes, ic as *void);
                matched = true;
            } else {
                // Unclosed { — C++ emits "{" + the scanned content as text
                var tx: *Node = make_text(str_sub(text, cstart - 1, i - cstart + 1));
                pl_push(st.levels[st.ilen - 1].nodes, tx as *void);
                matched = true;
            }
        }

        // $$math$$
        if (!matched && text[i] == '$' as char && i + 1 < n && text[i+1] == '$' as char) {
            var mstart: int = i + 2;
            var mend: int = str_find(text + mstart, "$$");
            if (mend >= 0) {
                var mi: *Node = make_node(NT_MATHINLINE);
                (*mi).content = str_sub(text, mstart, mend);
                pl_push(st.levels[st.ilen - 1].nodes, mi as *void);
                i = mstart + mend + 1;
                matched = true;
            }
        }

        if (!matched) {
            // append to last text node or create new
            if (pl_len(st.levels[st.ilen - 1].nodes) > 0) {
                var last: *Node = pl_get(st.levels[st.ilen - 1].nodes, pl_len(st.levels[st.ilen - 1].nodes) - 1) as *Node;
                if ((*last).ntype == NT_TEXT) {
                    var oldlen: int = strlen((*last).content);
                    var newc: *char = malloc((oldlen + 2) as i64) as *char;
                    memcpy(newc as *void, (*last).content as *void, oldlen);
                    newc[oldlen] = text[i];
                    newc[oldlen + 1] = 0 as char;
                    free((*last).content as *void);
                    (*last).content = newc;
                    i = i + 1;
                    continue;
                }
            }
            var one: *char = malloc(2) as *char;
            one[0] = text[i];
            one[1] = 0 as char;
            pl_push(st.levels[st.ilen - 1].nodes, make_text(one) as *void);
        }
        i = i + 1;
    }

    // flush remaining levels
    while (st.ilen > 1) {
        var lm: int = st.levels[st.ilen - 1].marker;
        var lnodes: *PtrList = st.levels[st.ilen - 1].nodes;
        st.ilen = st.ilen - 1;
        if (lm != 0) {
            pl_push(st.levels[st.ilen - 1].nodes, make_text(marker_str(lm)) as *void);
        }
        var q: int = 0;
        while (q < pl_len(lnodes)) {
            pl_push(st.levels[st.ilen - 1].nodes, pl_get(lnodes, q));
            q = q + 1;
        }
    }

    return st.levels[0].nodes;
}

func marker_str(m: int) -> *char {
    if (m == 1) { return "!!"; }
    if (m == 2) { return "::"; }
    if (m == 3) { return "=="; }
    if (m == 4) { return "%%"; }
    if (m == 5) { return "~~"; }
    if (m == 6) { return ",,"; }
    if (m == 7) { return "^^"; }
    return "";
}

// --- block parser ---
class DocState {
    var headingCounts: [int; 3];
}

func parse_line(line: *char, st: *DocState, out: *PtrList) {
    var trimmed: *char = str_trim(line);
    var tn: int = strlen(trimmed);
    if (tn == 0) { return; }

    if (trimmed[0] == '>' as char) {
        var level: int = 0;
        var pos: int = 0;
        while (pos < tn && trimmed[pos] == '>' as char) { level = level + 1; pos = pos + 1; }
        if (level > 3) { level = 3; }
        var autoNum: bool = false;
        if (pos < tn && trimmed[pos] == '#' as char) { autoNum = true; pos = pos + 1; }
        if (pos < tn && trimmed[pos] == ' ' as char) {
            var content: *char = trimmed + pos + 1;
            var hd: *Node = make_node(NT_HEADER);
            (*hd).level = level;
            (*hd).number = 0;
            if (autoNum) {
                (*st).headingCounts[level - 1] = (*st).headingCounts[level - 1] + 1;
                var i2: int = level;
                while (i2 < 3) { (*st).headingCounts[i2] = 0; i2 = i2 + 1; }
                (*hd).number = (*st).headingCounts[level - 1];
            }
            (*hd).children = parse_inline(content);
            pl_push(out, hd as *void);
            return;
        }
    }

    if (trimmed[0] == '.' as char) {
        var dots: int = 0;
        while (dots < tn && trimmed[dots] == '.' as char) { dots = dots + 1; }
        if (dots > 0 && dots < tn && trimmed[dots] == ' ' as char) {
            var li: *Node = make_node(NT_LIST);
            (*li).listType = LT_UNORDERED;
            (*li).level = dots;
            (*li).children = parse_inline(trimmed + dots + 1);
            (*li).nested = pl_new();
            pl_push(out, li as *void);
            return;
        }
    }

    if (tn >= 2 && is_digit(trimmed[0])) {
        var pos: int = 0;
        while (pos < tn && is_digit(trimmed[pos])) { pos = pos + 1; }
        var dots: int = 0;
        while (pos < tn && trimmed[pos] == '.' as char) { dots = dots + 1; pos = pos + 1; }
        if (dots > 0 && pos < tn && trimmed[pos] == ' ' as char) {
            var li: *Node = make_node(NT_LIST);
            (*li).listType = LT_ORDERED;
            (*li).level = dots;
            (*li).children = parse_inline(trimmed + pos + 1);
            (*li).nested = pl_new();
            pl_push(out, li as *void);
            return;
        }
    }

    if (tn >= 2 && is_alpha(trimmed[0])) {
        var pos: int = 0;
        while (pos < tn && is_alpha(trimmed[pos])) { pos = pos + 1; }
        var dots: int = 0;
        while (pos < tn && trimmed[pos] == '.' as char) { dots = dots + 1; pos = pos + 1; }
        if (dots > 0 && pos < tn && trimmed[pos] == ' ' as char) {
            var li: *Node = make_node(NT_LIST);
            (*li).listType = LT_ALPHA;
            (*li).level = dots;
            (*li).children = parse_inline(trimmed + pos + 1);
            (*li).nested = pl_new();
            pl_push(out, li as *void);
            return;
        }
    }

    if (trimmed[0] == '`' as char) {
        var ticks: int = 0;
        while (ticks < tn && trimmed[ticks] == '`' as char) { ticks = ticks + 1; }
        if (ticks > 0 && ticks < tn && trimmed[ticks] == ' ' as char) {
            var qt: *Node = make_node(NT_QUOTE);
            (*qt).level = ticks;
            (*qt).children = parse_inline(trimmed + ticks + 1);
            pl_push(out, qt as *void);
            return;
        }
    }

    if (strcmp(trimmed, "---") == 0) {
        var litNode: *Node = make_node(NT_LITERAL);
        (*litNode).content = str_dup("---");
        pl_push(out, litNode as *void);
        return;
    }

    var nodes: *PtrList = parse_inline(trimmed);
    var q: int = 0;
    while (q < pl_len(nodes)) {
        pl_push(out, pl_get(nodes, q));
        q = q + 1;
    }
}

// --- document parse ---
func parse_doc(input: *char) -> *PtrList {
    var doc: *PtrList = pl_new();
    var st: DocState = DocState { headingCounts: [0, 0, 0] };
    st.headingCounts[0] = 0;
    st.headingCounts[1] = 0;
    st.headingCounts[2] = 0;

    // split into lines
    var lines: *PtrList = pl_new();
    var n: int = strlen(input);
    var start: int = 0;
    var i: int = 0;
    while (i <= n) {
        if (i == n || input[i] == '\n' as char) {
            if (!(i == n && start == i)) {
                var line: *char = str_sub(input, start, i - start);
                pl_push(lines, line as *void);
            }
            start = i + 1;
        }
        i = i + 1;
    }

    var listStack: *PtrList = pl_new();  // of *Node (list nodes)

    var li: int = 0;
    var lineCount: int = pl_len(lines);
    while (li < lineCount) {
        var currentLine: *char = pl_get(lines, li) as *char;
        if (currentLine == nilPtr) {
            print("NILLINE=");
            printInt(li);
            print("\n");
        }
        var trimmed: *char = str_trim(currentLine);
        var tn: int = strlen(trimmed);

        if (tn == 0) {
            pl_push(doc, make_node(NT_BLANK) as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        // === literal ===
        if (strcmp(trimmed, "===") == 0) {
            var litContent: *char = malloc(1) as *char;
            litContent[0] = 0 as char;
            li = li + 1;
            var done: bool = false;
            while (li < lineCount && !done) {
                var tl: *char = str_trim(pl_get(lines, li) as *char);
                if (strcmp(tl, "===") == 0) { done = true; free(tl as *void); break; }
                var lineStr: *char = pl_get(lines, li) as *char;
                var oldLen: int = strlen(litContent);
                var nl: *char = malloc((oldLen + strlen(lineStr) + 2) as i64) as *char;
                memcpy(nl as *void, litContent as *void, oldLen);
                memcpy((nl + oldLen) as *void, lineStr as *void, strlen(lineStr));
                nl[oldLen + strlen(lineStr)] = '\n' as char;
                nl[oldLen + strlen(lineStr) + 1] = 0 as char;
                free(litContent as *void);
                litContent = nl;
                free(tl as *void);
                li = li + 1;
            }
            var lit: *Node = make_node(NT_LITERAL);
            (*lit).content = litContent;
            pl_push(doc, lit as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        // $$$ math block $$$
        if (str_find(trimmed, "$$$") == 0) {
            var mContent: *char = malloc(1) as *char;
            mContent[0] = 0 as char;
            li = li + 1;
            var mdone: bool = false;
            while (li < lineCount && !mdone) {
                var tl: *char = str_trim(pl_get(lines, li) as *char);
                if (str_find(tl, "$$$") == 0) { mdone = true; free(tl as *void); break; }
                var lineStr: *char = pl_get(lines, li) as *char;
                var oldLen: int = strlen(mContent);
                var nl: *char = malloc((oldLen + strlen(lineStr) + 2) as i64) as *char;
                memcpy(nl as *void, mContent as *void, oldLen);
                memcpy((nl + oldLen) as *void, lineStr as *void, strlen(lineStr));
                nl[oldLen + strlen(lineStr)] = '\n' as char;
                nl[oldLen + strlen(lineStr) + 1] = 0 as char;
                free(mContent as *void);
                mContent = nl;
                free(tl as *void);
                li = li + 1;
            }
            var mb: *Node = make_node(NT_MATHBLOCK);
            (*mb).content = mContent;
            pl_push(doc, mb as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        // {{ code block
        if (str_find(trimmed, "{{{{{{{{") == 0) {
            var lang: *char = str_dup("text");
            var langEnd: int = str_find(trimmed + 2, ":");
            if (langEnd >= 0) {
                free(lang as *void);
                lang = str_sub(trimmed, 2, langEnd);
            }
            var cContent: *char = malloc(1) as *char;
            cContent[0] = 0 as char;
            li = li + 1;
            var cdone: bool = false;
            while (li < lineCount && !cdone) {
                var tl: *char = str_trim(pl_get(lines, li) as *char);
                if (str_find(tl, "}}}}}}}}") == 0) { cdone = true; free(tl as *void); break; }
                var lineStr: *char = pl_get(lines, li) as *char;
                var oldLen: int = strlen(cContent);
                var nl: *char = malloc((oldLen + strlen(lineStr) + 2) as i64) as *char;
                memcpy(nl as *void, cContent as *void, oldLen);
                memcpy((nl + oldLen) as *void, lineStr as *void, strlen(lineStr));
                nl[oldLen + strlen(lineStr)] = '\n' as char;
                nl[oldLen + strlen(lineStr) + 1] = 0 as char;
                free(cContent as *void);
                cContent = nl;
                free(tl as *void);
                li = li + 1;
            }
            var cb: *Node = make_node(NT_CODEBLOCK);
            (*cb).language = lang;
            (*cb).content = cContent;
            pl_push(doc, cb as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        // [q] quote block (non-nested for simplicity: flat)
        if (strcmp(trimmed, "[q]") == 0) {
            var qContent: *char = malloc(1) as *char;
            qContent[0] = 0 as char;
            li = li + 1;
            var qdone: bool = false;
            while (li < lineCount && !qdone) {
                var tl: *char = str_trim(pl_get(lines, li) as *char);
                if (strcmp(tl, "[q]") == 0) { qdone = true; free(tl as *void); break; }
                var lineStr: *char = pl_get(lines, li) as *char;
                var oldLen: int = strlen(qContent);
                var nl: *char = malloc((oldLen + strlen(lineStr) + 2) as i64) as *char;
                memcpy(nl as *void, qContent as *void, oldLen);
                memcpy((nl + oldLen) as *void, lineStr as *void, strlen(lineStr));
                nl[oldLen + strlen(lineStr)] = '\n' as char;
                nl[oldLen + strlen(lineStr) + 1] = 0 as char;
                free(qContent as *void);
                qContent = nl;
                free(tl as *void);
                li = li + 1;
            }
            var sub: *PtrList = parse_doc(qContent);
            var qt: *Node = make_node(NT_QUOTE);
            (*qt).level = 1;
            (*qt).children = sub;
            pl_push(doc, qt as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            free(qContent as *void);
            li = li + 1;
            continue;
        }

        // [t] table
        if (strcmp(trimmed, "[t]") == 0) {
            var tb: *Node = make_node(NT_TABLE);
            (*tb).hasHeader = false;
            (*tb).rows = pl_new();
            li = li + 1;
            var tdone: bool = false;
            while (li < lineCount && !tdone) {
                var tl: *char = str_trim(pl_get(lines, li) as *char);
                if (strcmp(tl, "[t]") == 0) { tdone = true; free(tl as *void); break; }
                if (strcmp(tl, "---") == 0) {
                    (*tb).hasHeader = true;
                    free(tl as *void);
                    li = li + 1;
                    continue;
                }
                var rowLine: *char = pl_get(lines, li) as *char;
                var row: *Row = malloc(16) as *Row;
                (*row).cells = pl_new();
                var cstart: int = 0;
                var pos: int = 0;
                var depth: int = 0;
                var rn: int = strlen(rowLine);
                while (pos < rn) {
                    if (rowLine[pos] == '[' as char) { depth = depth + 1; }
                    if (rowLine[pos] == ']' as char) { depth = depth - 1; }
                    if (depth == 0 && pos + 1 < rn && rowLine[pos] == '|' as char && rowLine[pos+1] == '|' as char) {
                        var cellTxt: *char = str_trim(str_sub(rowLine, cstart, pos - cstart));
                        pl_push((*row).cells, parse_inline(cellTxt) as *void);
                        free(cellTxt as *void);
                        cstart = pos + 2;
                        pos = pos + 2;
                    } else { pos = pos + 1; }
                }
                var lastCell: *char = str_trim(str_sub(rowLine, cstart, rn - cstart));
                pl_push((*row).cells, parse_inline(lastCell) as *void);
                free(lastCell as *void);
                pl_push((*tb).rows, row as *void);
                free(tl as *void);
                li = li + 1;
            }
            pl_push(doc, tb as *void);
            (*listStack).len = 0;
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        // regular line
        var lineNodes: *PtrList = pl_new();
        parse_line(currentLine, &st, lineNodes);
        if (pl_len(lineNodes) == 0) {
            free(trimmed as *void);
            li = li + 1;
            continue;
        }

        var first: *Node = pl_get(lineNodes, 0) as *Node;
        if ((*first).ntype == NT_LIST) {
            var lvl: int = (*first).level;
            while (pl_len(listStack) > 0) {
                var top: *Node = pl_get(listStack, pl_len(listStack) - 1) as *Node;
                if ((*top).level >= lvl) { (*listStack).len = (*listStack).len - 1; }
                else { break; }
            }
            if (pl_len(listStack) == 0) {
                pl_push(doc, first as *void);
                pl_push(listStack, first as *void);
            } else {
                var parent: *Node = pl_get(listStack, pl_len(listStack) - 1) as *Node;
                pl_push((*parent).nested, first as *void);
                pl_push(listStack, first as *void);
            }
        } else {
            var isBlock: bool = false;
            if ((*first).ntype == NT_HEADER || (*first).ntype == NT_QUOTE || (*first).ntype == NT_CODEBLOCK || (*first).ntype == NT_TABLE) {
                isBlock = true;
            }
            var q: int = 0;
            while (q < pl_len(lineNodes)) {
                pl_push(doc, pl_get(lineNodes, q));
                q = q + 1;
            }
            if (!isBlock) {
                pl_push(doc, make_node(NT_BLANK) as *void);
            }
            (*listStack).len = 0;
        }
        free(trimmed as *void);
        li = li + 1;
    }

    return doc;
}

// --- HTML rendering ---
func escape_html(b: *StrBuf, s: *char) {
    var n: int = strlen(s);
    var i: int = 0;
    while (i < n) {
        if (s[i] == '&' as char) { sb_str(b, "&amp;"); }
        else if (s[i] == '"' as char) { sb_str(b, "&quot;"); }
        else if (s[i] == '\'' as char) { sb_str(b, "&apos;"); }
        else if (s[i] == '<' as char) { sb_str(b, "&lt;"); }
        else if (s[i] == '>' as char) { sb_str(b, "&gt;"); }
        else { sb_char(b, s[i]); }
        i = i + 1;
    }
}

func render_nodes(b: *StrBuf, nodes: *PtrList) {
    var i: int = 0;
    while (i < pl_len(nodes)) {
        var nd: *Node = pl_get(nodes, i) as *Node;
        if ((*nd).ntype == NT_LIST) {
            var firstList: *Node = nd;
            var openTag: *char = "ul";
            var closeTag: *char = "ul";
            if ((*firstList).listType == LT_ORDERED) { openTag = "ol"; closeTag = "ol"; }
            else if ((*firstList).listType == LT_ALPHA) { openTag = "ol type='a'"; closeTag = "ol"; }
            sb_char(b, '<' as char);
            sb_str(b, openTag);
            sb_char(b, '>' as char);
            while (i < pl_len(nodes)) {
                var ln: *Node = pl_get(nodes, i) as *Node;
                if ((*ln).ntype != NT_LIST || (*ln).listType != (*firstList).listType) { break; }
                sb_str(b, "<li>");
                render_nodes(b, (*ln).children);
                if ((*ln).nested != nilPtr) { render_nodes(b, (*ln).nested); }
                sb_str(b, "</li>");
                i = i + 1;
            }
            sb_char(b, '<' as char);
            sb_char(b, '/' as char);
            sb_str(b, closeTag);
            sb_char(b, '>' as char);
            i = i - 1;
        } else {
            render_node(b, nd);
        }
        i = i + 1;
    }
}

func render_node(b: *StrBuf, nd: *Node) {
    if ((*nd).ntype == NT_TEXT) {
        escape_html(b, (*nd).content);
    } else if ((*nd).ntype == NT_BLANK) {
        sb_str(b, "<br/>");
    } else if ((*nd).ntype == NT_HEADER) {
        sb_str(b, "<h");
        sb_int(b, (*nd).level);
        sb_char(b, '>' as char);
        if ((*nd).number > 0) {
            sb_int(b, (*nd).number);
            sb_str(b, ". ");
        }
        render_nodes(b, (*nd).children);
        sb_str(b, "</h");
        sb_int(b, (*nd).level);
        sb_char(b, '>' as char);
    } else if ((*nd).ntype == NT_QUOTE) {
        var q: int = 0;
        while (q < (*nd).level) { sb_str(b, "<blockquote>"); q = q + 1; }
        render_nodes(b, (*nd).children);
        q = 0;
        while (q < (*nd).level) { sb_str(b, "</blockquote>"); q = q + 1; }
    } else if ((*nd).ntype == NT_TABLE) {
        sb_str(b, "<table>");
        if ((*nd).hasHeader && pl_len((*nd).rows) > 0) {
            sb_str(b, "<thead><tr>");
            var hrow: *Row = pl_get((*nd).rows, 0) as *Row;
            var c: int = 0;
            while (c < pl_len((*hrow).cells)) {
                sb_str(b, "<th>");
                render_nodes(b, pl_get((*hrow).cells, c) as *PtrList);
                sb_str(b, "</th>");
                c = c + 1;
            }
            sb_str(b, "</tr></thead>");
        }
        sb_str(b, "<tbody>");
        var startRow: int = (*nd).hasHeader ? 1 : 0;
        var r: int = startRow;
        while (r < pl_len((*nd).rows)) {
            sb_str(b, "<tr>");
            var row: *Row = pl_get((*nd).rows, r) as *Row;
            var c2: int = 0;
            while (c2 < pl_len((*row).cells)) {
                sb_str(b, "<td>");
                render_nodes(b, pl_get((*row).cells, c2) as *PtrList);
                sb_str(b, "</td>");
                c2 = c2 + 1;
            }
            sb_str(b, "</tr>");
            r = r + 1;
        }
        sb_str(b, "</tbody></table>");
    } else if ((*nd).ntype == NT_MATHINLINE) {
        sb_str(b, "<span class=\"math-inline\">");
        escape_html(b, (*nd).content);
        sb_str(b, "</span>");
    } else if ((*nd).ntype == NT_MATHBLOCK) {
        sb_str(b, "<div class=\"math-block\">");
        escape_html(b, (*nd).content);
        sb_str(b, "</div>");
    } else if ((*nd).ntype == NT_TASK) {
        if ((*nd).checked) { sb_str(b, "<input type='checkbox' checked disabled>"); }
        else { sb_str(b, "<input type='checkbox' disabled>"); }
    } else if ((*nd).ntype == NT_LINK) {
        sb_str(b, "<a href=\"");
        escape_html(b, (*nd).url);
        sb_str(b, "\">");
        escape_html(b, (*nd).label);
        sb_str(b, "</a>");
    } else if ((*nd).ntype == NT_IMAGE) {
        sb_str(b, "<img src=\"");
        escape_html(b, (*nd).url);
        sb_str(b, "\" alt=\"");
        escape_html(b, (*nd).label);
        sb_str(b, "\">");
    } else if ((*nd).ntype == NT_LITERAL) {
        sb_str(b, "<pre>");
        escape_html(b, (*nd).content);
        sb_str(b, "</pre>");
    } else if ((*nd).ntype == NT_CODEBLOCK) {
        sb_str(b, "<pre><code class=\"language-");
        sb_str(b, (*nd).language);
        sb_str(b, "\">");
        escape_html(b, (*nd).content);
        sb_str(b, "</code></pre>");
    } else if ((*nd).ntype == NT_INLINECODE) {
        sb_str(b, "<code>");
        escape_html(b, (*nd).content);
        sb_str(b, "</code>");
    } else if ((*nd).ntype == NT_BOLD || (*nd).ntype == NT_ITALIC || (*nd).ntype == NT_UNDERLINE ||
               (*nd).ntype == NT_HIGHLIGHT || (*nd).ntype == NT_STRIKE || (*nd).ntype == NT_SUBSCRIPT ||
               (*nd).ntype == NT_SUPERSCRIPT) {
        var tag: *char = "strong";
        if ((*nd).ntype == NT_ITALIC) { tag = "em"; }
        else if ((*nd).ntype == NT_UNDERLINE) { tag = "u"; }
        else if ((*nd).ntype == NT_HIGHLIGHT) { tag = "mark"; }
        else if ((*nd).ntype == NT_STRIKE) { tag = "s"; }
        else if ((*nd).ntype == NT_SUBSCRIPT) { tag = "sub"; }
        else if ((*nd).ntype == NT_SUPERSCRIPT) { tag = "sup"; }
        sb_char(b, '<' as char);
        sb_str(b, tag);
        sb_char(b, '>' as char);
        render_nodes(b, (*nd).children);
        sb_str(b, "</");
        sb_str(b, tag);
        sb_char(b, '>' as char);
    }
}

// --- main ---
// std.io's read_all caps at 4096 bytes; read the whole stdin.
func read_all_big() -> *char {
    var cap: int = 65536;
    var buf: *char = malloc((cap) as i64) as *char;
    var total: int = 0;
    while (true) {
        if (total + 4096 > cap) {
            var ncap: int = cap * 2;
            var nd: *char = malloc((ncap) as i64) as *char;
            if (total > 0) { memcpy(nd as *void, buf as *void, total); }
            free(buf as *void);
            buf = nd;
            cap = ncap;
        }
        var n: int = read_stdin((buf + total) as *u8, 4096);
        if (n <= 0) break;
        total = total + n;
    }
    buf[total] = 0 as char;
    return buf;
}

func _start() {
    // Read the input file from stdin (the runner feeds the file via stdin).
    var input: *char = read_all_big();
    var doc: *PtrList = parse_doc(input);
    var b: *StrBuf = sb_new();

    // Wrap the rendered fragment in the same HTML document the C++
    // reference CLI emits (src/main.cpp).
    sb_str(b, "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>SOLUM Render</title>\n<style>body {{ font-family: sans-serif; padding: 40px; line-height: 1.6; max-width: 800px; margin: auto; color: #333; }}\n");
sb_str(b, "h1, h2, h3 {{ color: #222; }}\n");
sb_str(b, "table {{ border-collapse: collapse; margin-bottom: 1em; width: 100%; }}\n");
sb_str(b, "th, td {{ border: 1px solid #ddd; padding: 12px; text-align: left; }}\n");
sb_str(b, "th {{ background-color: #f8f8f8; }}\n");
sb_str(b, "pre {{ background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; border: 1px solid #ddd; }}\n");
sb_str(b, "code {{ background: #eee; padding: 2px 4px; border-radius: 3px; font-family: monospace; }}\n");
sb_str(b, "ul, ol {{ margin-bottom: 1em; }}\n");
sb_str(b, "li {{ margin-bottom: 0.5em; }}</style>\n");
sb_str(b, "</head>\n<body>\n");
    render_nodes(b, doc);
sb_str(b, "\n</body>\n</html>");
    var out: *char = sb_cstr(b);
    var outlen: int = (*b).slen;

    // write(1, out, outlen) — single multi-line asm block so the
    // {out}/{outlen} loads are emitted before the whole block.
    asm {
        "mov rax, 1\n"
        "mov rdi, 1\n"
        "mov rsi, {out}\n"
        "mov edx, {outlen}\n"
        "syscall\n"
        "mov rax, 60\n"
        "xor rdi, rdi\n"
        "syscall\n"
    }
}
