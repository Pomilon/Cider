// CIDER-BUG-092: a fixed array declared through a type alias takes the
// same list-literal and wide-string-literal initializers as the direct
// spelling. Before the fix the declaration site tested isArray on the
// alias spelling (false until the chain resolves), so `var s: Row =
// [1,2,3]` fell through to the generic mismatch ("Expected Row, got
// *int") and ir_gen's .data / element-store paths never ran.
// Covers locals, globals (nonzero values, so a silent BSS slot fails the
// checks), alias-of-alias chains, runtime elements and u16 widths.
type Row = [u8; 3];
type RowAlias = Row;
type DeepAlias = RowAlias;
type Words = [u16; 2];
type Wide = [u16; 4];
type WideAlias = Wide;

var g_row: Row = new [u8; 3] { 1, 2, 3 };
var g_alias: RowAlias = new [u8; 3] { 4, 5, 6 };
var g_deep: DeepAlias = new [u8; 3] { 7, 8, 9 };
var g_ws: Wide = new [u16; 4] { 65, 66, 67, 0 };
var g_ws_alias: WideAlias = new [u16; 4] { 88, 89, 90, 0 };

func main() -> int {
  // Local list literal through the alias.
  var s: Row = new [u8; 3] { 10, 20, 30 };
  if (s[0] != 10) { return 1; }
  if (s[1] != 20) { return 2; }
  if (s[2] != 30) { return 3; }

  // Alias of alias.
  var a: RowAlias = new [u8; 3] { 40, 50, 60 };
  if (a[0] != 40) { return 4; }
  if (a[2] != 60) { return 5; }

  // Runtime elements: every element store must run through the alias,
  // exactly like the direct spelling.
  var n: int = 77;
  var u: Row = new [u8; 3] { n as u8, (n + 1) as u8, 8 };
  if (u[0] != 77) { return 6; }
  if (u[1] != 78) { return 7; }
  if (u[2] != 8) { return 8; }

  // Wider elements: 16-bit stores through the alias.
  var w: Words = new [u16; 2] { 65535, 66 };
  if (w[0] != 65535) { return 9; }
  if (w[1] != 66) { return 10; }

  // Wide-string literal through the alias and its alias (NUL unit kept).
  var ws: Wide = new [u16; 4] { 65, 66, 67, 0 };
  if (ws[0] != 65) { return 11; }
  if (ws[2] != 67) { return 12; }
  if (ws[3] != 0) { return 13; }
  var wsa: WideAlias = new [u16; 4] { 88, 89, 90, 0 };
  if (wsa[0] != 88) { return 14; }
  if (wsa[2] != 90) { return 15; }
  if (wsa[3] != 0) { return 16; }

  // Globals emitted into .data (all nonzero).
  if (g_row[1] != 2) { return 17; }
  if (g_alias[2] != 6) { return 18; }
  if (g_deep[0] != 7) { return 19; }
  if (g_ws[1] != 66) { return 20; }
  if (g_ws[3] != 0) { return 21; }
  if (g_ws_alias[0] != 88) { return 22; }
  if (g_ws_alias[3] != 0) { return 23; }
  return 0;
}
