// CIDER-BUG-112: a list literal reassigned into an existing fixed array
// (`arr = [1,2,3];`) must take the declaration-time element semantics:
// alias-resolved shapes (CIDER-BUG-071/092), per-element width stores,
// aggregate element copies (CIDER-BUG-104) and the same size/type checks.
// Before the fix the reassignment fell through to the generic mismatch
// ("Expected [int; 3], got *int") because the list-literal path existed
// only at declaration time.
//
// Covered here on all three backends (VM unopt, VM optimized, native):
// direct/alias/alias-of-alias locals and globals (with runtime elements and
// narrow element widths for the per-element offsets), class/struct/
// interface aggregate elements with copy independence, struct fields
// (including a field and a parameter spelled with an alias-to-array of
// interface elements), deref targets and nested fixed arrays, the unchanged
// declaration path, and the unchanged scalar pointer-from-list expression
// path.
from std.io import print, printInt;

interface Shape {
  func area() -> int;
}

class C4 { var x: int; }                                      // 4 bytes
class C16 { var a: int; var b: int; var c: int; var d: int; } // 16 bytes
struct S8 { var a: int; var b: int; }                         // exactly 8 bytes

class Sq {
  var side: int;
  func area() -> int { return this.side * this.side; }
}

type Row = [int; 3];
type RowAlias = Row;
type RowChain = RowAlias;
type Bytes = [u8; 4];
type Shapes2 = [Shape; 2];    // alias-to-array of interface elements

struct Holder {
  var r: Row;
  var m: [[u8; 2]; 2];
}

struct WrapArr {
  var s: Shapes2;   // alias-to-array field
  var tail: int;
}

var g_direct: [int; 3];
var g_alias: Row;
var g_bytes: Bytes;
var g_s8: [S8; 2];
var g_c16: [C16; 2];
var g_iface: Shapes2;

// A parameter of alias-to-array type: the list reassignment runs on the
// callee's copy (the collector's interface flag must not treat the
// aggregate as one 16-byte fat pointer).
func refillShapes(dst: Shapes2, x: Shape, y: Shape) -> int {
  dst = [x, y];
  return dst[0].area() + dst[1].area();
}

func main() -> int {
  var n: int = 40;

  // Direct, alias and alias-of-alias locals with runtime elements, then a
  // second reassignment (stale bytes must be fully replaced).
  var d: [int; 3];
  d = [n, n + 1, n + 2];
  if (d[0] != 40 || d[1] != 41 || d[2] != 42) { return 1; }
  var a: Row;
  a = [1, 2, 3];
  if (a[0] != 1 || a[2] != 3) { return 2; }
  var aa: RowChain;
  aa = [4, 5, 6];
  if (aa[1] != 5) { return 3; }
  d = [7, 8, 9];
  if (d[0] != 7 || d[2] != 9) { return 4; }

  // Globals: a runtime list into a direct array, an alias-shaped one, and a
  // narrow (u8) element array (every element must land at its own offset;
  // the global label base is materialised for this).
  g_direct = [n * 2, n - 1, 0];
  if (g_direct[0] != 80 || g_direct[1] != 39 || g_direct[2] != 0) { return 5; }
  g_alias = [10, 20, 30];
  if (g_alias[0] != 10 || g_alias[2] != 30) { return 6; }
  g_bytes = [201, 202, 203, 204];
  if (g_bytes[0] != 201 || g_bytes[3] != 204) { return 7; }
  g_bytes = [1, 2, 3, 4];
  if (g_bytes[0] != 1 || g_bytes[2] != 3) { return 8; }

  // 8-byte struct elements: value copies, not source addresses, and a
  // global target with the same aggregate rule.
  var s1: S8; s1.a = 11; s1.b = 22;
  var s2: S8; s2.a = 33; s2.b = 44;
  var ls: [S8; 2];
  ls = [s1, s2];
  if (ls[0].a != 11 || ls[0].b != 22) { return 9; }
  if (ls[1].a != 33 || ls[1].b != 44) { return 10; }
  s1.a = 99;
  if (ls[0].a != 11) { return 11; }        // copy independence
  g_s8 = [s2, s1];
  if (g_s8[0].b != 44 || g_s8[1].a != 99) { return 12; }

  // 16-byte class elements: a truncated copy would lose the tail fields.
  var c1: C16; c1.a = 1; c1.b = 2; c1.c = 3; c1.d = 4;
  var c2: C16; c2.a = 5; c2.b = 6; c2.c = 7; c2.d = 8;
  var lc: [C16; 2];
  lc = [c1, c2];
  if (lc[0].d != 4 || lc[1].a != 5 || lc[1].d != 8) { return 13; }
  g_c16 = [c2, c1];
  if (g_c16[0].c != 7 || g_c16[1].b != 2) { return 14; }

  // 4-byte class elements through a local target.
  var e1: C4; e1.x = 70;
  var e2: C4; e2.x = 71;
  var le: [C4; 2];
  le = [e1, e2];
  if (le[0].x != 70 || le[1].x != 71) { return 15; }

  // 16-byte interface elements, direct array and alias-to-array (both fat
  // pointer halves must be copied; a re-assignment must replace both).
  var sq1: Sq; sq1.side = 3;
  var sq2: Sq; sq2.side = 4;
  var i1: Shape = sq1;
  var i2: Shape = sq2;
  var ia: [Shape; 2];
  ia = [i1, i2];
  if (ia[0].area() != 9 || ia[1].area() != 16) { return 16; }
  ia = [i2, i2];
  if (ia[0].area() != 16 || ia[1].area() != 16) { return 17; }
  var ib: Shapes2;
  ib = [i2, i1];
  if (ib[0].area() != 16 || ib[1].area() != 9) { return 18; }
  g_iface = [i1, i2];
  if (g_iface[0].area() != 9 || g_iface[1].area() != 16) { return 19; }

  // Alias-to-array struct field and function parameter (the collector must
  // size these as 2 x 16 bytes, not as one interface).
  var wa: WrapArr;
  wa.s = [i1, i2];
  if (wa.s[0].area() != 9 || wa.s[1].area() != 16) { return 29; }
  wa.s = [i2, i2];
  if (wa.s[0].area() != 16 || wa.s[1].area() != 16) { return 30; }
  if (refillShapes(ib, i2, i1) != 25) { return 31; }   // 16 + 9

  // Struct field target, nested fixed-array element target, and a deref
  // target.
  var h: Holder;
  h.r = [50, 51, 52];
  if (h.r[0] != 50 || h.r[2] != 52) { return 20; }
  h.m[1] = [7, 8];
  if (h.m[1][0] != 7 || h.m[1][1] != 8) { return 21; }
  var p: *Row = &h.r;
  *p = [60, 61, 62];
  if (h.r[0] != 60 || h.r[2] != 62) { return 22; }
  // Whole nested array from array-typed expressions (aggregate elements).
  var row0: [u8; 2]; row0[0] = 90; row0[1] = 91;
  var row1: [u8; 2]; row1[0] = 92; row1[1] = 93;
  h.m = [row0, row1];
  if (h.m[0][1] != 91 || h.m[1][0] != 92) { return 23; }

  // The scalar pointer-from-list expression path is unchanged, at both the
  // declaration and the reassignment site.
  var pv: *int = [1, 2, 3];
  if (pv[0] != 1 || pv[2] != 3) { return 24; }
  pv = [4, 5, 6];
  if (pv[0] != 4 || pv[2] != 6) { return 25; }

  // The declaration-time list literal path is unchanged.
  var decl: Row = [9, 8, 7];
  if (decl[0] != 9 || decl[2] != 7) { return 26; }
  var declAlias: RowAlias = [6, 5, 4];
  if (declAlias[1] != 5) { return 27; }
  var declBytes: Bytes = [10, 11, 12, 13];
  if (declBytes[0] != 10 || declBytes[3] != 13) { return 28; }

  printInt(d[0] + d[2]); print(",");
  printInt(g_direct[0] + g_direct[1]); print(",");
  printInt(g_bytes[1] + g_bytes[3]); print(",");
  printInt(ls[0].a + ls[1].b); print(",");
  printInt(g_s8[0].a + g_s8[1].b); print(",");
  printInt(lc[0].d + lc[1].d); print(",");
  printInt(g_c16[0].c + g_c16[1].a); print(",");
  printInt(le[0].x + le[1].x); print(",");
  printInt(ia[0].area() + ia[1].area()); print(",");
  printInt(ib[0].area() + ib[1].area()); print(",");
  printInt(h.r[0] + h.r[2]); print(",");
  printInt(h.m[0][1] + h.m[1][0]); print(",");
  printInt(pv[0] + pv[2]); print(",");
  printInt(decl[0] + declAlias[2] + declBytes[2]); print("\n");
  print("list_reassign_ok\n");
  return 0;
}
