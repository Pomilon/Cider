// CIDER-BUG-138 positive controls: every legal alias shape stays accepted
// after the declaration-site visibility check. Covered here: a builtin
// target, a same-module private target, an exported dotted target, an
// exported alias chain ending at the library's private type, a
// self-alias, and (inside the library) a self-qualified private target.
// CIDER-BUG-176: the library's exported self-qualified alias (and a bare
// chain over it) must also resolve at foreign use sites.
import alias_vis_lib;

struct LocalPriv {
  var v: int;
}

type IntAlias = int;
type LocalAlias = LocalPriv;
type PubAlias = alias_vis_lib.Pub;
type ChainAlias = alias_vis_lib.Chained;
type SelfAlias = SelfAlias;
type ForeignSelfQualified = alias_vis_lib.SelfQualified;
type ForeignChainViaSelf = alias_vis_lib.ChainViaSelf;

func main() -> int {
  var p: PubAlias;
  p.w = 4;
  p.h = 5;
  var c: ChainAlias;
  c.v = 7;
  var l: LocalAlias;
  l.v = 3;
  var i: IntAlias = 2;
  var s: ForeignSelfQualified;
  s.v = 11;
  var d: ForeignChainViaSelf;
  d.v = 13;
  return p.w + p.h + c.v + l.v + i + s.v + d.v;  // 45
}
