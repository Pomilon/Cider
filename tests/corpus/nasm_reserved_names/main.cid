// CIDER-BUG-072: main-file symbols keep their bare Cider names, so a name
// that collides with a NASM reserved word used to emit invalid assembly
// (`gs: dd 7` and `mov eax, [rel gs]` both fail to assemble). Colliding
// definitions now escape to a deterministic `$` suffix (`gs$`), applied to
// every definition and reference; non-colliding names (`add`, `main`,
// `arr`-style composites) keep their exact spelling.
var gs: int = 7;               // segment register
var ss: u32 = 5;               // segment register
var bp: u8 = 9;                // 16-bit register
var align: int = 11;           // NASM directive
var qword: [int; 3] = [1, 2, 3];  // reserved-named array global

// Reserved function name (also a register): escaped at definition and call.
func cs(a: int) -> int { return a + gs; }

// Instruction mnemonic: NASM accepts `add:` as a label, so it must keep its
// bare spelling (covered here so the test also pins the no-escaping rule).
func add(a: int, b: int) -> int { return a + b; }

func sumGlobals() -> int {
  return (gs + ss + bp + align) as int;
}

func main() -> int {
  if (sumGlobals() != 32) { return 1; }
  if (cs(1) != 8) { return 2; }
  if (add(20, 22) != 42) { return 3; }

  // Address-of + store through a pointer reaches the escaped label.
  var p: *int = &gs;
  *p = 17;
  if (gs != 17) { return 4; }

  // Array global with a reserved name, read and written.
  var n: int = 0;
  for (var i: int = 0; i < 3; i = i + 1) { n = n + qword[i]; }
  if (n != 6) { return 5; }
  qword[2] = 40;
  if (qword[2] != 40) { return 6; }

  return 0;
}
