// CIDER-BUG-245: a 16-byte load out of a global must read all 16 bytes,
// on the VM and on native.
//
// Root cause. The VM sized every LABEL-base LOAD at a forced 8 bytes
// ("global cells are 8 bytes", vm.cpp). Global cells are at least 8
// bytes but can be wider (Issue #11: `resb totalBytes`), so the rule
// silently truncates any wide aggregate load from a global to its first
// word: the data word of an interface value (the dispatch then indexes
// object fields as a vtable) or the first half of a struct. Native
// sizes every load by the destination type, so a scalar-branch
// misclassification truncates there identically — the width must follow
// the instruction, never the address spelling.
//
// Pinned, on all three backends (VM unoptimized, VM optimized, native):
//   * an interface global read into a local through the from-alias
//     spelling, then dispatched through both methods (the vtable word
//     must survive the load);
//   * the same global read through the module-qualified spelling;
//   * a 16-byte struct global read into a local (both halves printed);
//   * both values passed by value to a call;
//   * global-to-global copies of both kinds;
//   * a second implementor with a different tag/vtable stored into the
//     same global, so a stale vtable word fails loudly.
import lib;
from std.io import printInt;
from lib import gShape, gBox, gPeb, gB;

func takeShape(s: lib.Shape) -> int {
  return s.area() * 10 + s.tag();
}

func takeBig(b: lib.Big) -> i64 {
  return b.a * 100 + b.b;
}

func main() -> int {
  gBox.v = 21;
  gPeb.w = 100;
  gShape = gBox;
  lib.gB.a = 100;
  lib.gB.b = 7;

  // --- the interface global read into a variable -----------------------
  var s: lib.Shape = gShape;
  if (s.area() != 42) { return 1; }
  if (s.tag() != 7) { return 2; }
  printInt(s.area() * 10 + s.tag());

  // --- the same global through the qualified spelling -------------------
  var q: lib.Shape = lib.gShape;
  if (q.area() != 42) { return 3; }
  if (q.tag() != 7) { return 4; }

  // --- the 16-byte struct global read into a variable -------------------
  var b: lib.Big = gB;
  if (b.a != 100) { return 5; }
  if (b.b != 7) { return 6; }
  printInt((b.a * 100 + b.b) as int);

  // --- by-value arguments ------------------------------------------------
  if (takeShape(gShape) != 427) { return 7; }
  if (takeBig(gB) != 10007) { return 8; }

  // --- global-to-global copies -------------------------------------------
  lib.gShape = gShape;
  if (lib.gShape.tag() != 7) { return 9; }
  var c: lib.Big = lib.gB;
  if (c.a + c.b != 107) { return 10; }

  // --- a different implementor relabels the vtable -----------------------
  gShape = gPeb;
  var t: lib.Shape = gShape;
  if (t.area() != 101) { return 11; }
  if (t.tag() != 9) { return 12; }
  printInt(t.area() * 10 + t.tag());

  return 0;
}
