from std.io import print, printInt;

var touched: int = 0;

func touch() -> int {
    touched = touched + 1;
    return 7;
}

func main() -> int {
    var byCall: int = sizeof touch() as int;
    var byName: int = sizeof touched as int;
    var byType: int = sizeof(int) as int;
    printInt(byCall);
    print("\n");
    printInt(byName);
    print("\n");
    printInt(byType);
    print("\n");
    printInt(touched);
    print("\n");
    return 0;
}
