// CIDER-BUG-069: interface-typed struct/class fields and array elements are
// 16-byte fat pointers (data + vtable), exactly like interface variables
// (CIDER-BUG-054). They must be sized as 16 bytes, store the fat pointer on
// assignment (declaration, reassignment, struct literal), copy both words on
// by-value struct copies, and dispatch through the stored vtable when read.
// The companion lib.cid covers the cross-module/module-global spellings.
import lib;
from lib import Mark, Ten, Cell;

interface Shape {
  func area() -> int;
  func kind() -> int;
}

class Sq {
  var s: int;
  func area() -> int { return this.s * this.s; }
  func kind() -> int { return 1; }
}

class Rect {
  var w: int;
  var h: int;
  func area() -> int { return this.w * this.h; }
  func kind() -> int { return 2; }
}

struct Holder {
  var id: int;      // neighbour before the fat pointer
  var shape: Shape; // 16-byte fat pointer (offsets 8..24)
  var tail: int;    // neighbour after the fat pointer
}

class Box {
  var id: int;
  var shape: Shape;
  var tail: int;
}

struct Panel {
  var shapes: [Shape; 2]; // two 16-byte elements
  var tag: int;
}

struct Wrap {
  var pad: int;
  var inner: Holder; // nested struct carrying an interface field
}

struct Twin {
  var first: Shape;  // two adjacent fat pointers (offsets 0..16, 16..32)
  var second: Shape;
}

func areaOf(h: Holder) -> int {
  return h.shape.area();
}

// Callee retargets its own by-value copy; the caller's fat pointer must not
// be disturbed (the whole struct, including the interface field, is copied).
func retargeted(h: Holder) -> int {
  var r: Rect;
  r.w = 6;
  r.h = 7;
  h.shape = r;
  return h.shape.area();
}

func useShape(x: Shape) -> int {
  return x.area();
}

func areaViaPtr(p: *Holder) -> int {
  return p->shape.area();
}

func main() -> int {
  var c: Sq;
  c.s = 3;
  var r: Rect;
  r.w = 2;
  r.h = 5;

  // --- struct interface field: assign, neighbours intact, dispatch ---
  var h: Holder;
  h.id = 7;
  h.tail = 9;
  h.shape = c;
  if (h.id != 7) { return 1; }
  if (h.tail != 9) { return 2; }
  if (h.shape.area() != 9) { return 3; }

  // Reassignment dispatches to the new implementor.
  h.shape = r;
  if (h.shape.area() != 10) { return 4; }
  if (h.id != 7) { return 5; }
  if (h.tail != 9) { return 6; }

  // Reassign back to the first implementor.
  h.shape = c;
  if (h.shape.area() != 9) { return 7; }
  if (h.shape.kind() != 1) { return 8; }

  // --- struct literal initializes an interface field ---
  var lit: Holder = Holder{id: 11, shape: r, tail: 13};
  if (lit.id != 11) { return 9; }
  if (lit.tail != 13) { return 10; }
  if (lit.shape.area() != 10) { return 11; }
  if (lit.shape.kind() != 2) { return 12; }

  // --- by-value struct copy keeps both fat-pointer words ---
  var copy: Holder = h;
  if (copy.shape.area() != 9) { return 13; }
  if (copy.id != 7) { return 14; }
  if (copy.tail != 9) { return 15; }
  copy.shape = r;
  if (copy.shape.area() != 10) { return 16; }
  if (h.shape.area() != 9) { return 17; } // source untouched

  // --- by-value parameter copy (read and retarget) ---
  if (areaOf(h) != 9) { return 18; }
  if (retargeted(h) != 42) { return 19; }
  if (h.shape.area() != 9) { return 20; } // caller's field untouched

  // --- pointer-to-struct field access ---
  var hp: *Holder = &h;
  if (areaViaPtr(hp) != 9) { return 21; }
  hp->shape = r;
  if (areaViaPtr(hp) != 10) { return 22; }
  if (h.shape.area() != 10) { return 23; }
  hp->shape = c;
  if (h.shape.area() != 9) { return 24; }

  // --- interface field read into an interface variable ---
  var s2: Shape = h.shape;
  if (s2.area() != 9) { return 25; }
  s2 = r;
  if (s2.area() != 10) { return 26; }
  if (h.shape.area() != 9) { return 27; } // field untouched by local reassign

  // --- class interface field (value-class local) ---
  var b: Box;
  b.id = 21;
  b.tail = 23;
  b.shape = r;
  if (b.id != 21) { return 28; }
  if (b.tail != 23) { return 29; }
  if (b.shape.area() != 10) { return 30; }
  b.shape = c;
  if (b.shape.area() != 9) { return 31; }
  if (b.shape.kind() != 1) { return 32; }

  // --- class interface field (heap object) ---
  var bp: *Box = new Box;
  bp->id = 31;
  bp->tail = 33;
  bp->shape = r;
  if (bp->id != 31) { return 33; }
  if (bp->tail != 33) { return 34; }
  if (bp->shape.area() != 10) { return 35; }
  bp->shape = c;
  if (bp->shape.area() != 9) { return 36; }
  if (bp->shape.kind() != 1) { return 37; }

  // --- array of interfaces (local, 16-byte stride) ---
  var arr: [Shape; 2];
  arr[0] = c;
  arr[1] = r;
  if (arr[0].area() != 9) { return 38; }
  if (arr[1].area() != 10) { return 39; }
  arr[0] = arr[1]; // element-to-element fat-pointer copy
  if (arr[0].area() != 10) { return 40; }
  if (arr[1].area() != 10) { return 41; }
  arr[0] = r;
  if (arr[0].kind() != 2) { return 42; }

  // --- array of interfaces as a struct field ---
  var pn: Panel;
  pn.tag = 41;
  pn.shapes[0] = c;
  pn.shapes[1] = r;
  if (pn.tag != 41) { return 43; }
  if (pn.shapes[0].area() != 9) { return 44; }
  if (pn.shapes[1].area() != 10) { return 45; }
  pn.shapes[0] = r;
  if (pn.shapes[0].area() != 10) { return 46; }
  if (pn.shapes[0].kind() != 2) { return 47; }
  if (pn.tag != 41) { return 48; }

  // --- two adjacent fat pointers: no overlap, field-to-field copy ---
  var tw: Twin;
  tw.first = c;
  tw.second = r;
  if (tw.first.area() != 9) { return 49; }
  if (tw.second.area() != 10) { return 50; }
  tw.first = tw.second;
  if (tw.first.area() != 10) { return 51; }
  if (tw.second.area() != 10) { return 52; }
  tw.first = tw.first; // self-assignment
  if (tw.first.area() != 10) { return 53; }
  if (useShape(tw.second) != 10) { return 54; } // field as interface argument
  tw.second = c;
  if (tw.first.area() != 10) { return 55; }
  if (tw.second.area() != 9) { return 56; }

  // --- nested struct: copying the outer struct copies the inner fat pointer ---
  var w: Wrap;
  w.pad = 5;
  w.inner = h;
  if (w.pad != 5) { return 57; }
  if (w.inner.shape.area() != 9) { return 58; }
  var wcopy: Wrap = w;
  if (wcopy.inner.shape.area() != 9) { return 59; }
  wcopy.inner.shape = r;
  if (wcopy.inner.shape.area() != 10) { return 60; }
  if (w.inner.shape.area() != 9) { return 61; } // nested source untouched

  // --- cross-module: interface field of a module-global struct ---
  var ten: Ten;
  lib.shared.id = 63;
  lib.shared.mark = ten;
  if (lib.shared.id != 63) { return 62; }
  if (lib.shared.mark.value() != 10) { return 63; }
  var m: Mark = lib.shared.mark; // read through an imported interface type
  if (m.value() != 10) { return 64; }
  lib.shared.mark = ten;         // reassignment keeps the module-global path
  if (lib.shared.mark.value() != 10) { return 65; }

  return 0;
}
