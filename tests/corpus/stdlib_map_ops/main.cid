// CIDER-CHORE-003: std.map beyond map_remove.cid (which already covers
// collisions, tombstones, churn and growth). This program pins the empty-map
// error paths, key 0 and negative keys, replacement without growth,
// growth across a large negative-to-positive key range, removal of half the
// table, and independence of two maps.
from std.io import print, puts, printInt;
from std.map import HashMap, new_map, insert_map, get_map, contains_map, remove_map, len_map, free_map;

func main() -> int {
    // Empty map: misses are nil/false, remove is false, len is 0.
    var m: HashMap<int, int> = new_map::<int, int>();
    if (len_map::<int, int>(&m) != 0) return 1;
    if (get_map::<int, int>(&m, 5) != nilPtr) return 2;
    if (contains_map::<int, int>(&m, 5)) return 3;
    if (remove_map::<int, int>(&m, 5)) return 4;

    // Key 0, a negative key and a large key all resolve.
    insert_map::<int, int>(&m, 0, 100);
    insert_map::<int, int>(&m, -5, 200);
    insert_map::<int, int>(&m, 1000000, 300);
    if (len_map::<int, int>(&m) != 3) return 5;
    var p: *int = get_map::<int, int>(&m, 0);
    if (p == nilPtr || *p != 100) return 6;
    p = get_map::<int, int>(&m, -5);
    if (p == nilPtr || *p != 200) return 7;
    p = get_map::<int, int>(&m, 1000000);
    if (p == nilPtr || *p != 300) return 8;
    if (!contains_map::<int, int>(&m, -5)) return 9;

    // Replacement overwrites the value and leaves len alone.
    insert_map::<int, int>(&m, -5, 201);
    if (len_map::<int, int>(&m) != 3) return 10;
    p = get_map::<int, int>(&m, -5);
    if (p == nilPtr || *p != 201) return 11;

    // Growth across many negative and positive keys.
    var big: HashMap<int, int> = new_map::<int, int>();
    var i: int = -250;
    while (i < 250) {
        insert_map::<int, int>(&big, i, i * 3 + 1);
        i = i + 1;
    }
    if (len_map::<int, int>(&big) != 500) return 12;
    i = -250;
    while (i < 250) {
        p = get_map::<int, int>(&big, i);
        if (p == nilPtr) return 13;
        if (*p != i * 3 + 1) return 14;
        i = i + 1;
    }

    // Remove every even key; odd keys must stay reachable past tombstones.
    i = -250;
    var removed: int = 0;
    while (i < 250) {
        if (i % 2 == 0) {
            if (!remove_map::<int, int>(&big, i)) return 15;
            removed = removed + 1;
        }
        i = i + 1;
    }
    if (removed != 250) return 16;
    if (len_map::<int, int>(&big) != 250) return 17;
    i = -250;
    while (i < 250) {
        if (i % 2 == 0) {
            if (contains_map::<int, int>(&big, i)) return 18;
        } else {
            p = get_map::<int, int>(&big, i);
            if (p == nilPtr || *p != i * 3 + 1) return 19;
        }
        i = i + 1;
    }

    // Churn: reinsert the removed keys (freeing tombstones), remove again.
    i = -250;
    while (i < 250) {
        if (i % 2 == 0) insert_map::<int, int>(&big, i, i);
        i = i + 1;
    }
    if (len_map::<int, int>(&big) != 500) return 20;
    i = -250;
    while (i < 250) {
        if (i % 2 == 0) {
            if (!remove_map::<int, int>(&big, i)) return 21;
        }
        i = i + 1;
    }
    if (len_map::<int, int>(&big) != 250) return 22;

    // Two maps do not share state.
    insert_map::<int, int>(&m, 7, 700);
    if (len_map::<int, int>(&m) != 4) return 23;
    if (contains_map::<int, int>(&big, 400)) return 24;
    p = get_map::<int, int>(&m, 7);
    if (p == nilPtr || *p != 700) return 25;

    print("len_m="); printInt(len_map::<int, int>(&m)); puts("");
    print("len_big="); printInt(len_map::<int, int>(&big)); puts("");

    free_map::<int, int>(&m);
    free_map::<int, int>(&big);
    puts("map ok");
    return 0;
}
