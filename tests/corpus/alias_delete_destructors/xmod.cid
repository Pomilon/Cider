from std.alloc import operator new, operator delete;
// Cross-module alias targets for CIDER-BUG-125: the alias `Alias2` is
// exported, its target `XClass` is not, and the class destructor mangles under
// this defining module. A delete through the alias in the importing file must
// still find the destructor definition and label it with this module.
var xdrops: int = 0;

class XClass {
    var label: int;
    func ~XClass() {
        xdrops = xdrops + 1;
    }
}

export type Alias2 = XClass;
export type Chain2 = Alias2;

export func xcount() -> int {
    return xdrops;
}

export func xmake() -> *Chain2 {
    return new Chain2;
}
