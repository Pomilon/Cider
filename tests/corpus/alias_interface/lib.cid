// CIDER-BUG-078: an exported interface plus alias spellings of it, re-exported
// for the companion main.cid. `S` is a direct alias, `T` an alias-of-alias;
// both must behave exactly like the direct `Shape` spelling at every
// declaration site (storage, assignment, dispatch, fields, arrays, params,
// returns) and on every backend.
export interface Shape {
  func area() -> int;
  func kind() -> int;
}

export class Sq {
  var s: int;
  func area() -> int { return (*self).s * (*self).s; }
  func kind() -> int { return 1; }
}

export class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
  func kind() -> int { return 2; }
}

export type S = Shape;
export type T = S;
