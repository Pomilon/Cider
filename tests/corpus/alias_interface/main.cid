// CIDER-BUG-078: an alias to an interface (`type S = Shape`) must behave
// exactly like the direct interface spelling — 16-byte fat-pointer storage,
// the interface conversion/assignment rules, and vtable dispatch — at every
// declaration/annotation site. Before the fix, only sizing resolved the
// alias chain: `var s: S` stayed a type error at declaration/assignment/
// argument/return sites and dispatch reported "Type S is not a struct or
// class".
//
// Covered here: alias-typed locals (direct and alias-of-alias) with
// reassignment, an alias-to-interface copy, a module-global alias variable,
// struct and class fields spelled with the alias, a fixed array of alias
// elements, alias-typed parameters (bare and module-qualified) and returns,
// a module-qualified alias (`type V = lib.Shape`), a from-imported alias
// (`from lib import S`), and a local class satisfying the imported
// interface through the alias spelling.
import lib;
from lib import Shape, Sq, Rect, S, T;

type U = S;          // alias of a from-imported alias (on top of lib's S)
type V = lib.Shape;  // alias of a module-qualified interface

struct Holder {
  var id: int;
  var shape: S;   // 16-byte fat pointer at a non-zero offset
  var tail: int;  // neighbour after the fat pointer
}

class Box {
  var id: int;
  var shape: T;   // alias-of-alias field
  var tail: int;
}

class Local {
  var v: int;
  func area() -> int { return (*self).v + 100; }
  func kind() -> int { return 3; }
}

var gshape: U = nilPtr as U;  // module-global alias-of-alias interface variable

func areaVia(x: S) -> int { return x.area(); }
func kindVia(x: T) -> int { return x.kind(); }
func areaViaV(x: V) -> int { return x.area(); }

func make(v: int) -> Sq {  // concrete return, boxed below
  var c: Sq = Sq { s: v };
  return c;
}

func main() -> int {
  var acc: int = 0;
  var sq: Sq = Sq { s: 3 };
  var rect: Rect = Rect { w: 2, h: 5 };

  // Alias-typed local: declaration from an implementing class, dispatch,
  // then reassignment to a second implementor (fat-pointer store).
  var s: S = sq;
  acc = acc + s.area();  // 9
  s = rect;
  acc = acc + s.area();  // 10

  // Alias-of-alias local with dispatch.
  var t: T = sq;
  acc = acc + t.area();  // 9

  // Interface-to-interface copy through the alias spelling.
  var s2: S = s;
  acc = acc + s2.kind();  // 2

  // Module-global alias-typed interface variable.
  gshape = rect;
  acc = acc + gshape.area();  // 10

  // Struct field and class field spelled with the alias; the struct-literal
  // initializer is a declaration site too.
  var h: Holder = Holder { id: 1, shape: sq, tail: 7 };
  acc = acc + h.shape.area() + h.id + h.tail;  // 9 + 1 + 7
  var h2: Holder = Holder { id: 2, shape: sq, tail: 0 };
  acc = acc + h2.shape.area() + h2.id;  // 9 + 2
  var b: Box = Box { id: 0, shape: rect, tail: 0 };
  acc = acc + b.shape.area();  // 10

  // Fixed array of alias-typed elements.
  var arr: [T; 2] = [ nilPtr as T, nilPtr as T ];
  arr[0] = sq;
  arr[1] = rect;
  acc = acc + arr[0].area() + arr[1].area();  // 9 + 10

  // Alias-typed parameters (bare alias, alias-of-alias, module-qualified
  // alias of the interface).
  acc = acc + areaVia(sq) + kindVia(rect) + areaViaV(sq);  // 9 + 2 + 9

  // Module-qualified alias spellings (`lib.S`, `lib.T`).
  var qs: lib.S = sq;
  var qt: lib.T = rect;
  acc = acc + qs.area() + qt.kind();  // 9 + 2

  // Alias-typed return, and a local class satisfying the imported interface
  // while the value is stored through the alias.
  var m: U = make(4);
  acc = acc + m.area();  // 16
  var loc: Local = Local { v: 5 };
  var lv: S = loc;
  acc = acc + lv.area();  // 105

  return acc;  // 249
}
