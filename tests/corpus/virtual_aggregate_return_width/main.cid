// CIDER-BUG-224: a virtual/override by-value aggregate return must reach the
// caller as a full-width POINTER. The non-sret return convention is the
// internal "heap copy" ABI (see visit(ReturnStmt)'s legacy path): the callee
// mallocs a buffer, memcpys the aggregate into it, and returns the buffer's
// ADDRESS, which the caller reads out of and then frees at its enclosing scope
// exit (CIDER-BUG-137/156).
//
// THE DEFECT. The caller typed the VIRTUAL_CALL's destination register from the
// STATIC return spelling, and an array spelling's `name` is its ELEMENT
// spelling. So `-> [int; 2]` mapped to I32 and codegen wrote the returned
// address back with `mov dword [slot], eax`; `-> [u8; 4]` was worse, emitting
// `mov byte [slot], al` and storing ONE BYTE of a 64-bit address. The next read
// of that slot then loaded a value that is not a pointer.
//
// Why an int-element return survived for so long: the truncation is invisible
// when the destination slot's upper half already holds zero, the alloca region
// is zeroed on entry (CIDER-BUG-220) and a 32-bit store leaves the rest of the
// slot alone. So the same program passed or faulted depending only on where the
// register allocator happened to put that one value. Moving it is enough, and
// moving it takes nothing more than a branch elsewhere in the caller, or the
// removal of a dead duplicate block that shifted the spill layout. That is the
// register-allocation half of this ticket: a callee's codegen changed, with no
// source-level change anywhere near the call site.
//
// What is pinned here, on all three backends:
//   * a virtual array return, an override of it, a virtual STRUCT return and a
//     nested-array return, all read back through the returned pointer after the
//     frame has been churned, so a dead frame address cannot pass by luck;
//   * a virtual return of an array whose ELEMENT is NARROWER than a pointer.
//     This is the deterministic half of the guard: one byte of an address is
//     lost on every build, whatever the allocator does, and the caller's read
//     then dereferences a value under 256 (or frees it, which aborts);
//   * a return whose element is a full pointer width (`i64`), which the
//     defective typing happened to get right, so both sides of the
//     element-width split are pinned and the fix is not just "widen
//     everything";
//   * the array is also sized so the callee's buffer is a large allocation, so
//     a 32-bit truncation also loses the high half of a real heap address;
//   * the result is also assigned into an already-declared variable and read
//     through a pointer, so the width is checked on more than one path;
//   * a virtual scalar return still works, so the pointer typing did not leak
//     into the ordinary integer case.
from std.io import print, printInt;

type Narrow = [u8; 4];
type Row = [i64; 4];
type Two = [[i64; 2]; 2];
type Wide = [i32; 20000];

class Base {
  // A guard branch, so this definition is not the trivially shape the inliner
  // would fold away: the subject of the program is the CALLER's handling of the
  // result, not the callee's body.
  virtual func wide(n: int) -> Wide {
    var a: Wide = [0, ...];
    if (n < 0) { return a; }
    a[0] = 11;
    a[19999] = 12;
    return a;
  }
  // The narrow-element return: one byte of the returned address is all the
  // defective typing kept.
  virtual func narrow() -> Narrow {
    var b: Narrow = [1, 2, 3, 4];
    return b;
  }
  virtual func row() -> Row {
    var r: Row = [21, 22, 23, 24];
    return r;
  }
  virtual func nested() -> Two {
    var t: Two = [ [31, 32], [33, 34] ];
    return t;
  }
  virtual func scalar(n: int) -> int { return n * 3; }
}

class Derived : Base {
  func wide(n: int) -> Wide {
    var a: Wide = [0, ...];
    if (n < 0) { return a; }
    a[0] = 13;
    a[19999] = 14;
    return a;
  }
  func narrow() -> Narrow {
    var b: Narrow = [5, 6, 7, 8];
    return b;
  }
  func row() -> Row {
    var r: Row = [31, 32, 33, 34];
    return r;
  }
  func nested() -> Two {
    var t: Two = [ [41, 42], [43, 44] ];
    return t;
  }
  func scalar(n: int) -> int { return n * 5; }
}

// Churns the stack frame a return through a dead address would point into, so
// a missing copy is caught instead of accidentally reading what the callee
// happened to leave behind.
func churn(n: int) -> int {
  var a: [i64; 8] = [0, ...];
  for (var i: int = 0; i < 8; i = i + 1) { a[i] = i as i64; }
  if (n <= 0) { return (a[0] + a[7]) as int; }
  return (a[1] + (churn(n - 1) as i64)) as int;
}

func main() -> int {
  var d: Derived = Derived { };
  var bp: *Base = &d;

  // The narrow-element return, content-checked at both ends. Before the fix the
  // native build printed 5,0 here and then aborted in free() on the truncated
  // "pointer".
  var nb: Narrow = (*bp).narrow();
  if (nb[0] != 5) { return 1; }
  if (nb[1] != 6 || nb[2] != 7 || nb[3] != 8) { return 2; }

  // A large array return, read after the frame was churned: a 32-bit store of
  // the returned address loses the high half of a real heap pointer.
  var w: Wide = (*bp).wide(1);
  churn(6);
  if (w[0] != 13) { return 3; }
  if (w[19999] != 14) { return 4; }

  // The same result again, and the first one still intact: each call is its
  // own buffer.
  var w2: Wide = (*bp).wide(1);
  churn(4);
  if (w2[0] != 13 || w2[19999] != 14) { return 5; }
  if (w[0] != 13 || w[19999] != 14) { return 6; }

  // Assignment into an already-declared variable: the pointer travels from the
  // call's result register into the target through a plain aggregate copy.
  var w3: Wide = [0, ...];
  w3 = (*bp).wide(1);
  if (w3[0] != 13 || w3[19999] != 14) { return 7; }

  // Read back through a pointer, so the width is checked on a second path.
  var p: *Wide = &w3;
  if ((*p)[0] != 13 || (*p)[19999] != 14) { return 8; }

  // The element-width split: a full-pointer-width element return, a nested
  // array, and the narrow one again, all after more frame churn.
  churn(3);
  var r: Row = (*bp).row();
  if (r[0] != 31 || r[3] != 34) { return 9; }
  var t: Two = (*bp).nested();
  if (t[0][0] != 41 || t[1][1] != 44) { return 10; }
  var nb2: Narrow = (*bp).narrow();
  if (nb2[0] != 5 || nb2[3] != 8) { return 11; }

  // A virtual scalar return, so the pointer typing did not leak into the
  // ordinary integer case, and a result consumed in place.
  if ((*bp).scalar(4) != 20) { return 12; }
  if ((*bp).narrow()[3] != 8) { return 13; }
  if ((*bp).wide(0)[0] != 13) { return 14; }

  print("virtual_aggregate_return_width_ok\n");
  return 0;
}
