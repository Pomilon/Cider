// CIDER-BUG-211 (migrated to v3): the v2 defined-error line is not
// reprised in v3 (diff #19); interface values box from class pointers,
// and the nil dispatch path is probed here to record the v3 policy.
//
// Original ticket note:
// CIDER-BUG-211: a method call on a nil interface must be a defined runtime
// error on every backend, never a nil function-pointer load. A nil interface
// carries a zero vtable word, so dispatch used to read a method address out
// of address 0: the VM caught it only by accident (load's CIDER-BUG-059
// zero-address guard, reporting the unrelated "load: null pointer
// dereference") while native x86 executed `mov rax, [rbx]` with rbx = 0 and
// died with SIGSEGV and no output at all (exit 139).
//
// ir-gen now guards the vtable word at the one place every interface dispatch
// loads it and routes a nil receiver to the `_nil_dispatch_fail` routine,
// following the CIDER-ISS-001 convention. Expected on all three paths
// (VM unopt, VM opt, native):
//   stderr = "vm error: nil interface dispatch\n", exit = 2.
//
// The program exits non-zero with NO diagnostic while the guard works, so a
// regression that lets the nil dispatch through cannot accidentally match
// the expected output below.
interface Shape {
  func kind() -> int;
  func grow(n: int) -> int;
}

class Circle {
  var r: int;
  func kind() -> int { return 1; }
  func grow(n: int) -> int { return this->r + n; }
}

// A non-nil implementor, so the guard's live path is exercised too: every
// dispatch below this point must keep working after it is added.
func makeShape() -> Shape {
  var c: *Circle = new Circle { r: 10 };
  return c;
}

func main() -> int {
  // Control: a real interface value dispatches normally on all backends.
  var live: Shape = makeShape();
  if (live.kind() != 1) { return 101; }
  if (live.grow(5) != 15) { return 102; }

  // 1. The ticket's reproducer verbatim: an interface array whose elements
  //    were never assigned, dispatched through an index expression.
  var z: [Shape; 1] = uninit;
  z[0].kind();

  // 2. A bare unassigned interface local.
  var s: Shape = uninit;
  s.kind();

  // 3. The nil value threaded through a parameter (the callee dispatches,
  //    not the caller, so this pins the guard in a non-inlined function).
  dispatch(s);

  // 4. Read out of an interface-typed struct/class field that was never
  //    assigned, and through a pointer to that object.
  var holder: Holder = uninit;
  holder.shape.kind();
  var hp: *Holder = &holder;
  hp->shape.grow(1);

  // 5. A nil receiver returned from a function, so the value reaching the
  //    dispatch travelled through an sret slot rather than an alloca.
  var returned: Shape = makeNil();
  returned.grow(1);

  // 6. The nil value at a non-zero index of an interface array, proving the
  //    guard does not depend on the element's address.
  var many: [Shape; 3] = uninit;
  many[2].kind();

  // 7. A method with arguments, so the guarded call still marshals its
  //    parameters correctly on the live path after the guard.
  if (live.grow(1) != 11) { return 103; }

  // Unreachable: the first nil dispatch above already reported the error.
  return 200;
}

class Holder {
  var id: int;
  var shape: Shape;
  var tail: int;
}

func dispatch(s: Shape) -> int {
  return s.kind();
}

func makeNil() -> Shape {
  var s: Shape = uninit;
  return s;
}
