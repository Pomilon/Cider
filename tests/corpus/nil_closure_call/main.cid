// CIDER-BUG-237: calling through a nil closure OBJECT is a defined runtime error
// on every backend, never a raw signal. It is the case the CIDER-BUG-225 fix
// agent found and deliberately left unpinned, and the boundary that ticket's
// note points at:
//
//   var c: func(int) -> int;
//   c(3);
//
// A `func(...)` value is a closure OBJECT {callable slot, captures...}, and the
// call reads the slot out of it. That read is a LOAD `ir-gen` emits itself, so
// none of CIDER-BUG-219's source-level guards (which attach to `*`, a pointer
// member/index base and a pointer receiver) can see it, and CIDER-BUG-225's
// guard sits on the wrong side of it -- it tests the LOADED slot, i.e. the
// callee, and a nil object faults before that slot exists.
//
// The VM reached load's exact-zero guard and reported the IR instruction that
// faulted, `vm error: load: null pointer dereference` (exit 2); native x86
// executed `mov rax, [rbx]` with rbx = 0 and died with SIGSEGV and NO OUTPUT at
// all (exit 139). `ir-gen` now guards the closure object with the same
// `_nil_deref_fail` routine CIDER-BUG-219 uses, so the diagnostic is the
// language-level one on every backend and stays distinct from the `call: nil
// function pointer` a nil callable slot reports.
//
// Expected on all three paths (VM unopt, VM opt, native):
//   stderr = "vm error: null pointer dereference\n", exit = 2.
//
// Every live (non-nil) form of every guarded shape runs FIRST and must keep
// working, so the guard is pinned as costing a not-taken branch and nothing
// more. The program then calls through a never-assigned closure, so a
// regression that lets a nil object through cannot match the expected output on
// any backend.
// Migrated to v3: class values are built with literals naming every
// non-defaulted field and pointer field calls spell `->`. A `func(...)`
// value is not a pointer, so `nilPtr` cannot stand for a nil closure:
// `null is a pointer value` rejects the attempt, and uninitialized
// locals and globals are refused, so a nil closure object is
// inexpressible in v3. Only a raw `*func(...)` pointer can be nil.
func dbl(x: int) -> int { return x * 2; }
func inc(x: int) -> int { return x + 1; }

type Cb = func(int) -> int;

class Holder { var c: func(int) -> int; }
class Outer { var b: Holder; }

var globalNil: func(int) -> int = nilPtr;

func viaParam(c: func(int) -> int, x: int) -> int { return c(x); }
func pick(b: bool) -> func(int) -> int {
  if (b) { return func(x: int) -> int { return x * 3; }; }
  return nilPtr;
}
func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

func main() -> int {
  // ---- the live path, on every shape the guard is attached to -------------
  if (dbl(3) != 6) { return 101; }

  // 1. A live closure local, reassigned and then called repeatedly: the guard
  //    is per call and must stay a not-taken branch.
  var c: func(int) -> int = makeAdder(1);
  if (c(3) != 4) { return 102; }
  c = makeAdder(10);
  if (c(3) != 13) { return 103; }
  var acc: int = 0;
  var i: int = 0;
  while (i < 20) {
    acc = acc + c(1);
    i = i + 1;
  }
  if (acc != 220) { return 104; }   // c is makeAdder(10) by now: 20 * inc-by-10

  // 2. The alias spelling (`type Cb = func(int) -> int`) carries the alias name
  //    in its TypeInfo, so the guard has to be on the resolved value.
  var a: Cb = makeAdder(100);
  if (a(3) != 103) { return 105; }

  // 3. A parameter: the call happens in a callee, not at the point the closure
  //    was built, and the closure object travels as a plain pointer.
  if (viaParam(makeAdder(2), 3) != 5) { return 106; }

  // 4. A class field, a pointer-to-class field, a nested field and an array
  //    element -- the routes a nil object also travels (see the smoke test).
  var h: Holder = Holder { c: nilPtr };
  h.c = makeAdder(3);
  if (h.c(3) != 6) { return 107; }
  var hp: *Holder = &h;
  if (hp->c(3) != 6) { return 108; }
  var o: Outer = Outer { b: Holder { c: nilPtr } };
  o.b.c = makeAdder(4);
  if (o.b.c(3) != 7) { return 109; }
  var arr: [func(int) -> int; 2] = uninit;
  arr[0] = makeAdder(5);
  arr[1] = makeAdder(6);
  if (arr[0](3) != 8) { return 110; }
  if (arr[1](3) != 9) { return 111; }

  // 5. A closure returned by a function, both arms live, called directly on the
  //    result and through a temporary.
  if (pick(true)(3) != 9) { return 112; }
  var r: func(int) -> int = pick(true);
  if (r(3) != 9) { return 113; }

  // 6. A live module-scope global, the shape CIDER-BUG-228 made
  //    order-independent.
  globalNil = makeAdder(7);
  if (globalNil(3) != 10) { return 114; }

  // 7. A closure literal called in place, with and without a capture.
  if (dbl(4) != 8) { return 115; }
  var n: int = 5;
  var cap: func(int) -> int = func(x: int) -> int { return x + n; };
  if (cap(3) != 8) { return 116; }

  // 8. Comparing a live closure against nilPtr reads the OBJECT pointer and is
  //    not a dereference, so the guard does not change it.
  if (c == nilPtr) { return 117; }
  if (inc(1) != 2) { return 118; }

  // ---- the nil path: the first one below reports and exits ---------------
  // The ticket's reproducer, verbatim: a never-assigned closure local.
  var nilClosure: func(int) -> int = nilPtr;
  return nilClosure(3);
}
