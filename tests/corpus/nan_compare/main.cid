// CID-003 follow-up (I5): float comparisons must be IEEE-754 correct with
// NaN. The codegen used a bare setcc after ucomiss/ucomisd, but unordered
// (PF=1) sets ZF=CF=1, so `n != n` was false, `n == n` was true and every
// ordered compare was true on native — while the VM's native C++ double
// compares already followed IEEE. `0.0 / 0.0` is the runtime NaN source: the
// AST constant folder is not wired into the pipeline, so the division stays
// in the IR on every backend.
func main() -> int {
  var n: f64 = 0.0 / 0.0;
  var m: f64 = 0.0 / 0.0;
  // NaN != NaN, and NaN != another NaN.
  if (!(n != n)) { return 1; }
  if (!(n != m)) { return 2; }
  if (n == n) { return 3; }
  if (n == m) { return 4; }
  // All ordered compares are false when either side is NaN.
  if (n < m) { return 5; }
  if (n > m) { return 6; }
  if (n <= m) { return 7; }
  if (n >= m) { return 8; }
  var one: f64 = 1.0;
  if (!(n != one)) { return 9; }
  if (n == one) { return 10; }
  if (n < one) { return 11; }
  if (n > one) { return 12; }
  if (n <= one) { return 13; }
  if (n >= one) { return 14; }
  // Ordered compares on non-NaN f64 values must stay true.
  var two: f64 = 2.0;
  if (!(one < two)) { return 15; }
  if (!(two <= two)) { return 16; }
  if (two < one) { return 17; }
  if (one == two) { return 18; }

  // Same matrix at F32 width (ucomiss path).
  var fn: float = 0.0 / 0.0;
  if (!(fn != fn)) { return 20; }
  if (fn == fn) { return 21; }
  if (fn < 1.0) { return 22; }
  if (fn > 1.0) { return 23; }
  if (fn <= 1.0) { return 24; }
  if (fn >= 1.0) { return 25; }
  if (!(fn != 1.0)) { return 26; }
  if (fn == 1.0) { return 27; }
  // Mixed float/int operands convert to the float width.
  if (!(fn != 1)) { return 28; }
  if (fn < 1) { return 29; }
  // Mixed F32/F64 operands compare at f64 (usual conversions).
  if (n == fn) { return 30; }
  if (!(n != fn)) { return 31; }
  // Ordered compares on non-NaN floats must stay true.
  var fone: float = 1.0;
  var ftwo: float = 2.0;
  if (!(fone < ftwo)) { return 32; }
  if (!(ftwo == ftwo)) { return 33; }
  return 0;
}
