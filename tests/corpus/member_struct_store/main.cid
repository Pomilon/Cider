from std.alloc import malloc;
// CIDER-BUG-081: by-value struct member stores must copy the VALUE bytes at
// every size. The assignment path resolved the target field's declared type
// and stored it with lastExprType_, but that resolved type carries no
// isUserDefined flag and the `getTypeSize(...) > 8` fallback misses sizes 4
// and 8, so `o.inner = i` lowered to a scalar STORE of the source ADDRESS
// (clobbering the neighbour field) instead of a MEMCPY of the value. The
// StructLiteralExpr field-init path had the same defect unconditionally: it
// always scalar-STOREd, so `Outer{inner: i}` wrote the literal's alloca
// address into the field at any size.
//
// Covered target shapes: `o->field = s` through a pointer, `o.field = s`
// through a value class, nested member chains (`l1.l2.q = s`), struct
// literals with struct-typed fields (including nested literals and an
// 8-byte field), and array-element member targets (`arr[i].field = s`,
// also through a struct field array). Sizes 4 / exactly 8 / 16 bytes.
// RHS shapes: locals, struct literals, call returns, struct fields, element
// reads, `as` casts and self-copies. Alias-typed and generic struct fields,
// a module-level global holder and `this.field = s` inside a method round
// out the target shapes. Neighbour fields are pre-seeded with sentinels so
// an over-wide scalar store or a short MEMCPY changes the program's output,
// and destination struct fields are pre-dirtied before member overwrites so
// partial copies keep stale bytes.
from std.io import puts;

struct Q { var a: int; }                                      // 4 bytes
struct P { var a: int; var b: int; }                          // exactly 8 bytes
struct R { var a: int; var b: int; var c: int; var d: int; }  // 16 bytes

struct L2 { var q: Q; var tag: int; }                         // nested chain leaf
struct L1 { var l2: L2; var pad: int; }                       // nested chain root

struct Mid { var p: P; var q: Q; }                            // 8 + 4 byte members

struct Outer {
    var inner: Q;
    var pair: P;
    var big: R;
    var mid: Mid;
    var tail: int;
}

class COuter {
    var inner: Q;
    var pair: P;
    var big: R;
    var mid: Mid;
    var tail: int;
}

// Alias-typed and generic struct fields must classify by their RESOLVED
// shape too (getMemberFieldType follows `type X = T`; a literal's raw field
// spelling is resolved by isStructValueType/getTypeSize).
type QAlias = Q;
type PAlias = P;
struct AliasHolder { var q: QAlias; var tail: int; }
struct AliasHolderP { var p: PAlias; var tail: int; }
struct Box<T> { var v: T; var tag: int; }

// A module-level global holder and a class method writing through `this`.
var gOuter: Outer = Outer { inner: Q { a: 0 }, pair: P { a: 0, b: 0 }, big: R { a: 0, b: 0, c: 0, d: 0 }, mid: Mid { p: P { a: 0, b: 0 }, q: Q { a: 0 } }, tail: 0 };

class CWidget {
    var q: Q;
    var tail: int;
    func setQ(v: Q) {
        (*self).q = v;
    }
    func getQ() -> Q {
        return (*self).q;
    }
}

func mkQ(x: int) -> Q {
    return Q { a: x };
}

func mkP(x: int, y: int) -> P {
    return P { a: x, b: y };
}

func mkR(a: int, b: int, c: int, d: int) -> R {
    return R { a: a, b: b, c: c, d: d };
}

func mkMid(p: P, q: Q) -> Mid {
    return Mid { p: p, q: q };
}

func main() -> int {
    // Source values for every RHS shape.
    var i: Q = Q { a: 9 };
    var p: P = P { a: 11, b: 22 };
    var r: R = R { a: 1, b: 2, c: 3, d: 4 };
    var src: Outer = Outer { inner: i, pair: p, big: r, mid: mkMid(p, i), tail: 313 };

    // --- `o->field = s`: pointer member target, 4 / 8 / 16 bytes ---
    var o: *Outer = malloc(sizeof(Outer)) as *Outer;
    // neighbours seeded first: a wrong-width store must corrupt them.
    (*o).pair = mkP(101, 102);
    (*o).big = mkR(201, 202, 203, 204);
    (*o).tail = 999;
    (*o).inner = i;
    if ((*o).inner.a != 9) return 1;
    if ((*o).pair.a != 101 || (*o).pair.b != 102) return 2;   // 8-byte neighbour guard
    (*o).pair = mkP(33, 44);
    if ((*o).pair.a != 33 || (*o).pair.b != 44) return 3;
    if ((*o).inner.a != 9) return 4;                        // 4-byte neighbour guard
    // Pre-dirty the 16-byte destination, then overwrite: a short copy leaves
    // the sentinel bytes behind.
    (*o).big = mkR(70, 71, 72, 73);
    (*o).big = r;
    if ((*o).big.a != 1 || (*o).big.b != 2 || (*o).big.c != 3 || (*o).big.d != 4) return 5;
    if ((*o).tail != 999) return 6;                         // tail guard
    (*o).mid = mkMid(p, i);
    if ((*o).mid.p.a != 11 || (*o).mid.p.b != 22 || (*o).mid.q.a != 9) return 7;

    // RHS from call return and from a struct field read.
    (*o).pair = mkP(55, 66);
    if ((*o).pair.a != 55 || (*o).pair.b != 66) return 8;
    (*o).pair = src.pair;
    if ((*o).pair.a != 11 || (*o).pair.b != 22) return 9;
    (*o).inner = src.inner;
    if ((*o).inner.a != 9) return 10;
    // RHS from an element read and from an `as` cast.
    var parr: [P; 2] = [ P { a: 0, b: 0 }, P { a: 0, b: 0 } ];
    parr[1] = mkP(77, 88);
    (*o).pair = parr[1];
    if ((*o).pair.a != 77 || (*o).pair.b != 88) return 11;
    (*o).pair = p as P;
    if ((*o).pair.a != 11 || (*o).pair.b != 22) return 12;
    // Self-copy through the same member target.
    (*o).pair = (*o).pair;
    if ((*o).pair.a != 11 || (*o).pair.b != 22) return 13;
    (*o).inner = (*o).inner;
    if ((*o).inner.a != 9) return 14;

    // --- `o.field = s`: value-class member target, 4 / 8 / 16 bytes ---
    var vo: COuter = COuter { inner: Q { a: 0 }, pair: P { a: 0, b: 0 }, big: R { a: 0, b: 0, c: 0, d: 0 }, mid: Mid { p: P { a: 0, b: 0 }, q: Q { a: 0 } }, tail: 0 };
    vo.pair = mkP(101, 102);
    vo.big = mkR(201, 202, 203, 204);
    vo.tail = 999;
    vo.inner = i;
    if (vo.inner.a != 9) return 15;
    if (vo.pair.a != 101 || vo.pair.b != 102) return 16;
    vo.pair = mkP(33, 44);
    if (vo.pair.a != 33 || vo.pair.b != 44) return 17;
    if (vo.inner.a != 9) return 18;
    vo.big = mkR(70, 71, 72, 73);
    vo.big = r;
    if (vo.big.a != 1 || vo.big.b != 2 || vo.big.c != 3 || vo.big.d != 4) return 19;
    if (vo.tail != 999) return 20;
    vo.mid = mkMid(p, i);
    if (vo.mid.p.a != 11 || vo.mid.p.b != 22 || vo.mid.q.a != 9) return 21;

    // --- nested member chains (`l1.l2.q = s`) ---
    var l1: L1 = L1 { l2: L2 { q: Q { a: 0 }, tag: 222 }, pad: 111 };
    l1.l2.q = i;
    if (l1.l2.q.a != 9) return 22;
    if (l1.l2.tag != 222 || l1.pad != 111) return 23;
    l1.l2.q = mkQ(12);
    if (l1.l2.q.a != 12) return 24;
    var pl: *L1 = &l1;
    (*pl).l2.q = src.inner;
    if (l1.l2.q.a != 9) return 25;

    // --- struct literals with struct-typed fields (4 / 8 / 16 bytes) ---
    var litR: R = R { a: 8, b: 9, c: 10, d: 11 };
    var litMid: Mid = Mid { p: p, q: i };
    if (litMid.p.a != 11 || litMid.p.b != 22 || litMid.q.a != 9) return 26;
    var lit: Outer = Outer { inner: i, pair: p, big: r, mid: litMid, tail: 44 };
    if (lit.inner.a != 9) return 27;
    if (lit.pair.a != 11 || lit.pair.b != 22) return 28;
    if (lit.big.a != 1 || lit.big.b != 2 || lit.big.c != 3 || lit.big.d != 4) return 29;
    if (lit.mid.p.a != 11 || lit.mid.q.a != 9 || lit.tail != 44) return 30;
    // Literal RHS shapes: call return, nested literal, field read.
    var lit2: Outer = Outer { inner: mkQ(13), pair: mkP(14, 15), big: mkR(16, 17, 18, 19), mid: litMid, tail: 45 };
    if (lit2.inner.a != 13) return 31;
    if (lit2.pair.a != 14 || lit2.pair.b != 15) return 32;
    if (lit2.big.c != 18 || lit2.big.d != 19) return 33;
    if (lit2.mid.p.b != 22 || lit2.mid.q.a != 9 || lit2.tail != 45) return 34;
    var lit3: Outer = Outer { inner: lit.inner, pair: src.pair, big: lit2.big, mid: litMid, tail: 46 };
    if (lit3.inner.a != 9) return 35;
    if (lit3.pair.a != 11 || lit3.pair.b != 22) return 36;
    if (lit3.big.a != 16 || lit3.big.d != 19) return 37;
    if (lit3.mid.q.a != 9 || lit3.tail != 46) return 38;
    // Nested struct literal in a struct literal field.
    var lit4: Mid = Mid { p: P { a: 21, b: 22 }, q: Q { a: 23 } };
    var lit5: Outer = Outer { inner: lit4.q, pair: lit4.p, big: litR, mid: lit4, tail: 47 };
    if (lit5.pair.a != 21 || lit5.pair.b != 22) return 39;
    if (lit5.inner.a != 23 || lit5.mid.q.a != 23) return 40;
    if (lit5.big.d != 11 || lit5.tail != 47) return 41;

    // --- array-element member targets (`arr[i].field = s`) ---
    var arr: [Outer; 3] = [ Outer { inner: Q { a: 0 }, pair: P { a: 0, b: 0 }, big: R { a: 0, b: 0, c: 0, d: 0 }, mid: Mid { p: P { a: 0, b: 0 }, q: Q { a: 0 } }, tail: 0 }, Outer { inner: Q { a: 0 }, pair: P { a: 0, b: 0 }, big: R { a: 0, b: 0, c: 0, d: 0 }, mid: Mid { p: P { a: 0, b: 0 }, q: Q { a: 0 } }, tail: 0 }, Outer { inner: Q { a: 0 }, pair: P { a: 0, b: 0 }, big: R { a: 0, b: 0, c: 0, d: 0 }, mid: Mid { p: P { a: 0, b: 0 }, q: Q { a: 0 } }, tail: 0 } ];
    arr[0].pair = mkP(101, 102);
    arr[0].inner = i;
    if (arr[0].inner.a != 9) return 42;
    if (arr[0].pair.a != 101 || arr[0].pair.b != 102) return 43;
    arr[1].pair = mkP(55, 66);
    if (arr[1].pair.a != 55 || arr[1].pair.b != 66) return 44;
    arr[2].big = mkR(70, 71, 72, 73);
    arr[2].big = r;
    if (arr[2].big.a != 1 || arr[2].big.d != 4) return 45;
    arr[1].mid = mkMid(p, i);
    if (arr[1].mid.p.b != 22 || arr[1].mid.q.a != 9) return 46;
    // nested chain through an array element target
    var lm: [L1; 2] = [ L1 { l2: L2 { q: Q { a: 0 }, tag: 0 }, pad: 0 }, L1 { l2: L2 { q: Q { a: 0 }, tag: 0 }, pad: 0 } ];
    lm[1].pad = 333;
    lm[1].l2.q = i;
    if (lm[1].l2.q.a != 9) return 47;
    if (lm[1].pad != 333 || lm[1].l2.tag != 0) return 48;
    lm[0].l2.q = mkQ(64);
    if (lm[0].l2.q.a != 64) return 49;
    // element member target through a pointer to the array element
    var pe: *Outer = &arr[2];
    (*pe).inner = i;
    if ((*pe).inner.a != 9 || arr[2].big.a != 1) return 50;
    // mixed: member target, element RHS (CIDER-BUG-083 path stays green)
    arr[2].pair = parr[1];
    if (arr[2].pair.a != 77 || arr[2].pair.b != 88) return 51;

    // --- alias-typed struct fields: store and literal ---
    var ah: AliasHolder = AliasHolder { q: Q { a: 0 }, tail: 55 };
    ah.q = i;
    if (ah.q.a != 9 || ah.tail != 55) return 52;
    ah.q = mkQ(56);
    if (ah.q.a != 56 || ah.tail != 55) return 53;
    var ahLit: AliasHolder = AliasHolder { q: i, tail: 57 };
    if (ahLit.q.a != 9 || ahLit.tail != 57) return 54;
    var ahp: AliasHolderP = AliasHolderP { p: P { a: 0, b: 0 }, tail: 65 };
    ahp.p = p;
    if (ahp.p.a != 11 || ahp.p.b != 22 || ahp.tail != 65) return 55;

    // --- generic structs with by-value struct fields ---
    var bx: Box<Q> = Box<Q> { v: Q { a: 0 }, tag: 58 };
    bx.v = i;
    if (bx.v.a != 9 || bx.tag != 58) return 56;
    var bxp: Box<P> = Box<P> { v: P { a: 0, b: 0 }, tag: 59 };
    bxp.v = p;
    if (bxp.v.a != 11 || bxp.v.b != 22 || bxp.tag != 59) return 57;
    var bxLit: Box<Q> = Box<Q> { v: i, tag: 60 };
    if (bxLit.v.a != 9 || bxLit.tag != 60) return 58;

    // --- module-level global holder ---
    gOuter.tail = 61;
    gOuter.inner = i;
    if (gOuter.inner.a != 9 || gOuter.tail != 61) return 59;
    gOuter.pair = mkP(62, 63);
    if (gOuter.pair.a != 62 || gOuter.pair.b != 63) return 60;

    // --- `this.field = s` inside a class method ---
    var cw: CWidget = CWidget { q: Q { a: 0 }, tail: 64 };
    cw.setQ(i);
    var cgot: Q = cw.getQ();
    if (cgot.a != 9 || cw.q.a != 9 || cw.tail != 64) return 61;

    puts("member struct store ok");
    return 0;
}
