// CIDER-BUG-054: interface variables can be reassigned after declaration.
// Reassignment accepts any value whose type satisfies the interface (the
// same rule declaration-time assignment uses) and must dispatch to the
// newly assigned value.
interface Shape {
  func area() -> int;
}

class Sq {
  var s: int;
  func area() -> int { return (*self).s * (*self).s; }
}

class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
}

// CIDER-BUG-054: an interface parameter is an interface variable too —
// reassigning it must not disturb the caller's fat pointer (by-value).
func areaAfterRetarget(var x: Shape) -> int {
  var r: Rect = new Rect { w: 6, h: 7 };
  x = r;
  return x.area();
}

func main() -> int {
  var a: Sq = new Sq { s: 3 };
  var r: Rect = new Rect { w: 2, h: 5 };

  // Declaration-time assignment still works.
  var i: Shape = a;
  if (i.area() != 9) { return 1; }

  // Reassign to a different implementor: dispatch follows the new value.
  i = r;
  if (i.area() != 10) { return 2; }

  // Reassign back to the first implementor (same concrete type again).
  i = a;
  if (i.area() != 9) { return 3; }

  // A second interface variable, initialized from the first one, and
  // reassigned from it.
  var j: Shape = i;
  if (j.area() != 9) { return 4; }
  j = r;
  if (j.area() != 10) { return 5; }
  i = j;
  if (i.area() != 10) { return 6; }

  // Pointer-to-class values reassign like declaration-time assignment.
  var rp: *Rect = &r;
  i = rp;
  if (i.area() != 10) { return 7; }
  var hp: *Rect = alloc(sizeof(Rect), 8) as *Rect;
  (*hp).w = 3;
  (*hp).h = 4;
  i = hp;
  if (i.area() != 12) { return 8; }

  // Reassignment inside a loop: the vtable must be refreshed each
  // iteration, not just the data pointer.
  var k: int = 0;
  var other: Shape = a;
  while (k < 2) {
    if (k == 0) {
      i = a;
    } else {
      i = r;
    }
    if (i.area() != (k == 0 ? 9 : 10)) { return 9; }
    other = i;
    if (other.area() != i.area()) { return 10; }
    k++;
  }

  // Interface parameters dispatch after an in-callee reassignment, and
  // the caller's own fat pointer is untouched (parameters are by value).
  var target: Shape = a;
  if (areaAfterRetarget(target) != 42) { return 11; }
  if (target.area() != 9) { return 12; }
  return 0;
}
