// CIDER-BUG-135: list literals whose target elements are interface-typed
// must accept concrete implementors with the normal interface conversion —
// the same 16-byte fat-pointer store as `var i: Shape = <value>` — instead
// of the exact element-type test. Before the fix, `[Shape; 2] = [sq, rect]`
// reported "Array element type mismatch ... expected Shape, got Sq" at both
// declaration and reassignment, while the identical non-list conversion was
// accepted.
//
// Covered here on all three backends (VM unopt, VM optimized, native):
// declaration and reassignment lists of concrete implementors (direct,
// interface-alias and array-alias spellings, including an alias chain and a
// module-qualified/imported interface), dispatch through the stored
// elements, interface-to-interface fat-pointer copies, mixed
// interface/concrete elements in one list, pointer-to-implementor elements,
// global label targets, struct-field/deref/nested-element targets, the
// documented source-aliasing semantics (concrete elements store the object's
// address, exactly like a non-list interface store), a second reassignment
// and the unchanged declaration path for interface values.
import lib;
from std.io import print, printInt;

type ShapeAlias = lib.Shape;          // alias to the imported interface
type Shapes2 = [lib.Shape; 2];        // dotted interface element
type ShapesAlias = [ShapeAlias; 2];   // alias interface element
type ShapesChain = ShapesAlias;       // array-alias chain

// A local class satisfying the imported interface.
class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
}

struct Wrap {
  var id: int;
  var s: Shapes2;
  var tail: int;
}

var g_direct: Shapes2 = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];       // module-global label targets
var g_alias: ShapesAlias = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];

func main() -> int {
  var r1: Rect = Rect { w: 2, h: 5 };    // area 10
  var r2: Rect = Rect { w: 3, h: 4 };    // area 12
  var s1: lib.Sq = lib.Sq { side: 6 };         // area 36
  var s2: lib.Sq = lib.Sq { side: 7 };         // area 49

  // Declaration lists: direct dotted, interface alias, array alias, alias
  // chain; every element is a concrete implementor.
  var da: [lib.Shape; 2] = [ r1, s1 ];
  var db: [ShapeAlias; 2] = [ s1, r1 ];
  var dc: Shapes2 = [ r2, s2 ];
  var dd: ShapesChain = [ s2, r2 ];
  if (da[0].area() != 10 || da[1].area() != 36) { return 1; }
  if (db[0].area() != 36 || db[1].area() != 10) { return 2; }
  if (dc[0].area() != 12 || dc[1].area() != 49) { return 3; }
  if (dd[0].area() != 49 || dd[1].area() != 12) { return 4; }

  // Reassignment lists (the same conversion as the declaration site) and a
  // second reassignment; both fat-pointer halves must be replaced.
  var ra: [lib.Shape; 2] = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];
  ra = [ s2, r1 ];
  if (ra[0].area() != 49 || ra[1].area() != 10) { return 5; }
  ra = [ r2, r2 ];
  if (ra[0].area() != 12 || ra[1].area() != 12) { return 6; }
  var rb: Shapes2 = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];
  rb = [ r1, r1 ];
  if (rb[0].area() != 10 || rb[1].area() != 10) { return 7; }
  var rc: ShapesAlias = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];
  rc = [ s1, s1 ];
  if (rc[0].area() != 36 || rc[1].area() != 36) { return 8; }

  // Interface values keep the existing fat-pointer copy; a mixed list
  // converts only the concrete element.
  var i1: lib.Shape = r1;
  var i2: lib.Shape = s1;
  var mix: [lib.Shape; 2] = [ i1, s2 ];
  if (mix[0].area() != 10 || mix[1].area() != 49) { return 9; }
  var pair: [lib.Shape; 2] = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];
  pair = [ i2, r2 ];
  if (pair[0].area() != 36 || pair[1].area() != 12) { return 10; }

  // Pointer-to-implementor elements convert like any non-list interface
  // store (the pointer value is the data word).
  var p1: *lib.Sq = &s1;
  var p2: *lib.Sq = &s2;
  var ps: [lib.Shape; 2] = [ p1, p2 ];
  if (ps[0].area() != 36 || ps[1].area() != 49) { return 11; }

  // Module-global array targets (the label base is materialised), a struct
  // field, a deref target and a nested array element.
  g_direct = [ s1, r2 ];
  g_alias = [ r1, s1 ];
  if (g_direct[0].area() != 36 || g_direct[1].area() != 12) { return 12; }
  if (g_alias[0].area() != 10 || g_alias[1].area() != 36) { return 13; }
  var w: Wrap = Wrap { id: 0, s: [ nilPtr as lib.Shape, nilPtr as lib.Shape ], tail: 0 };
  w.id = 1;
  w.s = [ r2, s1 ];
  w.tail = 9;
  if (w.s[0].area() != 12 || w.s[1].area() != 36) { return 14; }
  if (w.id != 1 || w.tail != 9) { return 15; }
  var wp: *Shapes2 = &w.s;
  *wp = [ s2, r1 ];
  if (w.s[0].area() != 49 || w.s[1].area() != 10) { return 16; }
  var m: [[lib.Shape; 2]; 2] = [ [ r1, r2 ], [ r1, r2 ] ];
  m[1] = [ r1, r2 ];
  if (m[1][0].area() != 10 || m[1][1].area() != 12) { return 17; }

  // A concrete element stores the object's ADDRESS (documented aliasing,
  // same as `var i: Shape = value`): mutating the source is visible through
  // the list, and an interface-to-interface reassignment rebinds it.
  r1.w = 7;                    // r1.area() = 35
  s1.side = 8;                 // s1.area() = 64
  if (da[0].area() != 35 || da[1].area() != 64) { return 18; }
  da = [ i1, i2 ];
  r1.w = 9;                    // r1.area() = 45; only i1 (also r1) sees it
  if (da[0].area() != 45 || da[1].area() != 64) { return 19; }

  printInt(da[0].area() + da[1].area()); print(",");
  printInt(db[0].area() + db[1].area()); print(",");
  printInt(dc[0].area() + dc[1].area()); print(",");
  printInt(dd[0].area() + dd[1].area()); print(",");
  printInt(ra[0].area() + ra[1].area()); print(",");
  printInt(rb[1].area() + rc[0].area()); print(",");
  printInt(mix[0].area() + mix[1].area()); print(",");
  printInt(pair[0].area() + pair[1].area()); print(",");
  printInt(ps[0].area() + ps[1].area()); print(",");
  printInt(g_direct[0].area() + g_alias[1].area()); print(",");
  printInt(w.s[0].area() + w.s[1].area()); print(",");
  printInt(m[1][0].area() + m[1][1].area()); print("\n");
  print("interface_element_list_ok\n");
  return 0;
}
