// CIDER-BUG-238 module half: the interface, three implementors and the
// interface-typed globals the entry file reaches through `from`-import
// ALIASES rather than by qualified name.
//
// The interface is deliberately named `RTag` and every use site in the entry
// file spells it `lib.RTag`, so the BARE name `RTag` never enters that
// scope. That is the point of the fixture: a global's declared type is stored
// on its symbol spelled as WRITTEN HERE, so recovering it by that bare name
// in the importing file only works by accident — and it did work by accident
// whenever the entry file also from-imported the interface under that same
// name. Keeping the bare name out of scope makes the recovery-by-name the
// ONLY possible source of the fat pointer, so the test cannot pass for the
// wrong reason (see check_iface_global_fromstore_lookalike.cid for the
// rejections that must survive, and crossmod_iface_global_store for the
// module-qualified spelling CIDER-BUG-230 fixed).
from std.io import print;

export interface RTag {
  func o() -> int;
  func tag() -> int;
}

// First implementor: its finalizer REPORTS, so the trace shows which object
// was finalized and when.
export class RAlpha {
  var v: int;
  func o() -> int { return (*self).v; }
  func tag() -> int { return 7; }
  func deinit() { print("A"); }
}

// A second implementor with a DIFFERENT tag, so a stale vtable left behind by
// the previous store is visible as a wrong tag rather than a crash.
export class RBeta {
  var s: int;
  func o() -> int { return (*self).s; }
  func tag() -> int { return 13; }
  func deinit() { print("B"); }
}

// A third implementor whose methods are bigger, so its vtable entries differ
// from the other two in more than one slot — and whose object is larger, so a
// plain 4-byte copy of it into the slot would leave recognisable debris.
export class RGamma {
  var p: int;
  var pad: [u64; 4];
  func o() -> int { return (*self).p; }
  func tag() -> int { return 21; }
  func deinit() { print("C"); }
}

export var rAlpha: RAlpha = RAlpha { v: 0 };
export var rBeta: RBeta = RBeta { s: 0 };
export var rGamma: RGamma = RGamma { p: 0, pad: [0, ...] };

// The interface-typed globals, declared BELOW the implementors they hold.
export var gIface: RTag = nilPtr as RTag;
export var gCopy: RTag = nilPtr as RTag;

// An interface-typed field and an array of interfaces, so the from-alias
// recovery is exercised where the slot is not a module global.
export struct Holder {
  var inner: RTag;
  var pad: int;
}

export var gArr: [RTag; 2] = [nilPtr as RTag, nilPtr as RTag];

// The interface named in THIS module's own signatures, so a value reached
// through a from-alias has to survive the crossing in both directions.
export func takesTag(x: RTag) -> int { return x.o() * 100 + x.tag(); }

export func getTag() -> RTag { return gIface; }

export func peek() -> int { return gIface.o() * 1000 + gIface.tag(); }

// The control: the bare spelling, inside the module that declares both sides,
// which the checker has always accepted and ir_gen has always lowered as a
// 16-byte fat pointer. Every from-imported result must agree with it.
export func seedIface() -> int {
  gIface = rAlpha;
  return gIface.o();
}

// Not exported: a `from`-import may not name it at all (CIDER-BUG-060).
var hidden: RTag = nilPtr as RTag;
