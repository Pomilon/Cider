// CIDER-BUG-238: a concrete value stored into an interface-typed global
// through a `from`-import ALIAS (`from lib import gIface, rAlpha; gIface =
// rAlpha;`) must behave exactly like the same store spelled bare inside the
// defining module and exactly like the module-qualified spelling CIDER-BUG-230
// fixed. It did not, and the failure was SILENT: the checker accepted the
// program and all three backends then died on dispatch.
//
// Root cause. A module-scope variable's declared type is unusable as stored,
// for two independent reasons, and ir_gen had re-derived the recovery for
// itself at some value-read sites and not at others:
//
//   * the nominal is spelled as WRITTEN in the DEFINING module (lib's bare
//     `RTag`), and a `from`-alias binds the COLLECTOR's symbol object — which
//     the fresh, correctly-flagged symbol ir_gen builds in
//     visit(VarDeclStmt) never replaces, because it is defined only in the
//     owning module's scope. So the use site's scope need not contain the
//     spelling at all (CIDER-BUG-102);
//   * the collector never resolves the interface flag on a VARIABLE
//     declaration — unlike a class field, a struct field and every function
//     signature, which all go through resolveInterfaceTypeFlag — so
//     `sym->type.isInterface` is false and the fat pointer has to be recovered
//     by name.
//
// Sites that read the RAW `sym->type` therefore miscompiled while the
// checker (which recovers it in visit(IdentifierExpr)) accepted the program:
//   * the STORE (visit(AssignStmt)'s identifier target) missed the flag, fell
//     through to the plain aggregate path, and emitted a `memcpy` of the
//     concrete object's 4 bytes into the 16-byte interface slot, leaving the
//     vtable word at zero — "call: nil function pointer" on every dispatch;
//   * the READ (visit(IdentifierExpr)) missed it too, took the scalar branch,
//     loaded only the 8-byte DATA word, and the interface dispatch then
//     indexed that word as if it were the fat pointer — reading the concrete
//     object's own fields as a vtable pointer (a wrong tag, or a segfault).
//
// The fix routes all of them through one declaredVarType() recovery, and —
// because a closure's typed parameter was the one place that recovery could
// not be applied — aligns the closure prologue with the named-function one
// (see the closure case below).
//
// Pinned, on all three backends:
//   * the ticket's repro: the from-imported store, then dispatch;
//   * vtable correctness: three implementors with different tags AND
//     different layouts stored into the SAME alias in turn, so a stale or
//     wrong vtable label shows as a wrong tag instead of passing unnoticed;
//   * the READ through the alias, against the in-module control: a stale
//     vtable here is a wrong value, not a crash, so it needs its own checks;
//   * interface-to-interface copy, and a concrete POINTER (one indirection),
//     through the alias;
//   * an interface-typed field, an array of interfaces, an argument and a
//     return value, all crossed by a from-imported name;
//   * reassignment of a local interface variable from a concrete value;
//   * a closure whose PARAMETER is the interface, called with a concrete
//     value (the parameter-prologue half of the fix);
//   * the in-module control agrees with every aliased store;
//   * ownership: the store aliased the value, so the source global stays
//     readable and writable, and each global is finalized exactly once.
import lib;
from std.io import print;
from lib import gIface, gCopy, gArr, rAlpha, rBeta, rGamma;

// The interface itself is NEVER from-imported here: every spelling of it in
// this file is qualified, so the bare name the global's symbol carries
// (`RTag`) is not resolvable in this scope and the fat pointer can only come
// from the declared-type recovery. A test that also imported `RTag` would
// pass even with the recovery missing.

func main() -> int {
  rAlpha.v = 42;
  rBeta.s = 17;
  rGamma.p = 5;

  // --- the ticket's repro -------------------------------------------------
  gIface = rAlpha;
  if (gIface.o() != 42) { return 1; }
  if (gIface.tag() != 7) { return 2; }

  // --- vtable correctness: three implementors, one alias, in turn ---------
  // Different tags AND different object layouts, so neither a stale vtable
  // nor a plain 4-byte copy of the object can pass unnoticed.
  gIface = rBeta;
  if (gIface.o() != 17 || gIface.tag() != 13) { return 3; }
  gIface = rGamma;
  if (gIface.o() != 5 || gIface.tag() != 21) { return 4; }
  // Back to the first: the vtable must follow the store, not the last
  // concrete type that happened to be stored before it.
  gIface = rAlpha;
  if (gIface.o() != 42 || gIface.tag() != 7) { return 5; }

  // --- the READ through the alias, against the in-module control ----------
  // A stale vtable on the read side is a wrong VALUE, not a crash, so the
  // dispatch checks above cannot stand in for it: re-read the stored value
  // after every store, and compare the aliased read with what the defining
  // module's own bare-spelling read reports.
  if (lib.peek() != 42007) { return 6; }
  gIface = rGamma;
  if (lib.peek() != 5021) { return 7; }
  if (gIface.o() != 5 || gIface.tag() != 21) { return 8; }
  gIface = rAlpha;

  // --- interface to interface, and a concrete pointer, through the alias --
  gCopy = gIface;
  if (gCopy.o() != 42 || gCopy.tag() != 7) { return 9; }
  gCopy = rBeta;
  if (gCopy.tag() != 13) { return 10; }
  if (gIface.tag() != 7) { return 11; }
  var p: *lib.RAlpha = &rAlpha;
  gIface = p;
  if (gIface.o() != 42 || gIface.tag() != 7) { return 12; }

  // --- an interface-typed FIELD, reached through the same global ---------
  var h: lib.Holder;
  h.inner = rGamma;
  if (h.inner.o() != 5 || h.inner.tag() != 21) { return 13; }
  h.inner = rAlpha;
  if (h.inner.tag() != 7) { return 14; }

  // --- an array of interfaces --------------------------------------------
  gArr[0] = rAlpha;
  gArr[1] = rGamma;
  if (gArr[0].o() != 42 || gArr[0].tag() != 7) { return 15; }
  if (gArr[1].o() != 5 || gArr[1].tag() != 21) { return 16; }

  // --- an argument and a return, both spelled in lib's own signature ------
  if (lib.takesTag(rAlpha) != 4207) { return 17; }
  if (lib.takesTag(rGamma) != 521) { return 18; }
  var got: lib.RTag = lib.getTag();
  if (got.o() != 42 || got.tag() != 7) { return 19; }

  // --- reassignment of a LOCAL interface variable from a concrete value ---
  var local: lib.RTag;
  local = rBeta;
  if (local.o() != 17 || local.tag() != 13) { return 20; }
  local = rAlpha;
  if (local.tag() != 7) { return 21; }

  // --- a closure whose PARAMETER is the interface, given a concrete value -
  // The closure prologue now materialises the parameter as a real 16-byte
  // fat pointer, exactly as a named function's prologue does. Before the fix
  // it kept an 8-byte slot and only worked because the missing flag also kept
  // the parameter off the address path, so its vtable word was read from
  // 8 bytes past the slot. The value here is a CONCRETE one, so the call site
  // has to build the fat pointer from the declared parameter type.
  var c: fn(lib.RTag) -> int = func(z: lib.RTag) -> int { return z.o() * 2 + z.tag(); };
  if (c(rAlpha) != 91) { return 22; }
  if (c(rGamma) != 31) { return 23; }
  if (c(gIface) != 91) { return 24; }

  // --- the in-module control agrees with the aliased store ---------------
  if (lib.seedIface() != 42) { return 25; }
  if (gIface.o() != 42 || gIface.tag() != 7) { return 26; }

  // --- ownership: the store aliased the value, it did not consume it ------
  if (rAlpha.v != 42) { return 27; }
  rAlpha.v = 43;
  if (rAlpha.v != 43) { return 28; }
  if (gIface.o() != 43) { return 29; }
  rAlpha.v = 42;

  // The three implementor globals are finalized exactly once, at program exit
  // (the C/B/A trace in expected.json). A store that consumed, cloned or
  // double-released its source would change it.
  print("crossmod_iface_global_fromstore_ok\n");
  return 0;
}
