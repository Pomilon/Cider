from std.alloc import operator new, operator delete;
// CIDER-FEAT-003 / CIDER-BUG-123: class constructors. `func init(...)` in a class body is
// the class's constructor: `new C(args)` allocates and zero/default
// initializes the object, runs the field initializers (CIDER-BUG-049), then
// runs the constructor body with `this` bound and the arguments passed like
// a normal method. A class without an init is built with a literal,
// `new C { ... }`; a zero-argument init is invoked with `new C()`.
// Value-class instances (`var c: C = uninit;`) get the zero/field
// initializer treatment but never run a constructor.
//
// Base constructors are NOT inherited — `new C(...)` still requires C to
// declare its own `func init(...)` — and v3 chains a base constructor only
// through the explicit `super_init(...)` call in the derived init (Unified
// Standard 4.8.3); the CtorChild case spells it out. A base constructor
// that declares parameters has no argument source unless the derived init
// passes them — see the ParamBase cases. Base DESTRUCTORS are chained the
// other way round, most derived first; tests/programs/base_ctor_dtor_chain
// pins the full ordering for `new`, `delete` and value scopes.
import lib;
from std.io import print, printInt;

class Counter {
    var value: int = 10;    // field initializer: overwritten by init below
    var steps: int = 1;     // overwritten by init below

    func init(start: int, step: int) -> void {
        this->value = start;
        this->steps = step;
    }

    func bump() -> void { this->value = this->value + this->steps; }
    func get() -> int { return this->value; }
}

class Plain {
    var x: int = 3;
}

// Constructor calling methods: the delegated calls run in declaration order.
class MethodCaller {
    var total: int = 0;

    func add(n: int) -> void { this->total = this->total + n; }

    func init(a: int, b: int) -> void {
        this->add(a);
        this->add(b);
    }
}

class Zero {
    var z: int = 5;
    func init() -> void { this->z = this->z + 1; }
}

class Base {
    var base: int = 1;
    virtual func who() -> int { return 10; }
}

class Derived : Base {
    var own: int = 2;
    func init(v: int) -> void { this->own = v; }
    override func who() -> int { return 20; }
}

// CIDER-BUG-123: v2 chained a zero-parameter base constructor implicitly;
// v3 chains it only through the explicit `super_init()` below, and `tag`
// stays 99 — not the field-initializer 0 that the pre-123 behavior pinned.
class CtorBase {
    var tag: int = 0;
    func init() -> void { this->tag = 99; }
}

class CtorChild : CtorBase {
    var mine: int = 1;
    func init(v: int) -> void { super_init(); this->mine = v; }
}

// A base constructor that DECLARES PARAMETERS is not invoked unless the
// derived init passes arguments through `super_init(...)`; ParamChild does
// not, so `p` keeps its field-initializer value and only the derived
// constructor runs.
class ParamBase {
    var p: int = 1;
    func init(n: int) -> void { this->p = n; }
}

class ParamChild : ParamBase {
    var q: int = 2;
    func init(n: int) -> void { this->q = n; }
}

func read(c: *Counter) -> int { return c->get(); }

func main() -> int {
    // Constructor arguments set fields; methods see them (pointer use).
    var c: *Counter = new Counter(5, 2);
    c->bump();
    printInt(c->get()); print("\n");            // 7
    c->bump();
    printInt(read(c)); print("\n");             // 9

    // Class without a constructor: `new C` stays zero/field-initialized.
    var p: *Plain = new Plain { };
    printInt(p->x); print("\n");                // 3

    // Constructor calling other methods.
    var mc: *MethodCaller = new MethodCaller(4, 6);
    printInt(mc->total); print("\n");           // 10

    // Inheritance: inherited field initializers run, the derived constructor
    // runs, and virtual/override dispatch still works through a base pointer.
    var d: *Derived = new Derived(7);
    var b: *Base = d;
    printInt(d->own); print("\n");              // 7
    printInt(d->base); print("\n");             // 1 (field initializer)
    printInt(b->who()); print("\n");            // 20 (override)

    // Chained zero-parameter base ctor runs first, then the derived one.
    var cc: *CtorChild = new CtorChild(8);
    printInt(cc->tag); print("\n");             // 99 (CIDER-BUG-123)
    printInt(cc->mine); print("\n");            // 8

    // A base ctor WITH parameters is not chained; only the derived ctor runs.
    var pc: *ParamChild = new ParamChild(8);
    printInt(pc->p); print("\n");               // 1 (field initializer)
    printInt(pc->q); print("\n");               // 8

    // Zero-argument constructor: both the literal and the call form run it.
    var z1: *Zero = new Zero();
    var z2: *Zero = new Zero();
    printInt(z1->z); print("\n");               // 6
    printInt(z2->z); print("\n");               // 6

    // Value-class instance: field initializers only, no constructor.
    var vc: Counter = uninit;
    printInt(vc.value); print("\n");            // 10
    printInt(vc.steps); print("\n");            // 1

    // Class in a module: constructor mangling + qualified construction.
    var w: *lib.Widget = new lib.Widget(42);
    printInt(w->id); print("\n");               // 42
    var w2: *lib.Widget = lib.makeWidget(9);
    printInt(w2->id); print("\n");              // 9

    print("constructors_ok\n");
    return 0;
}
