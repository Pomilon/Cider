// Migrated to v3: the iteration protocol is `iter()` returning the
// iterator value and `next(it: *Iterator) -> *T` stepping it; receivers
// spell `this->`, and value locals spell `= uninit`.
from std.io import print, printInt;

class Counter {
  var start: int;
  var end: int;
  var cur: int;

  func iter() -> Counter {
    var it: Counter = uninit;
    it.start = this->start;
    it.end = this->end;
    it.cur = this->start;
    return it;
  }

  func next(it: *Counter) -> *int {
    if (it->cur >= it->end) { return nilPtr; }
    var p: *int = &it->cur;
    it->cur = it->cur + 1;
    return p;
  }
}

func _start() {
  var c: Counter = uninit;
  c.start = 0;
  c.end = 4;
  var total: int = 0;
  for (var x in c) {
    total = total + x;
  }
  if (total != 10) { asm { "mov rax, 60" } asm { "mov rdi, 1" } asm { "syscall" } }
  asm { "mov rax, 60" } asm { "mov rdi, 0" } asm { "syscall" }
}
