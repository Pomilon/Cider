func inner(s: string) -> string {
  return (s + 2) as string;
}

func main() -> int {
  var s: string = "hello";
  var t: string = inner(s);
  if (t[0] != 108) { return 1; }
  var u: string = s + 1;
  if (u[0] != 101) { return 2; }
  var v: string = 1 + s;
  if (v[0] != 101) { return 3; }
  var w: string = s + 5 - 2;
  if (w[0] != 108) { return 4; }
  if (t == s) { return 5; }
  return 0;
}
