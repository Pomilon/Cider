from std.alloc import operator new, operator delete;
// CIDER-BUG-225: a call through a nil function pointer. v2 made this a
// defined runtime error on every backend (`vm error: call: nil function
// pointer`, exit 2) guarded by its own `_nil_fnptr_fail` routine, separate
// from the nil-deref guard because the CALL is what failed, not a read.
//
// v3 does not define runtime error text (diff #19): a fault is a silent
// signal. A nil callee is the null function pointer, so the machine enters
// address zero and dies by SIGSEGV; the interpreter raises the same signal
// instead of refusing with a diagnostic. All three legs therefore agree on
// no output and the same death, which is why this program stays B-terminal:
// expected.json keeps the v2 text verbatim and is NOT blessed.
//
// Every live (non-nil) form below runs FIRST and must keep working, so the
// nil case cannot hide a broken call path. Each check returns a distinct
// code (102-120), and the program ends by calling a nil function pointer.
//
// v2 spellings migrated to v3: `fn(int) -> int` -> `*func(int) -> int`
// (the raw function-pointer spelling; `func(...)` values are closures),
// `extends` -> `:`, `hp.g` -> `hp->g`, bare function names -> `&name`,
// and locals/fields/globals that used to rely on closure slots now name
// the pointer spelling explicitly.
type Cb = *func(int) -> int;

func dbl(x: int) -> int { return x * 2; }
func inc(x: int) -> int { return x + 1; }
msabi func dblMs(x: int) -> int { return x + 20; }

struct Holder { g: *func(int) -> int; }

class Base { virtual func kind(x: int) -> int { return x; } }
class Derived : Base { override func kind(x: int) -> int { return x + 100; } }

var globalNil: *func(int) -> int = nilPtr;
var globalLive: *func(int) -> int = &dbl;

func viaParam(g: *func(int) -> int, x: int) -> int { return g(x); }
func pick(b: bool) -> *func(int) -> int { if (b) { return &dbl; } return nilPtr; }
func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

func main() -> int {
  // 1. A local raw function value, called by name and through a loop.
  var g: *func(int) -> int = &dbl;
  if (g(3) != 6) { return 102; }
  g = &inc;
  if (g(3) != 4) { return 103; }
  var acc: int = 0;
  var i: int = 0;
  while (i < 20) { acc = acc + g(1); i = i + 1; }
  if (acc != 40) { return 104; }

  // 2. An alias of the pointer spelling.
  var a: Cb = &dbl;
  if (a(5) != 10) { return 105; }

  // 3. A parameter carrying the pointer.
  if (viaParam(&dbl, 4) != 8) { return 106; }

  // 4. A struct field, reached by value and through a pointer.
  var h: Holder = uninit;
  h.g = &inc;
  if (h.g(3) != 4) { return 107; }
  var hp: *Holder = &h;
  if (hp->g(3) != 4) { return 108; }

  // 5. An array element.
  var arr: [*func(int) -> int; 2] = uninit;
  arr[0] = &dbl;
  arr[1] = &inc;
  if (arr[0](3) != 6) { return 109; }
  if (arr[1](3) != 4) { return 110; }

  // 6. A value returned from a call.
  var picked: *func(int) -> int = pick(true);
  if (picked(3) != 6) { return 111; }

  // 7. A module-scope global, live and nil.
  if (globalLive(3) != 6) { return 112; }
  if (globalNil != nilPtr) { return 113; }

  // 8. The msabi convention on a raw function value.
  var m: *msabi func(int) -> int = &dblMs;
  if (m(3) != 23) { return 114; }

  // 9. A closure value keeps its own spelling and pair representation.
  var add10: func(int) -> int = makeAdder(10);
  if (add10(5) != 15) { return 115; }

  // 10. A virtual method through a base pointer, and nil comparison.
  var derived: *Derived = new Derived { };
  if (derived->kind(3) != 103) { return 117; }
  var base: *Base = new Base { };
  if (base->kind(3) != 3) { return 118; }
  if (g == nilPtr) { return 119; }
  if (nilPtr != nilPtr) { return 120; }

  // The nil call: no output, SIGSEGV on every leg.
  var nilFn: *func(int) -> int = nilPtr;
  return nilFn(3);
}
