// CIDER-BUG-071: a fixed-array variable declared through a type alias
// (`type Row = [u8;3]; var s: Row = a[1:4];`) must copy a slice exactly
// like the direct spelling. Before the fix the alias spelling kept
// isArray off the declared type, so the declaration was rejected with
// "Type mismatch in declaration of 's'. Expected Row, got u8", and the
// reassignment `s = a[1:4]` was rejected the same way. Every element
// value below is checked, for a u8 alias and for a u16 alias of a
// different element width.
type Row = [u8; 3];
type Words = [u16; 2];
type Rows = [Row; 2];

struct Box {
  var arr: Row;
}

func main() -> int {
  var a: [u8; 5] = new [u8; 5] { 10, 42, 43, 44, 50 };

  // Middle slice at declaration time through the alias.
  var s: Row = a[1:4];
  if (s[0] != 42) { return 1; }
  if (s[1] != 43) { return 2; }
  if (s[2] != 44) { return 3; }

  // The copy must not modify the source array.
  if (a[1] != 42) { return 4; }
  if (a[3] != 44) { return 5; }

  // Head/tail forms through the same alias.
  var h: Row = a[0:3];
  if (h[0] != 10) { return 6; }
  if (h[1] != 42) { return 7; }
  if (h[2] != 43) { return 8; }
  var t: Row = a[2:5];
  if (t[0] != 43) { return 9; }
  if (t[1] != 44) { return 10; }
  if (t[2] != 50) { return 11; }

  // Assignment into an existing alias-declared array.
  var u: Row = new [u8; 3] { [0, ...] };
  u = a[2:5];
  if (u[0] != 43) { return 12; }
  if (u[1] != 44) { return 13; }
  if (u[2] != 50) { return 14; }

  // Dynamic bounds: the target's element count governs the copy.
  var lo: int = 1;
  var hi: int = 4;
  var d: Row = a[lo:hi];
  if (d[0] != 42) { return 15; }
  if (d[1] != 43) { return 16; }
  if (d[2] != 44) { return 17; }

  // A second alias with wider elements, declaration and assignment.
  var w: [u16; 4] = new [u16; 4] { 100, 200, 300, 400 };
  var ws: Words = w[1:3];
  if (ws[0] != 200) { return 18; }
  if (ws[1] != 300) { return 19; }
  var wt: Words = new [u16; 2] { [0, ...] };
  wt = w[2:4];
  if (wt[0] != 300) { return 20; }
  if (wt[1] != 400) { return 21; }

  // Alias of an alias: a nested fixed array copies its row elements.
  var z: Row = new [u8; 3] { 0, 0, 0 };
  var m: [Row; 4] = new [Row; 4] { z, z, z, z };
  m[0][0] = 1; m[0][1] = 2; m[0][2] = 3;
  m[1][0] = 4; m[1][1] = 5; m[1][2] = 6;
  m[2][0] = 7; m[2][1] = 8; m[2][2] = 9;
  m[3][0] = 10; m[3][1] = 11; m[3][2] = 12;
  var r: Rows = m[1:3];
  if (r[0][0] != 4) { return 22; }
  if (r[0][2] != 6) { return 23; }
  if (r[1][0] != 7) { return 24; }
  if (r[1][2] != 9) { return 25; }

  // A struct field of alias type is the same assignment target.
  var b: Box = new Box { arr: new [u8; 3] { 0, 0, 0 } };
  b.arr = a[0:3];
  if (b.arr[0] != 10) { return 26; }
  if (b.arr[1] != 42) { return 27; }
  if (b.arr[2] != 43) { return 28; }

  return 0;
}
