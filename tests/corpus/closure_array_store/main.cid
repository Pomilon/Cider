// CIDER-BUG-157: fixed arrays of closure-typed elements use the declared-
// shape list materialisation (CIDER-BUG-163/165), per-element closure
// copies, direct closure elements, by-value array copies, and closure-
// convention calls through elements. All three backends must agree.

type Adders = [func(int) -> int; 2];

func makeAdder(base: int) -> func(int) -> int {
  return func(x: int) -> int { return x + base; };
}

struct Holder {
  var fs: [func(int) -> int; 2];
  var one: func(int) -> int;
}

func sum(fs: [func(int) -> int; 2], x: int) -> int {
  return fs[0](x) + fs[1](x);
}

func sumAlias(fs: Adders, x: int) -> int {
  return fs[0](x) + fs[1](x);
}

func makePair() -> Adders {
  var p: Adders = new [func(int) -> int; 2] { makeAdder(1), makeAdder(2) };
  return p;
}

func main() -> int {
  // Declaration from a list of direct closures.
  var fs: Adders = new [func(int) -> int; 2] { makeAdder(10), makeAdder(100) };
  if (fs[0](5) != 15) return 1;
  if (fs[1](5) != 105) return 2;

  // Element assignment (direct closure); slots stay independent.
  fs[0] = makeAdder(20);
  if (fs[0](5) != 25) return 3;
  if (fs[1](5) != 105) return 4;

  // Whole-array reassignment from a list.
  fs = new [func(int) -> int; 2] { makeAdder(1), makeAdder(2) };
  if (fs[0](5) != 6) return 5;
  if (fs[1](5) != 7) return 6;

  // Struct-literal field from a list, plus a direct closure field.
  var h: Holder = new Holder { fs: new [func(int) -> int; 2] { makeAdder(30), makeAdder(40) }, one: makeAdder(50) };
  if (h.fs[0](1) != 31) return 7;
  if (h.fs[1](1) != 41) return 8;
  if (h.one(1) != 51) return 9;

  // Field assignment from a list, then an element through a pointer.
  h.fs = new [func(int) -> int; 2] { makeAdder(3), makeAdder(4) };
  var hp: *Holder = &h;
  (*hp).fs[1] = makeAdder(400);
  if (h.fs[1](1) != 401) return 10;

  // List literal as a call argument (declared-shape materialisation).
  if (sum(new [func(int) -> int; 2] { makeAdder(60), makeAdder(70) }, 2) != 62 + 72) return 11;
  var pair: Adders = makePair();
  if (sumAlias(pair, 2) != 3 + 4) return 12;

  // By-value copy semantics: the copy is independent of the source.
  var copy: Adders = pair;
  copy[0] = makeAdder(9);
  if (pair[0](2) != 3) return 13;
  if (copy[0](2) != 11) return 14;

  // *void element control dropped: closure<->*void conversions are the
  // T10 closures-repr wall (same as fn_cast_closure_*), tracked there.

  // Nested rows (CIDER-BUG-163 shape) with closure elements.
  var m: [[func(int) -> int; 2]; 2] = new [[func(int) -> int; 2]; 2] {
    new [func(int) -> int; 2] { makeAdder(1), makeAdder(2) },
    new [func(int) -> int; 2] { makeAdder(3), makeAdder(4) }
  };
  if (m[1][0](1) != 4) return 16;
  m[1][0] = makeAdder(40);
  if (m[1][0](1) != 41) return 17;

  return 0;
}
