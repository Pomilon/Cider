from std.io import print, printInt;

// CIDER-BUG-105 regression: forward-declared (later-declared) by-value
// class/struct fields must get their real size and offset once every
// declaration is collected. The collector used to size such a field with the
// unresolved-type default, so it collided with the fields after it; the same
// layout must result whatever the declaration order is, for member access,
// field initializers, whole-value copies, heap instances, arrays of forward
// types and embedded destructor registration.
//
// Migrated to v3: locals spell `= uninit`, embedded class fields carry a
// default construction (`B { }`, `C3 { }`, `[Later2 { }]`), `~D()` is
// `deinit()`, and the heap instance uses the `new A { }` literal. v3 runs a
// finalizer only through explicit `delete`, never at scope exit, so the
// embedded-drop count is pinned at zero.
//
// The ticket's shape: B is 12 bytes and declared after A. A.b used to be
// sized 8, so B.w and A.x shared offset 8.
class A {
  var b: B = B { };
  var x: int = 1;
}

class B {
  var y: int = 7;
  var z: int = 8;
  var w: int = 9;
}

// Dependency-order twin: the forward-declared layout must match it exactly.
class B2 {
  var y: int = 7;
  var z: int = 8;
  var w: int = 9;
}

class A2 {
  var b: B2 = B2 { };
  var x: int = 1;
}

// Nested forward chain: A3 -> B3 -> C3, both declared later.
class A3 {
  var b: B3 = B3 { };
  var x: int = 1;
}

class B3 {
  var c: C3 = C3 { };
  var z: int = 2;
}

class C3 {
  var u: int = 3;
  var v: int = 4;
  var w: int = 5;
}

// An array of a forward-declared class inside a struct embedded in a class.
struct SA {
  var arr: [C3; 3] = [C3 { }, C3 { }, C3 { }];
  var tail: int = 0;
}

class KA {
  var s: SA = SA { };
  var k: int = 7;
}

// Structs whose by-value field type (and array element type) is declared
// later: the element size must feed the array stride and the offsets after
// it, and the embedded class values must still initialise.
struct FAR {
  var arr: [Later2; 2] = [Later2 { }, Later2 { }];
  var tail: int = 0;
}

struct SFwd {
  var l: Later2 = Later2 { };
  var n: int = 0;
}

class Later2 {
  var a: int = 31;
  var b: int = 32;
  var c: int = 33;
}

// Embedded destructor registration must follow the corrected layout too:
// Holder is declared before D, and the trailing int must survive both D's
// initialization and Holder's destruction.
var drops: int = 0;

class Holder {
  var d: D = D { };
  var n: int = 21;
}

class D {
  var label: int = 0;
  func deinit() {
    drops = drops + 1;
  }
}

func main() -> int {
  var a: A = uninit;
  if (sizeof(A) != 16) { return 1; }        // B(12) + x(4)
  if (sizeof(B) != 12) { return 2; }
  if (sizeof(A) != sizeof(A2)) { return 3; }
  if (a.b.y != 7) { return 4; }
  if (a.b.z != 8) { return 5; }
  if (a.b.w != 9) { return 6; }
  if (a.x != 1) { return 7; }

  // Writes through the correct offsets; x must not alias b.w.
  a.b.w = 90;
  a.x = 11;
  if (a.b.w != 90) { return 8; }
  if (a.x != 11) { return 9; }

  // A whole-value copy keeps the layout and the source state.
  var c: A = a;
  if (c.b.y != 7) { return 10; }
  if (c.b.z != 8) { return 11; }
  if (c.b.w != 90) { return 12; }
  if (c.x != 11) { return 13; }

  // A heap instance: field initializers and delete use the same layout.
  var h: *A = new A { };
  if (h->b.y != 7) { return 14; }
  if (h->b.z != 8) { return 15; }
  if (h->b.w != 9) { return 16; }
  if (h->x != 1) { return 17; }
  delete h;

  // Nested chain and an array of a forward-declared class.
  var n3: A3 = uninit;
  if (sizeof(C3) != 12) { return 18; }
  if (sizeof(B3) != 16) { return 19; }
  if (sizeof(A3) != 20) { return 20; }
  if (n3.b.c.u != 3) { return 21; }
  if (n3.b.c.v != 4) { return 22; }
  if (n3.b.c.w != 5) { return 23; }
  if (n3.b.z != 2) { return 24; }
  if (n3.x != 1) { return 25; }
  var k: KA = uninit;
  if (sizeof(SA) != 40) { return 26; }     // [C3;3]=36 + tail
  if (sizeof(KA) != 44) { return 27; }     // SA(40) + k(4)
  if (k.s.arr[0].u != 3) { return 28; }
  if (k.s.arr[2].w != 5) { return 29; }
  if (k.s.tail != 0) { return 30; }
  if (k.k != 7) { return 31; }
  k.s.arr[1].v = 44;
  k.s.tail = 6;
  if (k.s.arr[1].v != 44) { return 32; }
  if (k.s.tail != 6) { return 33; }
  if (k.k != 7) { return 34; }

  // Embedded destructor registration on the corrected layout.
  {
    var hd: Holder = uninit;
    hd.d.label = 55;
    if (hd.d.label != 55) { return 35; }
    if (hd.n != 21) { return 36; }
  }
  // v3 finalizes only through explicit delete: an embedded value is not
  // destroyed at scope exit, so the drop count stays zero.
  if (drops != 0) { return 37; }

  // Struct fields and array elements whose type is declared later.
  if (sizeof(Later2) != 12) { return 38; }
  if (sizeof(FAR) != 28) { return 39; }    // [Later2;2]=24 + tail
  if (sizeof(SFwd) != 16) { return 40; }   // Later2(12) + n
  var far: FAR = uninit;
  if (far.arr[0].a != 31) { return 41; }
  if (far.arr[1].c != 33) { return 42; }
  if (far.tail != 0) { return 43; }
  far.arr[1].b = 44;
  far.tail = 7;
  if (far.arr[1].b != 44) { return 44; }
  if (far.tail != 7) { return 45; }
  var sf: SFwd = uninit;
  if (sf.l.b != 32) { return 46; }
  if (sf.n != 0) { return 47; }
  sf.l.c = 48;
  sf.n = 49;
  if (sf.l.c != 48) { return 48; }
  if (sf.n != 49) { return 49; }

  printInt(sizeof(A)); print(",");
  printInt(a.b.w); print(",");
  printInt(c.x); print(",");
  printInt(n3.b.c.w); print(",");
  printInt(k.s.arr[1].v + k.s.tail); print(",");
  printInt(drops); print(",");
  printInt(sizeof(FAR)); print(",");
  printInt(far.tail + sf.n); print("\n");
  print("forward_decl_fields_ok\n");
  return 0;
}
