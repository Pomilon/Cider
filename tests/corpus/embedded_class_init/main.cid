// CIDER-BUG-087 regression: an embedded class-value subobject must run its
// class's field initializers wherever the type system embeds a class value
// by value — struct fields (nested combinations included), fixed arrays of
// class values (local, field and global), and module-scope class/struct
// globals — on all three backends (VM unopt, VM optimized, native). Covers
// aliases, inheritance, `new S`, struct literals with omitted fields, the
// zero default for fields without an initializer, copy/explicit-value wins,
// and constructor ordering after the embedded initializers.
from std.io import printInt, print;

class Inner {
    var x: int = 5;
    var unset: int;            // no initializer: stays zero
}

class Mid {
    var inner: Inner;
}

struct SWrap {
    var inner: Inner;
    var pad: int;              // no initializer: stays zero
}

struct SNested {
    var wrap: SWrap;
    var arr: [Inner; 2];
}

type IAlias = Inner;
type SWrapAlias = SWrap;

// A class whose embedded values are structs and arrays of class values.
class Combo {
    var wrap: SWrap;
    var arr: [Inner; 2];
    var direct: Inner;
    var own: int = 9;
}

// Inherited embedded values initialise on derived instances too.
class Base {
    var inner: Inner;
    var b: int = 10;
}

class Derived extends Base {
    var arr: [Inner; 2];
}

// A struct inside a class inside a struct (deep nesting).
class Deep {
    var wrap: SWrap;
}

struct SDeep {
    var deep: Deep;
}

// A constructor observes the embedded initializers (they run first).
class WithCtor {
    var wrap: SWrap;
    var arr: [Inner; 2];
    var seen: int = 0;
    func init() -> void { this.seen = this.wrap.inner.x + this.arr[1].x; }
}

// Globals of every shape.
class Solo {
    var x: int = 5;
    var unset: int;
}

class GText {
    var text: string = "global";
    var n: int = 3;
}

var gSolo: Solo;
var gWrap: SWrap;
var gArr: [Inner; 2];
var gNested: SNested;
var gDerived: Derived;
var gText: GText;
var gCombo: Combo;

func main() -> int {
    // Struct locals, nested structs and aliases.
    var s: SWrap;
    if (s.inner.x != 5) return 1;
    if (s.inner.unset != 0) return 2;
    if (s.pad != 0) return 3;
    var n: SNested;
    if (n.wrap.inner.x != 5) return 4;
    if (n.arr[0].x != 5) return 5;
    if (n.arr[1].x != 5) return 6;
    var sa: SWrapAlias;
    if (sa.inner.x != 5) return 7;
    var m: Mid;
    if (m.inner.x != 5) return 8;

    // Fixed arrays of class values, nested and element-aliased.
    var a: [Inner; 3];
    if (a[0].x != 5) return 9;
    if (a[2].x != 5) return 10;
    var na: [[Inner; 2]; 2];
    if (na[0][0].x != 5) return 11;
    if (na[1][1].x != 5) return 12;
    var sarr: [SWrap; 2];
    if (sarr[0].inner.x != 5) return 13;
    if (sarr[1].inner.x != 5) return 14;
    var ia: [IAlias; 2];
    if (ia[1].x != 5) return 15;

    // Struct literals: omitted fields initialise, explicit ones win. An
    // omitted fixed-array field initialises every element.
    var lit: SWrap = SWrap{pad: 7};
    if (lit.inner.x != 5) return 16;
    if (lit.pad != 7) return 17;
    var litEmpty: SWrap = SWrap{};
    if (litEmpty.inner.x != 5) return 18;
    var litNested: SNested = SNested{wrap: SWrap{}};
    if (litNested.arr[0].x != 5) return 51;
    if (litNested.arr[1].x != 5) return 52;
    if (litNested.wrap.inner.x != 5) return 53;
    var custom: Inner;
    custom.x = 42;
    var litExplicit: SWrap = SWrap{inner: custom, pad: 1};
    if (litExplicit.inner.x != 42) return 19;
    if (litExplicit.pad != 1) return 20;

    // A whole-value copy keeps the source state (no re-init on the copy).
    var src: SWrap;
    src.inner.x = 42;
    var copy: SWrap = src;
    if (copy.inner.x != 42) return 21;

    // Class fields that embed structs and arrays of class values.
    var combo: Combo;
    if (combo.wrap.inner.x != 5) return 22;
    if (combo.arr[0].x != 5) return 23;
    if (combo.arr[1].x != 5) return 24;
    if (combo.direct.x != 5) return 25;
    if (combo.own != 9) return 26;

    // Inheritance travels with the embedded fields.
    var d: Derived;
    if (d.inner.x != 5) return 27;
    if (d.b != 10) return 28;
    if (d.arr[0].x != 5) return 29;

    // Struct-in-class-in-struct nesting.
    var sd: SDeep;
    if (sd.deep.wrap.inner.x != 5) return 30;

    // Heap-allocated structs run the same pass as locals.
    var h: *SWrap = new SWrap;
    if (h->inner.x != 5) return 31;
    var hd: *Derived = new Derived;
    if (hd->inner.x != 5) return 32;
    if (hd->arr[1].x != 5) return 33;

    // Constructors observe the embedded initializers (ordering).
    var wc: *WithCtor = new WithCtor;
    if (wc->seen != 10) return 34;
    var wcv: WithCtor;
    if (wcv.seen != 0) return 35;      // value instances run no ctor

    // Globals: class, struct, arrays, nested struct, inheritance, string.
    if (gSolo.x != 5) return 36;
    if (gSolo.unset != 0) return 37;
    if (gWrap.inner.x != 5) return 38;
    if (gWrap.pad != 0) return 39;
    if (gArr[0].x != 5) return 40;
    if (gArr[1].x != 5) return 41;
    if (gNested.wrap.inner.x != 5) return 42;
    if (gNested.arr[1].x != 5) return 43;
    if (gDerived.inner.x != 5) return 44;
    if (gDerived.b != 10) return 45;
    if (gDerived.arr[0].x != 5) return 46;
    if (gText.n != 3) return 47;
    if (gCombo.wrap.inner.x != 5) return 48;
    if (gCombo.arr[0].x != 5) return 49;

    // A copy of a nested initialised value carries the state.
    var ncopy: SNested = n;
    if (ncopy.wrap.inner.x != 5) return 50;

    printInt(litNested.arr[0].x); print(",");
    printInt(s.inner.x); print(",");
    printInt(n.arr[1].x); print(",");
    printInt(a[1].x); print(",");
    printInt(na[1][0].x); print(",");
    printInt(lit.inner.x + lit.pad); print(",");
    printInt(litExplicit.inner.x); print(",");
    printInt(combo.wrap.inner.x + combo.arr[1].x + combo.direct.x); print(",");
    printInt(d.inner.x + d.b); print(",");
    printInt(sd.deep.wrap.inner.x); print(",");
    printInt(h->inner.x + hd->arr[0].x); print(",");
    printInt(wc->seen); print(",");
    printInt(gSolo.x + gNested.arr[1].x + gDerived.b); print(",");
    print(gText.text); print(",");
    printInt(gCombo.arr[1].x + ncopy.wrap.inner.x); print("\n");
    print("embedded_class_init_ok\n");

    delete h;
    delete hd;
    delete wc;
    return 0;
}
