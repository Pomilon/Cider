// CIDER-BUG-243 module half: interface-typed globals whose DECLARATION ORDER
// differs from their interface's, reached from the entry file by both the
// module-qualified spelling (`lib.gEarly`) and a `from`-import ALIAS.
//
// The interface is deliberately named `DTag` and the entry file spells it
// `lib.DTag` everywhere, so the BARE name the globals' symbols carry
// (`DTag`, `DWrap`) is not resolvable in the importing scope. The 16-byte fat
// pointer therefore cannot be recovered by name at the use site any more: it
// has to be a property of the DECLARATION, resolved by the collector in the
// declaring module (symbol_collector.h visit(VarDeclStmt) ->
// resolveInterfaceTypeFlag). Until CIDER-BUG-243 the collector flagged no
// variable at all, so every read site re-derived it — and the declaration-order
// variants below were exactly the shapes where a per-site recovery rooted in
// the DECLARING module was the only thing that could have worked.
//
// Three orders are covered, one interface:
//   * gEarly is declared BEFORE the interface, so the collector's eager pass
//     has nothing to resolve against — the CIDER-BUG-209 second pass (extended
//     to variables) has to add the flag;
//   * gAlias is declared before its type ALIAS, and the alias chain's hops are
//     declared after it too (`DWrap` -> `DInner` -> `DTag`), each hop resolved
//     in its own defining module (CIDER-BUG-078/102/128);
//   * gAfter is declared after everything, the control that must agree with
//     the two above.
from std.io import print;

// --- declared BEFORE the interface -----------------------------------------
export var gEarly: DTag = nilPtr as DTag;

// --- declared before its alias chain, which is declared after the interface -
export var gAlias: DWrap = nilPtr as DWrap;
export type DWrap = DInner;
export type DInner = DTag;

export interface DTag {
  func o() -> int;
  func tag() -> int;
}

// The control: declared after the interface, the order the eager pass handles.
export var gAfter: DTag = nilPtr as DTag;

// First implementor: its finalizer REPORTS, so the trace shows which object
// was finalized and when.
export class DOne {
  var v: int;
  func init(x: int) { (*self).v = x; }
  func o() -> int { return (*self).v; }
  func tag() -> int { return 7; }
  func deinit() { print("A"); }
}

// A second implementor with a DIFFERENT tag, so a stale vtable left behind by
// the previous store is visible as a wrong tag rather than a crash.
export class DTwo {
  var s: int;
  func init(x: int) { (*self).s = x; }
  func o() -> int { return (*self).s; }
  func tag() -> int { return 13; }
  func deinit() { print("B"); }
}

// A third implementor whose methods are bigger and whose object is larger, so
// a plain 4-byte copy of it into the 16-byte slot leaves recognisable debris.
export class DThree {
  var p: int;
  var pad: [u64; 4];
  func init(x: int) { (*self).p = x; (*self).pad = [ 0, 0, 0, 0 ]; }
  func o() -> int { return (*self).p; }
  func tag() -> int { return 21; }
  func deinit() { print("C"); }
}


// The bare controls, inside the module that declares both sides: what the
// qualified and aliased spellings must agree with.
export func seedEarly() -> int {
  var d: *DOne = new DOne(0);
  (*d).v = 42;
  gEarly = d;
  return gEarly.o();
}

export func seedAlias() -> int {
  var d: *DTwo = new DTwo(0);
  (*d).s = 17;
  gAlias = d;
  return gAlias.o();
}

export func seedAfter() -> int {
  var d: *DThree = new DThree(0);
  (*d).p = 5;
  gAfter = d;
  return gAfter.o();
}

// Reads the interface back through a signature this module spells, so the
// result has to survive a cross-module call in every direction.
export func peekEarly() -> int { return gEarly.o() * 100 + gEarly.tag(); }
export func peekAlias() -> int { return gAlias.o() * 100 + gAlias.tag(); }
export func peekAfter() -> int { return gAfter.o() * 100 + gAfter.tag(); }

export func takesTag(x: DTag) -> int { return x.o() * 10 + x.tag(); }

// Not exported: no spelling may reach it (CIDER-BUG-060).
var hidden: DTag = nilPtr as DTag;
