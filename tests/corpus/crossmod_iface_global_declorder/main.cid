from std.alloc import operator new, operator delete;
// CIDER-BUG-243: an interface-typed global's representation must be resolved
// where it is DECLARED, not recovered by name at every read.
//
// lib declares three interface-typed globals in three different orders relative
// to their interface: `gEarly` BEFORE it, `gAlias` before an ALIAS chain that
// is itself declared after the interface, and `gAfter` after it. The collector
// resolved the interface flag for a class field, a struct field and every
// function signature, but for NO variable — so `sym->type.isInterface` was
// false and every value-read site had to recover the 16-byte fat pointer by
// name. This program is the regression for that root cause: it reaches the
// globals from BOTH directions a cross-module global can be read
// (module-qualified `lib.g`, and a `from`-import ALIAS), and the bare name the
// declarations carry is deliberately out of scope here, so a by-name recovery
// rooted in THIS module cannot produce the fat pointer.
//
// Pinned, on all three backends:
//   * a store into each of the three, through the qualified spelling, followed
//     by dispatch through both interface methods (a miscompiled store leaves a
//     zero vtable word: a crash, or a wrong tag);
//   * the same three through a `from`-import ALIAS, in turn, with three
//     implementors of different tags and different layouts, so a stale vtable
//     shows as a wrong tag instead of passing unnoticed;
//   * interface-to-interface copies, which must not re-label the vtable;
//   * a read back through a cross-module call whose signature this file never
//     spells, for each of the three;
//   * the bare in-module control agrees with all of it;
//   * ownership: a concrete-to-interface store ALIASES the value, so the
//     source global stays readable and writable, and each implementor global
//     is finalized exactly once at program exit (the trace in expected.json).
// The companion fixture check_iface_global_declorder_lookalike.cid pins the
// rejections that must survive for the forward-declared global.
import lib;
from std.io import print;
from lib import gEarly, gAlias, gAfter, DOne, DTwo, DThree;

// Neither the interface nor the aliases are from-imported here: every spelling
// in this file is qualified, so the bare names the declarations carry (`DTag`,
// `DWrap`, `DInner`) are not resolvable in this scope.

func main() -> int {
  var dOne: *DOne = new DOne(0);
  var dTwo: *DTwo = new DTwo(0);
  var dThree: *DThree = new DThree(0);
  (*dOne).v = 42;
  (*dTwo).s = 17;
  (*dThree).p = 5;

  // --- the qualified spelling, one global per declaration order ------------
  lib.gEarly = dOne;
  if (lib.gEarly.o() != 42) { return 1; }
  if (lib.gEarly.tag() != 7) { return 2; }
  lib.gAlias = dTwo;
  if (lib.gAlias.o() != 17 || lib.gAlias.tag() != 13) { return 3; }
  lib.gAfter = dThree;
  if (lib.gAfter.o() != 5 || lib.gAfter.tag() != 21) { return 4; }

  // --- the same three through a from-import ALIAS, in turn ----------------
  // Three implementors with different tags AND different object layouts, so
  // neither a stale vtable nor a plain 4-byte copy of the object passes.
  gEarly = dTwo;
  if (gEarly.o() != 17 || gEarly.tag() != 13) { return 5; }
  gEarly = dThree;
  if (gEarly.o() != 5 || gEarly.tag() != 21) { return 6; }
  gEarly = dOne;
  if (gEarly.o() != 42 || gEarly.tag() != 7) { return 7; }

  gAlias = dThree;
  if (gAlias.o() != 5 || gAlias.tag() != 21) { return 8; }
  gAlias = dOne;
  if (gAlias.o() != 42 || gAlias.tag() != 7) { return 9; }

  gAfter = dOne;
  if (gAfter.o() != 42 || gAfter.tag() != 7) { return 10; }
  gAfter = dThree;
  if (gAfter.o() != 5 || gAfter.tag() != 21) { return 11; }

  // --- interface to interface: a fat-pointer copy, no re-labelling --------
  gEarly = gAlias;
  if (gEarly.o() != 42 || gEarly.tag() != 7) { return 12; }
  gAfter = gEarly;
  if (gAfter.o() != 42 || gAfter.tag() != 7) { return 13; }
  gAlias = gAfter;
  if (gAlias.o() != 42 || gAlias.tag() != 7) { return 14; }

  // --- reads back through a cross-module call, per global -----------------
  if (lib.peekEarly() != 4207) { return 15; }
  if (lib.peekAlias() != 4207) { return 16; }
  if (lib.peekAfter() != 4207) { return 17; }

  // --- an argument spelled in lib's own signature -------------------------
  if (lib.takesTag(dThree) != 71) { return 18; }
  if (lib.takesTag(gEarly) != 427) { return 19; }

  // --- the in-module controls agree with every spelling above -------------
  if (lib.seedEarly() != 42) { return 20; }
  if (lib.seedAlias() != 17) { return 21; }
  if (lib.seedAfter() != 5) { return 22; }
  if (lib.peekEarly() != 4207) { return 23; }
  if (lib.peekAlias() != 1713) { return 24; }
  if (lib.peekAfter() != 521) { return 25; }
  // The controls did not disturb the globals reached through the aliases.
  gEarly = dOne;
  if (gEarly.o() != 42 || gEarly.tag() != 7) { return 26; }
  gAlias = dOne;
  if (gAlias.o() != 42 || gAlias.tag() != 7) { return 27; }
  gAfter = dOne;
  if (gAfter.o() != 42 || gAfter.tag() != 7) { return 28; }

  // --- ownership: the store aliased the value, it did not consume it ------
  if ((*dOne).v != 42) { return 29; }
  (*dOne).v = 43;
  if ((*dOne).v != 43) { return 30; }
  if (gEarly.o() != 43) { return 31; }
  (*dOne).v = 42;

  // The three implementor globals are finalized exactly once, at program exit
  // — the trace in expected.json. A store that consumed, cloned or
  // double-released its source would change it.
  print("crossmod_iface_global_declorder_ok\n");
  delete dThree;
  delete dTwo;
  delete dOne;
  return 0;
}
