// CIDER-BUG-150: list literals in argument and return positions must accept
// concrete implementors with the normal interface conversion — the same
// 16-byte fat-pointer store as `var i: Shape = <value>` — instead of the
// exact element-type test. Before the fix, every line below reported
// "Array element type mismatch", and `return <list>` reported "a return
// needs the declared type".
import lib;
from lib import Shape;
from std.io import print, printInt;

type Shapes2 = [lib.Shape; 2];        // dotted interface element

// A local class and interface named exactly like the lib spellings, to pin
// the mangling: the shapes below must resolve by module, not by spelling.
class Rect {
  var w: int;
  var h: int;
  func area() -> int { return (*self).w * (*self).h; }
  func kind() -> int { return 2; }
}

class Tri {
  var b: int;
  func area() -> int { return (*self).b * 2; }
  func kind() -> int { return 3; }
}

class Acc {
  var total: int;
  func add(shapes: [Shape; 2]) -> int {
    (*self).total = (*self).total + shapes[0].area() + shapes[1].area();
    return (*self).total;
  }
}

interface Sink {
  func add(shapes: [Shape; 2]) -> int;
}

class Wrap {
  var pair: [Shape; 2];
  func init(shapes: [Shape; 2]) {
    (*self).pair = shapes;
  }
  func sum() -> int {
    return (*self).pair[0].area() + (*self).pair[1].area();
  }
}

class Holder {
  func use(shapes: [Shape; 2]) -> int {
    return shapes[0].kind() * 100 + shapes[1].kind();
  }
  func mk(a: int, b: int) -> Shapes2 {
    gHmRect.w = a;
    gHmRect.h = b;
    gHmTri.b = 7;
    return [ gHmRect, gHmTri ];
  }
}

func sumAreas(shapes: [Shape; 2]) -> int {
  return shapes[0].area() + shapes[1].area();
}

func sumKinds(shapes: [Shape; 2]) -> int {
  return shapes[0].kind() + shapes[1].kind();
}

var gMkSq: lib.Sq = lib.Sq { side: 0 };
var gMkRect: Rect = Rect { w: 0, h: 0 };
var gHmRect: Rect = Rect { w: 0, h: 0 };
var gHmTri: Tri = Tri { b: 0 };

func mkpair() -> Shapes2 {
  gMkSq.side = 6;
  gMkRect.w = 2;
  gMkRect.h = 5;
  return [ gMkSq, gMkRect ];
}

func main() -> int {
  var r: Rect = Rect { w: 2, h: 5 };
  var t: Tri = Tri { b: 6 };
  var s: lib.Sq = lib.Sq { side: 7 };
  var h: Holder = Holder { };

  if (sumAreas([ r, t ]) != 22) { return 1; }
  if (sumKinds([ t, r ]) != 5) { return 2; }
  if (lib.total([ r, s ]) != 59) { return 3; }
  if (h.use([ s, t ]) != 103) { return 4; }

  var acc: Acc = Acc { total: 0 };
  var sink: Sink = acc;
  if (sink.add([ t, s ]) != 61) { return 5; }
  if (sink.add([ r, r ]) != 81) { return 6; }

  var w: *Wrap = new Wrap([ s, r ]);
  if ((*w).sum() != 59) { return 7; }

  var i: Shape = t;
  var pr: *Rect = &r;
  var ps: *lib.Sq = &s;
  if (sumAreas([ i, r ]) != 22) { return 8; }
  if (sumAreas([ pr, ps ]) != 59) { return 9; }
  if (sumKinds([ ps, pr ]) != 3) { return 10; }

  var p: Shapes2 = mkpair();
  if (p[0].area() + p[1].area() != 46) { return 11; }
  if (p[0].kind() * 100 + p[1].kind() != 102) { return 12; }
  var q: [Shape; 2] = h.mk(3, 4);
  if (q[0].area() + q[1].area() != 26) { return 13; }
  if (q[0].kind() * 100 + q[1].kind() != 203) { return 14; }

  printInt(sumAreas([ r, t ])); print(",");
  printInt(lib.total([ s, t ])); print(",");
  printInt(p[0].area() + p[1].area()); print(",");
  printInt(q[0].area() + q[1].area()); print("\n");
  print("interface_list_arg_return_ok\n");
  return 0;
}
