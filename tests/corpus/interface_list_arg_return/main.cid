// CIDER-BUG-150: a list literal whose elements are concrete implementors
// must convert element-wise to an array-of-interface parameter or return,
// exactly as it does for a declaration or a reassignment (CIDER-BUG-135):
// the fat pointer per element, the vtable built from the concrete type,
// and the same signature-identity / export-visibility rules. The
// declaration/reassignment spellings already converted; the argument
// (CIDER-BUG-165) and return (CIDER-BUG-177) sites share the same checker
// rule (checkFixedArrayElements -> checkInterfaceValue) and the same IR
// lowering (emitListLiteralTemp -> emitInterfaceStoreAt). This program pins
// that behavior: three implementors with different tags AND different
// layouts (Rect has two fields, Tri and Sq have one), dispatch through
// every interface method on every converted element, so a stale vtable
// shows as a wrong tag/area rather than a silent pass.
//
// Covered here on all three backends (VM unopt, VM optimized, native):
// argument lists to a free function (direct and array-alias spellings), an
// imported function (mixed local + imported implementors), a class method,
// an interface-dispatch method, and a constructor; list-literal returns
// from a free function (locals boxed at the return site, dispatched after
// the callee frame dies) and from a method; mixed interface/concrete
// elements; pointer-to-implementor elements. The look-alike rejections
// (non-implementor, wrong signature, different interface) stay rejected in
// both positions; see tests/fixtures/check_iface_list_arg_misuse and
// tests/fixtures/check_iface_list_return_misuse.
import lib;
from lib import Shape;
from std.io import print, printInt;

type Shapes2 = [Shape; 2];   // array-alias spelling of the interface array

// Local two-field implementor: area 10, kind 2 for w=2, h=5.
class Rect {
  var w: int;
  var h: int;
  func area() -> int { return this.w * this.h; }
  func kind() -> int { return 2; }
}

// Local one-field implementor (different layout AND different tag): area
// 12, kind 3 for b=6.
class Tri {
  var b: int;
  func area() -> int { return this.b * 2; }
  func kind() -> int { return 3; }
}

func sumAreas(shapes: [Shape; 2]) -> int {
  return shapes[0].area() + shapes[1].area();
}

func sumKinds(shapes: Shapes2) -> int {
  return shapes[0].kind() + shapes[1].kind();
}

interface Sink {
  func add(shapes: [Shape; 2]) -> int;
}

class Acc {
  var total: int;
  func add(shapes: [Shape; 2]) -> int {
    this.total = this.total + shapes[0].area() + shapes[1].area();
    return this.total;
  }
}

class Holder {
  func use(shapes: [Shape; 2]) -> int {
    return shapes[0].kind() * 100 + shapes[1].kind();
  }
  func mk(a: int, b: int) -> [Shape; 2] {
    var r: Rect; r.w = a; r.h = b;
    var t: Tri; t.b = a + b;
    return [r, t];
  }
}

class Wrap {
  var pair: [Shape; 2];
  func init(shapes: [Shape; 2]) -> void {
    this.pair = shapes;
  }
  func sum() -> int {
    return this.pair[0].area() + this.pair[1].area();
  }
}

// Return position over locals: the elements name this frame, so the return
// site must box them (CIDER-BUG-202) for dispatch after return to work.
func mkpair() -> Shapes2 {
  var s: lib.Sq; s.side = 6;      // area 36, kind 1
  var r: Rect; r.w = 2; r.h = 5;  // area 10, kind 2
  return [s, r];
}

func main() -> int {
  var r: Rect; r.w = 2; r.h = 5;  // area 10, kind 2
  var t: Tri; t.b = 6;            // area 12, kind 3
  var s: lib.Sq; s.side = 7;      // area 49, kind 1

  // Argument position: free functions, direct and alias spellings.
  if (sumAreas([r, t]) != 22) { return 1; }
  if (sumKinds([t, r]) != 5) { return 2; }
  // Argument position: imported callee, mixed local + imported elements.
  if (lib.total([r, s]) != 59) { return 3; }
  // Argument position: class method.
  var h: Holder;
  if (h.use([s, t]) != 103) { return 4; }
  // Argument position: interface dispatch.
  var sink: Sink = new Acc;
  if (sink.add([t, s]) != 61) { return 5; }
  if (sink.add([r, r]) != 81) { return 6; }
  // Argument position: constructor.
  var w: *Wrap = new Wrap([s, r]);
  if (w->sum() != 59) { return 7; }
  // Argument position: mixed interface/concrete elements.
  var i: Shape = t;
  if (sumAreas([i, r]) != 22) { return 8; }
  // Argument position: pointer-to-implementor elements.
  var pr: *Rect = &r;
  var ps: *lib.Sq = &s;
  if (sumAreas([pr, ps]) != 59) { return 9; }
  if (sumKinds([ps, pr]) != 3) { return 10; }
  // Return position: free function and method; dispatch after return.
  var p: Shapes2 = mkpair();
  if (p[0].area() + p[1].area() != 46) { return 11; }
  if (p[0].kind() * 100 + p[1].kind() != 102) { return 12; }
  var q: [Shape; 2] = h.mk(3, 4);
  if (q[0].area() + q[1].area() != 26) { return 13; }
  if (q[0].kind() * 100 + q[1].kind() != 203) { return 14; }

  printInt(sumAreas([r, t])); print(",");
  printInt(lib.total([s, t])); print(",");
  printInt(p[0].area() + p[1].area()); print(",");
  printInt(q[0].area() + q[1].area()); print("\n");
  print("interface_list_arg_return_ok\n");
  return 0;
}
