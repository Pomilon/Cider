// CIDER-CHORE-003: std.result expect() failure path. expect prints the
// caller's message and exits 1; the triple-differential harness pins the
// exact stdout, empty stderr and exit code for all three backends.
from std.result import Result, err, expect;

func main() -> int {
    var r: Result<int, string> = err::<int, string>("missing value");
    var v: int = expect::<int, string>(&r, "expect failed: missing value");
    return v; // unreachable: expect exits 1 first
}
