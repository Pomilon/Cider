// A cast to a *func(...) type with the exact same signature keeps working
// and stays callable with the target's spelling. Pinned three ways (VM
// unopt, VM opt, native):
//   - a named function's address cast to the direct *func(...) spelling,
//   - the same cast through a `type` alias, with aliased nested
//     parameter/return spellings,
//   - a *func(...) variable cast to an alias spelling,
//   - a closure object (func(...) spelling) called through its own shape,
//   - the msabi spelling, cast with a matching msabi source.
//
// The v2 program also cast a closure object (CIDER-BUG-068's runtime shape)
// to the raw fn(...) pointer spelling and called it through that. v3 keeps
// the two shapes distinct — func(...) is a callable value, *func(...) a
// pointer to one — so that cast is a principled refusal now and the line
// was dropped instead of being blessed.
from std.io import print, printInt;

type Cb = *func(int) -> int;
type MyInt = int;
type AliasCb = *func(MyInt) -> MyInt;

func inc(x: int) -> int { return x + 1; }
msabi func incMs(x: int) -> int { return x + 2; }

func main() -> int {
  // Direct identical signature.
  var f: *func(int) -> int = &inc;
  printInt(f(41)); print("\n");

  // Alias target (nested alias spellings resolve before comparison).
  var g: AliasCb = &inc as AliasCb;
  printInt(g(9)); print("\n");

  // A *func(...) value cast to the alias spelling.
  var h: Cb = f as Cb;
  printInt(h(1)); print("\n");

  // A closure object, called through its own spelling.
  var c: func(int) -> int = func(x: int) -> int { return x * 2; };
  printInt(c(21)); print("\n");

  // Compatible msabi cast.
  var m: *msabi func(int) -> int = &incMs as *msabi func(int) -> int;
  printInt(m(40)); print("\n");

  return 0;
}
