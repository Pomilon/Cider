// CIDER-FEAT-002: an exported enum used from another module. The enum is
// a distinct type (`lib.Shape`); its variants are reachable qualified
// (`lib.Shape.CIRCLE`), as a bare exported constant (`lib.CIRCLE`) and, in
// this module's own scope, bare (`CIRCLE`).
export enum Shape { CIRCLE, SQUARE, TRIANGLE }

// A `type` alias of an enum is a usable qualifier too
// (`lib.ShapeAlias.SQUARE`), rooting its bare target in this module.
export type ShapeAlias = Shape;

// An enum-typed struct field: layout must use the int-sized underlying
// value (4 bytes), not the 8-byte unknown-nominal default.
export struct Tagged {
    var shape: Shape;
}

// Enum parameter and enum -> int return conversion.
export func shapeCode(s: Shape) -> int { return s as int; }
