// CIDER-BUG-085: an imported fn(...) spelling whose parameter is an
// imported interface must match the imported function's collected
// signature (the canonical `lib::Shape` nominal is the same on both
// sides, and both carry the fat-pointer flag).
export interface Shape {
  func area() -> int;
}

export class Sq {
  var side: int;
  func init(v: int) -> void { this.side = v; }
  func area() -> int { return this.side * this.side; }
}

export func areaOf(x: Shape) -> int { return x.area(); }
