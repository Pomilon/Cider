// CIDER-BUG-154: an UNCAUGHT throw still runs the frame's scope exits
// before reporting the error. The finalizer bytes reach stdout first (the
// VM buffers them, native writes raw syscalls), then stderr carries
// `vm error: uncaught exception`, exit 2 — identical on all three paths
// (VM unopt, VM optim, native).
//
// The throw is raised in main itself, so every pending scope of the
// throwing frame is covered: locals, an embedded class value, a by-value
// return temporary and a defer. An uncaught throw raised in a CALLEE only
// unwinds that callee's frame — the callers are abandoned without their
// exits (the documented intermediate-frame limitation, see
// throw_finalizer_gaps).
from std.io import print, printInt;

var drops: int = 0;

class D {
    var label: int;
    func ~D() {
        drops = drops + 1;
        printInt(this.label);
        print(",");
    }
}

struct SW { var d: D; }

func mk(n: int) -> D {
    var d: D;
    d.label = n;
    return d;
}

func main() -> int {
    var a: D;
    a.label = 1;
    var s: SW;
    s.d.label = 2;
    var t: D = mk(3);       // mk's local prints 3 on return, before the throw
    defer { print("d;"); }
    throw 9;
}
