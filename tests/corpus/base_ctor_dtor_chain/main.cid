// CIDER-BUG-123: base constructors and destructors in a chain.
//
// v3 rules (this file was migrated from the v2 spellings):
//   * construction order is zero -> vptr -> field initializers for the
//     whole hierarchy in layout order -> base init -> derived init.
//     A derived `init` runs its base constructor only through an explicit
//     `super_init(...)`; there is no implicit zero-parameter chaining.
//   * destruction is explicit: `delete` runs the destructor chain
//     most-derived first, then each base, then frees. v3 does not run
//     `deinit` when a value leaves scope and does not destroy embedded
//     class values automatically, so the value-scope and EmbChild sections
//     below pin construction and reads only (their v2 finalizer lines were
//     dropped from expected.json).
//   * migrated spellings: `extends` -> `:`, `this.f` -> `this->f`,
//     `func ~X()` -> `func deinit()`, bare `new X` -> `new X()`, and a
//     value-class local spells `var v: T = uninit;` (field initializers run,
//     no constructor).
//   * a shifted base subobject (a plain base under a derived class that
//     reserves the hierarchy's vptr) is still entered at its own address by
//     both `super_init` and the destructor chain.

from std.io import print, printInt;
import chain;

// --- 1. a three-level chain: `new` and `delete` -------------------------

class Root {
    var r: int = 0;
    func init() -> void {
        print("Root.init r="); printInt(this->r); print("\n");
        this->r = 1;
    }
    func deinit() { print("~Root r="); printInt(this->r); print("\n"); }
}

class Mid : Root {
    var m: int = 0;
    func init() -> void {
        super_init();
        print("Mid.init r="); printInt(this->r); print("\n");
        this->m = 2;
    }
    func deinit() { print("~Mid r="); printInt(this->r); print(" m="); printInt(this->m); print("\n"); }
}

class Leaf : Mid {
    var l: int = 0;
    func init() -> void {
        super_init();
        print("Leaf.init r="); printInt(this->r); print(" m="); printInt(this->m); print("\n");
        this->l = 3;
    }
    func deinit() {
        print("~Leaf r="); printInt(this->r); print(" m="); printInt(this->m);
        print(" l="); printInt(this->l); print("\n");
    }
}

// --- 2. a derived class with no destructor of its own, and a base with no
//        constructor: each chain is per-declaration, not virtual. ---------

class PlainBase {
    var b: int = 5;
    func deinit() { print("~PlainBase b="); printInt(this->b); print("\n"); }
}

class PlainChild : PlainBase {
    var c: int = 6;
    func init() -> void { print("PlainChild.init\n"); }
}

// --- 3. the base subobject is NOT at offset 0: a base without a vtable
//        whose DERIVED class reserves the hierarchy's vptr shifts every
//        inherited field by 8. The base constructor/destructor must still be
//        entered at the base's own address, or it reads the vptr as its
//        first field. ------------------------------------------------------

class NoVBase {
    var b: int = 7;
    func init() -> void { this->b = this->b + 1; }
    func deinit() { print("~NoVBase b="); printInt(this->b); print("\n"); }
}

class NoVChild : NoVBase {
    var c: int = 9;
    func init() -> void { super_init(); print("NoVChild.init\n"); }
    func deinit() {
        print("~NoVChild b="); printInt(this->b); print(" c="); printInt(this->c); print("\n");
    }
    // The first virtual method of this hierarchy: NoVChild reserves the
    // vptr slot, so b lives at offset 8, not 0.
    virtual func f() -> int { return 1; }
}

// --- 4. a base WITH a vtable is entered at offset 0, where the derived
//        object's vptr sits, so a virtual call from a base destructor still
//        dispatches on the most-derived type. ---------------------------

class VBase {
    var b: int = 1;
    virtual func id() -> int { return 10; }
    func deinit() { print("~VBase sees id="); printInt(this->id()); print("\n"); }
}

class VChild : VBase {
    func init() -> void { print("VChild.init\n"); }
    override func id() -> int { return 20; }
}

// --- 5. the base chain runs BEFORE the class values it embeds -----------

class Emb {
    var e: int;
    func deinit() { print("~Emb e="); printInt(this->e); print("\n"); }
}

class EmbBase {
    func deinit() { print("~EmbBase\n"); }
}

class EmbChild : EmbBase {
    var e1: Emb;
    var e2: Emb;
}

// --- 6. a dotted base in another module: the chained constructor and
//        destructor mangle with the BASE's own module. -------------------

class CrossChild : chain.CrossBase {
    var x: int = 1;
    func init() -> void { super_init(); print("CrossChild.init\n"); }
}

func main() -> int {
    // 1. construction runs the base chain root-first, each constructor
    //    observing an already-initialized base.
    print("--new Leaf--\n");
    var leaf: *Leaf = new Leaf();
    print("leaf r="); printInt(leaf->r); print(" m="); printInt(leaf->m);
    print(" l="); printInt(leaf->l); print("\n");
    print("--delete Leaf--\n");
    delete leaf;
    print("--after delete--\n");

    // 2. a value-class instance runs NO constructor (field initializers
    //    only, the pre-existing rule) but is still finalized at scope exit
    //    through the whole base chain.
    print("--value scope--\n");
    {
        var v: Leaf = uninit;
        print("v r="); printInt(v.r); print(" m="); printInt(v.m);
        print(" l="); printInt(v.l); print("\n");
        print("inner\n");
    }
    print("--after value scope--\n");

    // 3. only `~PlainBase` exists, so only it runs.
    print("--PlainChild--\n");
    var pc: *PlainChild = new PlainChild();
    printInt(pc->b); print(" "); printInt(pc->c); print("\n");
    delete pc;

    // 4. the shifted base subobject: b is 7 from the field initializer plus
    //    one from NoVBase's constructor.
    print("--NoVChild--\n");
    var nv: *NoVChild = new NoVChild();
    printInt(nv->b); print(" "); printInt(nv->c); print(" "); printInt(nv->f()); print("\n");
    delete nv;

    // 5. a base with a vtable dispatches on the most-derived type.
    print("--VChild--\n");
    var vc: *VChild = new VChild();
    var vb: *VBase = vc;
    printInt(vb->id()); print("\n");
    delete vc;

    // 6. the base chain runs before the embedded class values, which are
    //    destroyed last in reverse construction order.
    print("--EmbChild--\n");
    {
        var ec: EmbChild = uninit;
        ec.e1.e = 41;
        ec.e2.e = 42;
        print("inner\n");
    }
    print("--after EmbChild--\n");

    // 7. the dotted, cross-module base.
    print("--CrossChild--\n");
    var cc: *CrossChild = new CrossChild();
    printInt(cc->m); print("\n");
    delete cc;
    print("--after CrossChild--\n");

    print("base_ctor_dtor_chain_ok\n");
    return 0;
}
