// CIDER-BUG-056: `==`/`!=` on two `string` values compares contents
// (strcmp semantics), while explicit pointer types keep identity
// comparison and `s + n` stays an interior-pointer operation.
func make_hello() -> string {
  return "hello";
}

func main() -> int {
  // Identical literal spellings fold.
  if (!("hi" == "hi")) { return 1; }
  if ("hi" != "hi") { return 2; }

  // Different literal contents compare unequal.
  if ("hi" == "ho") { return 3; }
  if (!("hi" != "ho")) { return 4; }

  // Empty strings.
  if (!("" == "")) { return 5; }
  if ("" == "a") { return 6; }

  // Equal contents through separate variables (runtime comparison).
  var a: string = "hello";
  var b: string = "hello";
  var c: string = "world";
  if (!(a == b)) { return 7; }
  if (a == c) { return 8; }
  if (!(a != c)) { return 9; }

  // Reassignment to another literal changes the content.
  b = "world";
  if (a == b) { return 10; }
  if (!(a != b)) { return 11; }

  // A function-returned string has equal content to a literal.
  b = make_hello();
  if (!(a == b)) { return 12; }
  if (b != a) { return 13; }

  // Interpolated (heap) strings compare by content too.
  var x: int = 42;
  var built: string = "v={x}";
  if (!(built == "v=42")) { return 14; }
  if (built != "v=42") { return 15; }

  // nilPtr checks stay pointer checks.
  if (a == nilPtr) { return 16; }
  var n: string = nilPtr as string;
  if (n != nilPtr) { return 17; }

  // Explicit *u8 comparisons stay pointer-identity checks: two literals
  // with the same bytes live at different addresses.
  var p: *u8 = "hi";
  var q: *u8 = "hi";
  if (p == q) { return 18; }
  var r: *u8 = p;
  if (!(r == p)) { return 19; }
  if (r != p) { return 20; }

  // A nil string compares equal to another nil string and unequal to a
  // real string, without dereferencing the null pointer.
  var m: string = nilPtr as string;
  if (!(n == m)) { return 21; }
  if (n == "x") { return 22; }
  if ("x" == n) { return 23; }

  return 0;
}
