// CIDER-BUG-124 regression: `extends` accepts module-qualified spellings
// exactly like every other type position. Covered here:
//   - a direct dotted base (`class A extends qlib.Base`)
//   - a dotted base that is itself derived (`class B extends mid.Mid`), so
//     pointer covariance across the two-level dotted chain
//   - a dotted ALIAS spelling resolving to the class (`mid.MidBase`)
//   - a from-import base (the pre-existing spelling) as the control
//   - inherited fields (including a transitive private base's field),
//     inherited plain/virtual methods, overrides calling super, dispatch
//     through a dotted base pointer, and a dotted `new` type
// Migrated to v3: `extends` spells `:`, a bare `new X` spells
// `new X { }`, and flat base packing gives sizeof(A/B/C/D) =
// 24/24/24/24 where v2 pinned 24/28/24/28; dispatch, inherited
// fields and overrides are unchanged.
import qlib;
import mid;
from mid import Mid;
from std.io import printInt, print;

class A : qlib.Base {
  var aTag: int = 30;
  override func score() -> int { return super.score() + 3; }
}

class B : mid.Mid {
  var bTag: int = 40;
  override func score() -> int { return super.score() + 4; }
}

class C : mid.MidBase {
  var cTag: int = 50;
  override func score() -> int { return super.score() + 5; }
}

class D : Mid {
  var dTag: int = 60;
  override func score() -> int { return super.score() + 6; }
}

func main() -> int {
  var base: *qlib.Base = new qlib.Base(11);
  printInt(base->tag); print(",");            // 11
  printInt(base->score()); print(",");        // 1
  printInt(base->baseOnly()); print(",");     // 11 + 7
  printInt(base->hiddenTag); print(",");      // 7  transitive private field
  printInt(base->hiddenScore()); print(",");  // 100 inherited virtual

  var a: *A = new A { };
  a->tag = 12;
  printInt(a->aTag); print(",");              // 30
  printInt(a->baseOnly()); print(",");        // 12 + 7
  printInt(a->score()); print(",");           // 1 + 3
  base = a;                                   // *A -> *qlib.Base
  printInt(base->score()); print(",");        // 4 dispatch through base

  var b: *B = new B { };
  b->tag = 13;
  printInt(b->midTag); print(",");            // 20 inherited from mid.Mid
  printInt(b->score()); print(",");           // 1 + 10 + 4
  var mb: *qlib.Base = b;                     // two dotted levels of covariance
  printInt(mb->score()); print(",");          // 15 dispatch
  var m: *mid.Mid = b;
  printInt(m->score()); print(",");           // 15

  var c: *C = new C { };
  c->tag = 14;
  printInt(c->score()); print(",");           // 1 + 5 alias-spelled base
  printInt(c->hiddenTag); print(",");         // 7
  var cb: *qlib.Base = c;
  printInt(cb->score()); print(",");          // 6

  var d: *D = new D { };
  d->tag = 15;
  printInt(d->score()); print(",");           // 1 + 10 + 6 from-import control
  printInt(sizeof(A)); print(",");
  printInt(sizeof(B)); print(",");
  printInt(sizeof(C)); print(",");
  printInt(sizeof(D)); print("\n");
  return 0;
}