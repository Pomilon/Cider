// CIDER-BUG-124 regression library. `Hidden` is private to this module and
// is named only through the module's own self-qualified base spelling
// (`qlib.Hidden`): intra-module use is unrestricted even though no other
// module may name it (CIDER-BUG-060 visibility). The spelling is also a
// forward reference while this body is collected (the importer binds `qlib`
// only afterwards), so CIDER-BUG-120's post-collection finalization must
// merge the base — fields, methods and vtable.
class Hidden {
  var hiddenTag: int = 7;
  virtual func hiddenScore() -> int { return 100; }
}

export class Base : qlib.Hidden {
  var tag: int = 10;
  func init(v: int) -> void { this->tag = v; }
  virtual func score() -> int { return 1; }
  func baseOnly() -> int { return this->hiddenTag + this->tag; }
}