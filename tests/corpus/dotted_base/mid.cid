// CIDER-BUG-124: `MidBase` is an alias whose target spelling (`qlib.Base`)
// is written HERE, so the alias chain must resolve in mid's own module even
// when the ultimate use site never spells `qlib` in that position. `Mid`
// itself extends a dotted base.
import qlib;

export type MidBase = qlib.Base;

export class Mid : qlib.Base {
  var midTag: int = 20;
  override func score() -> int { return super.score() + 10; }
}