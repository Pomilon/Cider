// CID-006 fix round 1 (F1): `type A = B` alias chains must classify and
// size as the base type on every backend. The local copies used to take a
// by-value MEMCPY from the value-as-address (native SIGSEGV); the non-fn
// chain read a garbage size off the alias symbol.
// Migrated to v3: the function-value type spells `func(int) -> int`
// (closure value); a named function converts to it, and alias chains
// classify and size exactly as the base type.
type FnBase = func(int) -> int;
type FnChain = FnBase;

type IntBase = int;
type IntChain = IntBase;

func inc(a: int) -> int { return a + 1; }

// Module-scope alias-chain global: emitted as a .data cell (the VM cell
// materializes in the Task 4 dq pass, so this one is unused here and all
// three backends can still run).
var unusedG: FnChain = inc;

func main() -> int {
    var f: FnChain = inc;             // alias-chain local copy of a function
    var g: func(int) -> int = f;        // direct spelling from a chained value
    var x: IntChain = 5;              // non-fn chain: sizes/stores like int
    var y: int = x;
    return g(10) + f(1) + x + y;      // 11 + 2 + 5 + 5 = 23
}
