// CIDER-BUG-212: the aggregate type carrying the interface field, the
// interface itself, the implementor, and the returning function are all
// declared and exported from an IMPORTED module, and only the call site and
// the dispatch are in the entry file.
//
// The layout walk has to root each field's type spelling in the module the
// field was DECLARED in (CIDER-BUG-090's rule, threaded the way ir_gen's
// fieldTypeModule threads it): a bare `Shape` written in `lib` must resolve
// against lib's scope, not the entry file's, or the embedded interface is
// invisible and the returned field dangles exactly as it does in one file.
export interface Shape {
  func area() -> int;
  func kind() -> int;
}

export class Sq {
  var side: int;
  func area() -> int { return this.side * this.side; }
  func kind() -> int { return 1; }
  func ~Sq() { }
}

export struct Holder { var s: Shape; var tag: int; }
export struct Inner { var s: Shape; }
export struct Outer { var in: Inner; var tag: int; }

export func localHolder() -> Holder {
  var s: Sq; s.side = 3;
  var i: Shape = s;
  var h: Holder; h.s = i; h.tag = 3;
  return h;
}

export func nestedOuter() -> Outer {
  var s: Sq; s.side = 4;
  var i: Shape = s;
  var o: Outer; o.in.s = i; o.tag = 5;
  return o;
}
