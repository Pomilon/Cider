// CIDER-ISS-011: prefix-compatible interface projections copy the existing
// data/vtable fat pointer and remain valid for dispatch and boxed-value cleanup.
// Migrated to v3: constructors/destructors spell `init()`/`deinit()` and
// deinit runs only through explicit `delete`; v3 does not finalize scope
// values or owned interface boxes, so this stays B-terminal and the v2
// drop count is not blessed. `this.` spells `this->`; value locals spell
// `uninit`.
var drops: int = 0;

interface Read {
  func read() -> int;
}

interface ReadWrite {
  func read() -> int;
  func write() -> int;
}

class Record {
  var value: int;
  func deinit() { drops = drops + 1; }
  func read() -> int { return this->value; }
  func write() -> int { return this->value + 1; }
}

func narrow(value: ReadWrite) -> Read { return value; }
func consume(value: Read) -> int { return value.read(); }

func makeRecord() -> ReadWrite {
  var value: Record = uninit;
  value.value = 40;
  return value;
}

func main() -> int {
  {
    var wide: ReadWrite = makeRecord();
    var narrowValue: Read = wide;
    if (narrowValue.read() != 40) { return 1; }

    narrowValue = wide;
    if (consume(narrowValue) != 40) { return 2; }

    var castValue: Read = wide as Read;
    if (castValue.read() != 40) { return 3; }

    var returned: Read = narrow(wide);
    if (returned.read() != 40) { return 4; }
  }
  // The returned boxed value's concrete destructor runs once for the callee
  // local and once for the owned box, despite the interface projections.
  if (drops != 2) { return 5; }
  return 0;
}
