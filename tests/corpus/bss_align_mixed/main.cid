// CIDER-BUG-132: .bss globals of heterogeneous natural alignment. Codegen
// must pad aligned .bss globals with reserved space (NASM `alignb`) so the
// object assembles without "attempt to initialize memory in BSS section",
// while the VM zero-fills the same layout. The symbol offsets are pinned by
// tests/unit/bss_align_smoke.sh.
var g8: u8 = 0;         // @ 0x00
var g32: u32 = 0;       // @ 0x04 (align 4 pads 3 bytes)
var g64: u64 = 0;       // @ 0x08
var tail: u8 = 0;       // @ 0x10
var g64b: u64 = 0;      // @ 0x18 (align 8 pads 7 bytes)
var init: i32 = 42;     // .data, initialized path unchanged

func main() -> int {
  g8 = 0xF0;
  g32 = 0x12345678;
  g64 = 0x1122334455667788;
  tail = 0x5A;
  g64b = 0x8877665544332211;
  if (g8 != 0xF0) { return 1; }
  if (g32 != 0x12345678) { return 2; }
  if (g64 != 0x1122334455667788) { return 3; }
  if (tail != 0x5A) { return 4; }
  if (g64b != 0x8877665544332211) { return 5; }
  if (init != 42) { return 6; }
  return 0;
}
