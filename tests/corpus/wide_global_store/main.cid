// CIDER-BUG-248: a global store must write at the width of the store
// instruction, which for a global is the cell's declared width, on the VM
// and on native.
//
// Root cause. The VM forced every LABEL-base STORE to 8 bytes ("global
// cells are 8 bytes", vm.cpp) — the exact mirror of the load rule
// CIDER-BUG-245 removed. The premise is false in both directions: a global
// cell is its declared type's width in .bss (`resb totalBytes`, Issue
// #20/11), which is 1 byte for a `u8` and 16 for an interface's fat
// pointer or a 2-word struct. A forced 8-byte store therefore truncated
// every wide aggregate store to its first word — silently, because the
// dropped second word then read back as whatever the cell held before (a
// stale vtable for an interface, a stale second half for a struct) — while
// a narrow store wrote 7 bytes past the cell native reserves as `resb 1`.
// Native was already consistent: it sizes a global store by the global's
// declared width (`globalTypes` in codegen.cpp), and ir_gen casts the
// right-hand side to the target's declared type first, so the instruction
// width the VM now follows is that same declared width.
//
// Honest scope: the truncation is latent, not live. The IR has no 16-byte
// store type, so ir_gen lowers every wide aggregate store to per-word
// stores or a MEMCPY (CIDER-BUG-238 and friends), verified by dumping the
// IR of every wide-global store shape. So this program pins the behavior
// in both directions rather than reproducing today's truncation: it fails
// the moment the width stops following the instruction. The pin that does
// fail without the fix is the IR-level case in vm_test.
//
// Pinned on all three backends (VM unoptimized, VM optimized, native):
//   * 16-byte struct globals written and read back through both halves;
//   * 16-byte interface globals written and DISPATCHED (both methods, two
//     implementors with different vtables) — the vtable word must land;
//   * narrow globals (u8, u16, bool, float, i32, i64) written and read
//     back, including negative and 200+-valued i32/i64 stores that only
//     round-trip if the width is right;
//   * every global re-read after each round, so a store wider than its cell
//     (or narrower, losing the top word) shows up as a corrupted value in
//     the global declared next to it;
//   * both spellings (from-alias and module-qualified) and by-value
//     arguments, so the pin does not depend on how the global is named.
//
// The narrow globals are declared interleaved with the wide ones in
// lib.cid precisely so a wrong width is caught in both directions. The
// checker keeps the other half honest: `bool = <i64>` and friends are
// rejected, so no well-typed program can read a narrow global's cell at a
// width its declaration does not have.
import lib;
from std.io import printInt, printF64;
from lib import gU8, gU16, gFlag, gF32, gI32, gI64, gBig1, gBig2, gShape1, gShape2,
           gBox, gPeb;

// Both halves of a 16-byte struct must survive a by-value call.
func takeBig(b: lib.Big) -> i64 {
  return b.a * 100 + b.b;
}

// Both words of an interface must survive: the vtable word is what the
// dispatch indexes.
func takeShape(s: lib.Shape) -> int {
  return s.area() * 10 + s.tag();
}

// Every global, checked in one place so each round can assert the full
// state after mixing wide and narrow stores.
func checkAll(tag: int) -> int {
  if (gU8 != 201) { return tag * 10 + 1; }
  if (gU16 != 60001) { return tag * 10 + 2; }
  if (!gFlag) { return tag * 10 + 3; }
  if (gF32 != 0.5) { return tag * 10 + 4; }
  if (gI32 != 0 - 2) { return tag * 10 + 5; }
  if (gI64 != 0 - 3) { return tag * 10 + 6; }
  if (lib.gBig1.a != 11 || lib.gBig1.b != 12) { return tag * 10 + 7; }
  if (lib.gBig2.a != 21 || lib.gBig2.b != 22) { return tag * 10 + 8; }
  // Dispatch reads the vtable word out of the global, so a truncated
  // interface store shows up as a wrong tag, not as a silent pass.
  if (lib.gShape1.area() != 42 || lib.gShape1.tag() != 7) { return tag * 10 + 9; }
  if (lib.gShape2.area() != 31 || lib.gShape2.tag() != 9) { return tag + 90; }
  return 0;
}

// The same check through the from-alias spelling of every global.
func checkAllAliased(tag: int) -> int {
  if (gBig1.a != 11 || gBig1.b != 12) { return tag * 10 + 1; }
  if (gBig2.a != 21 || gBig2.b != 22) { return tag * 10 + 2; }
  if (gShape1.area() != 42 || gShape1.tag() != 7) { return tag * 10 + 3; }
  if (gShape2.area() != 31 || gShape2.tag() != 9) { return tag * 10 + 4; }
  if (gU8 != 201) { return tag * 10 + 5; }
  if (gU16 != 60001) { return tag * 10 + 6; }
  return 0;
}

func main() -> int {
  // --- object payloads ----------------------------------------------------
  lib.gBox.v = 21;
  lib.gPeb.w = 30;

  // --- round 1: wide stores, then the narrow ones between them ----------
  // A 16-byte struct written field by field: both halves, through the
  // bare and the qualified spelling.
  lib.gBig1.a = 11;
  lib.gBig1.b = 12;
  gBig2.a = 21;
  gBig2.b = 22;
  // A 16-byte interface global: the data word and the vtable word.
  gShape1 = gBox;
  lib.gShape2 = gPeb;
  // Narrow stores, each landing next to a wide global. `gU8 = 201` and
  // `gI32 = -2` only read back right if the store is sized by the
  // instruction, and the wide globals either side only stay intact if the
  // narrow store does not run past its own cell.
  gU8 = 201;
  gU16 = 60001;
  gFlag = true;
  gF32 = 0.5;
  gI32 = 0 - 2;
  gI64 = (0 - 3) as i64;

  var bad: int = checkAll(1);
  if (bad != 0) { return bad; }
  bad = checkAllAliased(1);
  if (bad != 0) { return bad; }
  printInt(takeShape(gShape1));        // 427
  printInt(takeBig(gBig1) as int);            // 1112
  printInt(takeShape(lib.gShape2));    // 319
  printInt(takeBig(gBig2) as int);            // 2122

  // --- round 2: whole-value stores into both directions -------------------
  // Assign a struct and an interface by value, so each wide global is
  // rewritten as a value copy rather than field by field.
  var localBig1: lib.Big = lib.Big { a: 11, b: 12 };
  var localBig2: lib.Big = lib.Big { a: 21, b: 22 };
  var localShape: lib.Shape = gBox;
  var localPebble: lib.Shape = gPeb;
  gBig1 = localBig1;
  lib.gBig2 = localBig2;
  gShape2 = localPebble;
  lib.gShape1 = localShape;
  // Rewrite every narrow global too: a narrow store must not disturb the
  // wide globals it sits between, and vice versa.
  gU8 = 201;
  lib.gF32 = 0.5;
  gI64 = (0 - 3) as i64;

  bad = checkAll(2);
  if (bad != 0) { return bad; }
  bad = checkAllAliased(2);
  if (bad != 0) { return bad; }

  // --- round 3: a global-to-global wide copy, then a relabel -------------
  gShape1 = gShape2;
  gBig2 = gBig1;
  gU16 = 60001;
  gFlag = true;
  gI32 = 0 - 2;

  // The copy moved the second implementor's vtable into gShape1.
  if (gShape1.area() != 31 || gShape1.tag() != 9) { return 30; }
  if (gShape2.area() != 31 || gShape2.tag() != 9) { return 31; }
  if (gBig2.a != 11 || gBig2.b != 12) { return 32; }
  if (gBig1.a != 11 || gBig1.b != 12) { return 33; }

  // --- the narrow globals themselves, printed -----------------------------
  printInt(gU8 as int);                        // 201
  printInt(gU16 as int);                       // 60001
  if (gFlag) { printInt(1); } else { printInt(0); }
  printF64(gF32 as f64);                // 0.500000
  printInt(gI32);                       // -2
  printInt(gI64 as int);                       // -3
  printInt((gBig1.a * 100 + gBig1.b) as int);    // 1112
  printInt(gShape1.area() * 10 + gShape1.tag()); // 319
  return 0;
}