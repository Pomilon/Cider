// CIDER-BUG-228: DECLARATION ORDER must not decide whether a global is usable.
//
// Root cause: the IR generator bound each module-scope variable's global name
// only as the single source-order walk REACHED its declaration, so a use
// generated before that declaration could not resolve the name. The failure
// mode then depended on which shape reached the missing name:
//   * a WRITE (`gX += 1`, or any assignment target) indexed
//     `globalValues_[key]` with std::map::operator[], which default-inserts an
//     IRValue whose `kind` is uninitialized (ir.h). The result was a null
//     address, so the emitted code was `mov eax, dword [0 + 0]` — the VM
//     reported "load: null pointer dereference" and native code died with
//     SIGSEGV, on BOTH backends and with no diagnostic at all.
//   * a READ fell through to the "cannot resolve identifier" reporter error
//     inside IR generation, which is the wrong phase: `cider check` returned 0
//     and only `cider run`/`cider compile` ever saw the message.
//
// The rule chosen here: globals are FORWARD-VISIBLE, exactly like functions
// (mutual recursion already works, and the collector already resolves const
// initializers order-independently). Nothing in the surface forward-declares a
// global, so making declaration order irrelevant is the coherent option; the
// alternative — a located "undefined identifier" — would have made globals the
// one name kind in the language that must be declared before use. The fix
// hoists only the NAME -> label binding of every module-scope variable into a
// pre-pass (IrGenerator::predeclareModuleGlobals) ahead of body generation; the
// declaration still owns the storage, and the unresolvable-target path in
// visit(AssignStmt&) now reports instead of storing through a null address, so
// the silent nil-load/segfault path no longer exists.
//
// This program pins the VALUES on all three backends (VM unoptimized, VM
// optimized, native). The genuinely-undefined-global diagnostic is pinned
// separately by tests/fixtures/check_undeclared, which must keep reporting
// "Undefined identifier" for a name that no declaration binds.
import global_decl_order_lib;
from std.io import print;
from global_decl_order_lib import LibStruct, libLate, bumpLib, gLibLate;

// ---- the two shapes the ticket reported ----------------------------------
// A READ of a global declared after this function (the "ir error: cannot
// resolve identifier" half).
func readLate() -> int {
  return gReadLate;
}

// A WRITE to a global declared after this function (the nil-deref/SIGSEGV
// half). `+=` is the compound shape the ticket named; the plain `=` and the
// `++` are separate write shapes through the same assignment-target path, and
// all three run from a function declared before the global.
func bumpLate() -> int {
  gBumpLate += 5;
  gBumpLate = gBumpLate + 0;
  gBumpLate++;
  return gBumpLate;
}

// A global's ADDRESS taken before its declaration: getAddress() reaches the
// same binding, so this pins that path too rather than only the load/store one.
func addrLate() -> int {
  var p: *int = &gReadLate;
  return *p + 1;
}

// ---- a non-scalar global: array storage, indexed and mutated --------------
func fillLate() -> int {
  var i: int = 0;
  while (i < 4) {
    gArrLate[i] = gArrLate[i] + 10;
    i = i + 1;
  }
  return gArrLate[0] + gArrLate[3];
}

// ---- a global struct, field-written and field-read before declaration ----
func touchFields() -> int {
  gPointLate.x = 7;
  gPointLate.y = gPointLate.x + 3;
  return gPointLate.x * 100 + gPointLate.y;
}

// ---- a `const` global, declared BELOW the function that reads it ----------
// A distinct path from the `var` reads above: visit(IdentifierExpr) folds a
// const to its value only when the name is NOT in globalValues_ (it has no
// storage binding yet), and constValue is 0 for a const *variable*. So a
// forward-referenced const silently read 0 instead of 55 — a wrong value with
// no diagnostic, which is why the const is pinned alongside the vars.
func constLate() -> int {
  return gConstLate;
}

// ---- a global of a struct type declared below it, WRITTEN from above -----
// The type, its layout and its storage all come from declarations below this
// function, so the member assignment must resolve and land in that storage.
func writeDerived() -> int {
  gDerivedLate.x = 33;
  return gDerivedLate.x;
}

// ---- a global of a type from ANOTHER module, declared below --------------
// The type resolution and the storage binding both have to be
// order-independent, and the type is only reachable through a from-import.
func writeLibStruct() -> int {
  gLibStruct.x = 4;
  gLibStruct.y = 5;
  return gLibStruct.x;
}

// ---- the order-independent control: declared before use ------------------
var gControl: int = 100;

func useControl() -> int {
  gControl += 1;
  return gControl;
}

// ---- mutual recursion through a late global ------------------------------
func isEven(n: int) -> bool {
  if (n == 0) { return true; }
  return isOdd(n - 1);
}

func isOdd(n: int) -> bool {
  if (n == 0) { return false; }
  return isEven(n - 1);
}

func main() -> int {
  // 1. read before declaration
  if (readLate() != 42) { return 1; }
  if (gReadLate != 42) { return 2; }

  // 2. compound write before declaration (the reported nil-deref shape).
  //     gBumpLate starts at 10 and bumpLate does += 5, = +0, ++, so one call
  //     leaves 16 and the next 22.
  if (bumpLate() != 16) { return 3; }
  if (gBumpLate != 16) { return 4; }
  // ...and it must persist, i.e. it really is the one storage
  if (bumpLate() != 22) { return 5; }
  if (gBumpLate != 22) { return 6; }

  // 3. address of a late global
  if (addrLate() != 43) { return 7; }

  // 4. late array global: [1,2,3,4] + 10 per element -> [11,12,13,14], so
  //     first + last is 25.
  if (fillLate() != 25) { return 8; }

  // 5. late struct global's fields
  if (touchFields() != 710) { return 9; }

  // 6. a `const` global read before its declaration
  if (constLate() != 55) { return 10; }

  // 7. a struct global whose TYPE and storage are both declared below
  if (writeDerived() != 33) { return 11; }
  if (gDerivedLate.x != 33) { return 21; }

  // 8. the control: declaration BEFORE use is undisturbed
  if (useControl() != 101) { return 12; }
  if (gControl != 101) { return 13; }

  // 9. mutual recursion, which depends on the late global's value
  if (!isEven(10)) { return 14; }

  // 10. cross-module: a below-declared EXPORTED global in ANOTHER module,
  //     read and compound-written through a from-import alias. The binding
  //     must be visible to another file, not just inside the declaring one.
  if (gLibLate != 21) { return 15; }
  if (bumpLib() != 22) { return 16; }
  if (gLibLate != 22) { return 17; }
  // 11. a global here whose TYPE comes from another module and whose
  //     declaration is below this function: both the type resolution and the
  //     storage binding have to be order-independent.
  if (writeLibStruct() != 4) { return 18; }
  if (gLibStruct.x + gLibStruct.y != 9) { return 22; }

  print("global_decl_order_ok\n");
  return 0;
}

// ======================= declarations below every use above ===============
var gReadLate: int = 42;
var gBumpLate: int = 10;
const gConstLate: int = 55;
var gArrLate: [int; 4] = new [int; 4] {1, 2, 3, 4};

// Struct types declared after the functions that use globals OF those types:
// the layout comes from the collector (which has seen every declaration), the
// storage from the declaration, so the two orders must agree.
struct PointLate {
  var x: int;
  var y: int;
}
var gPointLate: PointLate = new PointLate { x: 0, y: 0 };

struct DerivedLate {
  var x: int;
}
var gDerivedLate: DerivedLate = new DerivedLate { x: 0 };

var gLibStruct: LibStruct = new LibStruct { x: 0, y: 0 };
