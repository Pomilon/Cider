// CIDER-BUG-175: `m.Holder{...}` must parse and behave exactly like the
// from-import `Holder{...}` literal: type resolution, export enforcement,
// field checks and literal stores (array fields included, CIDER-BUG-165,
// nested struct literals included). All three backends must agree.
import qlib;
import qwrap;
from qlib import Holder;
from qlib import Inner;

func takeHolder(h: qlib.Holder) -> int {
  return h.x + h.cells[0] + h.cells[1] + h.cells[2] + h.inner.v;
}

func makeLocal() -> qlib.Holder {
  return qlib.Holder{ x: 9, cells: [1, 1, 1], inner: qlib.Inner{ v: 1 } };
}

func main() -> int {
  // Qualified literal: array-field list materialisation and nested literal.
  var h: qlib.Holder = qlib.Holder{ x: 1, cells: [4, 5, 6], inner: qlib.Inner{ v: 7 } };
  if (h.x != 1 || h.cells[0] != 4 || h.cells[1] != 5 || h.cells[2] != 6 ||
      h.inner.v != 7) {
    return 1;
  }

  // From-import literal unchanged; the two spellings share one type.
  var b: Holder = Holder{ x: 2, cells: [7, 8, 9], inner: Inner{ v: 10 } };
  h = b;
  b = h;
  if (b.x != 2 || b.cells[2] != 9 || b.inner.v != 10) { return 2; }

  // Qualified literal as a call argument.
  if (takeHolder(qlib.Holder{ x: 3, cells: [1, 2, 3], inner: qlib.Inner{ v: 4 } }) != 13) {
    return 3;
  }

  // Transitive module: qwrap imports qlib and returns a qualified literal.
  var w: qlib.Holder = qwrap.wrapHolder(5);
  if (w.x != 5 || w.cells[0] != 1 || w.inner.v != 5) { return 4; }

  // The owner module's own self-qualified literal.
  var m: qlib.Holder = qlib.makeHolder(6);
  if (m.x != 6 || m.cells[2] != 8 || m.inner.v != 60) { return 5; }

  // Return position, through the local factory.
  if (makeLocal().x != 9) { return 6; }

  return 0;
}
