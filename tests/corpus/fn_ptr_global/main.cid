func add(a: int, b: int) -> int { return a + b; }
func neg(a: int, b: int) -> int { return b - a; }

var g: fn(int, int) -> int = add;
var h: fn(int, int) -> int = nilPtr;

func main() -> int {
  if (g(2, 3) != 5) { return 1; }
  if (h != nilPtr) { return 2; }
  g = neg;
  if (g(2, 3) != 1) { return 3; }
  return 0;
}
