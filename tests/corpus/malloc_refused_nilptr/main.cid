// CIDER-BUG-193 companion: pins the std.alloc.malloc refusal contract the
// stdlib OOM policy builds on. Sizes < 0 or > 1 GiB (MAX_TOTAL_BYTES) are
// refused with nilPtr cheaply -- no memory is touched -- so grow/reserve
// paths can rely on a nilPtr test. A small request must still succeed.
from std.alloc import malloc;

func main() -> int {
    var neg: *void = malloc(-1);
    if (neg != nilPtr) return 1;
    var huge: *void = malloc(1073741825);
    if (huge != nilPtr) return 2;
    var zero: *void = malloc(0);
    if (zero == nilPtr) return 3;
    var small: *u64 = malloc(32) as *u64;
    if (small == nilPtr) return 4;
    *small = 42;
    if (*small != 42) return 5;
    return 0;
}
