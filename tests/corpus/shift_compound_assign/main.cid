// CIDER-FEAT-008: `<<=` and `>>=` are the compound forms of `<<` / `>>`.
// They must parse, type-check with the same rules as the plain shift, and
// lower to the same LSHIFT/RSHIFT node as the expanded `x = x << n` form —
// so signed vs unsigned right shift (arithmetic vs logical fill) follows the
// existing plain-shift semantics.
//
// Coverage: both operators, both signednesses (i64 arithmetic fill,
// u64/u32 logical fill), narrow targets (u8/i8/u16/i16/u32) that must keep
// the stored width, a variable shift count, equality with the expanded
// form, and every target shape the compound machinery supports (local,
// member, element, pointer deref, global, loop update).
struct Mask { var f: u32; }

var gShift: u32 = 3;

func main() -> int {
  // --- int (32-bit) round trip -------------------------------------------
  var x: int = 1;
  x <<= 4;
  if (x != 16) { return 1; }
  x >>= 2;
  if (x != 4) { return 2; }
  x <<= 1;
  if (x != 8) { return 3; }

  // --- unsigned 64-bit: right shift is logical (zero fill) ---------------
  var u: u64 = 1;
  u <<= 63;
  if (u != 0x8000000000000000) { return 4; }
  u >>= 60;
  if (u != 8) { return 5; }
  var all: u64 = 0xFFFFFFFFFFFFFFFF;
  all >>= 63;
  if (all != 1) { return 6; }
  all <<= 1;
  if (all != 2) { return 7; }

  // --- signed 64-bit: right shift is arithmetic (sign fill) ---------------
  var s: i64 = (0 - 16) as i64;
  s >>= 2;
  if (s != (0 - 4)) { return 8; }
  s <<= 3;
  if (s != (0 - 32)) { return 9; }
  var neg: i64 = (0 - 1) as i64;
  neg >>= 60;
  if (neg != (0 - 1)) { return 10; }
  neg <<= 1;
  if (neg != (0 - 2)) { return 11; }

  // --- narrower widths keep the stored width (a shift does not promote) ---
  var b: u8 = 1;
  b <<= 3;
  if (b != 8) { return 12; }
  b >>= 1;
  if (b != 4) { return 13; }
  var c: i8 = (0 - 8) as i8;
  c >>= 2;
  if (c != (0 - 2)) { return 14; }
  c <<= 3;
  if (c != (0 - 16)) { return 15; }
  var d: u16 = 1;
  d <<= 12;
  if (d != 4096) { return 16; }
  d >>= 4;
  if (d != 256) { return 17; }
  var e: i16 = (0 - 1024) as i16;
  e >>= 4;
  if (e != (0 - 64)) { return 18; }
  e <<= 6;
  if (e != (0 - 4096)) { return 19; }
  var f: u32 = 0x12345678;
  f >>= 8;
  if (f != 0x123456) { return 20; }
  f <<= 4;
  if (f != 0x1234560) { return 21; }

  // --- a variable shift count, in either width ----------------------------
  var n: i64 = 3;
  var w: u8 = 1;
  w <<= 2;
  if (w != 4) { return 22; }
  w <<= (n as u8);              // 8-bit target, 64-bit count
  if (w != 32) { return 23; }
  w >>= 2;
  if (w != 8) { return 24; }
  var big: u64 = 0x8000000000000000;
  big >>= n;
  if (big != 0x1000000000000000) { return 25; }

  // --- identical to the expanded `x = x << n` form -------------------------
  var p1: u32 = 0x0F0F0F0F;
  var p2: u32 = 0x0F0F0F0F;
  p1 <<= 4;
  p2 = p2 << 4;
  if (p1 != p2) { return 26; }
  p1 >>= 8;
  p2 = p2 >> 8;
  if (p1 != p2) { return 27; }
  var q1: i64 = (0 - 123456789) as i64;
  var q2: i64 = (0 - 123456789) as i64;
  q1 >>= 5;
  q2 = q2 >> 5;
  if (q1 != q2) { return 28; }
  q1 <<= 5;
  q2 = q2 << 5;
  if (q1 != q2) { return 29; }

  // --- member, element, pointer-deref and global targets ------------------
  var m: Mask = new Mask { f: 5 };
  m.f <<= 4;
  if (m.f != 80) { return 30; }
  m.f >>= 2;
  if (m.f != 20) { return 31; }

  var arr: [u32; 3] = new [u32; 3] {[1, 2, 3]};
  arr[1] <<= 3;
  if (arr[1] != 16) { return 32; }
  arr[1] >>= 2;
  if (arr[1] != 4) { return 33; }
  arr[0] <<= 1;
  arr[2] >>= 1;
  if (arr[0] != 2 || arr[2] != 1) { return 34; }

  var p: *u32 = &arr[2];
  *p <<= 5;
  if (arr[2] != 32) { return 35; }
  *p >>= 3;
  if (arr[2] != 4) { return 36; }

  gShift <<= 3;
  if (gShift != 24) { return 37; }
  gShift >>= 2;
  if (gShift != 6) { return 38; }

  // --- a loop whose only update is a shift-assign -------------------------
  var acc: u32 = 1;
  for (var i: int = 0; i < 5; i += 1) {
    acc <<= 1;
  }
  if (acc != 32) { return 39; }
  var k: u32 = 1;
  var ones: u64 = 0;
  while (k < 256) {
    ones <<= 1;
    ones += 1;
    k <<= 1;
  }
  if (ones != 255) { return 40; }
  return 0;
}
