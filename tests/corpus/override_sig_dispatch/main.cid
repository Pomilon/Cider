// CIDER-BUG-141 positive control: compatible overrides must still bind
// the base method's vtable slot and dispatch to the derived body. Covers
// an exactly-matching signature, an alias spelling of a parameter type
// (`type Num = int` on one side, `int` on the other — the two spellings
// name one type and must stay a valid override) and a multi-level chain
// where each level overrides the level above it, plus a zero-argument
// virtual and an inherited plain method as controls.
// Migrated to v3: `extends` spells `:`, a bare `new Leaf` spells
// `new Leaf { }`, and the type-alias spelling stays a valid override.
from std.io import print, printInt;

type Num = int;

class Base {
    virtual func score(x: Num) -> int { return x + 1; }
    virtual func label() -> int { return 10; }
    func plain(x: int) -> int { return x * 2; }
}

class Mid : Base {
    override func score(x: int) -> int { return super.score(x) + 100; }
}

class Leaf : Mid {
    override func score(x: Num) -> int { return super.score(x) + 1000; }
    override func label() -> int { return 20; }
}

func main() -> int {
    var l: *Leaf = new Leaf { };
    var b: *Base = l;
    if (b->score(7) != 1108) return 1;   // 7+1, +100, +1000 through the slot
    if (b->label() != 20) return 2;       // leaf overrides a zero-arg virtual
    var m: *Mid = l;
    if (m->score(0) != 1101) return 3;    // dispatch through the mid type
    if (l->plain(4) != 8) return 4;       // inherited plain method untouched
    print("override_sig_ok\n");
    delete l;
    return 0;
}
