// Step 8 breadth: the owning library `String` and library-only formatting.
//
// `String` is explicit test-library code from `std.string`; it allocates
// through `std.alloc` and has no compiler-provided storage or hidden
// destructor. Every cleanup below is an explicit `string_deinit` call.
from std.alloc import malloc, free;
from std.io import print;
from std.string import String, string_new, string_from, string_copy, string_move;
from std.string import string_deinit, string_view, string_data, string_len, string_cap;
from std.string import string_append, string_append_bytes, string_append_byte;
from std.string import string_append_int, string_append_uint, string_append_hex;
from std.string import format_int, format_uint, format_hex;

func main() -> int {
    // The owning type allocates through std.alloc, not a compiler heap.
    // Exercise that explicit surface directly as well.
    var raw: *u8 = malloc(16) as *u8;
    if (raw == nilPtr) { return 1; }
    raw[0] = 7;
    if (raw[0] != 7) { return 2; }
    free(raw as *void);

    // Empty construction: no allocation, empty view, nil data pointer.
    var s: String = string_new();
    if (string_len(&s) != 0) { return 3; }
    if (string_cap(&s) != 0) { return 4; }
    if (string_data(&s) != nilPtr) { return 5; }
    if (string_view(&s) != "") { return 6; }

    // Explicit copy from a non-owning string view.
    var lit: String = string_from("hello");
    if (string_len(&lit) != 5) { return 7; }
    if (string_cap(&lit) < 5) { return 8; }
    if (string_view(&lit) != "hello") { return 9; }
    if (string_data(&lit) == nilPtr) { return 10; }

    // Append a view, one byte, and raw bytes; capacity grows as needed.
    string_append(&s, "hello");
    string_append_byte(&s, 32);
    string_append(&s, "world");
    var bang: [u8; 3] = [33, 33, 33];
    string_append_bytes(&s, &bang[0], 3);
    if (string_len(&s) != 14) { return 11; }
    if (string_cap(&s) < 14) { return 12; }
    if (string_view(&s) != "hello world!!!") { return 13; }

    // Formatting straight into the owning string.
    string_append_byte(&s, 124);
    string_append_int(&s, -42);
    string_append_byte(&s, 124);
    string_append_uint(&s, 42 as u64);
    string_append_byte(&s, 124);
    string_append_hex(&s, 255 as u64);
    if (string_view(&s) != "hello world!!!|-42|42|ff") { return 14; }

    // Formatting into caller-provided storage: signed decimal.
    var buf: [u8; 32] = [0, ...];
    var n: int = format_int(&buf[0], buf.len, -12345);
    if (n != 6) { return 15; }
    if (buf[0] != 45) { return 16; }
    if (buf[1] != 49) { return 17; }
    if (buf[2] != 50) { return 18; }
    if (buf[3] != 51) { return 19; }
    if (buf[4] != 52) { return 20; }
    if (buf[5] != 53) { return 21; }

    // The most negative i64 formats without overflowing the magnitude.
    var min: i64 = 0 - 9223372036854775807 - 1;
    var minn: int = format_int(&buf[0], 32, min);
    if (minn != 20) { return 22; }
    if (buf[0] != 45) { return 23; }
    if (buf[19] != 56) { return 24; }

    // A short caller buffer is refused without writing over it.
    var before: u8 = buf[0];
    var refused: int = format_int(&buf[0], 2, -12345);
    if (refused != -1) { return 25; }
    if (buf[0] != before) { return 26; }

    // Unsigned decimal and hexadecimal into caller storage.
    var z: int = format_uint(&buf[0], 32, 0 as u64);
    if (z != 1 || buf[0] != 48) { return 27; }
    var u: int = format_uint(&buf[0], 32, 123456789 as u64);
    if (u != 9) { return 28; }
    if (buf[0] != 49 || buf[8] != 57) { return 29; }
    var h: int = format_hex(&buf[0], 32, 256 as u64);
    if (h != 3) { return 30; }
    if (buf[0] != 49 || buf[1] != 48 || buf[2] != 48) { return 31; }
    h = format_hex(&buf[0], 32, 48879 as u64);
    if (h != 4) { return 32; }
    if (buf[0] != 98 || buf[1] != 101 || buf[2] != 101 || buf[3] != 102) { return 33; }

    // Copy is an explicit deep copy; mutating the source leaves it alone.
    var copy: String = string_copy(&lit);
    if (string_view(&copy) != "hello") { return 34; }
    string_append_byte(&lit, 33);
    if (string_view(&lit) != "hello!") { return 35; }
    if (string_view(&copy) != "hello") { return 36; }

    // Move transfers ownership and empties the source.
    var moved: String = string_move(&copy);
    if (string_len(&copy) != 0) { return 37; }
    if (string_cap(&copy) != 0) { return 38; }
    if (string_data(&copy) != nilPtr) { return 39; }
    if (string_view(&moved) != "hello") { return 40; }
    string_append_byte(&moved, 63);
    if (string_view(&moved) != "hello?") { return 41; }

    // Repeated growth keeps every byte and reports a real capacity.
    var grow: String = string_new();
    var i: int = 0;
    while (i < 100) {
        string_append_byte(&grow, 65);
        i = i + 1;
    }
    if (string_len(&grow) != 100) { return 42; }
    if (string_cap(&grow) < 100) { return 43; }
    var g: *u8 = string_data(&grow);
    i = 0;
    while (i < 100) {
        if (*(g + i) != 65) { return 44; }
        i = i + 1;
    }
    if (string_view(&grow)[99] != (65 as char)) { return 45; }

    print("result=");
    print(string_view(&s));
    print("\n");

    // Explicit cleanup only. Deinit is idempotent and clears the fields.
    string_deinit(&lit);
    string_deinit(&moved);
    string_deinit(&grow);
    string_deinit(&s);
    if (string_data(&s) != nilPtr) { return 46; }
    if (string_len(&s) != 0) { return 47; }
    if (string_cap(&s) != 0) { return 48; }
    if (string_view(&s) != "") { return 49; }
    string_deinit(&s);
    return 0;
}
