struct One {
  var v: u64;
}

struct Rect {
  var x: int;
  var y: int;
  var w: int;
  var h: int;
}

func getone(o: One) -> u64 {
  return o.v;
}

func overlaps(a: Rect, b: Rect) -> bool {
  if (b.x >= a.x + a.w) { return false; }
  if (b.x + b.w <= a.x) { return false; }
  return true;
}

func main() -> int {
  var o: One = One { v: 7 };
  if (getone(o) != 7) { return 1; }
  var dr: Rect = Rect { x: 0, y: 0, w: 10, h: 10 };
  var wt: Rect = Rect { x: 5, y: 5, w: 10, h: 10 };
  if (!overlaps(dr, wt)) { return 2; }
  var far: Rect = Rect { x: 50, y: 50, w: 5, h: 5 };
  if (overlaps(dr, far)) { return 3; }
  o.v = 99;
  if (getone(o) != 99) { return 4; }
  return 0;
}
