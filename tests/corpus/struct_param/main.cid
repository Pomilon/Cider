struct One {
  var v: u64;
}

struct Rect {
  var x: int;
  var y: int;
  var w: int;
  var h: int;
}

func getone(o: One) -> u64 {
  return o.v;
}

func overlaps(a: Rect, b: Rect) -> bool {
  if (b.x >= a.x + a.w) { return false; }
  if (b.x + b.w <= a.x) { return false; }
  return true;
}

func main() -> int {
  var o: One;
  o.v = 7;
  if (getone(o) != 7) { return 1; }
  var dr: Rect;
  dr.x = 0; dr.y = 0; dr.w = 10; dr.h = 10;
  var wt: Rect;
  wt.x = 5; wt.y = 5; wt.w = 10; wt.h = 10;
  if (!overlaps(dr, wt)) { return 2; }
  var far: Rect;
  far.x = 50; far.y = 50; far.w = 5; far.h = 5;
  if (overlaps(dr, far)) { return 3; }
  o.v = 99;
  if (getone(o) != 99) { return 4; }
  return 0;
}
