// CIDER-BUG-057: a slice assigned to a fixed array must copy the slice's
// elements (base[start .. end)) into the target — not the slice
// descriptor's header words. The target array size governs a copy whose
// slice length is dynamic; a statically-known mismatch is rejected by the
// checker (see tests/fixtures/check_slice_size_mismatch).
struct Pair {
    var arr: [u8; 2];
}

func main() -> int {
    var a: [u8; 5] = [10, 42, 43, 44, 50];

    // Middle slice into a matching-size array at declaration time.
    var s: [u8; 3] = a[1:4];
    if (s[0] != 42) { return 1; }
    if (s[1] != 43) { return 2; }
    if (s[2] != 44) { return 3; }

    // The copy must not modify the source array.
    if (a[1] != 42) { return 4; }

    // Head form a[:3].
    var h: [u8; 3] = a[0:3];
    if (h[0] != 10) { return 5; }
    if (h[1] != 42) { return 6; }
    if (h[2] != 43) { return 7; }

    // Tail form a[2:].
    var t: [u8; 3] = a[2:5];
    if (t[0] != 43) { return 8; }
    if (t[1] != 44) { return 9; }
    if (t[2] != 50) { return 10; }

    // Assignment into an existing array (no initializer) copies too.
    var u: [u8; 3] = [0, ...];
    u = a[1:4];
    if (u[0] != 42) { return 11; }
    if (u[1] != 43) { return 12; }
    if (u[2] != 44) { return 13; }

    // Wider elements: the copy must use the target's element width.
    var b: [int; 4] = [100, 200, 300, 400];
    var bi: [int; 2] = b[1:3];
    if (bi[0] != 200) { return 14; }
    if (bi[1] != 300) { return 15; }
    var bj: [int; 2] = [0, ...];
    bj = b[2:4];
    if (bj[0] != 300) { return 16; }
    if (bj[1] != 400) { return 17; }

    // Dynamic bounds: the target's element count governs the copy (the
    // checker cannot compare a runtime length; see the fixture for the
    // static-mismatch diagnostic).
    var lo: int = 1;
    var hi: int = 4;
    var d: [u8; 3] = a[lo:hi];
    if (d[0] != 42) { return 18; }
    if (d[1] != 43) { return 19; }
    if (d[2] != 44) { return 20; }

    // Assignment into an array element (nested fixed arrays): the element
    // slot is the copy target.
    var rows: [[u8; 2]; 3] = [0, ...];
    rows[0] = a[0:2];
    rows[2] = a[3:5];
    if (rows[0][0] != 10) { return 21; }
    if (rows[0][1] != 42) { return 22; }
    if (rows[2][0] != 44) { return 23; }
    if (rows[2][1] != 50) { return 24; }

    // for-in over a slice still iterates the slice's range only.
    var sum: int = 0;
    for (var x in a[1:4]) {
        sum = sum + x;
    }
    if (sum != 129) { return 25; }

    var isum: int = 0;
    for (var y in b[1:3]) {
        isum = isum + y;
    }
    if (isum != 500) { return 26; }

    var hsum: int = 0;
    for (var z in a[0:2]) {
        hsum = hsum + z;
    }
    if (hsum != 52) { return 27; }

    var tsum: int = 0;
    for (var w in a[3:5]) {
        tsum = tsum + w;
    }
    if (tsum != 94) { return 28; }

    // A nested-array source steps by the inner element's size.
    var m: [[u8; 2]; 4] = [0, ...];
    m[0][0] = 1; m[0][1] = 2;
    m[1][0] = 3; m[1][1] = 4;
    m[2][0] = 5; m[2][1] = 6;
    m[3][0] = 7; m[3][1] = 8;
    var r: [[u8; 2]; 2] = m[1:3];
    if (r[0][0] != 3) { return 29; }
    if (r[0][1] != 4) { return 30; }
    if (r[1][0] != 5) { return 31; }
    if (r[1][1] != 6) { return 32; }

    // A struct member array is an assignment target too.
    var p: Pair = Pair { arr: [0, 0] };
    p.arr = a[0:2];
    if (p.arr[0] != 10) { return 33; }
    if (p.arr[1] != 42) { return 34; }

    return 0;
}
