var g_t: [u8; 4] = new [u8; 4] {10, 20, 30, 40};
var g_w: [u16; 2] = new [u16; 2] {1000, 2000};

func main() -> int {
  if (g_t[0] != 10) { return 1; }
  if (g_t[3] != 40) { return 2; }
  if (g_w[1] != 2000) { return 3; }
  var t: [u8; 4] = new [u8; 4] {1, 2, 3, 4};
  if (t[2] != 3) { return 4; }
  var n: int = 9;
  var u: [u8; 2] = new [u8; 2] {n as u8, 8};
  if (u[0] != 9) { return 5; }
  if (u[1] != 8) { return 6; }
  return 0;
}
