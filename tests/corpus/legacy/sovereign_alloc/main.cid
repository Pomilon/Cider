from std.io import print, printInt, puts;
from std.alloc import malloc;

class Block {
    var size: int;
    var used: int;
    var data: *void;
}

class SovereignAlloc {
    var total_allocated: int;

    func alloc_block(size: int) -> *Block {
        var b: *Block = malloc(24) as *Block;
        (*b).size = size;
        (*b).used = 1;
        (*b).data = malloc(size as i64);
        (*self).total_allocated = (*self).total_allocated + size + 24;
        return b;
    }

    func report() -> void {
        print("Total Sovereign Bytes: ");
        printInt((*self).total_allocated);
        print("\n");
    }
}

func main() -> int {
    puts("Testing Sovereign Allocator...");
    var sa: *SovereignAlloc = malloc(sizeof(SovereignAlloc)) as *SovereignAlloc;
    (*sa).total_allocated = 0;

    var b1: *Block = (*sa).alloc_block(100);
    var b2: *Block = (*sa).alloc_block(200);
    var b3: *Block = (*sa).alloc_block(300);

    (*sa).report();
    
    print("Block 1 Size: "); printInt((*b1).size); print("\n");
    print("Block 2 Size: "); printInt((*b2).size); print("\n");
    print("Block 3 Size: "); printInt((*b3).size); print("\n");

    return 0;
}
