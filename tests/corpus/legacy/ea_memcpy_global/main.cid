from std.alloc import malloc, free;

class Point {
    var x: int;
}

class Box {
    var p: *Point;
    var q: *Point;
}

var gbox: Box = new Box { p: nilPtr, q: nilPtr };

func main() -> int {
    var np: *Point = malloc(sizeof(Point)) as *Point;
    var box1: Box = new Box { p: np, q: nilPtr };
    gbox = box1;           // MEMCPY into a GLOBAL — the pointer escapes
    (*box1.p).x = 42;
    var r: int = (*gbox.p).x;
    if (r == 42) { return 42; }
    return 1;
}
