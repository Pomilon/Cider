from std.io import puts, exit;

class Counter {
    var value: int;

    func increment() {
        (*self).value = (*self).value + 1;
    }

    func getValue() -> int {
        return (*self).value;
    }
}

func test_basic_class() -> int {
    var c: Counter = new Counter { value: 0 };
    c.increment();
    c.increment();
    c.increment();
    if (c.getValue() != 3) { return 1; }
    return 0;
}

func test_method_return() -> int {
    var c: Counter = new Counter { value: 42 };
    if (c.getValue() != 42) { return 2; }
    return 0;
}

func main() -> int {
    var result: int = 0;

    result = test_basic_class();
    if (result != 0) { puts("FAIL: basic class"); exit(result); }

    result = test_method_return();
    if (result != 0) { puts("FAIL: method return"); exit(result); }

    puts("PASS: class_method_stress");
    return 0;
}
