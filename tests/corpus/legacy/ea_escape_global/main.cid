from std.alloc import malloc, free;

class Point {
    var x: int;
}

var gp: *Point = nilPtr;

func main() -> int {
    var p: *Point = malloc(sizeof(Point)) as *Point;
    gp = p;        // escapes via global store
    (*p).x = 5;
    var r: int = (*gp).x;
    if (r == 5) { return 42; }
    return 1;
}
