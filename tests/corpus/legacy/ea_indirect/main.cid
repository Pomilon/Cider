from std.alloc import malloc, free;

class Shape {
    virtual func identify() -> int {
        return 1;
    }
}

// Migrated to v3: inheritance spells `class Circle : Shape`, the
// redeclaration itself overrides (no `override` keyword), and a pointer
// receiver calls with `->`.
class Circle : Shape {
    func identify() -> int {
        return 2;
    }
}

func _start() {
    var s: *Shape = new Circle { };
    var r: int = s->identify();   // VIRTUAL_CALL — conservative escape
    delete s;
    if (r == 2) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
