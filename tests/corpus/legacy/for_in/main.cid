func _start() {
    var arr: [int; 5] = new [int; 5] {[0, ...]};
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;

    var sum: int = 0;
    for (var x in arr) {
        sum = sum + x;
    }

    asm {
        "mov rax, 60"
        "mov edi, {sum}"
        "syscall"
    }
}
