from std.io import puts, printInt, exit;
from std.alloc import malloc, free;

// ===== UNION STRESS =====
union IntOrInt {
    var a: int;
    var b: int;
}

struct WithUnion {
    var tag: int;
    var data: IntOrInt;
}

func test_union_stress() -> int {
    // Overlap verification
    var u: IntOrInt;
    u.a = 42;
    if (u.a != 42) { return 1; }
    if (u.b != 42) { return 2; }
    u.b = 99;
    if (u.a != 99) { return 3; }
    // Struct containing union
    var w: WithUnion;
    w.tag = 1;
    w.data.a = 42;
    if (w.data.a != 42) { return 4; }
    // Array of unions
    var arr: [IntOrInt; 5];
    for (var i: int = 0; i < 5; i = i + 1) {
        arr[i].a = i * 100;
    }
    var sum: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) {
        sum = sum + arr[i].a;
    }
    if (sum != 1000) { return 5; }
    // sizeof
    if (sizeof(IntOrInt) != 4) { return 6; }
    return 0;
}

// ===== ALLOCATOR STRESS =====
func test_alloc_stress_extended() -> int {
    // Individual allocations
    var p0: *void = malloc(8) as *void;
    if (p0 == 0) { return 1; }
    var p1: *void = malloc(8) as *void;
    if (p1 == 0) { return 1; }
    var p2: *void = malloc(8) as *void;
    if (p2 == 0) { return 1; }
    // Array of pointers
    var ptrs: [*void; 3];
    ptrs[0] = p0;
    ptrs[1] = p1;
    ptrs[2] = p2;
    if (ptrs[0] == 0) { return 1; }
    if (ptrs[1] == 0) { return 1; }
    // Free through array
    free(ptrs[0]);
    free(ptrs[1]);
    free(ptrs[2]);
    return 0;
}

// ===== INTERFACE STRESS =====
interface Calculator {
    func compute(x: int) -> int;
}

class Adder {
    func compute(x: int) -> int {
        return x + 10;
    }
}

class Multiplier {
    func compute(x: int) -> int {
        return x * 3;
    }
}

func test_interface_stress() -> int {
    var a: Adder;
    var m: Multiplier;
    var c1: Calculator = a;
    var c2: Calculator = m;
    if (c1.compute(5) != 15) { return 1; }
    if (c2.compute(5) != 15) { return 2; }
    return 0;
}

// ===== DESTRUCTOR STRESS =====
var dtor_total: int = 0;

class DtorObj {
    func ~DtorObj() {
        dtor_total = dtor_total + 1;
    }
}

func test_dtor_stress() -> int {
    dtor_total = 0;
    // Single object scope
    {
        var a: DtorObj;
    }
    if (dtor_total != 1) { return 1; }
    // Multiple objects in same scope
    dtor_total = 0;
    {
        var a: DtorObj;
        var b: DtorObj;
    }
    if (dtor_total != 2) { return 2; }
    return 0;
}

// ===== TEMPLATE STRESS =====
func triple<T>(x: T) -> T {
    return x + x + x;
}

struct Pair<T> {
    var first: T;
    var second: T;
}

func test_template_stress() -> int {
    if (triple::<int>(5) != 15) { return 1; }
    var p: Pair<int>;
    p.first = 10;
    p.second = 20;
    if (p.first + p.second != 30) { return 2; }
    return 0;
}

// ===== SLICE STRESS =====
func test_slice_stress() -> int {
    var arr: [int; 10];
    for (var i: int = 0; i < 10; i = i + 1) {
        arr[i] = i * 10;
    }
    // Partial slice via for-in
    var sum: int = 0;
    for (var x in arr[3:7]) {
        sum = sum + x;
    }
    // arr[3:7] = [30, 40, 50, 60] = 180
    if (sum != 180) { return 1; }
    // Empty-ish slice
    sum = 0;
    for (var x in arr[0:0]) {
        sum = sum + x;
    }
    if (sum != 0) { return 2; }
    // Full slice via for-in
    sum = 0;
    for (var x in arr[0:10]) {
        sum = sum + x;
    }
    // sum of 0,10,20,...,90 = 450
    if (sum != 450) { return 3; }
    return 0;
}

// ===== FOR-IN STRESS =====
func test_forin_stress() -> int {
    var arr: [int; 10];
    for (var i: int = 0; i < 10; i = i + 1) { arr[i] = i; }
    // Basic sum
    var sum: int = 0;
    for (var x in arr) { sum = sum + x; }
    if (sum != 45) { return 1; }
    // Break
    sum = 0;
    for (var x in arr) {
        if (x >= 5) { break; }
        sum = sum + x;
    }
    if (sum != 10) { return 2; }
    // Continue
    sum = 0;
    for (var x in arr) {
        if (x % 2 == 0) { continue; }
        sum = sum + x;
    }
    if (sum != 25) { return 3; }
    return 0;
}

// ===== CROSS-FEATURE STRESS =====
func test_cross_feature() -> int {
    // Union + for-in
    var arr: [IntOrInt; 5];
    for (var i: int = 0; i < 5; i = i + 1) { arr[i].a = i; }
    var sum: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) { sum = sum + arr[i].a; }
    if (sum != 10) { return 1; }
    // Template
    if (triple::<int>(5) != 15) { return 2; }
    return 0;
}

func _start() {
    var r: int = 0;

    puts("union...\n");
    r = test_union_stress();
    if (r != 0) { puts("FAIL: union\n"); exit(r); }

    puts("alloc...\n");
    r = test_alloc_stress_extended();
    if (r != 0) { puts("FAIL: alloc\n"); exit(r); }

    puts("interface...\n");
    r = test_interface_stress();
    if (r != 0) { puts("FAIL: interface\n"); exit(r); }

    puts("dtor...\n");
    r = test_dtor_stress();
    if (r != 0) { puts("FAIL: destructor\n"); exit(r); }

    puts("template...\n");
    r = test_template_stress();
    if (r != 0) { puts("FAIL: template\n"); exit(r); }

    puts("slice...\n");
    r = test_slice_stress();
    if (r != 0) { puts("FAIL: slice\n"); exit(r); }

    puts("for-in...\n");
    r = test_forin_stress();
    if (r != 0) { puts("FAIL: for-in\n"); exit(r); }

    puts("cross...\n");
    r = test_cross_feature();
    if (r != 0) { puts("FAIL: cross\n"); exit(r); }

    puts("PASS: phase1_stress\n");

    asm { "mov rax, 60" "xor rdi, rdi" "syscall" }
}
