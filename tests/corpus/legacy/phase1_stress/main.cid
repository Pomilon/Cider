from std.alloc import operator new, operator delete, malloc, free;
from std.io import puts, printInt, exit;

// ===== UNION STRESS =====
union IntOrInt {
    var a: int;
    var b: int;
}

struct WithUnion {
    var tag: int;
    var data: IntOrInt;
}

func test_union_stress() -> int {
    // Overlap verification. v3 unions are tagged (TYPES 3.4a): the tag
    // names the live member, so a read under the other member's name
    // faults. Same-type overlap coverage goes through the documented
    // raw-bytes row instead (union as int reads the payload, tag
    // ignored, TYPES 4.6) — the bytes are the same bytes.
    var u: IntOrInt = IntOrInt { a: 0 };
    u.a = 42;
    if (u.a != 42) { return 1; }
    if ((u as int) != 42) { return 2; }
    u.b = 99;
    if ((u as int) != 99) { return 3; }
    // Struct containing union
    var w: WithUnion = WithUnion { tag: 1, data: IntOrInt { a: 42 } };
    if (w.data.a != 42) { return 4; }
    // Array of unions
    var arr: [IntOrInt; 5] = [IntOrInt { a: 0 }, ...];
    for (var i: int = 0; i < 5; i = i + 1) {
        arr[i].a = i * 100;
    }
    var sum: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) {
        sum = sum + arr[i].a;
    }
    if (sum != 1000) { return 5; }
    // sizeof: the tagged layout answers payload + tag (TYPES 3.4a)
    if (sizeof(IntOrInt) != 8) { return 6; }
    return 0;
}

// ===== ALLOCATOR STRESS =====
func test_alloc_stress_extended() -> int {
    // Individual allocations
    var p0: *void = malloc(8) as *void;
    if (p0 == nilPtr) { return 1; }
    var p1: *void = malloc(8) as *void;
    if (p1 == nilPtr) { return 1; }
    var p2: *void = malloc(8) as *void;
    if (p2 == nilPtr) { return 1; }
    // Array of pointers
    var ptrs: [*void; 3] = [p0, p1, p2];
    ptrs[1] = p1;
    ptrs[2] = p2;
    if (ptrs[0] == nilPtr) { return 1; }
    if (ptrs[1] == nilPtr) { return 1; }
    // Free through array
    free(ptrs[0]);
    free(ptrs[1]);
    free(ptrs[2]);
    return 0;
}

// ===== INTERFACE STRESS =====
interface Calculator {
    func compute(x: int) -> int;
}

class Adder {
    func compute(x: int) -> int {
        return x + 10;
    }
}

class Multiplier {
    func compute(x: int) -> int {
        return x * 3;
    }
}

func test_interface_stress() -> int {
    var a: Adder = Adder { };
    var m: Multiplier = Multiplier { };
    var c1: Calculator = a;
    var c2: Calculator = m;
    if (c1.compute(5) != 15) { return 1; }
    if (c2.compute(5) != 15) { return 2; }
    return 0;
}

// ===== DESTRUCTOR STRESS =====
// v3 finalizes only on delete (FEATURES 5.3): v2's scope-exit ~DtorObj
// becomes an explicit delete at the end of each scope. The counts stay
// exactly the ones the scope-unwind model produced.
var dtor_total: int = 0;

class DtorObj {
    func deinit() {
        dtor_total = dtor_total + 1;
    }
}

func test_dtor_stress() -> int {
    dtor_total = 0;
    // Single object scope
    {
        var a: *DtorObj = malloc(sizeof(DtorObj) as i64) as *DtorObj;
        delete a;
    }
    if (dtor_total != 1) { return 1; }
    // Multiple objects in same scope
    dtor_total = 0;
    {
        var a: *DtorObj = malloc(sizeof(DtorObj) as i64) as *DtorObj;
        var b: *DtorObj = malloc(sizeof(DtorObj) as i64) as *DtorObj;
        delete b;
        delete a;
    }
    if (dtor_total != 2) { return 2; }
    return 0;
}

// ===== TEMPLATE STRESS =====
func triple<T>(x: T) -> T {
    return x + x + x;
}

struct Pair<T> {
    var first: T;
    var second: T;
}

func test_template_stress() -> int {
    if (triple::<int>(5) != 15) { return 1; }
    var p: Pair<int> = Pair<int> { first: 10, second: 20 };
    if (p.first + p.second != 30) { return 2; }
    return 0;
}

// ===== SLICE STRESS =====
func test_slice_stress() -> int {
    var arr: [int; 10] = [0, ...];
    for (var i: int = 0; i < 10; i = i + 1) {
        arr[i] = i * 10;
    }
    // Partial slice via for-in
    var sum: int = 0;
    for (var x in arr[3:7]) {
        sum = sum + x;
    }
    // arr[3:7] = [30, 40, 50, 60] = 180
    if (sum != 180) { return 1; }
    // Empty-ish slice
    sum = 0;
    for (var x in arr[0:0]) {
        sum = sum + x;
    }
    if (sum != 0) { return 2; }
    // Full slice via for-in
    sum = 0;
    for (var x in arr[0:10]) {
        sum = sum + x;
    }
    // sum of 0,10,20,...,90 = 450
    if (sum != 450) { return 3; }
    return 0;
}

// ===== FOR-IN STRESS =====
func test_forin_stress() -> int {
    var arr: [int; 10] = [0, ...];
    for (var i: int = 0; i < 10; i = i + 1) { arr[i] = i; }
    // Basic sum
    var sum: int = 0;
    for (var x in arr) { sum = sum + x; }
    if (sum != 45) { return 1; }
    // Break
    sum = 0;
    for (var x in arr) {
        if (x >= 5) { break; }
        sum = sum + x;
    }
    if (sum != 10) { return 2; }
    // Continue
    sum = 0;
    for (var x in arr) {
        if (x % 2 == 0) { continue; }
        sum = sum + x;
    }
    if (sum != 25) { return 3; }
    return 0;
}

// ===== CROSS-FEATURE STRESS =====
func test_cross_feature() -> int {
    // Union + for-in
    var arr: [IntOrInt; 5] = [IntOrInt { a: 0 }, ...];
    for (var i: int = 0; i < 5; i = i + 1) { arr[i].a = i; }
    var sum: int = 0;
    for (var i: int = 0; i < 5; i = i + 1) { sum = sum + arr[i].a; }
    if (sum != 10) { return 1; }
    // Template
    if (triple::<int>(5) != 15) { return 2; }
    return 0;
}

func _start() {
    var r: int = 0;

    puts("union...\n");
    r = test_union_stress();
    if (r != 0) { puts("FAIL: union\n"); exit(r); }

    puts("alloc...\n");
    r = test_alloc_stress_extended();
    if (r != 0) { puts("FAIL: alloc\n"); exit(r); }

    puts("interface...\n");
    r = test_interface_stress();
    if (r != 0) { puts("FAIL: interface\n"); exit(r); }

    puts("dtor...\n");
    r = test_dtor_stress();
    if (r != 0) { puts("FAIL: destructor\n"); exit(r); }

    puts("template...\n");
    r = test_template_stress();
    if (r != 0) { puts("FAIL: template\n"); exit(r); }

    puts("slice...\n");
    r = test_slice_stress();
    if (r != 0) { puts("FAIL: slice\n"); exit(r); }

    puts("for-in...\n");
    r = test_forin_stress();
    if (r != 0) { puts("FAIL: for-in\n"); exit(r); }

    puts("cross...\n");
    r = test_cross_feature();
    if (r != 0) { puts("FAIL: cross\n"); exit(r); }

    puts("PASS: phase1_stress\n");

    asm { "mov rax, 60" "xor rdi, rdi" "syscall" }
}
