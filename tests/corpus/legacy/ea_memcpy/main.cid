from std.alloc import malloc, free;
class Point {
    var x: int;
}

class Box {
    var p: *Point;
    var q: *Point;
}

func main() -> int {
    var np: *Point = malloc(sizeof(Point)) as *Point;
    var box1: Box = Box { p: np, q: nilPtr };    // taints box1's slot
    var box2: Box = box1;  // MEMCPY — must propagate taint to box2's slot
    (*box2.p).x = 42;
    free(box2.p as *void);         // free must be recognized and removed
    var r: int = (*box1.p).x;
    if (r == 42) { return 42; }
    return 1;
}
