class Point {
    var x: int;
}

class Box {
    var p: *Point;
    var q: *Point;
}

func _start() {
    var box1: Box;
    box1.p = new Point;    // taints box1's slot
    var box2: Box = box1;  // MEMCPY — must propagate taint to box2's slot
    box2.p.x = 42;
    delete box2.p;         // free must be recognized and removed
    var r: int = box1.p.x;
    if (r == 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
