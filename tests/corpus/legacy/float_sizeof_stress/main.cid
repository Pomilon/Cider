from std.io import puts, exit;

func test_char_string() -> int {
    var c: char = 'A';
    if (c != (65 as char)) { return 1; }
    if (c != 'A') { return 2; }

    c = 'Z';
    if (c != (90 as char)) { return 3; }

    var lower: char = 'a';
    var upper: char = ((lower as u8) - 32) as char;
    if (upper != 'A') { return 4; }

    return 0;
}

func test_sizeof() -> int {
    var si32: i64 = sizeof(int);
    if (si32 != 4) { return 1; }

    var si64: i64 = sizeof(i64);
    if (si64 != 8) { return 2; }

    var schar: i64 = sizeof(char);
    if (schar != 1) { return 3; }

    // v3 bool is one byte (layout.h); v2's 4-byte bool is not inherited
    var sbool: i64 = sizeof(bool);
    if (sbool != 1) { return 4; }

    var sfloat: i64 = sizeof(float);
    if (sfloat != 4) { return 5; }

    return 0;
}

func test_string_exists() -> int {
    var s: string = "hello";
    return 0;
}

func main() -> int {
    var result: int = test_char_string();
    if (result != 0) { return result; }
    result = test_sizeof();
    if (result != 0) { return result + 10; }
    result = test_string_exists();
    if (result != 0) { return result + 20; }
    return 0;
}
