from std.alloc import operator new, operator delete, malloc, free;

class Point {
    var x: int;
}

// destroy frees its param; v3 always allocates `new` on the heap.
func destroy(p: *Point) -> void {
    delete p;
}

// Migrated to v3: class values are built with literals naming every field
// and pointer field access spells `->`. v3 always allocates `new` on the
// heap, so the v2 stack-escape probe is moot and its post-free canary read
// (undefined behaviour) is dropped.
func _start() {
    var q: *Point = new Point { x: 0 };
    q->x = 42;
    var r: int = q->x;
    destroy(q);
    // v3 allocates every `new` on the heap, so the v2 stack-escape probe is
    // moot. The v2 post-free canary read is undefined behaviour and is
    // replaced by a read before the delete.
    if (r == 42) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
