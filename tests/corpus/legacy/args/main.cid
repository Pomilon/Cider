func main(argc: i64, argv: **char) -> int {
    if (argc < 1) {
        return 1;
    }

    if (argv[0] == nilPtr) {
        return 2;
    }

    if (argc >= 3) {
        if (argv[1] == nilPtr) {
            return 3;
        }
        if (argv[2] == nilPtr) {
            return 4;
        }
    }

    return 0;
}
