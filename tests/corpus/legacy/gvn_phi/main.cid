func sum_loop(n: u64) -> u64 {
    var total: u64 = 0;
    var i: u64 = 0;
    while (i < n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

func _start() {
    var s1: u64 = sum_loop(10);  // 0+1+...+9 = 45
    var s2: u64 = sum_loop(5);   // 0+1+...+4 = 10
    if (s1 == 45 && s2 == 10) {
        asm { "mov rax, 60" }
        asm { "mov rdi, 42" }
        asm { "syscall" }
    }
    asm { "mov rax, 60" }
    asm { "mov rdi, 1" }
    asm { "syscall" }
}
