from std.io import puts;

interface Drawable {
    func draw() -> void;
}

class Circle {
    func draw() -> void {
        puts("Circle");
    }
}

class Square {
    func draw() -> void {
        puts("Square");
    }
}

func main() -> int {
    var c: Circle = new Circle { };
    var s: Square = new Square { };
    var d1: Drawable = &c;
    var d2: Drawable = &s;
    d1.draw();
    d2.draw();
    puts("PASS: interface");
    return 0;
}
