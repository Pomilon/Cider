from std.io import puts, exit;

union IntOrInt {
    var a: int;
    var b: int;
}

union IntAndChar {
    var i: int;
    var c: char;
}

struct Pair {
    var x: int;
    var y: int;
}

union StructOrInt {
    var p: Pair;
    var i: int;
}

func _start() {
    // Test 1: Two ints share offset 0 — verify overlap
    var u: IntOrInt;
    u.a = 42;
    if (u.a != 42) { puts("FAIL: write a\n"); exit(1); }
    if (u.b != 42) { puts("FAIL: b != a\n"); exit(2); }
    u.b = 99;
    if (u.a != 99) { puts("FAIL: write b doesn't change a\n"); exit(3); }
    // Test 2: sizeof = max field size
    var sz: int = sizeof(IntOrInt);
    if (sz != 4) { puts("FAIL: sizeof\n"); exit(4); }
    // Test 3: char + int — total size = 4
    var sz2: int = sizeof(IntAndChar);
    if (sz2 != 4) { puts("FAIL: sizeof char+int\n"); exit(5); }
    // Test 4: struct + int
    var su: StructOrInt;
    su.p.x = 10;
    su.p.y = 20;
    if (su.p.x + su.p.y != 30) { puts("FAIL: struct in union\n"); exit(6); }
    puts("PASS: union\n");
    asm { "mov rax, 60" "xor rdi, rdi" "syscall" }
}
