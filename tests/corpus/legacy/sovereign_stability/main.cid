from std.io import print, printInt, puts;
from std.alloc import malloc;

class Worker {
    var id: int;
    virtual func work(n: int) -> int {
        if (n <= 0) return this->id;
        return this->work(n - 1) + 1;
    }
}

// Migrated to v3: inheritance spells `class SuperWorker : Worker`, the
// redeclaration itself overrides (no `override` keyword), field access
// through `this` spells `this->`, class values are built with literals, and
// `puts` is replaced by `print` with the newline in the string.
class SuperWorker : Worker {
    func work(n: int) -> int {
        if (n <= 0) return this->id * 2;
        return this->work(n - 1) + 2;
    }
}

func _start() -> void {
    print("Starting Sovereign Stability Test...\n");
    
    var total_success: int = 0;
    for (var i: int = 0; i < 10; i = i + 1) {
        var w: *Worker = nilPtr;
        if (i % 2 == 0) {
            w = new Worker { id: 0 };
            w->id = i;
        } else {
            w = new SuperWorker { id: 0 };
            w->id = i;
        }
        
        // Polymorphic call with recursion
        var res: int = w->work(10);
        
        print("Iteration "); printInt(i); 
        print(" Result: "); printInt(res); 
        print("\n");
        
        total_success = total_success + 1;
    }
    
    print("Stability Test Complete. Cycles: ");
    printInt(total_success);
    print("\n");

    asm {
        "mov rax, 60\n"
        "xor rdi, rdi\n"
        "syscall\n"
    }
}
