from std.alloc import malloc, free;

class Point {
    var x: int;
}

var stored: *Point = nilPtr;

// keep stores p into a global — its param summary must be escaping.
func keep(p: *Point) {
    stored = p;
}

func main() -> int {
    var q: *Point = malloc(sizeof(Point)) as *Point;
    keep(q);        // q escapes via keep's escaping param
    (*q).x = 42;
    var r: int = (*stored).x;
    free(q as *void);
    if (r == 42) { return 42; }
    return 1;
}
