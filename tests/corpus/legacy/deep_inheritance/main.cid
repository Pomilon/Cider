// Migrated to v3: inheritance spells `class D : C`, and a class literal
// names every non-defaulted field, inherited ones included.
class A {
    var a: int;
}
class B : A {
    var b: int;
}
class C : B {
    var c: int;
}
class D : C {
    var d: int;
}

func main() -> int {
    var obj: *D = new D { a: 0, b: 0, c: 0, d: 0 };
    obj->a = 1;
    obj->b = 2;
    obj->c = 4;
    obj->d = 8;
    
    var sum: int = obj->a + obj->b + obj->c + obj->d;
    return sum; // 1 + 2 + 4 + 8 = 15
}
