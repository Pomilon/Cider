from std.io import print, printInt, puts;
from std.alloc import malloc;

class Node {
    var value: int;
    var next: *Node;
}

class LinkedList {
    var head: *Node;

    func append(val: int) -> void {
        var newNode: *Node = malloc(sizeof(Node)) as *Node;
        (*newNode).value = val;
        (*newNode).next = nilPtr;

        if ((*self).head == nilPtr) {
            (*self).head = newNode;
            return;
        }

        var curr: *Node = (*self).head;
        while ((*curr).next != nilPtr) {
            curr = (*curr).next;
        }
        (*curr).next = newNode;
    }

    func printList() -> void {
        var curr: *Node = (*self).head;
        while (curr != nilPtr) {
            printInt((*curr).value);
            print(" -> ");
            curr = (*curr).next;
        }
        puts("NULL");
    }
}

func main() -> int {
    puts("Testing Linked List...");
    var list: *LinkedList = malloc(sizeof(LinkedList)) as *LinkedList;
    (*list).head = nilPtr;

    (*list).append(10);
    (*list).append(20);
    (*list).append(30);
    (*list).append(40);

    (*list).printList();

    return 0;
}
