from std.alloc import operator new, operator delete, malloc, free;
from std.io import print, printInt, exit;

class Base {
    virtual func identify() -> void {
        print("Base\n");
    }
}

// Migrated to v3: inheritance spells `class Derived : Base`, the
// redeclaration itself overrides (no `override` keyword), and class values
// are built with literals.
class Derived : Base {
    func identify() -> void {
        print("Derived\n");
    }
}

func _start() -> void {
    var b: *Base = new Base { };
    var d: *Derived = new Derived { };
    var poly: *Base = d;

    print("b->identify(): ");
    b->identify();

    print("d->identify(): ");
    d->identify();

    print("poly->identify(): ");
    poly->identify();

    // syscall: exit(0)
    asm {
        "mov rax, 60"
        "xor rdi, rdi"
        "syscall"
    }
}
