func _start() {
    var size: int = 3;
    var matrix: [int; 9] = new [int; 9] {[0, ...]}; // 3x3 flat array
    
    // Initialize to identity matrix
    for (var i: int = 0; i < size; i = i + 1) {
        for (var j: int = 0; j < size; j = j + 1) {
            if (i == j) {
                matrix[i * size + j] = 1;
            } else {
                matrix[i * size + j] = 0;
            }
        }
    }
    
    // Sum all elements
    var total: int = 0;
    for (var k: int = 0; k < 9; k = k + 1) {
        total = total + matrix[k];
    }
    
    // syscall: exit(total)
    asm {
        "mov rax, 60"
        "mov edi, {total}"
        "syscall"
    }
}
