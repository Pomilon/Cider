// CIDER-BUG-070: module-qualified interface types in every declaration and
// dispatch position that accepts an unqualified interface: local variable,
// assignment/reassignment (fat-pointer store), method dispatch before and
// after retargeting, interface-typed struct/class fields, arrays, module
// globals, and interface parameters across modules. The companion lib.cid
// declares the interface and two implementors; extra.cid uses the same
// qualified spelling from a transitively imported module.
import lib;
import extra;
from lib import Shape, Sq, Rect;

// Qualified interface field: neighbours on both sides catch a wrong store
// width (the fat pointer must stay 16 bytes at a natural offset).
struct Holder {
  var id: int;
  var shape: lib.Shape;
  var tail: int;
}

class Box {
  var id: int;
  var shape: lib.Shape;
  var tail: int;
}

// A module-global interface variable with a qualified type.
var gshape: lib.Shape = nilPtr as lib.Shape;
var grect: lib.Rect = lib.Rect { w: 0, h: 0 };

// Qualified interface parameter. CIDER-BUG-080 accepts concrete values at
// call boundaries too, for both spellings; this test keeps to
// interface-to-interface passing. Reassigning the callee's by-value copy
// must not disturb the caller's fat pointer.
func areaVia(x: lib.Shape) -> int {
  return x.area();
}

func areaViaBare(x: Shape) -> int {
  return x.area();
}

func main() -> int {
  var sq: lib.Sq = lib.Sq { s: 3 };
  var rect: lib.Rect = lib.Rect { w: 2, h: 5 };

  // --- qualified declaration, initialization and dispatch ---
  var sh: lib.Shape = sq;
  if (sh.area() != 9) { return 1; }
  if (sh.kind() != 1) { return 2; }

  // --- reassignment to a second implementor: vtable follows the value ---
  sh = rect;
  if (sh.area() != 10) { return 3; }
  if (sh.kind() != 2) { return 4; }
  sh = sq;
  if (sh.area() != 9) { return 5; }

  // --- declaration without an initializer, then assignment ---
  var sh2: lib.Shape = nilPtr as lib.Shape;
  sh2 = rect;
  if (sh2.area() != 10) { return 6; }
  sh2 = sh;
  if (sh2.area() != 9) { return 7; }

  // --- pointer-to-class values retarget like declaration-time assignment ---
  var rp: *lib.Rect = &rect;
  sh = rp;
  if (sh.area() != 10) { return 8; }
  var hp: *lib.Rect = alloc(sizeof(lib.Rect), 8) as *lib.Rect;
  (*hp).w = 3;
  (*hp).h = 4;
  sh = hp;
  if (sh.area() != 12) { return 9; }

  // --- qualified interface field in a struct (16-byte store) ---
  var h: Holder = Holder { id: 7, shape: sq, tail: 9 };
  if (h.id != 7) { return 10; }
  if (h.tail != 9) { return 11; }
  if (h.shape.area() != 9) { return 12; }
  h.shape = rect;
  if (h.shape.area() != 10) { return 13; }
  if (h.shape.kind() != 2) { return 14; }
  if (h.id != 7) { return 15; }
  if (h.tail != 9) { return 16; }

  // Struct literal with a qualified interface field.
  var lit: Holder = Holder { id: 11, shape: rect, tail: 13 };
  if (lit.id != 11) { return 17; }
  if (lit.tail != 13) { return 18; }
  if (lit.shape.area() != 10) { return 19; }

  // --- qualified interface field in a class (value and heap) ---
  var b: Box = Box { id: 21, shape: rect, tail: 23 };
  if (b.shape.area() != 10) { return 20; }
  b.shape = sq;
  if (b.shape.kind() != 1) { return 21; }
  if (b.id != 21) { return 22; }
  if (b.tail != 23) { return 23; }
  var bp: *Box = alloc(sizeof(Box), 8) as *Box;
  (*bp).id = 31;
  (*bp).tail = 33;
  (*bp).shape = sq;
  if ((*bp).shape.area() != 9) { return 24; }
  (*bp).shape = rect;
  if ((*bp).shape.area() != 10) { return 25; }

  // --- array of qualified interface values (16-byte stride) ---
  var arr: [lib.Shape; 2] = [ nilPtr as lib.Shape, nilPtr as lib.Shape ];
  arr[0] = sq;
  arr[1] = rect;
  if (arr[0].area() != 9) { return 26; }
  if (arr[1].area() != 10) { return 27; }
  arr[0] = arr[1];
  if (arr[0].kind() != 2) { return 28; }

  // --- qualified interface parameter across modules ---
  if (areaVia(sh) != 12) { return 29; }
  if (extra.kindOf(sh) != 2) { return 30; }
  if (extra.retarget(sh) != 42) { return 31; }
  if (sh.area() != 12) { return 32; } // caller's fat pointer untouched
  if (areaViaBare(sh) != 12) { return 33; } // bare alias param, qualified arg
  var bare: Shape = rect;                  // bare declaration keeps working
  if (areaVia(bare) != 10) { return 34; }
  sh = bare;
  if (sh.kind() != 2) { return 35; }

  // --- module-global qualified interface variable ---
  gshape = sq;
  if (gshape.area() != 9) { return 36; }
  grect = rect;
  gshape = grect;
  if (gshape.area() != 10) { return 37; }
  gshape = hp;
  if (gshape.kind() != 2) { return 38; }
  gshape = sq;
  if (gshape.area() != 9) { return 39; }

  // --- a qualified interface value is a 16-byte fat pointer ---
  if (sizeof(lib.Shape) != 16) { return 40; }
  if (sizeof(Shape) != 16) { return 41; }

  return 0;
}
